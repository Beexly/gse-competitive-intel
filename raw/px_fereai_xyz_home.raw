disabled:pointer-events-none disabled:opacity-50 transition-[transform,opacity,background-color,border-color,filter] duration-gl-press ease-gl active:scale-[0.98] rounded-button hover:brightness-95 bg-gl-btn-primary text-gl-on-primary h-8 px-4 py-2 text-caption min-w-[64px]" aria-busy="false" href="/agent">Open Fere</a><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-semibold cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-gl-line-3 focus-visible:ring-offset-1 focus-visible:ring-offset-gl-bg disabled:pointer-events-none disabled:opacity-50 transition-[transform,opacity,background-color,border-color,filter] duration-gl-press ease-gl active:scale-[0.98] rounded-button bg-gl-surface-0 text-gl-ink border border-gl-line-2 hover:border-gl-line-3 text-caption p-0 h-8 w-8 min-w-0 md:hidden" aria-busy="false" aria-label="Open menu"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu h-4 w-4" aria-hidden="true"><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h16"></path></svg></button></div></nav></header><main class="pt-[calc(56px+var(--banner-h,0px))]"><section data-section="hero" class="mx-auto flex min-h-[calc(100dvh-57px)] w-full max-w-[1320px] flex-col justify-center px-4 py-10 md:px-8 lg:min-h-[calc(100dvh-72px)]"><div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-11"><div><p class="gl-lbl flex items-center gap-2"><span class="size-1.5 shrink-0 rounded-full bg-gl-ember"></span>AI trading strategies · every asset class</p><h1 class="day-one-display mt-3.5">A sentence becomes<br/>a strategy.</h1><p class="day-one-body-lg mt-[18px] max-w-[52ch]">Fere AI is an AI-powered crypto trading and research platform that gives traders autonomous agents with non-custodial wallets to analyze markets and execute on-chain trades around the clock.</p><p class="day-one-body-lg mt-3 max-w-[46ch]">Describe what to watch or trade. Fere compiles it into rules you can read and runs it 24/7 — paper first, hard caps always, kill switch one tap away.</p><p class="mt-2 max-w-[46ch] text-[13px] text-text-disabled">Use Fere inside ChatGPT &amp; Claude —<!-- --> <a class="text-text-tertiary underline-offset-2 transition-colors duration-gl-state ease-gl hover:text-text-primary hover:underline" href="#connect-mcp">Connect via MCP</a></p><div class="mt-6 flex flex-wrap items-center gap-3.5"><a class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-semibold cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-gl-line-3 focus-visible:ring-offset-1 focus-visible:ring-offset-gl-bg disabled:pointer-events-none disabled:opacity-50 transition-[transform,opacity,background-color,border-color,filter] duration-gl-press ease-gl active:scale-[0.98] rounded-button hover:brightness-95 bg-gl-btn-primary text-gl-on-primary h-12 px-6 py-3 text-body-normal min-w-[96px] min-h-11" aria-busy="false" href="/agent">Run your first strategy</a><a href="#stream" class="inline-flex min-h-11 items-center px-2.5 text-[13.5px] text-text-tertiary transition-colors duration-gl-state ease-gl hover:text-text-primary">watch the stream ↓</a></div><div class="mt-[26px] flex flex-col items-start gap-2.5"><div class="flex flex-col gap-3 items-center lg:items-start "><span class="text-caption font-semibold uppercase tracking-wide text-text-tertiary text-center lg:text-left">Ranked #1 on Product Hunt</span><div class="flex flex-wrap items-center gap-3 justify-center lg:justify-start"><a href="https://www.producthunt.com/products/fere-ai/launches/fere-ai?embed=true&amp;utm_source=badge-top-post-topic-badge&amp;utm_medium=badge&amp;utm_campaign=badge-fere-ai" target="_blank" rel="noopener noreferrer" class="inline-block transition-opacity duration-gl-state ease-gl hover:opacity-90" aria-label="Fere AI — #1 Product of the Month in Web3 on Product Hunt"><img src="/badges/ph-top-month-web3-light.svg" alt="" width="250" height="54" class="h-auto w-[210px] max-w-full sm:w-[230px] md:w-[250px]"/></a><a href="https://www.producthunt.com/products/fere-ai/launches/fere-ai?embed=true&amp;utm_source=badge-top-post-topic-badge&amp;utm_medium=badge&amp;utm_campaign=badge-fere-ai" target="_blank" rel="noopener noreferrer" class="inline-block transition-opacity duration-gl-state ease-gl hover:opacity-90" aria-label="Fere AI — #1 Product of the Month in Fintech on Product Hunt"><img src="/badges/ph-top-month-fintech-light.svg" alt="" width="250" height="54" class="h-auto w-[210px] max-w-full sm:w-[230px] md:w-[250px]"/></a></div></div><p class="flex flex-wrap items-center gap-x-[22px] gap-y-1"><span><span class="gl-fig-sm text-[15px] text-text-primary">10M+</span> <span class="day-one-stat-lbl">live executions</span></span><span><span class="gl-fig-sm text-[15px] text-text-primary">7,000+</span> <span class="day-one-stat-lbl">traders daily</span></span><span><span class="gl-fig-sm text-[15px] text-text-primary">90+</span> <span class="day-one-stat-lbl">days running</span></span></p></div></div><div class="day-one-hero-card relative"><div aria-hidden="true" class="pointer-events-none absolute inset-0 translate-y-[-38px] scale-[0.92] rounded-card border border-gl-line-1 bg-gl-surface-1 opacity-25"></div><div aria-hidden="true" class="pointer-events-none absolute inset-0 translate-y-[-20px] scale-[0.96] rounded-card border border-gl-line-2 gl-surface-2 opacity-50"></div><article class="day-one-hero-card-inner relative z-10 flex flex-col gap-2.5 overflow-hidden rounded-card border border-gl-line-3 gl-surface-3 p-4 shadow-[0_24px_64px_rgba(16,18,21,0.14)] dark:shadow-[0_24px_80px_rgba(0,0,0,0.5)]"><div aria-hidden="true" class="day-one-hero-sheen"></div><div class="flex items-center gap-2"><span class="inline-flex items-center rounded-chip border border-gl-line-1 bg-gl-surface-0 px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.1em] text-text-secondary">L2 · Live, capped</span><span class="flex-1"></span><span class="day-one-badge-live inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.12em]"><span class="gl-live-dot" aria-hidden="true"></span>live</span></div><h2 class="text-[22px] font-semibold leading-[1.14] tracking-[-0.035em] text-text-primary">Long HYPE when funding flips negative</h2><p class="text-[13.5px] leading-relaxed text-text-tertiary">Enter on the flip, size 5% of book, cut at −2%. Best in the 8h window after the reset.</p><div class="flex flex-wrap items-center gap-1.5"><span class="inline-flex shrink-0 items-center gap-2 whitespace-nowrap rounded-button border border-gl-line-1 bg-gl-surface-0 px-3 py-1.5 font-mono text-[10.5px] uppercase tracking-[0.1em] text-text-secondary"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="size-[15px] shrink-0 text-text-tertiary text-gl-pos"><path d="M3 12h4l2.5-6 4 12 2.5-6h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>Hyperliquid · perps</span><span class="inline-flex shrink-0 items-center gap-2 whitespace-nowrap rounded-button border border-gl-line-1 bg-gl-surface-0 px-3 py-1.5 font-mono text-[10.5px] uppercase tracking-[0.1em] text-text-secondary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-hexagon size-[15px] shrink-0 text-text-tertiary" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>Crypto</span><span class="inline-flex shrink-0 items-center gap-2 whitespace-nowrap rounded-button border border-gl-line-1 bg-gl-surface-0 px-3 py-1.5 font-mono text-[10.5px] uppercase tracking-[0.1em] text-text-secondary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-up size-[15px] shrink-0 text-text-tertiary" aria-hidden="true"><path d="M16 7h6v6"></path><path d="m22 7-8.5 8.5-5-5L2 17"></path></svg>Perps</span><span class="inline-flex shrink-0 items-center gap-2 whitespace-nowrap rounded-button border border-gl-line-1 bg-gl-surface-0 px-3 py-1.5 font-mono text-[10.5px] uppercase tracking-[0.1em] text-text-secondary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-up size-[15px] shrink-0 text-text-tertiary" aria-hidden="true"><path d="M16 7h6v6"></path><path d="m22 7-8.5 8.5-5-5L2 17"></path></svg>Funding</span></div><div class="flex items-end gap-3 border-t border-gl-line-1 pt-2.5"><svg viewBox="0 0 100 40" class="h-9 w-[88px] shrink-0 text-gl-pos" aria-hidden="true"><path d="M0,34 L10,32 L20,33 L30,28 L40,29 L50,24 L60,26 L70,20 L80,22 L90,18 L100,15" fill="none" stroke="currentColor" stroke-width="1.6" class="day-one-spark-draw"></path></svg><span><span class="gl-fig-lg block text-gl-pos">+18.4%</span><span class="gl-fig-sm block text-gl-ink-3">since deploy</span></span><span class="flex-1"></span><span class="gl-fig-sm text-right text-gl-ink-3">DD −9.4% · SR 2.14<br/>next run<!-- --> <span class="text-gl-ink-2">04:59</span></span></div><div class="rounded-input border border-gl-line-1 bg-gl-well px-3 py-2.5"><span class="gl-lbl-dim normal-case tracking-[0.05em]">latest run</span><p class="mt-1 text-[12.5px] text-gl-ink-2">14:22 · Run complete — funding still positive, no entry. Waiting.</p></div><div class="flex items-center gap-2 pt-1"><a class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-semibold cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-gl-line-3 focus-visible:ring-offset-1 focus-visible:ring-offset-gl-bg disabled:pointer-events-none disabled:opacity-50 transition-[transform,opacity,background-color,border-color,filter] duration-gl-press ease-gl active:scale-[0.98] rounded-button hover:brightness-95 bg-gl-btn-primary text-gl-on-primary h-10 px-6 py-3 text-body-sm min-w-[80px] min-h-11" aria-busy="false" href="/agent?query=Long+HYPE+when+funding+flips+negative">Run your own</a><span class="flex-1"></span><span class="inline-flex w-fit items-center gap-1.5 whitespace-nowrap rounded-full border border-gl-line-1 bg-gl-surface-0 py-0.5 pl-1 pr-2.5 text-[12px] text-text-secondary max-w-[55%] truncate"><span class="inline-flex size-[17px] shrink-0 items-center justify-center overflow-hidden rounded-full bg-gl-tile font-mono text-[8.5px] text-text-tertiary">X</span>@quantfeed on X · 4m</span></div></article><div class="relative z-10 mt-4 flex justify-center gap-1.5" role="tablist" aria-label="Example strategy cards"><button type="button" role="tab" aria-selected="true" aria-label="Show strategy: Long HYPE when funding flips negative" class="size-1.5 rounded-full transition-[background-color,transform] duration-gl-state ease-gl focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-gl-line-3 focus-visible:ring-offset-1 focus-visible:ring-offset-gl-bg scale-125 bg-gl-ember"></button><button type="button" role="tab" aria-selected="false" aria-label="Show strategy: Volatility breakout on the 4h, ATR-scaled" class="size-1.5 rounded-full bg-gl-ink-4 transition-[background-color,transform] duration-gl-state ease-gl focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-gl-line-3 focus-visible:ring-offset-1 focus-visible:ring-offset-gl-bg"></button><button type="button" role="tab" aria-selected="false" aria-label="Show strategy: Buy NO when rate-cut odds overshoot" class="size-1.5 rounded-full bg-gl-ink-4 transition-[background-color,transform] duration-gl-state ease-gl focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-gl-line-3 focus-visible:ring-offset-1 focus-visible:ring-offset-gl-bg"></button><button type="button" role="tab" aria-selected="false" aria-label="Show strategy: Fade the gold/oil ratio at 2σ extremes" class="size-1.5 rounded-full bg-gl-ink-4 transition-[background-color,transform] duration-gl-state ease-gl focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-gl-line-3 focus-visible:ring-offset-1 focus-visible:ring-offset-gl-bg"></button><button type="button" role="tab" aria-selected="false" aria-label="Show strategy: Fade outsized Saturday moves in BTC" class="size-1.5 rounded-full bg-gl-ink-4 transition-[background-color,transform] duration-gl-state ease-gl focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-gl-line-3 focus-visible:ring-offset-1 focus-visible:ring-offset-gl-bg"></button><button type="button" role="tab" aria-selected="false" aria-label="Show strategy: Ping crypto-exposed equities before earnings" class="size-1.5 rounded-full bg-gl-ink-4 transition-[background-color,transform] duration-gl-state ease-gl focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-gl-line-3 focus-visible:ring-offset-1 focus-visible:ring-offset-gl-bg"></button></div></div></div></section><section data-section="how" class="mx-auto w-full max-w-[1320px] px-4 py-11 md:px-8 lg:py-16"><div class="mb-2 flex flex-wrap items-baseline gap-3.5"><h2 class="day-one-h-sec">From a sentence to a filled order.</h2><span class="flex-1"></span><span class="gl-lbl">how it works</span></div><p class="day-one-body mb-[18px]">Not a dashboard. Not a signal bot. Fere breaks your strategy into steps, pulls live data for each, and executes real orders on real venues — then explains every run in a sentence.</p><div class="grid grid-cols-1 gap-3 md:grid-cols-3 md:gap-3.5"><div class="rounded-card border border-gl-line-1 bg-gl-surface-1 p-4"><span class="gl-lbl-ember">01<!-- --> · <!-- -->Describe it</span><p class="mt-2.5 text-[13px] leading-[1.5] text-text-tertiary">One sentence. Fere asks at most two clarifying questions, then compiles a spec you can read — numbered rules in plain English.</p></div><div class="rounded-card border border-gl-line-1 bg-gl-surface-1 p-4"><span class="gl-lbl-ember">02<!-- --> · <!-- -->Dry-run it</span><p class="mt-2.5 text-[13px] leading-[1.5] text-text-tertiary">Every strategy runs once before it deploys and shows the exact alert or trade it would have produced. Nothing goes live blind.</p></div><div class="rounded-card border border-gl-line-1 bg-gl-surface-1 p-4"><span class="gl-lbl-ember">03<!-- --> · <!-- -->Deploy on the ladder</span><p class="mt-2.5 text-[13px] leading-[1.5] text-text-tertiary">Monitors can’t lose money. Trading strategies paper-trade first, then go live under hard caps. You promote them — never the other way.</p></div></div><div class="day-one-exec-scrub relative mt-4" style="height:220vh" data-section="exec-scrub"><div class="day-one-exec-scrub-panel"><div class="rounded-card border border-gl-line-2 gl-surface-2 text-text-primary overflow-visible p-5 lg:p-6"><div class="grid grid-cols-1 gap-6 lg:grid-cols-[1.05fr_1fr] lg:gap-9"><section aria-label="Execution live sample" class="flex min-w-0 flex-col"><div class="mb-3 flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="gl-lbl-ember">Execution · live sample</span><span class="flex-1"></span><span class="gl-lbl text-text-disabled">step-by-step replay</span></div><div class="mb-4 flex flex-wrap gap-1.5" role="tablist" aria-label="Example order workflows"><button type="button" role="tab" aria-selected="true" class="rounded-button border px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.1em] transition-colors duration-gl-state ease-gl border-gl-line-3 bg-gl-surface-0 text-text-primary">Spot</button><button type="button" role="tab" aria-selected="false" class="rounded-button border px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.1em] transition-colors duration-gl-state ease-gl border-gl-line-1 bg-transparent text-text-disabled hover:border-gl-line-2 hover:text-text-secondary">Perps</button><button type="button" role="tab" aria-selected="false" class="rounded-button border px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.1em] transition-colors duration-gl-state ease-gl border-gl-line-1 bg-transparent text-text-disabled hover:border-gl-line-2 hover:text-text-secondary">Predictions</button></div><div class="day-one-exec-timeline relative" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Order trace progress"><span aria-hidden="true" class="pointer-events-none absolute bottom-2 left-[2px] top-2 w-0.5 -translate-x-1/2 rounded-full bg-gl-line-1"></span><span aria-hidden="true" class="day-one-exec-timeline-fill pointer-events-none absolute left-[2px] top-2 w-0.5 -translate-x-1/2 rounded-full bg-text-primary/55" style="height:calc(0% - 8px)"></span><ol class="relative flex flex-col gap-0" aria-label="Order execution steps" aria-live="polite" style="opacity:1;transform:none"><li class="day-one-exec-step relative pl-5 is-active" style="--step-index:1" aria-current="step"><button type="button" class="absolute inset-x-0 top-0 z-[1] h-9 cursor-pointer rounded-sm opacity-0" aria-label="Jump to step 01: Read intent"></button><span aria-hidden="true" class="day-one-exec-step-node absolute left-[2px] top-[7px] size-[7px] -translate-x-1/2 rounded-full border border-gl-line-2 bg-gl-bg"></span><div class="flex items-center gap-2"><span class="shrink-0 font-mono text-[10px] uppercase tracking-[0.14em] transition-colors duration-500 ease-gl text-gl-ember">01</span><span class="text-[13px] font-medium tracking-tight transition-colors duration-500 ease-gl text-text-primary">Read intent</span><span class="flex-1"></span><span class="gl-live-dot shrink-0" aria-hidden="true"></span></div><div class="day-one-exec