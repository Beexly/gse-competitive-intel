          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "End this credential's access to this API",
        "description": "Revokes the session this API holds for the caller and denylists the presented credential until its\nown expiry. It does not reach the credential's issuer: the API key you presented stays valid at\nClerk until you revoke it on the account page, and an OAuth grant can still refresh — so this ends\naccess HERE, not everywhere; the account page or support is where to revoke those. Works for any\nverified credential whether or not the account is entitled, so a downgraded account can still sign\nout.",
        "tags": [
          "auth"
        ],
        "parameters": [],
        "responses": {
          "204": {
            "description": "Signed out. Nothing to report, and a body would only invite parsing one."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
