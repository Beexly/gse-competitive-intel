          },
          {
            "$ref": "#/components/parameters/division"
          },
          {
            "$ref": "#/components/parameters/export"
          }
        ],
        "responses": {
          "200": {
            "description": "JSON report, or — when `export=true` — a CSV attachment named `download.csv`.",
            "headers": {
              "Content-Disposition": {
                "description": "Sent only with the `text/csv` variant. The filename is the one the report declares.",
