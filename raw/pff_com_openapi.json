      "Error": {
        "title": "Error",
        "description": "The single error shape this API answers with, on every status below. `code` is the field to branch\non — it is stable, and the human-readable `message` is not. `request_id` is echoed in the\n`x-request-id` response header and is what to quote in a bug report. `details` is machine-readable\ncontext for the failure: `upstream_status` on anything that came back from the data behind this API\n(`null` when there was no response at all), `parameter` on a parameter rejected before any data was\nfetched, `upstream_timeout_ms` on a deadline this API imposed, `upstream` naming which data source\nfailed on a `502` or `504` from a `/v2` operation, and `league` and `team` on a `404` for a team\nthat did not resolve. It never carries an upstream body.",
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_parameter",
                  "not_found",
                  "unauthorized",
                  "forbidden",
                  "rate_limited",
                  "session_provisioning",
                  "upstream_error",
                  "upstream_timeout",
                  "internal_error"
                ]
              },
              "message": {
                "type": "string",
                "description": "Human-readable, and deliberately not part of the contract."
              },
              "request_id": {
                "type": "string",
                "description": "Also sent as the `x-request-id` response header."
              },
              "details": {
                "type": "object",
                "additionalProperties": true,
                "description": "Machine-readable context. Absent when there is none."
              }
            }
          }
        }
      },
      "Whoami": {
        "description": "What this API believes about the caller. `entitled` and `tier` are reported here, never enforced —\nthis operation itself never gates on either.",
        "type": "object",
        "required": [
          "external_id",
          "email",
          "tier",
          "entitled",
          "entitlement_reason",
          "credential",
          "session_expires_at",
          "installations"
        ],
        "additionalProperties": false,
        "properties": {
          "external_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The linked subscriber identity this credential resolves to, or `null` for an account with none —\nevery other operation refuses that account with `403 forbidden`, reason `unlinked_account`."
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "description": "The account email on file, or `null`."
          },
          "tier": {
            "type": [
              "string",
              "null"
            ],
            "description": "The account's subscription tier (for example `pro`, `annual`, `monthly`), or `null`. Not itself the\nentitlement decision — see `entitled`."
          },
          "entitled": {
            "type": "boolean",
            "description": "Whether this account may use the operations below. `false` is the one place this API says why a\nrequest would be refused, rather than refusing it."
          },
          "entitlement_reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "subscription_required",
              "trial",
              "unlinked_account",
              null
            ],
            "description": "Which refusal, when `entitled` is `false`; `null` when it is `true`. Mirrors the `403` error\nenvelope's own `details.reason` on every other operation: `subscription_required` (the account is\nnot PFF Pro), `trial` (a Pro free trial, which does not include this API until it converts) and\n`unlinked_account` (no subscriber record at all) are different problems with different fixes, and a\nbare `entitled: false` would send a paying account that is merely unlinked or on trial to the\nsubscribe page for something buying Pro again would not fix."
          },
          "credential": {
            "type": "string",
            "enum": [
              "oauth",
              "api_key"
            ],
            "description": "Which security scheme the presented credential satisfied."
          },
          "session_expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the session this API holds for the caller next needs renewing, or `null` when no session exists\nyet — this operation never creates one."
          },
          "installations": {
            "type": "object",
            "required": [
              "max"
            ],
            "additionalProperties": false,
            "properties": {
              "max": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "The device limit configured on this account, or `null` if none is. Reported only — nothing enforces\nit yet."
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request parameters were rejected.\n\n`error.code` is `invalid_parameter`.\n\nEither the request was refused before any data was fetched — a `required` parameter above was\nmissing or empty — or the parameters themselves were rejected. In the first case\n`error.details.parameter` names the offending parameter and `error.details.upstream_status` is\n`null`.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "The credential is missing or was refused.\n\n`error.code` is `unauthorized`.\n\n`details.reason` names why: `missing` (no `Authorization` header at all), `malformed` (not a bearer\ncredential this API understands), `expired`, `invalid_signature`, `revoked`, or `wrong_token_type`\n(a session token was presented — this API never accepts one). The `WWW-Authenticate` response header\nis always `Bearer realm=\"pff-pro\", error=\"invalid_token\"`.",
        "headers": {
          "WWW-Authenticate": {
            "description": "Bearer realm=\"pff-pro\", error=\"invalid_token\" (RFC 6750).",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The caller may not read this league or report, or may not use this API at all.\n\n`error.code` is `forbidden`.\n\nFour shapes share this status. Three are this API refusing the account itself and are told apart by\n`details.reason`; the fourth is the upstream refusing one league or report to an account that is\notherwise entitled, which carries `details.upstream_status` and no `details.reason` at all. A\nview-only league entitlement is NOT any of them: that comes back `200` with the withheld columns\nlisted under `restricted`, never a `403`. `subscription_required` means the credential verified but\nthe account is not PFF Pro — `details.tier` carries the account's tier (or `null`) and\n`details.subscribe_url` where to upgrade; the message names both. `trial` means the account is on\nthe Pro free trial, which does not include this API until it converts to a paid plan —\n`details.tier` carries it, and there is no `subscribe_url` because there is nothing left to buy.\n`unlinked_account` means the account has no linked subscriber record at all — a support matter, not\na subscription one.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "No such route, or no such report.\n\n`error.code` is `not_found`.\n\nThe same envelope whichever it is.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ExportTooBroad": {
        "description": "The requested export spans too many weeks or seasons.\n\n`error.code` is `upstream_error`.\n\nRequests spanning too many weeks or seasons are rejected with a `422`. Narrow the `week` or `season`\nlist and retry; `error.details.upstream_status` is `422`.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimited": {
        "description": "A read or export budget is exhausted.\n\n`error.code` is `rate_limited`.\n\nTwo causes share this status, told apart by `error.code`. `rate_limited` is this API's own\nper-account budget — so many reads a minute, so many exports a minute, across every operation here —\nand `error.details.scope` says which (`api` or `export`; `verify_ip` when too many API keys were\ntried from one address); `x-ratelimit-limit`, `x-ratelimit-remaining` and `x-ratelimit-reset` (epoch\nseconds) ride on every counted response, not only this one, so a client can watch its budget before\nit runs out. `upstream_error` is the data source's own metering refusing an export — reads and\nexports are metered separately there too — and `error.details.upstream_status` is `429`.\n`Retry-After` says when to come back, on either cause.",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before retrying.",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Limit": {
            "description": "The budget the refused request was counted against, in requests per window.",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Remaining": {
            "description": "Requests left in the current window — `0` on a refusal.",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Reset": {
            "description": "When the window resets, as seconds since the Unix epoch.",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "InternalError": {
        "description": "This API failed.\n\n`error.code` is `internal_error`.\n\nA fault in this API itself, not in the data behind it — that is reported as a `502`. Nothing of the\nunderlying error reaches the caller; `error.request_id` is what to quote when reporting it.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "UpstreamError": {
        "description": "The data behind this API could not be reached, or failed.\n\n`error.code` is `upstream_error`.\n\n`error.details.upstream_status` carries the status that came back, or `null` when there never was a\nresponse. Retryable, but not immediately.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "UpstreamUnavailable": {
        "description": "A dependency this API needs is temporarily unavailable.\n\n`error.code` is `upstream_error`.\n\nThree causes share this status, told apart by `error.code`. `upstream_error` covers export metering\nthat failed closed, and the identity provider being unreachable while verifying a credential or\nreading an account — both are retryable service states, not faults. `session_provisioning` means\nthis API is still setting up a session for a caller signing in for the first time, or after a long\ngap — retrying is the intended way to wait it out, never a sign of a broken request. `Retry-After`\nsays how long, on every cause.",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before retrying.",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "UpstreamTimeout": {
        "description": "The request did not complete in time.\n\n`error.code` is `upstream_timeout`.\n\nThe `facet` family is allowed substantially longer than the rest, because an NCAA `division` fan-out\ngenuinely runs long. `error.details.upstream_timeout_ms` carries the deadline that fired when this\nAPI imposed it.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "headers": {
      "CsvContentDisposition": {
        "description": "Present only when `format=csv`:\n`attachment; filename=\"<operationId[-selector]>_<league>[_<team|scope>]_<season>[_<weekGroup>|_<weekIds joined by ->].csv\"`.\n`team-directory` has neither a team nor a scope, so that segment is omitted —\n`team-directory_nfl_2025.csv`. Only `[A-Za-z0-9._-]` survive in the name; anything else becomes `-`.",
        "required": false,
        "schema": {
          "type": "string"
        }
      }
    },
    "securitySchemes": {
      "pffOAuth": {
        "type": "oauth2",
        "description": "Sign in with your PFF account in the browser (interactive use).",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://clerk.pff.com/oauth/authorize",
            "tokenUrl": "https://clerk.pff.com/oauth/token",
            "scopes": {
              "openid": "",
              "profile": "",
              "email": "",
              "offline_access": "stay signed in — lets the CLI refresh silently"
            }
          }
        }
      },
      "pffApiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "A PFF API key (ak_…) from www.pff.com/account/api-keys — for scripts and CI, never a browser."
      }
    }
