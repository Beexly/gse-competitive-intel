  },
  "components": {
    "parameters": {
      "league": {
        "name": "league",
        "in": "query",
        "description": "League slug for the leaderboard commands — exactly `nfl`, `ncaa`, `hs`, `aaf` and `ufl` are\nrecognised; anything else is rejected. Give it with `--season`, or give `--game` alone instead (the\nleague is resolved from the game); a request satisfying neither is refused with `400\ninvalid_parameter` before anything is fetched, and a blank value counts as missing for that rule.\nAccess is enforced per league: a caller with view-only rights gets a `200` with fields removed and a\n`restricted` key, not a `403`.",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "nfl",
            "ncaa",
            "hs",
            "aaf",
            "ufl"
          ]
        }
      },
      "league_required": {
        "name": "league",
        "in": "query",
        "description": "League slug, and the FIRST positional argument of every command that takes one — every command\nexcept the `facet` leaderboards, where `--league` stays a flag because `--game` alone is a complete\nrequest. Exactly `nfl`, `ncaa`, `hs`, `aaf` and `ufl` are recognised; anything else is rejected.\nOnly the four configured leagues — `nfl`, `ncaa`, `aaf`, `ufl` — are ever listed by `ref-leagues`,\nso `hs` is accepted here but has no discoverable metadata. Access is enforced per league: a caller\nwith view-only rights gets a `200` with fields removed and a `restricted` key, not a `403`.\nRequired: leave the positional out and restish refuses to send the request at all, and a blank value\nis refused with `400 invalid_parameter` naming this parameter, before anything is fetched.",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "nfl",
            "ncaa",
            "hs",
            "aaf",
            "ufl"
          ]
        }
      },
      "season": {
        "name": "season",
        "in": "query",
        "description": "Season, as a four-digit year. Integer-coerced by `ref-games`, the `team` family and the `player`\nfamilies, so this form is a single season — a comma-separated list does not survive the coercion.\nThe `facet` and `signature` families never coerce it and take a list instead; they use the\n`season_list` variant. On `player-position-pivot` exports, a request spanning too many seasons is\nrejected with a `422`.",
        "required": false,
        "schema": {
          "type": "integer",
          "example": 2025
        }
      },
      "season_required": {
        "name": "season",
        "in": "query",
        "description": "Season, as a four-digit year, taken as a positional argument. A single season only — this form is\ninteger-coerced, so a comma-separated list does not survive it. Required: leave the positional out\nand restish refuses to send the request at all, and a blank value is refused with `400\ninvalid_parameter` naming this parameter, before anything is fetched.",
        "required": true,
        "schema": {
          "type": "integer",
          "example": 2025
        }
      },
      "season_list": {
        "name": "season",
        "in": "query",
        "description": "Season for the leaderboard commands. A four-digit year, or a comma-separated list such as\n`2023,2024` — never coerced, so a list reaches the data intact. Give it with `--league`, or give\n`--game` alone instead; a request satisfying neither is refused with `400 invalid_parameter` before\nanything is fetched, and a blank value counts as missing for that rule. When `--game` carries the\nrequest, a blank season instead short-circuits to an empty 200 — the recorded behaviour of the data\nbehind this API. On an export, a value spanning too many seasons comes back `422`.",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^(\\d{4}(,\\d{4})*)?$",
          "example": "2025"
        }
      },
      "season_list_required": {
        "name": "season",
        "in": "query",
        "description": "Season, and the SECOND positional argument of the four `signature` commands. A four-digit year, or a\ncomma-separated list of them such as `2023,2024` — the `signature` family never coerces this value,\nso a list reaches the data intact. Required: leave the positional out and restish refuses to send\nthe request at all, and a blank value is refused with `400 invalid_parameter` naming this parameter,\nbefore anything is fetched — the pattern below admits the blank string only because the shape is\nshared with the optional variant. On an export, a value spanning too many seasons comes back `422`.",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^(\\d{4}(,\\d{4})*)?$",
          "example": "2025"
        }
      },
      "week": {
        "name": "week",
        "in": "query",
        "description": "Week filter. Never coerced except by `ref-games`, so a comma-separated list is accepted such as\n`1,2,3`. `ref-games` is the one exception — it integer-coerces the value and takes the\n`week_integer` variant. A present-but-empty value short-circuits `facet`/`signature` to an empty\n200. On exports, a value spanning too many weeks is rejected with a `422`.",
        "required": false,
        "schema": {
          "type": "string",
          "example": "1"
        }
      },
      "week_required": {
        "name": "week",
        "in": "query",
        "description": "Week, and the THIRD positional argument of the four `signature` commands. A week number, or a\ncomma-separated list such as `1,2,3` — the `signature` family never coerces this value, so a list\nreaches the data intact. Required: leave the positional out and restish refuses to send the request\nat all, and a blank value is refused with `400 invalid_parameter` naming this parameter, before\nanything is fetched. On an export, a value spanning too many weeks comes back `422`.",
        "required": true,
        "schema": {
          "type": "string",
          "example": "1"
        }
      },
      "week_integer": {
        "name": "week",
        "in": "query",
        "description": "Week, and the THIRD positional argument of `games` — the one command that takes a single week number\nrather than a comma-separated list. Required: leave the positional out and restish refuses to send\nthe request at all, and a blank value is refused with `400 invalid_parameter` naming this parameter,\nbefore anything is fetched.",
        "required": true,
        "schema": {
          "type": "integer",
          "example": 1
        }
      },
      "franchise_id": {
        "name": "franchise_id",
        "in": "query",
        "x-cli-name": "franchise",
        "description": "Franchise (team) id. Integer-coerced by `ref-games` and the `team` family, forwarded uncoerced by\n`facet`. Unlike `season` and `week` there is no list variant: nothing splits this value and no known\ncaller sends more than one, so a list form would be speculation. Sent as `--franchise` on the\ncommand line and as `franchise_id` on the wire. Ids come from `ref-leagues` / `team-list`.",
        "required": false,
        "schema": {
          "type": "integer"
        }
      },
      "franchise_id_required": {
        "name": "franchise_id",
        "in": "query",
        "description": "Franchise (team) id, and the THIRD positional argument of `team-summary` — the report is\nfranchise-scoped, so there is no all-teams form of it. Ids come from `ref-leagues` / `team-list`.\nRequired: leave the positional out and restish refuses to send the request at all, and a blank value\nis refused with `400 invalid_parameter` naming this parameter, before anything is fetched.",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      "game_id": {
        "name": "game_id",
        "in": "query",
        "x-cli-name": "game",
        "description": "Single-game filter, `facet` family only, forwarded uncoerced. It is also read by the entitlement\ncheck, which resolves the game to its league and applies that league's restrictions — so a `game_id`\nfrom a league you cannot access is a 403 even when `league` says otherwise. Sent as `--game` on the\ncommand line and as `game_id` on the wire. Ids come from `ref-games`.",
        "required": false,
        "schema": {
          "type": "integer"
        }
      },
      "player_id": {
        "name": "player_id",
        "in": "query",
        "description": "Player id, taken as a positional argument. Ids come from `ref-players`. Required: leave the\npositional out and restish refuses to send the request at all, and a blank value is refused with\n`400 invalid_parameter` naming this parameter, before anything is fetched.",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      "id": {
        "name": "id",
        "in": "query",
        "description": "Exact player-id lookup, `ref-players` only. Distinct from `player_id`, which the report families\nuse.",
        "required": false,
        "schema": {
          "type": "integer"
        }
      },
      "name": {
        "name": "name",
        "in": "query",
        "description": "Free-text player-name search, `ref-players` only. Forwarded to the upstream as `q`, not as `name`.",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "career": {
        "name": "career",
        "in": "query",
        "description": "Career-aggregate toggle, on the player report operations only. Forwarded uncoerced and not validated\nhere — the upstream interprets it, and how it is interpreted depends on the report:\n\nOn the 13 reports whose body is a `PlayerReportSummary`, `career=true` replaces `season`: send\n`league` + `career=true` + `week` + `player_id` and the body switches from\n`subject`/`week_totals`/`weeks` to `subject`/`career`/`seasons`.\n\nOn the five that are not (`player-passing-concept`, `player-passing-depth`,\n`player-passing-pressure`, `player-receiving-depth`, `player-rushing-direction`) it changes nothing\n— the same body comes back — and `season` is still required: omitting it is a 400, with or without\n`career`.",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "division": {
        "name": "division",
        "in": "query",
        "description": "NCAA division fan-out, `facet` family only, and **only honoured when `league=ncaa`** — for any other\nleague it is ignored entirely. Comma-separated; each element must be `fbs`, `fcs` or `lower` and\nmaps to a group of franchises: `fbs` covers FBS plus the all-star group, `fcs` covers FCS, and\n`lower` covers D2 and D3. Any other value fails with `502 upstream_error` — the request reaches the\ndata behind this API and that is where it breaks. Divisions are fetched in parallel and the results\nconcatenated, so a multi-division request can take substantially longer than a single-division one.",
        "required": false,
        "schema": {
          "type": "string",
          "example": "fbs"
        }
      },
      "export": {
        "name": "export",
        "in": "query",
        "description": "`--export true` — the literal string `true`, and nothing else — returns the report as `text/csv`\nrather than JSON. A restish client prints the raw file under `--rsh-print b`, or you can redirect\nthe body to a file; asking for `-o json` instead renders the whole export as a single JSON string,\nquoted and with its line breaks escaped. An unentitled request returns an empty body. Any other\nvalue returns JSON. Exports are metered separately from reads — a request spanning too many weeks or\nseasons is rejected with a `422`, and an exhausted export budget with a `429`. On\n`player-position-pivot`, `--export true` alone is not enough: `--player` and `--season` must be\npresent too, or JSON comes back instead.",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "true"
          ]
        }
      },
      "LeaguePath": {
        "name": "league",
        "in": "path",
        "required": true,
        "description": "League slug: `nfl` or `ncaa`. Anything else is refused with `400 invalid_parameter` before any\ndata is fetched. It is the first positional argument of every command on this surface.",
        "schema": {
          "type": "string",
          "enum": [
            "nfl",
            "ncaa"
          ]
        }
      },
      "SeasonQuery": {
        "name": "season",
        "in": "query",
        "required": false,
        "description": "Season, as a four-digit year: `2006` or later, and at most one year past the current season.\nLeft out, the current season is used — the season turns over on 1 March, so January and February\nstill belong to the previous year's season. A present-but-empty or non-numeric value is refused\nwith `400 invalid_parameter`: a default is applied only to a parameter that was omitted.",
        "schema": {
          "type": "integer",
          "minimum": 2006
        }
      },
      "WeekGroupQuery": {
        "name": "weekGroup",
        "in": "query",
        "required": false,
        "description": "Which part of the season to cover: `REG` (regular season), `PO` (playoffs) or `REGPO` (both,\nthe default). Cannot be combined with `weekIds` — naming both is refused with\n`400 invalid_parameter`. Echoed back on the response as `weekGroup`.",
        "schema": {
          "type": "string",
          "enum": [
            "REG",
            "PO",
            "REGPO"
          ]
        }
      },
      "WeekIdsQuery": {
        "name": "weekIds",
        "in": "query",
        "required": false,
        "description": "Comma-separated week ids to cover instead of a whole `weekGroup` — `1,2,3` is the first three\nregular-season weeks. Every id must be a real week of the league's calendar; the list is\nde-duplicated and put in calendar order, and the response echoes it as `weekIds` in place of\n`weekGroup`. Cannot be combined with `weekGroup` — naming both is refused with\n`400 invalid_parameter`.",
        "schema": {
          "type": "string",
          "pattern": "^[0-9]+(,[0-9]+)*$"
        }
      },
      "TeamPath": {
        "name": "team",
        "in": "path",
        "required": true,
        "description": "The team, as its slug (`los-angeles-rams`) or its numeric franchise id (`26`) — both resolve\nthrough the league's team directory for the season, and both produce the same answer. Unknown\neither way is refused with `404 not_found`, and `details.team` echoes what was asked. The\nsecond positional argument of every per-team command.",
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      },
      "WeekQuery": {
        "name": "week",
        "in": "query",
        "required": false,
        "description": "Narrow the report to one week of the `weekGroup` — or, with `weekTo`, to a span of weeks. A week\nid the group does not hold is refused with `400 invalid_parameter` naming the ids it does hold.",
        "schema": {
          "type": "integer"
        }
      },
      "WeekToQuery": {
        "name": "weekTo",
        "in": "query",
        "required": false,
        "description": "The last week of a span that starts at `week`; requires `week`. A reversed span is read the\nright way round. Refused with `400 invalid_parameter` when `week` is absent.",
        "schema": {
          "type": "integer"
        }
      },
      "FormatQuery": {
        "name": "format",
        "in": "query",
        "required": false,
        "description": "The body's shape: `json` (the default) is the table object described under `application/json`;\n`csv` streams the same table as a file — header row of the column keys, one line per row — with\n`content-type: text/csv` and a `content-disposition` attachment name built from the command, the\nteam and the season. Metadata beside the table (`sos`, `groups`, `updatedAt`, the echoed week\nspan) is not in the file; ask for `json` when you need it. Errors keep the JSON envelope whatever\n`format` said. Any other value is refused with `400 invalid_parameter`.",
        "schema": {
          "type": "string",
          "enum": [
            "json",
            "csv"
          ],
          "default": "json"
        }
      },
      "TableQuery": {
        "name": "table",
        "in": "query",
        "required": false,
        "description": "Which of this operation's two tables to serve when `format=csv`: `rows` (the default) is the\nrusher × direction table, `totals` the team's per-direction totals. The JSON body always carries\nboth. Refused with `400 invalid_parameter` for any other value.",
        "schema": {
          "type": "string",
          "enum": [
            "rows",
            "totals"
          ],
          "default": "rows"
        }
      },
      "TeamStatsCategory": {
        "name": "category",
        "in": "query",
        "required": false,
        "description": "Which stat category the table covers. `offense-overall-success` unless set. An unknown value is\nrefused with `400 invalid_parameter` — the message lists the accepted ones.",
        "schema": {
          "type": "string",
          "default": "offense-overall-success",
          "enum": [
            "offense-overall-success",
            "offense-passing",
            "offense-rushing",
            "defense-overall-success",
            "defense-passing",
            "defense-rushing",
            "defense-opponent-tendencies"
          ]
        }
      },
      "TeamStatsScope": {
        "name": "scope",
        "in": "query",
        "required": false,
        "description": "Which teams the ranks are computed against — and which rows come back: `league` (every team,\nthe default), a conference (`afc`, `nfc`) or a division (`afc-east` … `nfc-west`). Conference and\ndivision scopes are NFL-only; an unknown value is refused with `400 invalid_parameter`.",
        "schema": {
          "type": "string",
          "default": "league",
          "enum": [
            "league",
            "afc",
            "nfc",
            "afc-east",
            "afc-north",
            "afc-south",
            "afc-west",
            "nfc-east",
            "nfc-north",
            "nfc-south",
            "nfc-west"
          ]
        }
      },
      "LeadersGroupQuery": {
        "name": "group",
        "in": "query",
        "required": false,
        "description": "Which position group the leaders come from — `receiving` (the default), `passing`, `rushing` or\n`defense`. Anything else is refused with `400 invalid_parameter`.",
        "schema": {
          "type": "string",
          "default": "receiving",
          "enum": [
            "receiving",
            "passing",
            "rushing",
            "defense"
          ]
        }
      },
      "TeamReportPath": {
        "name": "report",
        "in": "path",
        "required": true,
        "description": "Which report: `offense`, `passing`, `passing-depth`, `passing-pressure`, `receiving`,\n`receiving-depth`, `rushing`, `blocking`, `pass-blocking`, `run-blocking`, `defense`,\n`run-defense`, `pass-rush`, `coverage`, `special-teams`, `kick-returns`, `field-goals`,\n`punting`, `kickoffs`. The third positional argument. Rushing direction is its own command,\n`team-rushing-direction`, because its answer is two tables.",
        "schema": {
          "type": "string",
          "enum": [
            "offense",
            "passing",
            "passing-depth",
            "passing-pressure",
            "receiving",
            "receiving-depth",
            "rushing",
            "blocking",
            "pass-blocking",
            "run-blocking",
            "defense",
            "run-defense",
            "pass-rush",
            "coverage",
            "special-teams",
            "kick-returns",
            "field-goals",
            "punting",
            "kickoffs"
          ]
        }
      }
    },
    "schemas": {
      "ReportValue": {
        "description": "One report cell.\n\nThe column set is not fixed by this API: the upstream row is passed through untouched apart from\nflattening the `grades` / `snap_counts` / `*_grades` sub-objects into prefixed keys —\n`grades.offense` becomes `grades_offense`. Which columns a row carries therefore depends on the\nreport, the position, the query form and the caller's entitlement, and cannot be enumerated here.",
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "RestrictedColumns": {
