    "/v1/auth/whoami": {
      "get": {
        "operationId": "whoami",
        "summary": "Show what this API believes about the current credential",
        "description": "Answers with the account's tier and entitlement rather than refusing a non-Pro account, so a PFF+ or\nfree account can see WHY it would be refused elsewhere — `entitled: false` with the real tier —\ninstead of guessing from a blanket `403`. Never spends a sign-in: it reads the account and, if a\nsession already exists, reports its expiry without creating one.",
        "tags": [
