      "Column": {
        "title": "Column",
        "description": "One entry per key every row carries, in the order the rows carry them. `label` is the human\nheading a table renderer prints; `type` is the JSON type of a non-null cell — `integer`,\n`number`, `string` or `boolean`. Any cell may also be `null`, meaning the value does not apply\nor was withheld; a row never omits a key.",
        "type": "object",
        "required": [
          "key",
          "label",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$",
            "description": "The row key, camelCase."
          },
          "label": {
            "type": "string",
            "description": "Human-readable heading for the column."
          },
          "type": {
            "type": "string",
            "enum": [
              "integer",
              "number",
              "string",
              "boolean"
            ],
            "description": "JSON type of a non-null cell in this column."
          }
        }
      },
      "TeamIdentity": {
        "title": "TeamIdentity",
