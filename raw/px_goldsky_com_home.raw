 loading="eager" width="64" height="64" decoding="async" data-nimg="1" class="object-contain object-center content-none" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2Fhome%2Fheartbeat%2Fzksync.png&amp;w=64&amp;q=75 1x, /_next/image?url=%2Fimages%2Fhome%2Fheartbeat%2Fzksync.png&amp;w=128&amp;q=75 2x" src="/_next/image?url=%2Fimages%2Fhome%2Fheartbeat%2Fzksync.png&amp;w=128&amp;q=75"/></div></div><div class="Logos_item___IgW7" style="--index:32"><div class="relative h-full w-full"><img alt="polygon logo" loading="eager" width="64" height="64" decoding="async" data-nimg="1" class="object-contain object-center content-none" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2Fhome%2Fheartbeat%2Fpolygon.png&amp;w=64&amp;q=75 1x, /_next/image?url=%2Fimages%2Fhome%2Fheartbeat%2Fpolygon.png&amp;w=128&amp;q=75 2x" src="/_next/image?url=%2Fimages%2Fhome%2Fheartbeat%2Fpolygon.png&amp;w=128&amp;q=75"/></div></div><div class="Logos_item___IgW7" style="--index:33"><div class="relative h-full w-full"><img alt="mantle logo" loading="eager" width="64" height="64" decoding="async" data-nimg="1" class="object-contain object-center content-none" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2Fhome%2Fheartbeat%2Fmantle.png&amp;w=64&amp;q=75 1x, /_next/image?url=%2Fimages%2Fhome%2Fheartbeat%2Fmantle.png&amp;w=128&amp;q=75 2x" src="/_next/image?url=%2Fimages%2Fhome%2Fheartbeat%2Fmantle.png&amp;w=128&amp;q=75"/></div></div></div><div class="Fade_fade__y3MfL Fade_left__11GAs Fade_horizontal__0SKFO"></div><div class="Fade_fade__y3MfL Fade_right__TVks_ Fade_horizontal__0SKFO"></div><div class="Fade_fade__y3MfL Fade_bottom__OilBj Fade_vertical__2Cwvr"></div></div></div></div></div></div></section><section id="quotes" aria-labelledby="quotes-heading"><div class="container mx-auto lg:max-w-screen-lg px-4 lg:px-0 flex flex-col items-center gap-20 pt-[72px] sm:pt-[220px]"><div class="flex flex-col gap-6 max-w-[520px]"><div class="flex flex-col gap-4"><div class="flex items-center justify-center"><div class="inline-flex items-center rounded-full gap-1.5 px-2.5 py-1 border text-gs-text-primary/50"><div class="font-mono font-medium text-[14px] tracking-wide leading-tight uppercase text-gs-text-primary/50">Customer Love</div></div></div><h2 class="text-gs-heading-2xl font-medium text-center leading-tight text-balance" id="quotes-heading">Happier teams at <br/> every stage of growth</h2></div><p class="text-gs-text-secondary text-gs-body-lg text-center leading-normal">Goldsky gives developers the tools they need to create vibrant Web3 experiences in minutes.</p></div><div class="flex flex-col gap-5"><div class="flex flex-wrap justify-center gap-5"><blockquote class="flex-1 flex flex-col gap-10 p-8 min-w-[340px] rounded-2xl border border-gs-border transition-all duration-300 ease-out group min-w-[340px]" style="opacity:1"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" height="48" viewBox="0 0 49 48" fill="none"><path d="M48.507 8.78874C40.2253 8.78874 35.662 13.6901 35.662 20.7887V27.7183H46.4789V48H27.0422V22.4789C27.0422 8.78874 35.3239 0 48.507 0V8.78874ZM0 48V22.4789C0 8.78874 8.28169 0 21.4648 0V8.78874C13.1831 8.78874 8.61972 13.6901 8.61972 20.7887V27.7183H19.4366V48H0Z" fill="#F34B13"></path></svg></span><div class="flex-1"><p class="text-gs-body-lg">Arweave stores billions of individual data items, which Goldsky makes extremely simple and fast to query. They have set a new benchmark amongst Arweave indexes.</p></div><footer class="flex items-center gap-2"><img alt="Sam Williams" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" class="rounded-full" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2Fhome%2Fquotes%2Fsam-arweave.png&amp;w=48&amp;q=75 1x, /_next/image?url=%2Fimages%2Fhome%2Fquotes%2Fsam-arweave.png&amp;w=96&amp;q=75 2x" src="/_next/image?url=%2Fimages%2Fhome%2Fquotes%2Fsam-arweave.png&amp;w=96&amp;q=75"/><div class="flex flex-col gap-1"><p class="text-gs-text-primary text-gs-heading-xs leading-tight">Sam Williams</p><p class="text-gs-text-secondary leading-tight">CEO, Arweave</p></div></footer></blockquote><blockquote class="flex-1 flex flex-col gap-10 p-8 min-w-[340px] rounded-2xl border border-gs-border transition-all duration-300 ease-out group min-w-[340px]" style="opacity:1"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" height="48" viewBox="0 0 49 48" fill="none"><path d="M48.507 8.78874C40.2253 8.78874 35.662 13.6901 35.662 20.7887V27.7183H46.4789V48H27.0422V22.4789C27.0422 8.78874 35.3239 0 48.507 0V8.78874ZM0 48V22.4789C0 8.78874 8.28169 0 21.4648 0V8.78874C13.1831 8.78874 8.61972 13.6901 8.61972 20.7887V27.7183H19.4366V48H0Z" fill="#F34B13"></path></svg></span><div class="flex-1"><p class="text-gs-body-lg">Polymarket requires real-time data in order to power the platform that our customers trade on. We’ve been looking for a reliable partner for low-latency data for a long time, and Goldsky has exceeded our expectations in almost every single category.</p></div><footer class="flex items-center gap-2"><img alt="Liam Kovatch" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" class="rounded-full" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2Fhome%2Fquotes%2Fliam-polymarket.png&amp;w=48&amp;q=75 1x, /_next/image?url=%2Fimages%2Fhome%2Fquotes%2Fliam-polymarket.png&amp;w=96&amp;q=75 2x" src="/_next/image?url=%2Fimages%2Fhome%2Fquotes%2Fliam-polymarket.png&amp;w=96&amp;q=75"/><div class="flex flex-col gap-1"><p class="text-gs-text-primary text-gs-heading-xs leading-tight">Liam Kovatch</p><p class="text-gs-text-secondary leading-tight">Head of Engineering, Polymarket</p></div></footer></blockquote></div><div class="flex flex-wrap justify-center gap-5"><blockquote class="flex-1 flex flex-col gap-10 p-8 min-w-[340px] rounded-2xl border border-gs-border transition-all duration-300 ease-out group min-w-[340px]" style="opacity:1"><div class="h-12 flex items-center"><img alt="Privy logo" loading="lazy" width="24" height="24" decoding="async" data-nimg="1" class="h-6 w-auto" style="color:transparent" src="/images/home/quotes/privy.svg"/></div><div class="flex-1"><p class="text-gs-body-lg">Powering Privy’s multi-chain wallet infrastructure and webhook delivery.</p></div></blockquote><blockquote class="flex-1 flex flex-col gap-10 p-8 min-w-[340px] rounded-2xl border border-gs-border transition-all duration-300 ease-out group min-w-[340px]" style="opacity:1"><div class="h-12 flex items-center"><img alt="Stellar logo" loading="lazy" width="24" height="30" decoding="async" data-nimg="1" class="h-6 w-auto" style="color:transparent;width:auto;height:30px" src="/images/home/logos/stellar.svg"/></div><div class="flex-1"><p class="text-gs-body-lg">Streaming real-time data across the Stellar ecosystem with enterprise-scale reliability.</p></div></blockquote><blockquote class="flex-1 flex flex-col gap-10 p-8 min-w-[340px] rounded-2xl border border-gs-border transition-all duration-300 ease-out group min-w-[340px]" style="opacity:1"><div class="h-12 flex items-center"><img alt="Monad logo" loading="lazy" width="24" height="24" decoding="async" data-nimg="1" class="h-6 w-auto" style="color:transparent" src="/images/home/quotes/monad.svg"/></div><div class="flex-1"><p class="text-gs-body-lg">Accelerating Monad&#x27;s dApp development and on-chain analytics.</p></div></blockquote></div></div><a class="inline-flex items-center justify-center gap-1 rounded-[12px] transition-[background-color,border-color,box-shadow,transform] duration-gs-press ease-gs-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gs-text-quaternary focus-visible:ring-offset-2 focus-visible:ring-offset-gs-background disabled:opacity-50 disabled:cursor-not-allowed disabled:shadow-none disabled:translate-y-0 motion-reduce:transition-none motion-reduce:transform-none bg-gs-white relative px-4 py-3 shadow-[inset_0px_-1.5px_0px_#BFBFBF,inset_0px_1px_0px_#E6E6E