Real-time_data"},{"@type":"Thing","name":"Data streaming","@id":"https://en.wikipedia.org/wiki/Streaming_data"},{"@type":"Thing","name":"Subgraphs","@id":"https://www.wikidata.org/wiki/Q7631151","sameAs":"https://en.wikipedia.org/wiki/The_Graph"},{"@type":"Thing","name":"Data infrastructure","@id":"https://www.wikidata.org/wiki/Q5227304","sameAs":"https://en.wikipedia.org/wiki/Data_infrastructure"},{"@type":"Thing","name":"Data pipelines","@id":"https://www.wikidata.org/wiki/Q1192422","sameAs":"https://en.wikipedia.org/wiki/Pipeline_(computing)"},{"@type":"Thing","name":"Data transformation","sameAs":"https://en.wikipedia.org/wiki/Data_transformation"},{"@type":"Thing","name":"Decentralized finance","@id":"https://www.wikidata.org/wiki/Q84055514","sameAs":"https://en.wikipedia.org/wiki/Decentralized_finance"},{"@type":"Thing","name":"GraphQL","@id":"https://www.wikidata.org/wiki/Q25104949","sameAs":"https://en.wikipedia.org/wiki/GraphQL"}]}</script><div><div class="w-full h-full relative"><div class="flex flex-col"><div class="overflow-hidden flex flex-col bg-gs-surface-middle text-gs-text-primary [@media(min-width:1024px)_and_(min-height:1300px)]:h-[calc(100vh-10rem)]"><div class="container mx-auto lg:max-w-screen-lg px-4 lg:px-0 flex-1 min-h-0 flex flex-col"><div class="relative flex h-full flex-col items-center mt-20 py-8 gap-12 [@media(min-width:1024px)_and_(min-height:1300px)]:justify-between [@media(min-width:1024px)_and_(min-height:1300px)]:gap-0"><div class="flex flex-col items-center gap-5 flex-shrink-0"><div class="text-gs-heading-5xl font-medium text-center lg:text-gs-heading-5xl w-full"><h1 class="flex flex-col leading-[1.1] [text-wrap:balance]"><span>Instant data for<br/>onchain finance</span></h1></div><p class="text-gs-text-secondary text-gs-body-lg text-center max-w-lg">The borderless data platform for fintech and crypto businesses, with native stablecoin support and <!-- -->&lt;<!-- -->1s latency.</p><div class="flex items-center gap-4 mt-3"><a clas