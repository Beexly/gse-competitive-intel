<script>
    (function () {
        var authBase = 'https://api.ftnfantasy.com';
        var forcePopup = false;
        var forceRealPreview = false;
        var popup = document.getElementById('ftn-cancellation-discount-popup');

        function getCookie(name) {
            var cookies = document.cookie ? document.cookie.split('; ') : [];
            for (var i = 0; i < cookies.length; i++) {
                var parts = cookies[i].split('=');
                if (decodeURIComponent(parts.shift() || '') === name) {
                    return decodeURIComponent(parts.join('=') || '');
                }
            }
            return '';
        }

        function authorizedFetch(url) {
            var accessToken = getCookie('access_token');
            if (!accessToken || accessToken === 'undefined') {
                return Promise.resolve(null);
            }

            return fetch(url, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + accessToken
                },
                credentials: 'omit'
            }).then(function (response) {
                if (!response.ok) {
                    return null;
                }

                return response.text().then(function (text) {
                    if (!text) {
                        return {};
                    }

                    try {
                        return JSON.parse(text);
                    } catch (error) {
                        return {};
                    }
                });
            }).catch(function () {
                return null;
            });
        }

        function isScheduledForCancellation(subscription) {
            return Boolean(
                subscription &&
                subscription.cancel_at_period_end === true &&
                (subscription.cancel_at || subscription.current_period_end)
            );
        }

        function getSubscriptionId(subscription) {
            return subscription.subscription_id || subscription.stripe_subscription_id || subscription.id || '';
        }

        function findDiscountForSubscription(subscription) {
            var subscriptionId = getSubscriptionId(subscription);
            if (!subscriptionId) {
                return Promise.resolve(null);
            }

            return authorizedFetch(authBase + '/subscriptions/' + encodeURIComponent(subscriptionId) + '/cancellations/discount').then(function (response) {
                if (
                    response &&
                    Boolean(response.has_discount) &&
                    response.discount &&
                    Boolean(response.discount.display_modal)
                ) {
                    return {
                        subscription: subscription,
                        subscriptionId: subscriptionId,
                        discount: response.discount,
                        discountResponse: response
                    };
                }

                return null;
            });
        }

        function findCancellationDiscount() {
            return authorizedFetch(authBase + '/subscriptions/').then(function (subscriptions) {
                if (subscriptions && !Array.isArray(subscriptions) && Array.isArray(subscriptions.subscriptions)) {
                    subscriptions = subscriptions.subscriptions;
                }
                if (!Array.isArray(subscriptions)) {
                    return null;
                }

                return subscriptions.filter(isScheduledForCancellation).reduce(function (promise, subscription) {
                    return promise.then(function (offer) {
                        return offer || findDiscountForSubscription(subscription);
                    });
                }, Promise.resolve(null));
            });
        }

        function getDismissCookieName() {
            var offer = window.ftnCancellationDiscountOffer || {};
            return offer.discount && offer.discount.id
                ? 'ftnCancellationDiscountDismissed_' + offer.discount.id
                : '';
        }

        function isDismissed() {
            var cookieName = getDismissCookieName();
            return cookieName ? getCookie(cookieName) === 'true' : false;
        }

        function formatDiscountAmount(amountOff) {
            var amount = Number(amountOff || 0) / 100;
            if (!amount) {
                return '';
            }

            return '$' + (Number.isInteger(amount) ? amount.toFixed(0) : amount.toFixed(2));
        }

        function applyDiscountPlaceholders(offer) {
            if (!popup || !offer || !offer.discount) {
                return;
            }

            var discount = offer.discount;
            var percentOff = Number(discount.percent_off || 0) / 100;
            var amountOff = formatDiscountAmount(discount.amount_off);
            var formattedDiscount = percentOff ? percentOff + '%' : amountOff;
            var replacements = {
                '{{discount}}': formattedDiscount,
                '{{discount_percent}}': percentOff ? String(percentOff) : '',
                '{{discount_amount}}': amountOff,
                '{{discount_label}}': discount.label || '',
                '{{discount_duration}}': discount.duration || ''
            };

            function replaceTokens(value) {
                Object.keys(replacements).forEach(function (token) {
                    value = value.split(token).join(replacements[token]);
                });
                return value;
            }

            var textNodes = [];
            var walker = document.createTreeWalker(popup, NodeFilter.SHOW_TEXT);
            while (walker.nextNode()) {
                textNodes.push(walker.currentNode);
            }
            textNodes.forEach(function (node) {
                node.nodeValue = replaceTokens(node.nodeValue);
            });

            popup.querySelectorAll('*').forEach(function (element) {
                Array.prototype.slice.call(element.attributes || []).forEach(function (attribute) {
                    if (attribute.value.indexOf('{{') !== -1) {
                        element.setAttribute(attribute.name, replaceTokens(attribute.value));
                    }
                });
            });
        }

        function announceCancellationDiscountOffer(offer) {
            document.dispatchEvent(new CustomEvent('ftn:cancellation-discount-offer', {
                detail: {
                    offer: offer
                }
            }));
        }

        function showPopup() {
            if (popup) {
                popup.style.display = 'block';
                document.body.style.overflow = 'hidden';
            }
        }

        function closePopup(rememberDismissal) {
            var wasOpen = popup && popup.style.display !== 'none';
            if (popup) {
                popup.style.display = 'none';
                document.body.style.overflow = '';
            }

            var cookieName = getDismissCookieName();
            if (rememberDismissal && wasOpen && cookieName) {
                document.cookie = cookieName + '=true; path=/; max-age=604800; SameSite=Lax; Secure';
            }
        }

        window.ftnAcceptCancellationDiscount = function (subscriptionId) {
            var offer = window.ftnCancellationDiscountOffer || {};
            if (offer.testMode && !subscriptionId) {
                return Promise.resolve(null);
            }

            var id = subscriptionId || offer.subscriptionId || '';
            if (!id) {
                return Promise.resolve(null);
            }

            return authorizedFetch(authBase + '/subscriptions/' + encodeURIComponent(id) + '/cancellations/discount/accept').then(function (response) {
                if (response) {
                    window.location.reload();
                }
                return response;
            });
        };

        document.addEventListener('click', function (event) {
            var target = event.target && event.target.closest ? event.target : null;
            var acceptButton = target ? target.closest('[data-cancellation-discount-accept], .js-cancellation-discount-accept') : null;
            if (acceptButton) {
                event.preventDefault();
                if (acceptButton.getAttribute('aria-busy') === 'true') {
                    return;
                }

                acceptButton.setAttribute('aria-busy', 'true');
                window.ftnAcceptCancellationDiscount(acceptButton.getAttribute('data-subscription-id')).then(function (response) {
                    if (!response) {
                        acceptButton.removeAttribute('aria-busy');
                    }
                });
                return;
            }

            var closeButton = target ? target.closest('[data-cancellation-discount-close], .js-cancellation-discount-close, .js-cancellation-discount-dismiss') : null;
            if (closeButton) {
                event.preventDefault();
                event.stopPropagation();
                closePopup(true);
                return;
            }

            if (popup && event.target === popup) {
                closePopup(true);
            }
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
                closePopup(true);
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            if (forcePopup) {
                window.ftnCancellationDiscountOffer = {
                    testMode: true,
                    subscriptionId: '',
                    discount: {
                        amount_off: 0,
                        percent_off: 1000,
                        duration: 'once',
                        display_modal: true,
                        label: 'Test discount'
                    }
                };
                announceCancellationDiscountOffer(window.ftnCancellationDiscountOffer);
                applyDiscountPlaceholders(window.ftnCancellationDiscountOffer);
                showPopup();
                return;
            }

            findCancellationDiscount().then(function (offer) {
                if (!offer) {
                    return;
                }

                window.ftnCancellationDiscountOffer = offer;
                announceCancellationDiscountOffer(offer);
                if (forceRealPreview || !isDismissed()) {
                    applyDiscountPlaceholders(offer);
                    showPopup();
                }
            });
        });
    })();
</script>
<script id="ftn-sgp-bootstrap">
(function () {
  function money(x){
    return Number(x||0).toLocaleString(undefined,{style:'currency',currency:'USD',maximumFractionDigits:2});
  }
  function americanToDecimal(a){
    a = Number(a);
    if (!isFinite(a) || a === 0) return 1;
    return a > 0 ? 1 + a/100 : 1 + 100/Math.abs(a);
  }

  function initOne(root){
    if (!root || root.dataset.sgpInited) return;
    root.dataset.sgpInited = '1';

    var oddsEl = root.querySelector('#bookOdds');
    var stake  = root.querySelector('#stake');
    var profit = root.querySelector('#profit');
    var total  = root.querySelector('#totalReturn');
    if (!oddsEl || !stake || !profit || !total) return;

    var raw = (oddsEl.getAttribute('data-odds') || oddsEl.textContent || '+0').replace(/[^\-\+\d]/g,'');
    var american = parseInt(raw,10) || 0;
    var dec = americanToDecimal(american);

    function recalc(){
      var s = Number(stake.value || 0);
      var p = s * (dec - 1);
      var t = s + p;
      profit.textContent = money(p);
      total.textContent  = money(t);
    }
    stake.addEventListener('input', recalc, {passive:true});
    stake.addEventListener('change', recalc);
    recalc();
  }

  function initAll(){ document.querySelectorAll('.ftn-sgp-widget-structure').forEach(initOne); }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }

  // Catch content injected later (shortcodes/Elementor/infinite scroll)
  new MutationObserver(initAll).observe(document.documentElement, {childList:true, subtree:true});
})();
</script>


