acity duration-300 group-hover:via-primary/40"></div><div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-primary/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div><div class="mb-3 flex items-center gap-2.5"><div class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded bg-primary/10 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-git-branch h-3.5 w-3.5"><line x1="6" x2="6" y1="3" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg></div><div class="h-px flex-1 bg-border/40 transition-colors duration-300 group-hover:bg-primary/20"></div></div><h3 class="mb-2 text-lg font-semibold tracking-tight">Alt Lines</h3><p class="text-sm leading-relaxed text-muted-foreground">Access alternate spreads and totals alongside the main lines.</p><div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-primary/[0.04] to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div></div><div class="group relative overflow-hidden rounded-xl p-6 transition-all duration-400 border border-border/45 bg-card/47 backdrop-blur-sm hover:-translate-y-0.5 hover:border-white/[0.12] hover:shadow-[0_8px_32px_-6px_rgba(0,0,0,0.4)]"><div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent transition-opacity duration-300 group-hover:via-primary/40"></div><div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-primary/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div><div class="mb-3 flex items-center gap-2.5"><div class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded bg-primary/10 text-primary"><svg xmln