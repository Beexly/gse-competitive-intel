py-1 font-mono text-sm font-bold text-primary transition-colors bg-primary/10">28</span></div><div style="opacity:0;transition:opacity 800ms 0ms ease-out"><div class="relative mx-auto overflow-hidden" style="width:100%;max-width:1148px;height:88px"><div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-20 bg-gradient-to-r from-background to-transparent"></div><div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-20 bg-gradient-to-l from-background to-transparent"></div></div></div></div><div class="mx-auto cursor-pointer select-none text-center" style="max-width:1148px"><div class="mx-auto mb-6 flex w-fit items-center justify-center gap-3"><span class="text-xs uppercase tracking-[0.2em] underline-offset-4 transition-all font-semibold text-muted-foreground">Leagues</span><span class="rounded-md px-2.5 py-1 font-mono text-sm font-bold text-primary transition-colors bg-primary/10">67</span></div><div style="opacity:0;transition:opacity 800ms 200ms ease-out"><div class="relative mx-auto overflow-hidden" style="width:100%;max-width:1148px;height:88px"><div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-20 bg-gradient-to-r from-background to-transparent"></div><div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-20 bg-gradient-to-l from-background to-transparent"></div></div></div></div><div class="mx-auto cursor-pointer select-none text-center" style="max-width:1148px"><div class="mx-auto mb-6 flex w-fit items-center justify-center gap-3"><span class="text-xs uppercase tracking-[0.2em] underline-offset-4 transition-all font-semibold text-muted-foreground">Bookmakers</span><span class="rounded-md px-2.5 py-1 font-mono text-sm font-bold text-primary transition-colors bg-primary/10">85</span></div><div style="opacity:0;transition:opacity 800ms 400ms ease-out"><div class="relative mx-auto overflow-hidden" style="width:100%;max-width:1148px;height:88px"><div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-20 bg-gradient-to-r from-background to-transparent"></div><div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-20 bg-gradient-to-l from-background to-transparent"></div></div></div></div><div class="mx-auto cursor-pointer select-none text-center" style="max-width:1148px"><div class="mx-auto mb-6 flex w-fit items-center justify-center gap-3"><span class="text-xs uppercase tracking-[0.2em] underline-offset-4 transition-all font-semibold text-muted-foreground">Markets</span><span class="rounded-md px-2.5 py-1 font-mono text-sm font-bold text-primary transition-colors bg-primary/10">1368</span></div><div style="opacity:0;transition:opacity 800ms 600ms ease-out"><div class="relative mx-auto overflow-hidden" style="width:100%;max-width:1148px;height:88px"><div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-20 bg-gradient-to-r from-background to-transparent"></div><div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-20 bg-gradient-to-l from-background to-transparent"></div></div></div></div></div></section><section class="container pb-24 md:pb-32 overflow-hidden"><div class="group relative overflow-hidden rounded-2xl border border-border bg-elevated transition-all duration-300 hover:border-primary/20 hover:shadow-[0_16px_48px_rgba(0,0,0,0.2),0_0_0_1px_rgba(16,185,129,0.06)]"><div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/50 to-transparent"></div><div class="grid items-stretch md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]"><div class="relative z-[1] flex flex-col justify-center p-8 md:p-10 lg:p-12"><div class="mb-4"><h2 class="text-2xl font-bold tracking-tight md:text-3xl">We wrangle the data. <span class="text-gradient-a">You build the product.</span></h2></div><p class="mb-6 max-w-[480px] text-[15px] leading-relaxed text-foreground-secondary">Every minute we update over a million unique data points and normalize them all into a single, predictable schema so that you don&#x27;t have to.</p><div class="flex flex-col gap-4"><div class="flex items-start gap-3 animate-in fade-in slide-in-from-bottom-2 duration-600" style="animation-delay:0ms"><div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-primary/15 bg-primary/[0.08]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layers h-4 w-4 text-primary"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path></svg></div><div><div class="text-sm font-semibold">Unified Schema</div><div class="text-[13px] leading-relaxed text-foreground-secondary">Every league or bookmaker structures their data differently. We normalize it all into a consistent format.</div></div></div><div class="flex items-start gap-3 animate-in fade-in slide-in-from-bottom-2 duration-600" style="animation-delay:150ms"><div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-primary/15 bg-primary/[0.08]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-globe h-4 w-4 text-primary"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg></div><div><div class="text-sm font-semibold">Expanding Coverage</div><div class="text-[13px] leading-relaxed text-foreground-secondary">Supporting a new league or bookmaker typically requires zero code changes on your end.</div></div></div><div class="flex items-start gap-3 animate-in fade-in slide-in-from-bottom-2 duration-600" style="animation-delay:300ms"><div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-primary/15 bg-primary/[0.08]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shuffle h-4 w-4 text-primary"><path d="m18 14 4 4-4 4"></path><path d="m18 2 4 4-4 4"></path><path d="M2 18h1.973a4 4 0 0 0 3.3-1.7l5.454-8.6a4 4 0 0 1 3.3-1.7H22"></path><path d="M2 6h1.972a4 4 0 0 1 3.6 2.2"></path><path d="M22 18h-6.041a4 4 0 0 1-3.3-1.8l-.359-.45"></path></svg></div><div><div class="text-sm font-semibold">Market Normalization</div><div class="text-[13px] leading-relaxed text-foreground-secondary">One book calls it &#x27;Anytime Home Run&#x27;. Another calls it &#x27;Over/Under 0.5 Home Runs&#x27;. Same market, different name. We handle cases like this automatically.</div></div></div><div class="flex items-start gap-3 animate-in fade-in slide-in-from-bottom-2 duration-600" style="animation-delay:450ms"><div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-primary/15 bg-primary/[0.08]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap h-4 w-4 text-primary"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg></div><div><div class="text-sm font-semibold">Derived Insights</div><div class="text-[13px] leading-relaxed text-foreground-secondary">Our aggregated data set allows you to identify trends and generate insights that you can&#x27;t get anywhere else.</div></div></div></div></div><div class="relative m-[1px] min-h-[320px] overflow-hidden rounded-b-2xl md:min-h-[480px] md:rounded-bl-none md:rounded-r-2xl"><div class="pointer-events-none absolute inset-y-0 left-0 z-[1] hidden w-16 bg-gradient-to-r from-elevated to-transparent md:block"></div><canvas class="block h-full w-full cursor-crosshair"></canvas><div class="pointer-events-none absolute left-1/2 top-1/2 z-[2] -translate-x-1/2 -translate-y-1/2"><img alt="SportsGameOdds" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="rounded-xl" style="color:transparent;filter:drop-shadow(0 0 18px rgba(16,185,129,0.3)) drop-shadow(0 0 50px rgba(16,185,129,0.12))" srcSet="/_next/image?url=%2Fsgo-logo-small.png&amp;w=48&amp;q=75 1x, /_next/image?url=%2Fsgo-logo-small.png&amp;w=96&amp;q=75 2x" src="/_next/image?url=%2Fsgo-logo-small.png&amp;w=96&amp;q=75"/></div></div></div></div></section><section class="container pb-24 md:pb-32" id="features"><div class="mx-auto max-w-3xl text-center mb-12"><h2 class="text-balance text-3xl font-bold tracking-tight md:text-5xl">Advanced <span class="text-gradient-a">Capabilities</span></h2><p class="mt-4 text-balance text-sm text-muted-foreground md:text-lg mx-auto max-w-2xl">SportsGameOdds offers features you won&#x27;t find in other odds APIs.</p></div><div class="relative overflow-hidden"><div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-[500px] w-[700px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/[0.06] blur-[120px]"></div><div class="grid gap-3 grid-cols-1 md:grid-cols-2 lg:grid-cols-3"><div class="group relative overflow-hidden rounded-xl p-6 transition-all duration-400 border border-border/45 bg-card/47 backdrop-blur-sm hover:-translate-y-0.5 hover:border-white/[0.12] hover:shadow-[0_8px_32px_-6px_rgba(0,0,0,0.4)]"><div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent transition-opacity duration-300 group-hover:via-primary/40"></div><div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-primary/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div><div class="mb-3 flex items-center gap-2.5"><div class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded bg-primary/10 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-grid h-3.5 w-3.5"><rect width="7" height="7" x="3" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="14" rx="1"></rect><rect width="7" height="7" x="3" y="14" rx="1"></rect></svg></div><div class="h-px flex-1 bg-border/40 transition-colors duration-300 group-hover:bg-primary/20"></div></div><h3 class="mb-2 text-lg font-semibold tracking-tight">Partial Game Odds</h3><p class="text-sm leading-relaxed text-muted-foreground">Segment Odds on 1st, 2nd, 3rd, 4th - half, quarter, period, round, set, etc.</p><div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-primary/[0.04] to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div></div><div class="group relative overflow-hidden rounded-xl p-6 transition-all duration-400 border border-border/45 bg-card/47 backdrop-blur-sm hover:-translate-y-0.5 hover:border-white/[0.12] hover:shadow-[0_8px_32px_-6px_rgba(0,0,0,0.4)]"><div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent transition-opacity duration-300 group-hover:via-primary/40"></div><div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-primary/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div><div class="mb-3 flex items-center gap-2.5"><div class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded bg-primary/10 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trophy h-3.5 w-3.5"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path><path d="M4 22h16"></path><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path></svg></div><div class="h-px flex-1 bg-border/40 transition-colors duration-300 group-hover:bg-primary/20"></div></div><h3 class="mb-2 text-lg font-semibold tracking-tight">Daily Fantasy Odds</h3><p class="text-sm leading-relaxed text-muted-foreground">Lines from DFS platforms like PrizePicks and Underdog included alongside traditional sportsbooks.</p><div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-primary/[0.04] to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div></div><div class="group relative overflow-hidden rounded-xl p-6 transition-all duration-400 border border-border/45 bg-card/47 backdrop-blur-sm hover:-translate-y-0.5 hover:border-white/[0.12] hover:shadow-[0_8px_32px_-6px_rgba(0,0,0,0.4)]"><div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent transition-opacity duration-300 group-hover:via-primary/40"></div><div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-primary/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div><div class="mb-3 flex items-center gap-2.5"><div class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded bg-primary/10 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-up h-3.5 w-3.5"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg></div><div class="h-px flex-1 bg-border/40 transition-colors duration-300 group-hover:bg-primary/20"></div></div><h3 class="mb-2 text-lg font-semibold tracking-tight">Prediction Markets</h3><p class="text-sm leading-relaxed text-muted-foreground">Access lines from prediction markets like Kalshi and Polymarket alongside traditional sportsbooks.</p><div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-primary/[0.04] to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div></div><div class="group relative overflow-hidden rounded-xl p-6 transition-all duration-400 border border-border/45 bg-card/47 backdrop-blur-sm hover:-translate-y-0.5 hover:border-white/[0.12] hover:shadow-[0_8px_32px_-6px_rgba(0,0,0,0.4)]"><div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent transition-opacity duration-300 group-hover:via-primary/40"></div><div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-primary/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div><div class="mb-3 flex items-center gap-2.5"><div class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded bg-primary/10 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link h-3.5 w-3.5"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg></div><div class="h-px flex-1 bg-border/40 transition-colors duration-300 group-hover:bg-primary/20"></div></div><h3 class="mb-2 text-lg font-semibold tracking-tight">Deeplinks to Bookmakers</h3><p class="text-sm leading-relaxed text-muted-foreground">Direct users to specific bets on sportsbook platforms with ease.</p><div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-primary/[0.04] to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div></div><div class="group relative overflow-hidden rounded-xl p-6 transition-all duration-400 border border-border/45 bg-card/47 backdrop-blur-sm hover:-translate-y-0.5 hover:border-white/[0.12] hover:shadow-[0_8px_32px_-6px_rgba(0,0,0,0.4)]"><div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent transition-opacity duration-300 group-hover:via-primary/40"></div><div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-primary/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div><div class="mb-3 flex items-center gap-2.5"><div class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded bg-primary/10 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap h-3.5 w-3.5"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg></div><div class="h-px flex-1 bg-border/40 transition-colors duration-300 group-hover:bg-primary/20"></div></div><h3 class="mb-2 text-lg font-semibold tracking-tight">Websocket Streaming</h3><p class="text-sm leading-relaxed text-muted-foreground">Push-based real-time odds feeds allow you to receive fresh data the moment it changes.</p><div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-primary/[0.04] to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div></div><div class="group relative overflow-hidden rounded-xl p-6 transition-all duration-400 border border-border/45 bg-card/47 backdrop-blur-sm hover:-translate-y-0.5 hover:border-white/[0.12] hover:shadow-[0_8px_32px_-6px_rgba(0,0,0,0.4)]"><div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent transition-opacity duration-300 group-hover:via-primary/40"></div><div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-primary/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div><div class="mb-3 flex items-center gap-2.5"><div class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded bg-primary/10 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-scale h-3.5 w-3.5"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path><path d="M7 21h10"></path><path d="M12 3v18"></path><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"></path></svg></div><div class="h-px flex-1 bg-border/40 transition-colors duration-300 group-hover:bg-primary/20"></div></div><h3 class="mb-2 text-lg font-semibold tracking-tight">Consensus &amp; Fair Odds</h3><p class="text-sm leading-relaxed text-muted-foreground">Algorithmically derived fair odds and consensus lines give you an analytical edge beyond raw bookmaker data.</p><div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-primary/[0.04] to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div></div></div></div></section><section class="container pb-24 md:pb-32"><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is an odds API?","acceptedAnswer":{"@type":"Answer","text":"An odds API is a programmatic interface that delivers real-time and historical sports betting odds — moneylines, spreads, totals, and player props — from sportsbooks directly into your app. Unlike a sports stats API, an odds API focuses on bookmaker prices and lines. SportsGameOdds provides all of this through one REST and WebSocket API, with live scores and settlement data included."}},{"@type":"Question","name":"What is SportsGameOdds?","acceptedAnswer":{"@type":"Answer","text":"SportsGameOdds is a REST API that delivers real-time betting odds, scores, stats, and settlement data from 85+ sportsbooks across 67+ leagues and 28+ sports. Instead of scraping bookmakers yourself, you get clean, structured data through simple API calls — updated every 30–60 seconds with moneylines, spreads, totals, player props, alternate lines, and more."}},{"@type":"Question","name":"What sports, leagues, and bookmakers do you cover?","acceptedAnswer":{"@type":"Answer","text":"We cover 67+ leagues across 28+ sports — including NFL, NBA, MLB, NHL, UFC, EPL, La Liga, Champions League, and many more — with odds from 85+ bookmakers like DraftKings, FanDuel, BetMGM, Pinnacle, Bet365, and PrizePicks. We're continuously adding coverage."}},{"@type":"Question","name":"Does the API include sharp bookmakers like Pinnacle?","acceptedAnswer":{"@type":"Answer","text":"Yes. SportsGameOdds aggregates odds from 85+ bookmakers, including sharp books like Pinnacle alongside major sportsbooks such as DraftKings, FanDuel, BetMGM, Bet365, and Caesars. We also include DFS pick'em lines from PrizePicks and Underdog, plus prediction-market prices from Kalshi and Polymarket — all normalized into one consistent schema."}},{"@type":"Question","name":"What types of betting data do you provide?","acceptedAnswer":{"@type":"Answer","text":"We provide pre-match and live odds across all major bet types: moneylines, spreads, over/unders, 3-way moneylines, player props, team props, alternate lines, and more — for full game, halves, quarters, and other periods. We also provide live scores, box scores, team and player stats, market settlement/outcomes, consensus odds with vig removed, and deeplinks to bookmaker bet slips."}},{"@type":"Question","name":"How accurate and fast is your odds data?","acceptedAnswer":{"@type":"Answer","text":"Odds accuracy is 99.9%+ via direct bookmaker feeds, scores and stats are 99.5%+ verified against official sources, and event metadata is 99.9%+. Odds update every 30–60 seconds on average, with near-instant streaming updates available on the AllStar plan."}},{"@type":"Question","name":"How does your pricing compare to other odds APIs?","acceptedAnswer":{"@type":"Answer","text":"We charge per event, not per market or bookmaker. A single NBA game with 100 markets across 20 bookmakers costs 1 object — compared to potentially 2,000 units with per-market pricing from competitors. This makes SportsGameOdds 60–80% cheaper for most use cases, with fully predictable billing. We also offer an perpetually free tier."}},{"@type":"Question","name":"Is there a free tier I can start with?","acceptedAnswer":{"@type":"Answer","text":"Yes. The free Amateur plan gives you 2,500 objects a month at 10 requests per minute, covering 8 leagues and 9 bookmakers, with no credit card required. Odds, live scores and settlement data are all included, so it is enough to build and evaluate against real games before you upgrade."}},{"@type":"Question","name":"How quickly can I integrate the API?","acceptedAnswer":{"@type":"Answer","text":"Most developers are up and running within a few hours. We provide official SDKs for JavaScript, Python, Ruby, Go, and Java, plus a quickstart guide with code examples. Sign up, get your API key instantly, and make your first request in minutes."}}]}]}</script><div class="mx-auto max-w-3xl text-center mb-12"><h2 class="text-balance text-3xl font-bold tracking-tight md:text-5xl">Common Questions</h2></div><div class="mx-auto max-w-3xl"><div class="space-y-3"><details name="faq" class="overflow-hidden rounded-xl border transition-all duration-300 [&amp;::details-content]:[content-visibility:visible] border-border bg-card/80 hover:border-border-subtle open:border-primary/30 open:bg-gradient-to-r open:from-primary/[0.06] open:to-card/60 open:shadow-[0_0_20px_rgba(16,185,129,0.06)] open:[&amp;_svg]:rotate-180 open:[&amp;_svg]:text-primary open:[&amp;_[data-faq-body]]:grid-rows-[1fr]"><summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-6 py-5 text-base md:text-lg font-semibold text-foreground/80 hover:text-foreground transition-colors [&amp;::-webkit-details-marker]:hidden"><span>What is an odds API?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down mt-0.5 size-5 shrink-0 text-muted-foreground transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></summary><div data-faq-body="true" class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out"><div class="overflow-hidden"><div class="whitespace-pre-line px-6 pb-5 text-muted-foreground leading-relaxed">An odds API is a programmatic interface that delivers real-time and historical sports betting odds — moneylines, spreads, totals, and player props — from sportsbooks directly into your app. Unlike a sports stats API, an odds API focuses on bookmaker prices and lines. SportsGameOdds provides all of this through one REST and WebSocket API, with live scores and settlement data included.</div></div></div></details><details name="faq" class="overflow-hidden rounded-xl border transition-all duration-300 [&amp;::details-content]:[content-visibility:visible] border-border bg-card/80 hover:border-border-subtle open:border-primary/30 open:bg-gradient-to-r open:from-primary/[0.06] open:to-card/60 open:shadow-[0_0_20px_rgba(16,185,129,0.06)] open:[&amp;_svg]:rotate-180 open:[&amp;_svg]:text-primary open:[&amp;_[data-faq-body]]:grid-rows-[1fr]"><summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-6 py-5 text-base md:text-lg font-semibold text-foreground/80 hover:text-foreground transition-colors [&amp;::-webkit-details-marker]:hidden"><span>What is SportsGameOdds?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down mt-0.5 size-5 shrink-0 text-muted-foreground transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></summary><div data-faq-body="true" class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out"><div class="overflow-hidden"><div class="whitespace-pre-line px-6 pb-5 text-muted-foreground leading-relaxed">SportsGameOdds is a REST API that delivers real-time betting odds, scores, stats, and settlement data from 85+ sportsbooks across 67+ leagues and 28+ sports. Instead of scraping bookmakers yourself, you get clean, structured data through simple API calls — updated every 30–60 seconds with moneylines, spreads, totals, player props, alternate lines, and more.</div></div></div></details><details name="faq" class="overflow-hidden rounded-xl border transition-all duration-300 [&amp;::details-content]:[content-visibility:visible] border-border bg-card/80 hover:border-border-subtle open:border-primary/30 open:bg-gradient-to-r open:from-primary/[0.06] open:to-card/60 open:shadow-[0_0_20px_rgba(16,185,129,0.06)] open:[&amp;_svg]:rotate-180 open:[&amp;_svg]:text-primary open:[&amp;_[data-faq-body]]:grid-rows-[1fr]"><summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-6 py-5 text-base md:text-lg font-semibold text-foreground/80 hover:text-foreground transition-colors [&amp;::-webkit-details-marker]:hidden"><span>What sports, leagues, and bookmakers do you cover?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down mt-0.5 size-5 shrink-0 text-muted-foreground transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></summary><div data-faq-body="true" class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out"><div class="overflow-hidden"><div class="whitespace-pre-line px-6 pb-5 text-muted-foreground leading-relaxed">We cover 67+ leagues across 28+ sports — including NFL, NBA, MLB, NHL, UFC, EPL, La Liga, Champions League, and many more — with odds from 85+ bookmakers like DraftKings, FanDuel, BetMGM, Pinnacle, Bet365, and PrizePicks. We&#x27;re continuously adding coverage.<div class="mt-3 flex flex-wrap gap-x-4 gap-y-1"><a class="text-primary hover:text-primary/80 underline underline-offset-2 text-sm font-medium transition-colors" href="/sports">Browse Sports<!-- --> →</a><a class="text-primary hover:text-primary/80 underline underline-offset-2 text-sm font-medium transition-colors" href="/leagues">Browse Leagues<!-- --> →</a><a class="text-primary hover:text-primary/80 underline underline-offset-2 text-sm font-medium transition-colors" href="/bookmakers">Browse Bookmakers<!-- --> →</a></div></div></div></div></details><details name="faq" class="overflow-hidden rounded-xl border transition-all duration-300 [&amp;::details-content]:[content-visibility:visible] border-border bg-card/80 hover:border-border-subtle open:border-primary/30 open:bg-gradient-to-r open:from-primary/[0.06] open:to-card/60 open:shadow-[0_0_20px_rgba(16,185,129,0.06)] open:[&amp;_svg]:rotate-180 open:[&amp;_svg]:text-primary open:[&amp;_[data-faq-body]]:grid-rows-[1fr]"><summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-6 py-5 text-base md:text-lg font-semibold text-foreground/80 hover:text-foreground transition-colors [&amp;::-webkit-details-marker]:hidden"><span>Does the API include sharp bookmakers like Pinnacle?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down mt-0.5 size-5 shrink-0 text-muted-foreground transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></summary><div data-faq-body="true" class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out"><div class="overflow-hidden"><div class="whitespace-pre-line px-6 pb-5 text-muted-foreground leading-relaxed">Yes. SportsGameOdds aggregates odds from 85+ bookmakers, including sharp books like Pinnacle alongside major sportsbooks such as DraftKings, FanDuel, BetMGM, Bet365, and Caesars. We also include DFS pick&#x27;em lines from PrizePicks and Underdog, plus prediction-market prices from Kalshi and Polymarket — all normalized into one consistent schema.</div></div></div></details><details name="faq" class="overflow-hidden rounded-xl border transition-all duration-300 [&amp;::details-content]:[content-visibility:visible] border-border bg-card/80 hover:border-border-subtle open:border-primary/30 open:bg-gradient-to-r open:from-primary/[0.06] open:to-card/60 open:shadow-[0_0_20px_rgba(16,185,129,0.06)] open:[&amp;_svg]:rotate-180 open:[&amp;_svg]:text-primary open:[&amp;_[data-faq-body]]:grid-rows-[1fr]"><summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-6 py-5 text-base md:text-lg font-semibold text-foreground/80 hover:text-foreground transition-colors [&amp;::-webkit-details-marker]:hidden"><span>What types of betting data do you provide?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down mt-0.5 size-5 shrink-0 text-muted-foreground transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></summary><div data-faq-body="true" class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out"><div class="overflow-hidden"><div class="whitespace-pre-line px-6 pb-5 text-muted-foreground leading-relaxed">We provide pre-match and live odds across all major bet types: moneylines, spreads, over/unders, 3-way moneylines, player props, team props, alternate lines, and more — for full game, halves, quarters, and other periods. We also provide live scores, box scores, team and player stats, market settlement/outcomes, consensus odds with vig removed, and deeplinks to bookmaker bet slips.</div></div></div></details><details name="faq" class="overflow-hidden rounded-xl border transition-all duration-300 [&amp;::details-content]:[content-visibility:visible] border-border bg-card/80 hover:border-border-subtle open:border-primary/30 open:bg-gradient-to-r open:from-primary/[0.06] open:to-card/60 open:shadow-[0_0_20px_rgba(16,185,129,0.06)] open:[&amp;_svg]:rotate-180 open:[&amp;_svg]:text-primary open:[&amp;_[data-faq-body]]:grid-rows-[1fr]"><summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-6 py-5 text-base md:text-lg font-semibold text-foreground/80 hover:text-foreground transition-colors [&amp;::-webkit-details-marker]:hidden"><span>How accurate and fast is your odds data?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down mt-0.5 size-5 shrink-0 text-muted-foreground transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></summary><div data-faq-body="true" class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out"><div class="overflow-hidden"><div class="whitespace-pre-line px-6 pb-5 text-muted-foreground leading-relaxed">Odds accuracy is 99.9%+ via direct bookmaker feeds, scores and stats are 99.5%+ verified against official sources, and event metadata is 99.9%+. Odds update every 30–60 seconds on average, with near-instant streaming updates available on the AllStar plan.</div></div></div></details><details name="faq" class="overflow-hidden rounded-xl border transition-all duration-300 [&amp;::details-content]:[content-visibility:visible] border-border bg-card/80 hover:border-border-subtle open:border-primary/30 open:bg-gradient-to-r open:from-primary/[0.06] open:to-card/60 open:shadow-[0_0_20px_rgba(16,185,129,0.06)] open:[&amp;_svg]:rotate-180 open:[&amp;_svg]:text-primary open:[&amp;_[data-faq-body]]:grid-rows-[1fr]"><summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-6 py-5 text-base md:text-lg font-semibold text-foreground/80 hover:text-foreground transition-colors [&amp;::-webkit-details-marker]:hidden"><span>How does your pricing compare to other odds APIs?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down mt-0.5 size-5 shrink-0 text-muted-foreground transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></summary><div data-faq-body="true" class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out"><div class="overflow-hidden"><div class="whitespace-pre-line px-6 pb-5 text-muted-foreground leading-relaxed">We charge per event, not per market or bookmaker. A single NBA game with 100 markets across 20 bookmakers costs 1 object — compared to potentially 2,000 units with per-market pricing from competitors. This makes SportsGameOdds 60–80% cheaper for most use cases, with fully predictable billing. We also offer an perpetually free tier.<div class="mt-3 flex flex-wrap gap-x-4 gap-y-1"><a class="text-primary hover:text-primary/80 underline underline-offset-2 text-sm font-medium transition-colors" href="/pricing">See Plans &amp; Pricing<!-- --> →</a></div></div></div></div></details><details name="faq" class="overflow-hidden rounded-xl border transition-all duration-300 [&amp;::details-content]:[content-visibility:visible] border-border bg-card/80 hover:border-border-subtle open:border-primary/30 open:bg-gradient-to-r open:from-primary/[0.06] open:to-card/60 open:shadow-[0_0_20px_rgba(16,185,129,0.06)] open:[&amp;_svg]:rotate-180 open:[&amp;_svg]:text-primary open:[&amp;_[data-faq-body]]:grid-rows-[1fr]"><summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-6 py-5 text-base md:text-lg font-semibold text-foreground/80 hover:text-foreground transition-colors [&amp;::-webkit-details-marker]:hidden"><span>Is there a free tier I can start with?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down mt-0.5 size-5 shrink-0 text-muted-foreground transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></summary><div data-faq-body="true" class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out"><div class="overflow-hidden"><div class="whitespace-pre-line px-6 pb-5 text-muted-foreground leading-relaxed">Yes. The free Amateur plan gives you 2,500 objects a month at 10 requests per minute, covering 8 leagues and 9 bookmakers, with no credit card required. Odds, live scores and settlement data are all included, so it is enough to build and evaluate against real games before you upgrade.<div class="mt-3 flex flex-wrap gap-x-4 gap-y-1"><a class="text-primary hover:text-primary/80 underline underline-offset-2 text-sm font-medium transition-colors" href="/pricing">Sign Up Free<!-- --> →</a><a class="text-primary hover:text-primary/80 underline underline-offset-2 text-sm font-medium transition-colors" href="/blog/your-guide-to-free-sportsbook-apis">Compare free API tiers<!-- --> →</a></div></div></div></div></details><details name="faq" class="overflow-hidden rounded-xl border transition-all duration-300 [&amp;::details-content]:[content-visibility:visible] border-border bg-card/80 hover:border-border-subtle open:border-primary/30 open:bg-gradient-to-r open:from-primary/[0.06] open:to-card/60 open:shadow-[0_0_20px_rgba(16,185,129,0.06)] open:[&amp;_svg]:rotate-180 open:[&amp;_svg]:text-primary open:[&amp;_[data-faq-body]]:grid-rows-[1fr]"><summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-6 py-5 text-base md:text-lg font-semibold text-foreground/80 hover:text-foreground transition-colors [&amp;::-webkit-details-marker]:hidden"><span>How quickly can I integrate the API?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down mt-0.5 size-5 shrink-0 text-muted-foreground transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></summary><div data-faq-body="true" class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out"><div class="overflow-hidden"><div class="whitespace-pre-line px-6 pb-5 text-muted-foreground leading-relaxed">Most developers are up and running within a few hours. We provide official SDKs for JavaScript, Python, Ruby, Go, and Java, plus a quickstart guide with code examples. Sign up, get your API key instantly, and make your first request in minutes.<div class="mt-3 flex flex-wrap gap-x-4 gap-y-1"><a class="text-primary hover:text-primary/80 underline underline-offset-2 text-sm font-medium transition-colors" href="/docs/basics/setup">Quickstart Guide<!-- --> →</a></div></div></div></div></details></div></div><div class="mt-10 text-center"><a data-slot="button" class="group inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 aria-invalid:border-destructive border border-border bg-background shadow-xs hover:bg-primary/[0.08] hover:border-primary/50 hover:text-foreground h-9 px-4 py-2 has-[&gt;svg]:px-3" href="/faq">View All</a></div></section><section class="container pb-24 md:pb-32"><div class="flex items-baseline justify-between gap-4"><div class=""><h2 class="text-2xl font-bold tracking-tight md:text-3xl">Recent Articles</h2></div><a class="hidden shrink-0 items-center gap-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-primary sm:inline-flex" href="/blog">View all<!-- --> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div><div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4"><a class="group" href="/blog/college-basketball-odds-api-guide"><div class="relative flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-card transition-all duration-500 hover:-translate-y-1 hover:border-primary/30 hover:shadow-[0_8px_40px_rgba(16,185,129,0.1)]"><div class="absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r opacity-60 transition-opacity duration-300 group-hover:opacity-100 from-primary via-accent to-info"></div><div class="relative aspect-[16/9] overflow-hidden"><img alt="How to Pull College Basketball Odds and Player Props" loading="lazy" decoding="async" data-nimg="fill" class="object-cover transition-transform duration-700 group-hover:scale-[1.05]" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 320px" srcSet="/_n