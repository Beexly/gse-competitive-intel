  <head>
    <script>
      if (location.host === 'alpha.betstack.app') {
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.getRegistrations().then(rs => rs.forEach(r => r.unregister()));
        }
        location.replace(location.href.replace('alpha.betstack.app', 'betstack.app'));
      }
    </script>
    <meta charset="UTF-8" />
