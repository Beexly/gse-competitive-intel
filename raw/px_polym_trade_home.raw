      function showStaleBanner() {
        const el = document.getElementById('stale-chunk')
        if (el) el.style.display = 'flex'
      }
      function reloadNow() {
        location.reload()
      }
      // глобалом: зовётся из onclick плашки, обычную функцию линтер считает мёртвой
      window.reloadIfOnline = function () {
        // в офлайне reload сменил бы плашку на страницу сетевой ошибки — ждём сеть и грузимся сами
        if (navigator.onLine) return reloadNow()
        window.addEventListener('online', reloadNow, { once: true })
        const el = document.querySelector('#stale-chunk span')
        if (el) el.textContent = "You're offline. We'll reload when the connection is back."
      }
      function reloadOnStaleChunk(e) {
        try {
          if (
            e.type === 'astro:hydration-error' &&
            !(e.detail && e.detail.error instanceof TypeError)
          )
            return
          // остальные острова падают следом в этом же документе: reload уже в полёте,
          // плашка мигнула бы поверх перезагрузки
          if (window.__chunkReloading) return
          // сеть отвалилась: reload сейчас убьёт и сам документ, поэтому ждём её возврата
          if (!navigator.onLine) {
            window.addEventListener('online', reloadNow, { once: true })
            return showStaleBanner()
          }
          // второй фейл за минуту: reload уже не помог, дальше решает юзер
          if (Date.now() - Number(sessionStorage.chunkReload) < 60000) return showStaleBanner()
          sessionStorage.chunkReload = Date.now()
          window.__chunkReloading = 1
          e.preventDefault()
          location.reload()
        } catch {
          // reload не состоялся — снимаем флаг, иначе beforeSend ослепнет до конца жизни документа
          delete window.__chunkReloading
        }
      }
      window.addEventListener('vite:preloadError', reloadOnStaleChunk)
