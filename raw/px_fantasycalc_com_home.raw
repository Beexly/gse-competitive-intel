<body>
<app-root></app-root>
<!-- Raptive adblock recovery: skip on localhost and beta -->
<script>
  (function (e) {
    var hostname = window.location.hostname;
    if (/^localhost$|^127\.0\.0\.1$/.test(hostname) || /^beta\.fantasycalc\.com$/i.test(hostname)) return;

    const t = '__adblocker';
    if (-1 === e.cookie.indexOf(t)) {
      const n = new XMLHttpRequest();
      (n.open('GET', 'https://ads.adthrive.com/abd/abd.js', !0), (n.onreadystatechange = function () {
        if (XMLHttpRequest.DONE === n.readyState) if (200 === n.status) {
          const t = e.createElement('script');
          ((t.innerHTML = n.responseText), e.getElementsByTagName('head')[0].appendChild(t));
        } else {
          const n = new Date();
          (n.setTime(n.getTime() + 3e5), (e.cookie = t + '=true; expires=' + n.toUTCString() + '; path=/'));
        }
      }), n.send());
    }
  })(document);
</script>
<script data-cfasync="false" data-abr-mode="essential">
  (function () {
