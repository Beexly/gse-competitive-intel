  <!-- Analytics and ads: skip on localhost; skip ads on beta -->
  <script>
    (function () {
      var hostname = window.location.hostname;
      var isLocal = /^localhost$|^127\.0\.0\.1$/.test(hostname);
      var isBeta = /^beta\.fantasycalc\.com$/i.test(hostname);
      if (isLocal) return;

      // Google Analytics
      var ga = document.createElement('script');
      ga.async = true;
      ga.src = 'https://www.googletagmanager.com/gtag/js?id=UA-125091098-1';
      document.head.appendChild(ga);

      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag('js', new Date());
      gtag('config', 'UA-125091098-1');

      if (isBeta) return;

      // Raptive (AdThrive)
      (function (w, d) {
        w.adthrive = w.adthrive || {};
        w.adthrive.cmd = w.adthrive.cmd || [];
        w.adthrive.plugin = 'adthrive-ads-manual';
        w.adthrive.host = 'ads.adthrive.com';
        var s = d.createElement('script');
        s.async = true;
        s.referrerpolicy = 'no-referrer-when-downgrade';
        s.src = 'https://' + w.adthrive.host + '/sites/665a34b5426ea45d310b289d/ads.min.js?referrer=' + w.encodeURIComponent(w.location.href) + '&cb=' + (Math.floor(Math.random() * 100) + 1);
        var n = d.getElementsByTagName('script')[0];
        n.parentNode.insertBefore(s, n);
      })(window, document);
    })();
  </script>

