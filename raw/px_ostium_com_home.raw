776198a908004223ba3639c68673714da6be8e73-1125x750.png&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fkr4wbrio%2Fproduction%2F776198a908004223ba3639c68673714da6be8e73-1125x750.png&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fkr4wbrio%2Fproduction%2F776198a908004223ba3639c68673714da6be8e73-1125x750.png&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fkr4wbrio%2Fproduction%2F776198a908004223ba3639c68673714da6be8e73-1125x750.png&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fkr4wbrio%2Fproduction%2F776198a908004223ba3639c68673714da6be8e73-1125x750.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fkr4wbrio%2Fproduction%2F776198a908004223ba3639c68673714da6be8e73-1125x750.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fkr4wbrio%2Fproduction%2F776198a908004223ba3639c68673714da6be8e73-1125x750.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fkr4wbrio%2Fproduction%2F776198a908004223ba3639c68673714da6be8e73-1125x750.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fkr4wbrio%2Fproduction%2F776198a908004223ba3639c68673714da6be8e73-1125x750.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fkr4wbrio%2Fproduction%2F776198a908004223ba3639c68673714da6be8e73-1125x750.png&amp;w=3840&amp;q=75"/></div><div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink/40"><span>Article</span><span>Crypto Briefing </span><span>Apr 28, 2026</span></div><p class="mt-3 text-[0.95rem] leading-[1.6] text-ink line-clamp-4">Ostium launches decentralized execution layer with Jump as hedging partner</p></a><a href="https://thedefiant.io/news/defi/ostium-launches-institutional-hedging-layer" target="_blank" rel="noopener noreferrer" class="group flex flex-col border-l border-t border-ink/10 p-5 transition-colors hover:bg-surface/40"><div class="relative mb-4 aspect-[16/10] w-full overflow-hidden rounded bg-surface"><img alt="The Defiant" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(max-width: 768px) 100vw, 33vw" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fkr4wbrio%2Fproduction%2F20f52a31238f9a01be53adb772f505f7d03115e4-1125x750.png&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fkr4wbrio%2Fproduction%2F20f52a31238f9a01be53adb772f505f7d03115e4-1125x750.png&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fkr4wbrio%2Fproduction%2F20f52a31238f9a01be53adb772f505f7d03115e4-1125x750.png&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fkr4wbrio%2Fproduction%2F20f52a31238f9a01be53adb772f505f7d03115e4-1125x750.png&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fkr4wbrio%2Fproduction%2F20f52a31238f9a01be53adb772f505f7d03115e4-1125x750.png&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fkr4wbrio%2Fproduction%2F20f52a31238f9a01be53adb772f505f7d03115e4-1125x750.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fkr4wbrio%2Fproduction%2F20f52a31238f9a01be53adb772f505f7d03115e4-1125x750.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fkr4wbrio%2Fproduction%2F20f52a31238f9a01be53adb772f505f7d03115e4-1125x750.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fkr4wbrio%2Fproduction%2F20f52a31238f9a01be53adb772f505f7d03115e4-1125x750.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fkr4wbrio%2Fproduction%2F20f52a31238f9a01be53adb772f505f7d03115e4-1125x750.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fkr4wbrio%2Fproduction%2F20f52a31238f9a01be53adb772f505f7d03115e4-1125x750.png&amp;w=3840&amp;q=75"/></div><div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink/40"><span>Article</span><span>The Defiant</span><span>Apr 28, 2026</span></div><p class="mt-3 text-[0.95rem] leading-[1.6] text-ink line-clamp-4">Ostium Launches Institutional Hedging Layer</p></a></div></div></div></div></div></section><section class="py-24 px-6"><div class="mx-auto max-w-3xl"><div class="mb-12 text-center" style="opacity:0;transform:translateY(32px)"><h2 class="gradient-text-display text-4xl font-normal md:text-5xl">Common Questions</h2></div><div style="opacity:0;transform:translateY(32px)"><div class="FAQ-module__5E5jIW__acc"><div class="FAQ-module__5E5jIW__accItem FAQ-module__5E5jIW__accItemOpen"><button type="button" class="FAQ-module__5E5jIW__accHeader" aria-expanded="true"><span class="FAQ-module__5E5jIW__accLabel">What is Ostium?</span><svg class="FAQ-module__5E5jIW__accChevron" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 6l4 4 4-4"></path></svg></button><div class="FAQ-module__5E5jIW__accBody"><div class="FAQ-module__5E5jIW__accBodyInner"><p class="FAQ-module__5E5jIW__accPara">Ostium is a decentralized perpetual futures exchange that lets you trade stocks, commodities, and forex with leverage — directly from your crypto wallet, with no broker or custodian.</p></div></div></div><div class="FAQ-module__5E5jIW__accItem "><button type="button" class="FAQ-module__5E5jIW__accHeader" aria-expanded="false"><span class="FAQ-module__5E5jIW__accLabel">How is Ostium different from a traditional broker?</span><svg class="FAQ-module__5E5jIW__accChevron" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 6l4 4 4-4"></path></svg></button><div class="FAQ-module__5E5jIW__accBody"><div class="FAQ-module__5E5jIW__accBodyInner"><p class="FAQ-module__5E5jIW__accPara">With Ostium, you keep full custody of your funds. There are no account approvals, no frozen positions, no hidden spreads, and no intermediaries. Everything is settled on-chain via smart contracts.</p></div></div></div><div class="FAQ-module__5E5jIW__accItem "><button type="button" class="FAQ-module__5E5jIW__accHeader" aria-expanded="false"><span class="FAQ-module__5E5jIW__accLabel">Why should perps traders use Ostium?</span><svg class="FAQ-module__5E5jIW__accChevron" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 6l4 4 4-4"></path></svg></button><div class="FAQ-module__5E5jIW__accBody"><div class="FAQ-module__5E5jIW__accBodyInner"><p class="FAQ-module__5E5jIW__accPara">Ostium offers deep liquidity across global markets — equities, gold, oil, forex — with transparent on-chain pricing tied to real-world data. You get institutional-grade markets with DeFi-grade access.</p></div></div></div><div class="FAQ-module__5E5jIW__accItem "><button type="button" class="FAQ-module__5E5jIW__accHeader" aria-expanded="false"><span class="FAQ-module__5E5jIW__accLabel">What do I need to get started?</span><svg class="FAQ-module__5E5jIW__accChevron" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 6l4 4 4-4"></path></svg></button><div class="FAQ-module__5E5jIW__accBody"><div class="FAQ-module__5E5jIW__accBodyInner"><p class="FAQ-module__5E5jIW__accPara">Just a crypto wallet (like MetaMask or Rabby) and USDC on Arbitrum. Connect your wallet at app.ostium.com and you can start trading in under a minute.</p></div></div></div><div class="FAQ-module__5E5jIW__accItem "><button type="button" class="FAQ-module__5E5jIW__accHeader" aria-expanded="false"><span class="FAQ-module__5E5jIW__accLabel">Are my funds safe?</span><svg class="FAQ-module__5E5jIW__accChevron" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 6l4 4 4-4"></path></svg></button><div class="FAQ-module__5E5jIW__accBody"><div class="FAQ-module__5E5jIW__accBodyInner"><p class="FAQ-module__5E5jIW__accPara">Your collateral is always in your wallet or in audited smart contracts — never in Ostium&#x27;s custody. You can verify every position, deposit, and withdrawal on-chain.</p></div></div></div><div class="FAQ-module__5E5jIW__accItem "><button type="button" class="FAQ-module__5E5jIW__accHeader" aria-expanded="false"><span class="FAQ-module__5E5jIW__accLabel">What is the settlement currency?</span><svg class="FAQ-module__5E5jIW__accChevron" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 6l4 4 4-4"></path></svg></button><div class="FAQ-module__5E5jIW__accBody"><div class="FAQ-module__5E5jIW__accBodyInner"><p class="FAQ-module__5E5jIW__accPara">All positions are collateralized and settled in USDC on Arbitrum. Profits and losses are realized in USDC.</p></div></div></div><div class="FAQ-module__5E5jIW__accItem "><button type="button" class="FAQ-module__5E5jIW__accHeader" aria-expanded="false"><span class="FAQ-module__5E5jIW__accLabel">What are the fees?</span><svg class="FAQ-module__5E5jIW__accChevron" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 6l4 4 4-4"></path></svg></button><div class="FAQ-module__5E5jIW__accBody"><div class="FAQ-module__5E5jIW__accBodyInner"><p class="FAQ-module__5E5jIW__accPara">Opening fees range from 2–10 basis points depending on the market. There are also rollover (funding) fees that vary based on the asset and market conditions.</p></div></div></div></div></div></div></section><section class="relative overflow-hidden py-32 px-6"><div class="pointer-events-none absolute inset-0 -z-10"><div class="absolute left-1/2 top-1/2 h-[500px] w-[700px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-orange/5 blur-[120px]"></div></div><div class="mx-auto max-w-3xl text-center"><div style="opacity:0;transform:translateY(32px)"><h2 class="mx-auto gradient-text-display text-[clamp(2rem,5vw,3.3125rem)] font-normal leading-[1.12] tracking-[-0.01em]">Global Asset Trading.<br/>Transparent Settlement.</h2></div><div style="opacity:0;transform:translateY(32px)"><p class="mt-6 text-base leading-relaxed text-ink/50 md:text-lg">Trade perpetuals on anything with full self-custody. Metals, energy, stocks, indices, and more.</p></div><div style="opacity:0;transform:translateY(32px)"><div class="mt-10 flex flex-wrap items-center justify-center gap-3"><a class="inline-flex items-center justify-center rounded transition-colors duration-150 cursor-pointer select-none bg-card text-ink font-semibold hover:bg-grey-20 active:bg-grey-20/80 px-8 py-3 text-md " target="_blank" rel="noopener noreferrer" href="https://app.ostium.com">Start Trading</a><a class="inline-flex items-center justify-center rounded transition-colors duration-150 cursor-pointer select-none bg-card text-ink font-semibold hover:bg-grey-20 active:bg-grey-20/80 px-8 py-3 text-md " target="_blank" rel="noopener noreferrer" href="https://docs.ostium.com">Read Docs</a></div></div></div></section><!--$--><!--/$--></main><footer class="border-t border-ink/5 bg-canvas"><div class="mx-auto max-w-7xl px-6 py-16"><div class="grid grid-cols-2 gap-8 md:grid-cols-4 lg:grid-cols-5"><div class="col-span-2 lg:col-span-2"><a class="inline-flex items-center gap-2 mb-4" href="/"><span class="text-orange font-bold text-lg tracking-wider">●</span><span class="text-sm font-semibold tracking-widest text-ink uppercase">Ostium</span></a><p class="text-sm text-ink/50 max-w-xs leading-relaxed">Trade perpetuals on stocks, commodities, and forex with real market liquidity.</p><div class="mt-6 flex gap-4"><a href="https://x.com/ostium" target="_blank" rel="noopener noreferrer" class="text-xs text-ink/40 hover:text-ink/70 transition-colors">X</a><a href="https://discord.com/invite/ostiu