(function(){
try{
  var key="berry-scroll:"+location.pathname+location.search+":"+Math.round(window.innerWidth||0);
  var navEntry=performance.getEntriesByType&&performance.getEntriesByType("navigation")[0];
  var navType=navEntry?navEntry.type:"navigate";
  var canStore=false;
  try{sessionStorage.setItem("__berry_scroll_test","1");sessionStorage.removeItem("__berry_scroll_test");canStore=true;}catch(e){}
  if("scrollRestoration"in history)history.scrollRestoration="manual";
  function save(){
    if(!canStore)return;
    try{sessionStorage.setItem(key,JSON.stringify({y:Math.max(0,Math.round(window.scrollY||0)),t:Date.now()}));}catch(e){}
  }
  var saveRaf=0;
  addEventListener("scroll",function(){
    if(saveRaf)return;
    saveRaf=requestAnimationFrame(function(){saveRaf=0;save();});
  },{passive:true});
  addEventListener("pagehide",save,{capture:true});
  addEventListener("beforeunload",save,{capture:true});
  var target=null;
  var shouldRestore=navType==="reload"||(!location.hash&&navType==="back_forward");
  if(canStore&&shouldRestore){
    try{
      var raw=sessionStorage.getItem(key);
      var parsed=raw?JSON.parse(raw):null;
      if(parsed&&typeof parsed.y==="number")target=Math.max(0,parsed.y);
      if(target===null){
        var prefix="berry-scroll:"+location.pathname+location.search+":";
        var bestT=-1;
        for(var i=0;i<sessionStorage.length;i++){
          var k=sessionStorage.key(i);
          if(!k||k.indexOf(prefix)!==0)continue;
          var p=null;
          try{p=JSON.parse(sessionStorage.getItem(k)||"");}catch(e){}
          if(p&&typeof p.y==="number"&&(p.t||0)>bestT){bestT=p.t||0;target=Math.max(0,p.y);}
        }
      }
    }catch(e){}
  }
  if(target===null)return;
  var cancelled=false;
  function cancel(){cancelled=true;document.documentElement.removeAttribute("data-scroll-restoring");}
  ["touchstart","pointerdown"].forEach(function(type){
    addEventListener(type,cancel,{passive:true,once:true,capture:true});
  });
  var scrollKeys={" ":1,"PageUp":1,"PageDown":1,"Home":1,"End":1,"ArrowUp":1,"ArrowDown":1};
  addEventListener("keydown",function(e){
    if(cancelled||e.metaKey||e.ctrlKey||e.altKey)return;
    if(scrollKeys[e.key])cancel();
  },{passive:true,capture:true});
  var bootNow=performance.now();
  var lastWheel=-1;
  addEventListener("wheel",function(){
    if(cancelled)return;
    var now=performance.now();
    var chained=lastWheel<0?now-bootNow<400:now-lastWheel<150;
    lastWheel=now;
    if(now-bootNow>1200||!chained)cancel();
  },{passive:true,capture:true});
  function restore(){
    if(cancelled)return;
    scrollTo(0,target);
  }
  function finish(){
    if(cancelled)return;
    restore();
    document.documentElement.removeAttribute("data-scroll-restoring");
    save();
  }
  document.documentElement.dataset.scrollRestoring="true";
  window.__berryRestoreScroll=function(){
    restore();
    requestAnimationFrame(restore);
    if(document.readyState==="loading"){
      document.addEventListener("DOMContentLoaded",restore,{once:true});
    }else{
      setTimeout(restore,0);
    }
    addEventListener("load",function(){
      restore();
      requestAnimationFrame(restore);
      setTimeout(restore,0);
    },{once:true});
    // The intro finalizes its height on document.fonts.ready, which on a cold
    // first reload lands after any fixed timeout.
    if(document.fonts&&document.fonts.ready&&document.fonts.ready.then){
      document.fonts.ready.then(restore);
    }
    // Re apply until the target holds. GSAP ScrollTrigger refreshes on mount
    // and on load can programmatically shove the scroll, and only user input
    // should cancel. Watch document height and live scroll position, finish
    // once the page has loaded and the target held for a few frames, with a
    // 4s safety cap.
    var loaded=document.readyState==="complete";
    addEventListener("load",function(){loaded=true;},{once:true});
    var lastH=-1,holdFrames=0,t0=Date.now();
    (function settle(){
      if(cancelled)return;
      var h=document.documentElement.scrollHeight;
      var maxY=Math.max(0,h-window.innerHeight);
      var want=target<maxY?target:maxY;
      if(h===lastH&&Math.abs((window.scrollY||0)-want)<=2){holdFrames++;}
      else{lastH=h;holdFrames=0;restore();}
      if((!loaded||holdFrames<12)&&Date.now()-t0<4000){requestAnimationFrame(settle);}
      else{finish();}
    })();
  };
}catch(e){}
})();
