nd:linear-gradient(148deg, #8fd5cd 0%, #65b0b4 35%, #416f8e 68%, #344777 100%);box-shadow:0 28px 70px rgba(0, 0, 0, 0.33)"><div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(circle at 18% 10%, rgba(214, 246, 236, 0.36) 0%, rgba(214, 246, 236, 0.12) 28%, transparent 58%), radial-gradient(circle at 86% 82%, rgba(58, 44, 124, 0.64) 0%, rgba(58, 44, 124, 0.24) 42%, transparent 72%), radial-gradient(92% 82% at 74% 98%, rgba(14, 25, 49, 0.58) 0%, rgba(14, 25, 49, 0.22) 44%, transparent 76%)"></div><div class="absolute inset-0 opacity-[0.16] mix-blend-soft-light pointer-events-none"><svg class="h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><defs><filter id="how-it-works-state-noise"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" seed="12" stitchTiles="stitch"></feTurbulence></filter></defs><rect width="100%" height="100%" filter="url(#how-it-works-state-noise)"></rect></svg></div><div class="relative z-10 h-full flex flex-col justify-center"><div class="max-w-3xl" style="font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, &#x27;Liberation Mono&#x27;, &#x27;Courier New&#x27;, monospace"><div class="grid grid-cols-[auto_1fr] items-start gap-x-4 md:gap-x-5"><span class="text-base sm:text-lg md:text-2xl lg:text-3xl !leading-[1.35] tracking-[-0.01em] text-white" style="text-shadow:0 0 14px rgba(255,255,255,0.22)">&gt;</span><div class="relative"><p class="text-base sm:text-lg md:text-2xl lg:text-3xl !leading-[1.35] tracking-[-0.01em] text-white/90 opacity-0 pointer-events-none select-none">Build an agent that tracks stablecoin depegs and posts risk alerts with context.</p><p class="absolute inset-0 text-base sm:text-lg md:text-2xl lg:text-3xl !leading-[1.35] tracking-[-0.01em] text-white/90"><span></span><span aria-hidden="true" class="inline-block ml-1 align-baseline text-white/90">|</span></p></div></div></div></div></div></div></div></div></div></div></section><section id="features" class="relative section-space scroll-mt-16"><div class="max-w-7xl mx-auto px-6 relative z-10"><div class="text-center max-w-3xl mx-auto" style="opacity:0;transform:translateY(14px)"><h2 class="type-section-title">Features</h2><p class="type-body text-muted mt-3 max-w-2xl mx-auto font-polySansNeutralWide">Agents that read onchain state, coordinate across protocols, and improve from every outcome.</p></div><div class="ecosystem-rail mt-4 flex overflow-x-auto gap-4 pb-2 snap-x snap-mandatory lg:grid lg:grid-cols-3 lg:gap-4 lg:overflow-visible lg:pb-0" style="-webkit-overflow-scrolling:touch;touch-action:pan-y"><article data-ecosystem-card="true" class="shrink-0 basis-full w-full snap-start lg:basis-auto lg:w-auto rounded-[26px] border border-border-2 p-4 lg:p-5" style="opacity:0"><div class="relative h-[170px] lg:h-[190px] rounded-2xl border border-[#1e1e1e] bg-[#0a0a0a] overflow-hidden"><div class="absolute inset-0 opacity-50 bg-[linear-gradient(0deg,#1e1e1e_1px,transparent_1px),linear-gradient(90deg,#1e1e1e_1px,transparent_1px)] bg-[size:26px_26px]"></div><div class="absolute left-[20%] top-[24%] w-20 h-20 rounded-full bg-[#4db8a4]/55 blur-[10px]"></div><div class="absolute left-[34%] top-[16%] w-24 h-24 rounded-full bg-[#4db8a4]/45 blur-[10px]"></div><div class="absolute left-[24%] top-[42%] w-20 h-20 rounded-full bg-[#4db8a4]/35 blur-[10px]"></div><div class="absolute left-[48%] top-[44%] w-20 h-20 rounded-full bg-[#f5f5f5]/25 blur-[10px]"></div><div class="absolute right-[16%] bottom-[20%] w-16 h-16 rounded-full bg-[#4db8a4]/45 blur-[10px]"></div></div><div class="mt-4"><p class="type-kicker text-muted font-polySansNeutralWide">Native Integrations</p><h3 class="mt-2 text-xl font-polySansMedianWide tracking-tight text-[#f5f5f5]">Seamless across chains and major protocols</h3><p class="type-body-sm mt-2 text-text-2 font-polySansNeutralWide">Agents connect and execute natively across chains and liquidity venues in one consistent runtime.</p></div></article><article data-ecosystem-card="true" class="shrink-0 basis-full w-full snap-start lg:basis-auto lg:w-auto rounded-[26px] border border-border-2 p-4 lg:p-5" style="opacity:0"><div class="relative h-[170px] lg:h-[190px] rounded-2xl border border-[#1e1e1e] bg-[#0a0a0a] p-2.5 overflow-hidden"><div class="space-y-1.5"><div class="rounded-xl border border-accent bg-surface-2 px-3 py-2 shadow-[0_0_0_1px_rgba(77,184,164,0.2)]"><div class="flex items-center justify-between gap-3"><div class="flex items-center gap-2.5 min-w-0"><span class="h-2 w-2 rounded-full bg-accent"></span><span class="text-sm text-text truncate font-polySansNeutralWide">Research Agent</span></div><span class="text-xs uppercase tracking-[0.12em] text-accent font-polySansNeutralWide">Live</span></div></div><div class="rounded-xl border border-border-2 bg-surface-2 px-3 py-2"><div class="flex items-center gap-2.5"><span class="h-2 w-2 rounded-full bg-muted"></span><span class="text-sm text-text-2 truncate font-polySansNeutralWide">Execution Agent</span></div></div><div class="rounded-xl border border-border-2 bg-surface-2 px-3 py-2"><div class="flex items-center gap-2.5"><span class="h-2 w-2 rounded-full bg-muted"></span><span class="text-sm text-text-2 truncate font-polySansNeutralWide">Risk Monitor</span></div></div><div class="rounded-xl border border-border-2 bg-surface-2 px-3 py-2"><div class="flex items-center gap-2.5"><span class="h-2 w-2 rounded-full bg-muted"></span><span class="text-sm text-text-2 truncate font-polySansNeutralWide">Settlement Agent</span></div></div></div><div class="absolute left-3 right-3 bottom-3 h-[1px] bg-border-2"></div></div><div class="mt-4"><p class="type-kicker text-muted font-polySansNeutralWide">Autonomous Operations</p><h3 class="mt-2 text-xl font-polySansMedianWide tracking-tight">From request to verified action</h3><p class="type-body-sm mt-2 text-text-2 font-polySansNeutralWide">A single instruction can trigger research, planning, execution, and checks automatically.</p></div></article><article data-ecosystem-card="true" class="shrink-0 basis-full w-full snap-start lg:basis-auto lg:w-auto rounded-[26px] border border-border-2 p-4 lg:p-5" style="opacity:0"><div class="relative h-[170px] lg:h-[190px] rounded-2xl border border-[#1e1e1e] bg-[#0a0a0a] p-3 overflow-hidden"><div class="grid grid-cols-2 gap-2.5 h-full"><div class="rounded-xl border border-border-2 bg-surface-2 p-2.5 flex flex-col justify-between"><p class="text-xs uppercase tracking-[0.14em] text-muted font-polySansNeutralWide">Run 01</p><div class="space-y-2"><div class="h-1.5 rounded-full bg-border-2"></div><div class="h-1.5 rounded-full bg-border-2 w-4/5"></div><div class="h-1.5 rounded-full bg-accent w-2/3"></div></div></div><div class="rounded-xl border border-accent bg-surface-2 p-2.5 flex flex-col justify-between shadow-[0_0_0_1px_rgba(77,184,164,0.2)]"><p class="text-xs uppercase tracking-[0.14em] text-accent font-polySansNeutralWide">Run 12</p><div class="space-y-2"><div class="h-1.5 rounded-full bg-border-2 w-2/3"></div><div class="h-1.5 rounded-full bg-accent"></div><div class="h-1.5 rounded-full bg-accent w-5/6"></div></div></div></div><div class="absolute left-1/2 -translate-x-1/2 bottom-3 rounded-full border border-border-2 bg-surface-2 px-2.5 py-1"><span class="text-xs uppercase tracking-[0.16em] text-accent font-polySansNeutralWide">Feedback Loop</span></div></div><div class="mt-4"><p class="type-kicker text-muted font-polySansNeutralWide">Continuous Improvement</p><h3 class="mt-2 text-xl tracking-tight font-polySansMedianWide">Every run improves the next one</h3><p class="type-body-sm mt-2 text-text-2 font-polySansNeutralWide">Outcomes and corrections are logged each cycle so agent decisions become sharper over time.</p></div></article></div><div class="mt-4 flex items-center justify-end gap-2 lg:hidden"><button type="button" disabled="" aria-label="Scroll ecosystem cards left" class="h-10 w-10 rounded-full border text-sm transition-all duration-