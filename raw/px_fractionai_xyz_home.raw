ps://fractionai.xyz/dapp/stable-up\\\"}}}\"}],[\"$\",\"meta\",\"4\",{\"name\":\"fc:miniapp\",\"content\":\"{\\\"version\\\":\\\"next\\\",\\\"imageUrl\\\":\\\"https://fractionai.xyz/embed.png\\\",\\\"button\\\":{\\\"title\\\":\\\"Launch Fraction AI\\\",\\\"action\\\":{\\\"type\\\":\\\"launch_frame\\\",\\\"name\\\":\\\"Fraction AI\\\",\\\"url\\\":\\\"https://fractionai.xyz/dapp/stable-up\\\"}}}\"}],[\"$\",\"meta\",\"5\",{\"name\":\"format-detection\",\"content\":\"telephone=no\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:title\",\"content\":\"Fraction AI\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:description\",\"content\":\"Create agents that manage capital better than anyone\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:image\",\"content\":\"https://fractionai.xyz/og_image_yt.png\"}],[\"$\",\"meta\",\"9\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twitter:title\",\"content\":\"Fraction AI\"}],[\"$\",\"meta\",\"11\",{\"name\":\"twitter:description\",\"content\":\"Create agents that manage capital better than anyone\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter:image\",\"content\":\"https://fractionai.xyz/og_image_yt.png\"}],[\"$\",\"link\",\"13\",{\"rel\":\"shortcut icon\",\"href\":\"/apple-touch-icon.png\"}],[\"$\",\"link\",\"14\",{\"rel\":\"icon\",\"href\":\"/icon.svg\",\"type\":\"image/svg+xml\"}],[\"$\",\"link\",\"15\",{\"rel\":\"icon\",\"href\":\"/search-favicon.png\",\"type\":\"image/png\",\"sizes\":\"48x48\"}],[\"$\",\"link\",\"16\",{\"rel\":\"apple-touch-icon\",\"href\":\"/icon.svg\"}],[\"$\",\"$L27\",\"17\",{}]]\n"])</script></body></html>