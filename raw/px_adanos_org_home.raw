    <div class="hero-wrapper">
        <div class="hero-grid hero-grid--animated" aria-hidden="true"></div>
        <div class="hn-hero">
            <div class="hn-top">
                <div class="hn-badge">Market sentiment API <span class="hn-pdot"></span></div>
                <h1 class="hn-h1">The sentiment layer<br>for markets.</h1>
                <div class="hn-brand-row">
                    <img src="/images/reddit.webp" alt="Reddit" width="32" height="32" loading="lazy">
                    <span class="hn-brand-plus">+</span>
                    <img src="/images/x.webp" alt="X" width="32" height="32" loading="lazy">
                    <span class="hn-brand-plus">+</span>
                    <span class="hn-brand-news"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5.5" cy="18.5" r="2.25"/><path d="M5 13a5.5 5.5 0 0 1 5.5 5.5" fill="none" stroke="#fff" stroke-width="2.25" stroke-linecap="round"/><path d="M5 8a10.5 10.5 0 0 1 10.5 10.5" fill="none" stroke="#fff" stroke-width="2.25" stroke-linecap="round"/><path d="M5 3a15.5 15.5 0 0 1 15.5 15.5" fill="none" stroke="#fff" stroke-width="2.25" stroke-linecap="round" opacity="0.68"/></svg></span>
                    <span class="hn-brand-plus">+</span>
                    <img src="/images/polymarket.webp" alt="Polymarket" width="32" height="32" loading="lazy">
                </div>
                <p class="hn-sub">Sentiment and attention data for stocks and crypto in one API. <br>Across Reddit, X, financial news, Polymarket and crypto communities - unified into clean, comparable sentiment signals.</p>
                <div class="hero-cta">
                    <a href="/register" class="btn">Get API Key</a>
                    <a href="https://api.adanos.org/docs" target="_blank" rel="noopener" class="btn btn-secondary">API Docs</a>
                </div>
            </div>
            <div class="hn-visual">
                <input type="radio" name="hn-tab" id="hn-tab-trending" checked class="hn-tab-input">
                <input type="radio" name="hn-tab" id="hn-tab-stock" class="hn-tab-input">
                <input type="radio" name="hn-tab" id="hn-tab-market" class="hn-tab-input">
                <input type="radio" name="hn-tab" id="hn-tab-compare" class="hn-tab-input">
                <input type="radio" name="hn-tab" id="hn-tab-explain" class="hn-tab-input">
                <input type="radio" name="hn-tab" id="hn-tab-mentions" class="hn-tab-input">
                <div class="hn-col hn-left">
                    <div class="hn-card hn-source-card" id="hn-card-reddit">
                        <div class="hn-card-ico nav-dropdown-icon-wrap reddit">
                            <svg viewBox="0 0 24 24"><path d="M17.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/></svg>
                        </div>
                        <div class="hn-card-copy">
                            <div class="hn-card-lbl">Reddit</div>
                            <div class="hn-card-meta">Stocks, ETFs, crypto</div>
                        </div>
                    </div>
                    <div class="hn-card hn-source-card" id="hn-card-x">
                        <div class="hn-card-ico nav-dropdown-icon-wrap x">
                            <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        </div>
                        <div class="hn-card-copy">
                            <div class="hn-card-lbl">X / Twitter</div>
                            <div class="hn-card-meta">Cashtags Sentiment</div>
                        </div>
                    </div>
                    <div class="hn-card hn-source-card" id="hn-card-news">
                        <div class="hn-card-ico nav-dropdown-icon-wrap news">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5.5" cy="18.5" r="2.25"/><path d="M5 13a5.5 5.5 0 0 1 5.5 5.5" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"/><path d="M5 8a10.5 10.5 0 0 1 10.5 10.5" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"/><path d="M5 3a15.5 15.5 0 0 1 15.5 15.5" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" opacity="0.68"/></svg>
                        </div>
                        <div class="hn-card-copy">
                            <div class="hn-card-lbl">Financial News</div>
                            <div class="hn-card-meta">100+ publishers</div>
                        </div>
                    </div>
                    <div class="hn-card hn-source-card" id="hn-card-polymarket">
                        <div class="hn-card-ico nav-dropdown-icon-wrap polymarket">
                            <svg viewBox="0 0 24 24"><rect x="3" y="12" width="4" height="9" rx="1"/><rect x="10" y="7" width="4" height="14" rx="1"/><rect x="17" y="3" width="4" height="18" rx="1"/></svg>
                        </div>
                        <div class="hn-card-copy">
                            <div class="hn-card-lbl">Polymarket</div>
                            <div class="hn-card-meta">Real-money predictions</div>
                        </div>
                    </div>
                </div>
                <div class="hn-term">
                    <div class="hn-term-rail" aria-hidden="true"></div>
                    <div class="hn-tbar">
                        <div class="hn-tl-wrap"><div class="hn-tl hn-tl-r"></div><div class="hn-tl hn-tl-y"></div><div class="hn-tl hn-tl-g"></div></div>
                        <div class="hn-tabs">
                            <label for="hn-tab-trending" class="hn-tab">/trending</label>
                            <label for="hn-tab-stock" class="hn-tab">/stock</label>
                            <label for="hn-tab-market" class="hn-tab">/market</label>
                            <label for="hn-tab-compare" class="hn-tab">/compare</label>
                            <label for="hn-tab-explain" class="hn-tab">/explain</label>
                            <label for="hn-tab-mentions" class="hn-tab">/mentions</label>
                        </div>
                    </div>
                    <div class="hn-body-wrap">
                        <div class="hn-tbody hn-tbody--trending">
                            <div class="hn-reqline"><span class="hn-req-call"><span class="hn-method">GET</span> <span class="hn-path">/<span class="hn-src">reddit</span>/stocks/v1/trending<span class="hn-query">?limit=20</span></span></span><span class="hn-status"><span class="hn-dot"></span><span class="hn-ok">200 OK</span><span class="hn-sep">·</span><span>142 ms</span></span></div>
                            <div class="hn-json">
                            <div class="hn-json-line"><span class="jb">[</span></div>
                            <div class="hn-json-line">  <span class="jb">{</span></div>
                            <div class="hn-json-line">    <span class="jk">"ticker"</span><span class="jp">:</span> <span class="js">"TSLA"</span><span class="jp">,</span></div>
                            <div class="hn-json-line">    <span class="jk">"company_name"</span><span class="jp">:</span> <span class="js">"Tesla, Inc."</span><span class="jp">,</span></div>
                            <div class="hn-json-line hn-hl">    <span class="jk">"buzz_score"</span><span class="jp">:</span> <span class="jn jn-hl">87.5</span><span class="jp">,</span></div>
                            <div class="hn-json-line">    <span class="jk">"trend"</span><span class="jp">:</span> <span class="js">"rising"</span><span class="jp">,</span></div>
                            <div class="hn-json-line">    <span class="jk">"mentions"</span><span class="jp">:</span> <span class="jn">342</span><span class="jp">,</span></div>
                            <div class="hn-json-line">    <span class="jk">"unique_posts"</span><span class="jp">:</span> <span class="jn">45</span><span class="jp">,</span></div>
                            <div class="hn-json-line">    <span class="jk">"subreddit_count"</span><span class="jp">:</span> <span class="jn">8</span><span class="jp">,</span></div>
                            <div class="hn-json-line">    <span class="jk">"sentiment_score"</span><span class="jp">:</span> <span class="jn">0.23</span><span class="jp">,</span></div>
                            <div class="hn-json-line">    <span class="jk">"bullish_pct"</span><span class="jp">:</span> <span class="jn">45</span><span class="jp">,</span></div>
                            <div class="hn-json-line">    <span class="jk">"bearish_pct"</span><span class="jp">:</span> <span class="jn">18</span><span class="jp">,</span></div>
                            <div class="hn-json-line">    <span class="jk">"total_upvotes"</span><span class="jp">:</span> <span class="jn">15234</span><span class="jp">,</span></div>
                            <div class="hn-json-line">    <span class="jk">"trend_history"</span><span class="jp">:</span> <span class="jb">[</span><span class="jn">45.2</span><span class="jp">,</span> <span class="jn">52.1</span><span class="jp">,</span> <span class="jn">48.7</span><span class="jp">,</span> <span class="jn">67.3</span><span class="jp">,</span> <span class="jn">72.1</span><span class="jp">,</span> <span class="jn">78.4</span><span class="jp">,</span> <span class="jn">87.5</span><span class="jb">]</span></div>
