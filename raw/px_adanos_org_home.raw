<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Primary Meta Tags -->
    <title>Adanos Market Sentiment API for Stocks & Crypto</title>
    <meta name="title" content="Adanos Market Sentiment API for Stocks & Crypto">
    <meta name="description" content="Sentiment and attention data for stocks and crypto from Reddit, X, news and Polymarket in one API.">
    <meta name="keywords" content="market sentiment API, stock sentiment API, crypto sentiment API, Reddit sentiment, social sentiment data, stock buzz, sentiment analysis, Polymarket">
    <meta name="author" content="Adanos Software GmbH">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://adanos.org">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="512x512" href="/images/favicon.png">
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="apple-touch-icon" href="/images/favicon.png">

    <!-- Font Preloading -->
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://adanos.org">
    <meta property="og:title" content="Adanos Market Sentiment API for Stocks & Crypto">
    <meta property="og:description" content="Sentiment and attention data for stocks and crypto from Reddit, X, news and Polymarket in one API.">
    <meta property="og:site_name" content="Adanos Software">
    <meta property="og:locale" content="en_US">
    <meta property="og:image" content="https://adanos.org/images/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Adanos - Market Sentiment API for Stocks and Crypto">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="https://adanos.org">
    <meta name="twitter:title" content="Adanos Market Sentiment API for Stocks & Crypto">
    <meta name="twitter:description" content="Sentiment and attention data for stocks and crypto from Reddit, X, news and Polymarket in one API.">
    <meta name="twitter:image" content="https://adanos.org/images/og-image.png">

    <!-- Additional SEO -->
    <meta name="theme-color" content="#1a1a1a">
    <meta name="geo.region" content="DE-BE">
    <meta name="geo.placename" content="Berlin">

    <!-- Structured Data -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://adanos.org/#website",
        "name": "Adanos",
        "url": "https://adanos.org",
        "description": "Market sentiment data API for stocks and crypto. Reddit, X, news and Polymarket signals in one API.",
        "publisher": { "@id": "https://adanos.org/#organization" },
        "potentialAction": {
            "@type": "SearchAction",
            "target": { "@type": "EntryPoint", "urlTemplate": "https://adanos.org/stocks/{search_term_string}" },
            "query-input": "required name=search_term_string"
        }
    }
    </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        "@id": "https://adanos.org/#organization",
        "name": "Adanos Software GmbH",
        "url": "https://adanos.org",
        "logo": "https://adanos.org/images/favicon.svg",
        "sameAs": [
            "https://github.com/adanos-software",
            "https://www.wikidata.org/wiki/Q140388225"
        ],
        "description": "German software company providing sentiment and attention data for stocks and crypto from Reddit, X, news and Polymarket in one API.",
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "Käthe-Niederkirchner-Str. 30",
            "addressLocality": "Berlin",
            "postalCode": "10407",
            "addressCountry": "DE"
        },
        "makesOffer": [
            {
                "@type": "Offer",
                "itemOffered": {
                    "@type": "SoftwareApplication",
                    "name": "StockAlert.pro",
                    "applicationCategory": "FinanceApplication",
                    "url": "https://stockalert.pro",
                    "operatingSystem": "Web",
                    "offers": {
                        "@type": "Offer",
                        "url": "https://stockalert.pro",
                        "availability": "https://schema.org/OnlineOnly",
                        "price": "0",
                        "priceCurrency": "EUR"
                    }
                }
            },
            {
                "@type": "Offer",
                "itemOffered": {
                    "@type": "WebAPI",
                    "name": "Reddit Stock Sentiment API",
                    "url": "https://adanos.org/reddit-stock-sentiment"
                }
            },
            {
                "@type": "Offer",
                "itemOffered": {
                    "@type": "WebAPI",
                    "name": "Reddit Crypto Sentiment API",
                    "url": "https://adanos.org/reddit-crypto-sentiment"
                }
            },
            {
                "@type": "Offer",
                "itemOffered": {
                    "@type": "WebAPI",
                    "name": "X Stock Sentiment API",
                    "url": "https://adanos.org/x-stock-sentiment"
                }
            },
            {
                "@type": "Offer",
                "itemOffered": {
                    "@type": "WebAPI",
                    "name": "Stock News Sentiment API",
                    "url": "https://adanos.org/stock-news-sentiment"
                }
            },
            {
                "@type": "Offer",
                "itemOffered": {
                    "@type": "WebAPI",
                    "name": "Polymarket Stock Sentiment API",
                    "url": "https://adanos.org/polymarket-stock-sentiment"
                }
            },
            {
                "@type": "Offer",
                "itemOffered": {
                    "@type": "SoftwareApplication",
                    "name": "Finance Sentiment CLI",
                    "url": "https://adanos.org/finance-sentiment-cli",
                    "applicationCategory": "DeveloperApplication",
                    "operatingSystem": "Windows, macOS, Linux",
                    "offers": {
                        "@type": "Offer",
                        "url": "https://adanos.org/finance-sentiment-cli",
                        "availability": "https://schema.org/OnlineOnly",
                        "price": "0",
                        "priceCurrency": "USD"
                    }
                }
            }
        ]
    }
    </script>

    <!-- Styles -->
    <link rel="stylesheet" href="global.css">
    <style>
/* ── Network Hero ─────────────────────────────────── */
.hn-hero { position: relative; z-index: 10; padding-bottom: 0; }
.hn-top { max-width: var(--max-width); margin: 0 auto; padding: 116px 48px 28px; display: flex; flex-direction: column; align-items: center; text-align: center; }
.hn-badge { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 14px; text-transform: uppercase; letter-spacing: .05em; color: var(--c-text-secondary); margin-bottom: 12px; }
.hn-pdot { width: 6px; height: 6px; border-radius: 50%; background: var(--c-green); animation: hnPdot 2.2s ease-out infinite; }
@keyframes hnPdot { 0% { box-shadow: 0 0 0 0 rgba(46,125,50,.45); } 60% { box-shadow: 0 0 0 7px rgba(46,125,50,0); } 100% { box-shadow: 0 0 0 0 rgba(46,125,50,0); } }
.hn-h1 { font-size: var(--h1-page-desktop-size); max-width: 100%; margin-bottom: 18px; }
.hn-sub { font-size: 20px; color: var(--c-text-secondary); line-height: 1.6; max-width: 700px; margin-bottom: 20px; }
@media (min-width: 769px) { .hn-top .hero-cta .btn { padding: 16px 58px; } }
.hn-brand-row { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
.hn-brand-row img { width: 32px; height: 32px; border-radius: 8px; object-fit: contain; }
.hn-brand-news { width: 32px; height: 32px; border-radius: 8px; background: #16a34a; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
.hn-brand-news svg { width: 18px; height: 18px; fill: #fff; }
.hn-brand-plus { font-size: 16px; color: #ccc; font-weight: 300; }
.hn-visual { --hn-feed-gap: clamp(36px, 5vw, 80px); position: relative; z-index: 10; max-width: 1400px; margin: 0 auto; padding: 0 40px; display: grid; grid-template-columns: 240px minmax(0, 1fr) 240px; column-gap: var(--hn-feed-gap); align-items: stretch; min-height: 520px; }
.hn-col { display: flex; flex-direction: column; justify-content: center; gap: 16px; position: relative; z-index: 3; }
.hn-left { overflow: visible; }
.hn-card { display: flex; align-items: center; gap: 10px; width: 100%; background: #f8f6f1; border: 1px solid #ebe7df; border-radius: 10px; padding: 14px 16px; box-shadow: 0 1px 2px rgba(15,23,42,0.04); user-select: none; font: inherit; color: inherit; text-align: left; position: relative; cursor: default; }
.hn-left .hn-source-card::after { content: ''; position: absolute; top: 50%; left: 100%; width: calc(var(--hn-feed-gap) + 2px); height: 2px; border-radius: 999px; background: linear-gradient(90deg, rgba(var(--hn-source-rgb, 132,145,165), 0.08), rgba(var(--hn-source-rgb, 132,145,165), 0.92), rgba(var(--hn-source-rgb, 132,145,165), 0.08)); transform: translateY(-50%); pointer-events: none; background-size: 200% 100%; animation: hnConnectorFlow 1.55s linear infinite; }
.hn-left .hn-source-card::before { content: ''; position: absolute; top: 50%; left: 100%; width: 8px; height: 8px; border-radius: 50%; background: rgba(var(--hn-source-rgb, 132,145,165), 0.96); transform: translate(-4px, -50%); opacity: .98; pointer-events: none; animation: hnPacketTravel 1.55s ease-in-out infinite; }
.hn-right .hn-card::after { content: ''; position: absolute; top: 50%; right: 100%; width: calc(var(--hn-feed-gap) + 2px); height: 2px; border-radius: 999px; background: linear-gradient(90deg, rgba(var(--hn-outcome-rgb, 132,145,165), 0.92), rgba(var(--hn-outcome-rgb, 132,145,165), 0.24), rgba(var(--hn-outcome-rgb, 132,145,165), 0.08)); transform: translateY(-50%); pointer-events: none; background-size: 200% 100%; animation: hnConnectorFlow 1.65s linear infinite; }
.hn-right .hn-card::before { content: ''; position: absolute; top: 50%; right: calc(100% + var(--hn-feed-gap)); width: 8px; height: 8px; border-radius: 50%; background: rgba(var(--hn-outcome-rgb, 132,145,165), 0.96); transform: translate(4px, -50%); opacity: .98; pointer-events: none; animation: hnOutcomePacketTravel 1.65s ease-in-out infinite; }
#hn-card-reddit { --hn-source-rgb: 255,69,0; }
#hn-card-x { --hn-source-rgb: 17,17,17; }
#hn-card-news { --hn-source-rgb: 22,163,74; }
#hn-card-polymarket { --hn-source-rgb: 47,91,218; }
#hn-card-analysis { --hn-outcome-rgb: 37,99,235; }
#hn-card-fintech { --hn-outcome-rgb: 124,58,237; }
#hn-card-agents { --hn-outcome-rgb: 234,88,12; }
#hn-card-quant { --hn-outcome-rgb: 5,150,105; }
#hn-card-reddit::after, #hn-card-reddit::before { animation-delay: 0s; }
#hn-card-x::after, #hn-card-x::before { animation-delay: .18s; }
#hn-card-news::after, #hn-card-news::before { animation-delay: .36s; }
#hn-card-polymarket::after, #hn-card-polymarket::before { animation-delay: .54s; }
#hn-card-analysis::after, #hn-card-analysis::before { animation-delay: .1s; }
#hn-card-fintech::after, #hn-card-fintech::before { animation-delay: .28s; }
#hn-card-agents::after, #hn-card-agents::before { animation-delay: .46s; }
#hn-card-quant::after, #hn-card-quant::before { animation-delay: .64s; }
@keyframes hnConnectorFlow { from { background-position: 200% 50%; } to { background-position: 0% 50%; } }
@keyframes hnPacketTravel {
    0% { left: 100%; opacity: 0; transform: translate(-5px, -50%) scale(0.85); }
    12% { opacity: 1; }
    82% { opacity: 1; }
    100% { left: calc(100% + var(--hn-feed-gap)); opacity: 0; transform: translate(-5px, -50%) scale(1.08); }
}
@keyframes hnOutcomePacketTravel {
    0% { right: calc(100% + var(--hn-feed-gap)); opacity: 0; transform: translate(5px, -50%) scale(0.85); }
    12% { opacity: 1; }
    82% { opacity: 1; }
    100% { right: 100%; opacity: 0; transform: translate(5px, -50%) scale(1.08); }
}
.hn-card-ico { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: var(--hn-icon-bg, var(--nav-icon-bg, var(--field-bg))); color: var(--hn-icon-fg, var(--nav-icon-fg, var(--c-text))); }
.hn-card-ico svg { width: 22px; height: 22px; color: currentColor; fill: currentColor; }
.hn-card-ico.reddit svg { width: 26px; height: 26px; }
.hn-card-ico--analysis { --hn-icon-bg: #dde8ff; --hn-icon-fg: #215bd8; }
.hn-card-ico--fintech { --hn-icon-bg: #ece2ff; --hn-icon-fg: #7c3aed; }
.hn-card-ico--agents { --hn-icon-bg: #f7e3d8; --hn-icon-fg: #c96a1a; }
.hn-card-ico--quant { --hn-icon-bg: #d1fae5; --hn-icon-fg: #059669; }
.hn-card-copy { display: grid; gap: 2px; }
.hn-card-lbl { font-size: 13px; font-weight: 600; letter-spacing: -.01em; }
.hn-card-meta { font-size: 13px; line-height: 1.45; color: #6B7280; }
.hn-term { height: 100%; background: #0D1117; border: 1px solid rgba(255,255,255,0.08); border-radius: var(--radius-lg) var(--radius-lg) 0 0; box-shadow: 0 18px 40px rgba(0,0,0,0.22), 0 2px 10px rgba(0,0,0,0.10); overflow: hidden; position: relative; z-index: 10; display: flex; flex-direction: column; }
.hn-term-rail { position: absolute; left: -1px; top: 52px; bottom: 36px; width: 3px; border-radius: 999px; background: linear-gradient(180deg, rgba(148,163,184,0.14), rgba(148,163,184,0.52) 48%, rgba(148,163,184,0.14)); z-index: 2; pointer-events: none; animation: hnRailPulse 2.1s ease-in-out infinite; }
@keyframes hnRailPulse {
    0%, 100% { opacity: 0.72; }
    50% { opacity: 1; }
}
.hn-tbar { background: #161B22; border-bottom: 1px solid rgba(255,255,255,0.06); padding: 10px 14px; display: flex; align-items: center; }
.hn-tl-wrap { display: flex; gap: 6px; flex-shrink: 0; margin-right: 14px; }
.hn-tl { width: 11px; height: 11px; border-radius: 50%; }
.hn-tl-r { background: #FF5F57; } .hn-tl-y { background: #FFBD2E; } .hn-tl-g { background: #28C840; }
.hn-tabs { display: flex; flex: 1; gap: 6px; overflow-x: auto; scrollbar-width: none; -ms-overflow-style: none; }
.hn-tabs::-webkit-scrollbar { display: none; }
.hn-tab { padding: 7px 14px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.04); font-family: var(--font-mono); font-size: 13px; color: rgba(255,255,255,0.58); cursor: pointer; white-space: nowrap; user-select: none; transition: background .15s, border-color .15s, color .15s, box-shadow .15s; appearance: none; }
.hn-tab:hover { color: rgba(255,255,255,0.84); background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.14); }
.hn-tab-input { display: none; }
#hn-tab-trending:checked ~ .hn-term .hn-tab[for="hn-tab-trending"],
#hn-tab-stock:checked ~ .hn-term .hn-tab[for="hn-tab-stock"],
#hn-tab-market:checked ~ .hn-term .hn-tab[for="hn-tab-market"],
#hn-tab-compare:checked ~ .hn-term .hn-tab[for="hn-tab-compare"],
#hn-tab-mentions:checked ~ .hn-term .hn-tab[for="hn-tab-mentions"],
#hn-tab-explain:checked ~ .hn-term .hn-tab[for="hn-tab-explain"] { color: #F8FAFC; background: rgba(255,255,255,0.14); border-color: rgba(255,255,255,0.18); box-shadow: inset 0 1px 0 rgba(255,255,255,0.08); font-weight: 600; }
.hn-tbar,
.hn-tbody { position: relative; z-index: 1; }
.hn-body-wrap { position: relative; flex: 1 1 auto; min-height: 0; --hn-body-pad-top: 20px; --hn-body-pad-side: 22px; --hn-body-pad-bottom: 22px; }
.hn-tbody { height: 100%; padding: var(--hn-body-pad-top) calc(var(--hn-body-pad-side) + 20px) var(--hn-body-pad-bottom) var(--hn-body-pad-side); box-sizing: border-box; font-family: var(--font-mono); font-size: 16px; line-height: 1.75; display: none; overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: none; }
.hn-tbody::-webkit-scrollbar { width: 0; height: 0; }
#hn-tab-trending:checked ~ .hn-term .hn-tbody--trending,
#hn-tab-stock:checked ~ .hn-term .hn-tbody--stock,
#hn-tab-market:checked ~ .hn-term .hn-tbody--market,
#hn-tab-compare:checked ~ .hn-term .hn-tbody--compare,
#hn-tab-mentions:checked ~ .hn-term .hn-tbody--mentions,
#hn-tab-explain:checked ~ .hn-term .hn-tbody--explain { display: block; }
.hn-json { display: grid; gap: 5px; overflow: visible; padding-top: 2px; }
.hn-json-line { white-space: pre-wrap; min-width: 0; overflow-wrap: anywhere; color: #E5E7EB; font-size: 15px; line-height: 1.7; }
/* ── Hero terminal: request line, status, source highlight (conversion) ── */
.hn-reqline { font-family: var(--font-mono); font-size: clamp(12px, 1.5vh, 14px); line-height: 1.7; letter-spacing: .01em; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 4px 16px; margin-bottom: clamp(8px, 1.4vh, 13px); }
.hn-method { color: #34D399; font-weight: 700; }
.hn-path { color: #93C5FD; }
.hn-req-call { min-width: 0; overflow-wrap: break-word; }
.hn-status { font-family: var(--font-mono); font-size: clamp(11px, 1.3vh, 12.5px); color: rgba(255,255,255,0.46); display: inline-flex; align-items: center; gap: 7px; white-space: nowrap; flex: none; }
.hn-status .hn-ok { color: #34D399; font-weight: 600; }
.hn-status .hn-note { color: rgba(252,211,77,0.92); }
.hn-sep { opacity: 0.4; }
.hn-dot { width: 7px; height: 7px; border-radius: 50%; background: #28C840; flex-shrink: 0; animation: hnDotPulse 2s ease-out infinite; }
@media (prefers-reduced-motion: reduce) { .hn-dot { animation: none; } }
@keyframes hnDotPulse { 0% { box-shadow: 0 0 0 0 rgba(40,200,64,0.45); } 60% { box-shadow: 0 0 0 6px rgba(40,200,64,0); } 100% { box-shadow: 0 0 0 0 rgba(40,200,64,0); } }
.hn-json-line.hn-hl { background: linear-gradient(90deg, rgba(88,166,255,0.12), rgba(88,166,255,0)); border-left: 2px solid rgba(88,166,255,0.6); margin-left: -10px; padding-left: 8px; border-radius: 2px; }
.hn-path .hn-src { color: #FCA5A5; font-weight: 700; }

@media (min-width: 1101px) {
    .hn-hero {
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
    }
    .hn-top {
        width: 100%;
        flex: 1 1 auto;
        justify-content: center;
        padding: clamp(96px, 8vw, 116px) 48px clamp(20px, 1.5vw, 28px);
    }
    .hn-h1 {
        margin-bottom: clamp(14px, 1vw, 18px);
    }
    .hn-sub {
        font-size: clamp(18px, 2vw, 20px);
        line-height: 1.5;
        max-width: 700px;
        margin-bottom: clamp(16px, 1.2vw, 20px);
    }
    .hn-visual {
        width: 100%;
        flex: none;
        height: clamp(280px, 48vh, 520px);
        min-height: 0;
    }
    .hn-col {
        gap: clamp(10px, 1.4vh, 16px);
    }
    .hn-card {
        padding: clamp(10px, 1.2vh, 14px) clamp(12px, 1.4vh, 16px);
    }
    .hn-card-ico {
        width: clamp(34px, 4vh, 40px);
        height: clamp(34px, 4vh, 40px);
    }
    .hn-card-ico svg {
        width: clamp(19px, 2.2vh, 22px);
        height: clamp(19px, 2.2vh, 22px);
    }
    .hn-card-lbl {
        font-size: 13px;
    }
    .hn-card-meta {
        font-size: 13px;
    }
    .hn-tbar {
        padding: 9px 13px;
    }
    .hn-tab {
        padding: 6px clamp(10px, 1.2vh, 14px);
        font-size: 13px;
    }
    .hn-body-wrap {
        --hn-body-pad-top: clamp(14px, 1.8vh, 20px);
        --hn-body-pad-side: clamp(16px, 2vh, 22px);
        --hn-body-pad-bottom: clamp(16px, 2vh, 22px);
    }
    .hn-tbody {
        font-size: clamp(13px, 1.5vh, 16px);
        line-height: 1.6;
    }
    .hn-json-line {
        font-size: clamp(13px, 1.5vh, 15px);
        line-height: 1.65;
    }
}
@media (max-width: 1100px) {
    .hero-wrapper { min-height: auto; }
    .hn-hero { display: flex; flex-direction: column; }
    .hn-brand-row { display: flex; }
    .hn-top { padding: 124px 32px 50px; flex: 1 1 auto; justify-content: center; }
    .hn-visual { max-width: 820px; padding: 0 24px; display: flex; flex-direction: column; gap: 20px; min-height: 0; flex: none; height: clamp(320px, 45vh, 460px); }
    .hn-col.hn-left { display: none; }
    .hn-col.hn-right { display: none; }
    .hn-term { order: 1; height: auto; flex: 1 1 auto; }
    .hn-body-wrap { height: auto; flex: 1 1 auto; min-height: 200px; }
    .hn-tbody { height: 100%; }
    .hn-term-rail { display: none; }
}
@media (max-width: 768px) {
    .hn-hero { padding-bottom: 0; min-height: auto; display: block; }
    .hn-top { padding: 108px 20px 26px; align-items: flex-start; text-align: left; }
    .hn-h1 { font-size: 36px; max-width: 100%; }
    .hn-sub { font-size: 17px; max-width: 100%; margin-bottom: 16px; line-height: 1.55; }
    .hn-sub br { display: none; }
    .hn-visual { padding: 0 20px; gap: 16px; }
    .hn-tab { font-size: 13px; padding: 7px 10px; }
    .hn-body-wrap { --hn-body-pad-top: 16px; --hn-body-pad-side: 16px; --hn-body-pad-bottom: 16px; flex: 1 1 auto; min-height: 220px; }
    .hn-tbody { height: 100%; font-size: 14px; }
    .hn-json-line { font-size: 13px; line-height: 1.65; }
    /* Drop the request query params and response status on phones: they wrap awkwardly. Kept on desktop. */
    .hn-query, .hn-status { display: none; }
}

/* ── Use Cases Section ─────────────────────────────── */
#use-cases { padding-top: clamp(60px, 8vw, 80px); }
#use-cases .about-highlight { overflow: hidden; padding: 0; }
#use-cases .about-highlight img { width: 100%; height: auto; display: block; padding: 24px 24px 0; }
#use-cases .about-highlight h3 { padding: 24px 32px 0; }
#use-cases .about-highlight p { padding: 0 32px 32px; }

