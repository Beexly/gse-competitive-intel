nk-0 inline-flex items-center justify-center overflow-hidden rounded-full" style="width:20px;height:20px;background:var(--alpha-6)"><img src="/icons/polymarket-icon.svg" alt="" class="h-full w-full object-cover" style="filter:grayscale(1) brightness(1.45) contrast(0.92)"/></span><div class="flex-1 min-w-0"><div class="text-[11px] font-light flex items-center gap-1 max-w-full" style="color:var(--text-secondary)"><span class="block break-words leading-snug overflow-hidden" style="max-height:2.75em">BTC above $150k by June</span></div><div class="flex items-center gap-1.5 mt-0.5 text-[10px] leading-none"><span class="ob-num whitespace-nowrap" style="color:var(--green)">28.4¢</span><span aria-hidden="true" class="h-2.5 w-px self-center shrink-0" style="background-color:var(--alpha-10)"></span><span class="ob-num whitespace-nowrap" style="color:var(--red)">71.6¢</span></div></div></div><div class="relative flex items-center gap-2 py-1.5 rounded select-none" style="background:transparent;padding-left:8px;padding-right:8px"><span class="flex-shrink-0 inline-flex items-center justify-center overflow-hidden rounded-full" style="width:20px;height:20px;background:var(--alpha-6)"><img src="/icons/kalshi-icon.svg" alt="" class="h-full w-full object-cover" style="filter:grayscale(1) brightness(1.45) contrast(0.92)"/></span><div class="flex-1 min-w-0"><div class="text-[11px] font-light flex items-center gap-1 max-w-full" style="color:var(--text-secondary)"><span class="block break-words leading-snug overflow-hidden" style="max-height:2.75em">GDP print beats estimate</span></div><div class="flex items-center gap-1.5 mt-0.5 text-[10px] leading-none"><span class="ob-num whitespace-nowrap" style="color:var(--green)">25.4¢</span><span aria-hidden="true" class="h-2.5 w-px self-center shrink-0" style="background-color:var(--alpha-10)"></span><span class="ob-num whitespace-nowrap" style="color:var(--red)">74.6¢</span></div></div></div><div class="relative flex items-center gap-2 py-1.5 ro