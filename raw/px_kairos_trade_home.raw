  font-variant-ligatures: no-contextual;
}
.kairos-desk { font-family: Inter, system-ui, sans-serif; }

@keyframes kd-ring { from { transform: translate(-50%,-50%) scale(0.35); opacity: 0.5 } to { transform: translate(-50%,-50%) scale(2.6); opacity: 0 } }
@keyframes kd-caret { 0%,49% { opacity: 1 } 50%,100% { opacity: 0 } }
@keyframes kd-live { 0%,100% { opacity: 0.25 } 50% { opacity: 1 } }
@keyframes kd-enter { from { opacity: 0; transform: translateY(4px) } to { opacity: 1; transform: none } }
.kd-ring { animation: kd-ring 520ms cubic-bezier(0.22,1,0.36,1) forwards; }
.kd-caret { animation: kd-caret 900ms steps(1) infinite; margin-left: 1px; }
.kd-live { animation: kd-live 1.4s ease-in-out infinite; }
.kd-enter { animation: kd-enter 320ms cubic-bezier(0.22,1,0.36,1) both; }
