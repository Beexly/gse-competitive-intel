<script type="text/javascript">

            var formattedDate = new Date();
            var d = formattedDate.getDate();
            var m = formattedDate.getMonth() + 1;
            var y = formattedDate.getFullYear();
            var getEventsFrom = y + '-' + (m < 10 ? '0' + m : m) + '-' + (d < 10 ? '0' + d : d);

            var newdateCalendar = new Date();
            newdateCalendar.setDate(newdateCalendar.getDate() + 1);
            var ddCalendar = newdateCalendar.getDate();
            var mmCalendar = newdateCalendar.getMonth() + 1;
            var yCalendar = newdateCalendar.getFullYear();
            var getEventsTo = yCalendar + '-' + (mmCalendar < 10 ? '0' + mmCalendar : mmCalendar) + '-' + (ddCalendar < 10 ? '0' + ddCalendar : ddCalendar);

            var offset = new Date().getTimezoneOffset(),
            o = Math.abs(offset);
            var getTimezone = (offset < 0 ? "+" : "-") + ("00" + Math.floor(o / 60)).slice(-2) + ":" + ("00" + (o % 60)).slice(-2);

            $.ajax({
                url: 'https://apiv3.apifootball.com/?',
                cache: false,
                data: {
                    action: 'get_events',
                    Widgetkey: '893b8a8d15fa14f9ba4b684f1df792e740769586d0a302a04731404785f69',
                    from: getEventsFrom,
                    to: getEventsTo,
                    timezone: getTimezone,
                    withOutDetails: true,
                    get_pred: true,
                    limit: 30
                },
                dataType: 'json'
            }).done(function(res) {
                // console.log(res);
                $.each(res, function(key, value) {

                    var generatedLink = value.country_name+'/'+value.league_name+'/'+value.match_hometeam_name+'-vs-'+value.match_awayteam_name+'/'+value.match_date+'/'+value.match_id;
                    var newGeneratedLink = generatedLink.replace(/\s/g,'-');
                    var htmlConstructorLink = 'https://apifootball.com/widgets/full/widgetMatchResults.html?'+newGeneratedLink;

                    // $('.nextMatchesApi').append('<tr onclick="location.href=\''+htmlConstructorLink+'\';">' +
                    $('.nextMatchesApi').append('<tr class="matchHover" onclick="window.open(\''+htmlConstructorLink+'\', \'_blank\', \'width=700, height=650\');">' +
                        //'<td class="col-md-1"><div class="sample-icon col-md-3 col-sm-4 f16"><div style="height:16px; background-image: url('+value.country_logo+');height: 20px; padding-left: 30px; background-repeat: no-repeat; background-position: center; background-size: cover;"></div></div></td>' +
                        '<td class="col-md-1">'+value.match_date+'</td>' +
                        '<td class="col-md-2">'+value.match_hometeam_name+'</td>' +
                        '<td class="col-md-1" style="text-align:center;">'+value.match_hometeam_score+' - '+value.match_awayteam_score+'</td>' +
                        '<td class="col-md-2">'+value.match_awayteam_name+'</td>' +
                        '<td class="col-md-1" align="center">'+Math.floor(value.prob_HW)+'%</td>' +
                        '<td class="col-md-1" align="center">'+Math.floor(value.prob_D)+'%</td>' +
                        '<td class="col-md-1" align="center">'+Math.floor(value.prob_AW)+'%</td>' +
                    '</tr>');
                });

            });
        </script>

          <script type="text/javascript">

$("#promo-tab").hide();
$("#close").on("click", function(){
$("#promo-outer").slideUp();
$("#promo-tab").slideDown();
if($(window).width() < 991){
$('.content').css('padding-top', '53px');
}
});
$("#promo-tab").on("click", function(){
$(this).slideUp();
$("#promo-outer").slideDown();
if($(window).width() < 991){
$('.content').css('padding-top', '15px');
}
});


    </script>

<script type="text/javascript">
        document.getElementById("setFooterYear").innerHTML = new Date().getFullYear();
    </script>
<script src="//code.tidio.co/pzfkh8xzrth3mdgfmajvje2uzaymuvoc.js" async></script>	
</body>

</html>
