<!-- Temperature Markets search filter -->
<script>
document.addEventListener('DOMContentLoaded', function() {
	var searchInput = document.getElementById('wethr-market-search');
	var noResults   = document.getElementById('wethr-no-results');
	var dropdown    = document.querySelector('.wethr-mega-dropdown');
	if (!searchInput || !dropdown) return;

	// Gather all market <li> elements with their searchable text
	var items = [];
	dropdown.querySelectorAll('li[data-market]').forEach(function(li) {
		var a = li.querySelector('a');
		if (!a) return;
		var extra = li.getAttribute('data-search') || '';
		items.push({
			el: li,
			href: a.getAttribute('href'),
			text: ((a.textContent || '') + ' ' + extra).toLowerCase()
		});
	});

	// Group headings & columns to hide when empty
	var groups = dropdown.querySelectorAll('.wethr-market-group, .wethr-intl-group');
	var visibleItems = [];

	function filterMarkets() {
		var query = searchInput.value.toLowerCase().trim();
		visibleItems = [];

		items.forEach(function(item) {
			var match = !query || item.text.indexOf(query) !== -1;
			item.el.style.display = match ? '' : 'none';
			if (match) visibleItems.push(item);
		});

		// Toggle reflow mode — display:contents on lists so items fill the grid
		dropdown.classList.toggle('wethr-searching', !!query);

		// Hide group headings if all their children are hidden
		groups.forEach(function(group) {
			var hasVisible = false;
			group.querySelectorAll('li[data-market]').forEach(function(li) {
				if (li.style.display !== 'none') hasVisible = true;
			});
			group.style.display = hasVisible ? '' : 'none';
		});

		// Show "no results" message
		if (noResults) {
			noResults.style.display = (!visibleItems.length && query) ? '' : 'none';
		}
	}

	searchInput.addEventListener('input', filterMarkets);

	// Enter key navigates to the sole visible result
	searchInput.addEventListener('keydown', function(e) {
		if (e.key === 'Enter' && visibleItems.length === 1) {
			e.preventDefault();
			window.location.href = visibleItems[0].href;
		}
	});

	// Auto-focus search when dropdown opens
	if (typeof UIkit !== 'undefined') {
		// Helper: hide a dropdown that's been locked open by makeClickOnly().
		// makeClickOnly() blocks ALL hide attempts unless the _wethrAllowHide
		// flag is set first — so any code that needs to close one of these
		// dropdowns programmatically must go through this helper.
		function safeHideDropdown(dropdownEl) {
			if (!dropdownEl) return;
			var drop = UIkit.drop(dropdownEl);
			if (!drop) return;
			dropdownEl._wethrAllowHide = true;
			drop.hide(false);
		}

		// Convert ALL navbar dropdowns from hover-driven to fully click-driven:
		//   • Hover does NOT open them (blocked in beforeshow).
		//   • Hover/mouse-leave does NOT close them (blocked in beforehide).
		//   • Only an explicit click on the toggle, an outside click, the X
		//     button, or the ESC key (in the search field) can close them.
		function makeClickOnly(dropdownEl) {
			var toggle = dropdownEl.parentElement.querySelector(':scope > a');
			if (!toggle) return;
			var clicked = false;
			dropdownEl._wethrAllowHide = false;

			// Block hover-triggered opens
			UIkit.util.on(dropdownEl, 'beforeshow', function(e) {
				if (!clicked) { e.preventDefault(); return; }
				clicked = false;
			});

			// Block hover-triggered hides — keep menu open until an
			// explicit close path sets _wethrAllowHide = true.
			UIkit.util.on(dropdownEl, 'beforehide', function(e) {
				if (!dropdownEl._wethrAllowHide) { e.preventDefault(); return; }
				dropdownEl._wethrAllowHide = false;
			});

			// Toggle on click
			toggle.addEventListener('click', function(e) {
				e.preventDefault();
				var drop = UIkit.drop(dropdownEl);
				if (!drop) return;
				if (dropdownEl.classList.contains('uk-open')) {
					safeHideDropdown(dropdownEl);
				} else {
					clicked = true;
					drop.show();
				}
			});

			// Close when clicking outside
			document.addEventListener('click', function(e) {
				if (!dropdownEl.contains(e.target) && !toggle.contains(e.target) && dropdownEl.classList.contains('uk-open')) {
					safeHideDropdown(dropdownEl);
				}
			});
		}

		// Apply to mega dropdown + all sub-dropdowns
		document.querySelectorAll('.wethr-mega-dropdown, .wethr-sub-dropdown').forEach(function(el) {
			// Skip account dropdown — already uses uk-dropdown="mode: click"
			if (el.closest('.uk-navbar-right')) return;
			makeClickOnly(el);
		});

		// X close button inside the mega dropdown
		var megaCloseBtn = document.getElementById('wethr-mega-close');
		if (megaCloseBtn) {
			megaCloseBtn.addEventListener('click', function(e) {
				e.preventDefault();
				e.stopPropagation();
				safeHideDropdown(dropdown);
			});
		}

		// Search-specific: auto-focus and ESC key (mega dropdown only)
		UIkit.util.on(dropdown, 'shown', function() {
			searchInput.value = '';
			filterMarkets();
			setTimeout(function() { searchInput.focus(); }, 50);
		});

		searchInput.addEventListener('keydown', function(e) {
			if (e.key === 'Escape') {
				e.preventDefault();
				e.stopPropagation();
				safeHideDropdown(dropdown);
			}
		});
	}
});
</script>

<!-- High/Low Notifier popup launcher (used by the menu items above) -->
<script>
function wethrOpenNotifierPopup(e) {
	// Respect modifier-clicks: cmd/ctrl/shift/middle-click should follow href
	// (open in new tab) instead of opening a popup window. Matches expected
	// link behavior elsewhere on the site.
	if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return true;

	// Named target 'wethr-notifier-main' means clicking the menu item again
	// while a notifier window is already open just FOCUSES that window
	// instead of spawning a duplicate. Additional windows opened from the
	// "+" button inside the notifier itself use unique names.
	var w = window.open(
		'/notifier',
		'wethr-notifier-main',
		'popup=yes,width=440,height=760,resizable=yes,scrollbars=yes'
	);
	if (w) {
		try { w.focus(); } catch (err) {}
		e.preventDefault();
		return false;
	}
	// Popup blocked → fall through to the href so the user still gets the page
	return true;
}
</script>
