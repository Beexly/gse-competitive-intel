<!-- Ad attribution capture: UTMs + platform click IDs (gclid/gbraid/wbraid,
     rdt_cid, twclid, fbclid) into the wethr_attr first-party cookie (90 days).
     Landing page / referrer / timestamp are first-touch; UTM + click-ID fields
     are last-non-direct-touch. registration.php reads this cookie server-side
     at signup, no hidden fields needed. -->
<script>
(function() {
    var params = new URLSearchParams(window.location.search);
    var KEYS = ['utm_source','utm_medium','utm_campaign','utm_term','utm_content',
                'gclid','gbraid','wbraid','rdt_cid','twclid','fbclid'];
    var attr = {};
    try {
        var m = document.cookie.match('(?:^|; )wethr_attr=([^;]*)');
        if (m) attr = JSON.parse(decodeURIComponent(m[1])) || {};
    } catch (e) { attr = {}; }

    var touched = false;
    KEYS.forEach(function(k) {
        var v = params.get(k);
        if (v) { attr[k] = v.slice(0, 250); touched = true; }
    });
    // First touch only: landing page, external referrer, timestamp
    if (!attr.lp) {
        attr.lp = (location.pathname + location.search).slice(0, 500);
        attr.ts = Date.now();
        if (document.referrer && document.referrer.indexOf(location.hostname) === -1) {
            attr.ref = document.referrer.slice(0, 500);
        }
        touched = true;
    }
    if (touched) {
        var d = new Date();
        d.setTime(d.getTime() + 90 * 24 * 60 * 60 * 1000);
        document.cookie = 'wethr_attr=' + encodeURIComponent(JSON.stringify(attr)) +
            ';expires=' + d.toUTCString() + ';path=/;SameSite=Lax';
    }
})();
</script>

<!-- gclid capture (legacy path, kept for existing forms): reads gclid from URL,
     stores in first-party cookie for 90 days, then auto-injects a hidden gclid
     field into any form posting to /register -->
<script>
(function() {
    // Capture gclid from URL into cookie
    var params = new URLSearchParams(window.location.search);
    var gclid = params.get('gclid');
    if (gclid) {
        var d = new Date();
        d.setTime(d.getTime() + 90 * 24 * 60 * 60 * 1000);
        document.cookie = 'gclid=' + encodeURIComponent(gclid) + ';expires=' + d.toUTCString() + ';path=/;SameSite=Lax';
    }

    // Read gclid from cookie
    var stored = (function() {
        var m = document.cookie.match('(?:^|; )gclid=([^;]*)');
        return m ? decodeURIComponent(m[1]) : '';
    })();

    // Auto-inject hidden gclid field into any form that posts to /register
    if (stored) {
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('form[action="/register"], form[action*="/register"]').forEach(function(form) {
                if (!form.querySelector('input[name="gclid"]')) {
                    var input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'gclid';
                    input.value = stored;
                    form.appendChild(input);
                }
            });
        });
    }
})();
</script>

<!-- Referral code capture: reads ref from URL, stores in first-party cookie for 30 days -->
<script>
(function() {
    var params = new URLSearchParams(window.location.search);
    var ref = params.get('ref');
    // First touch: only set if no existing referral cookie
    if (ref && !document.cookie.match('(?:^|; )referral_code=')) {
        var d = new Date();
        d.setTime(d.getTime() + 30 * 24 * 60 * 60 * 1000);
        document.cookie = 'referral_code=' + encodeURIComponent(ref) + ';expires=' + d.toUTCString() + ';path=/;SameSite=Lax';
    }
})();
</script>

