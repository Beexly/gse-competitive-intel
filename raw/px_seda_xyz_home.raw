<!-- ───────────────────────── 1. HERO ───────────────────────── -->
<section class="hero">
  <canvas id="hero-particles" class="hero-canvas" aria-hidden="true"></canvas>
  <div class="container hero-inner">
    <h1>
      Powering <span class="accent">24/7</span> Markets
    </h1>

    <p class="subhead">
      SEDA's oracle infrastructure delivers data to industry-leading markets across equities, indices, and verifiable outcomes for markets that never sleep.
    </p>

    <div class="hero-cta">
      <a class="btn btn-primary btn-lg" href="contact.html">
        Talk to us
        <span class="material-symbols-rounded">arrow_forward</span>
      </a>
      <a class="btn btn-tertiary btn-lg" href="#products">
        Explore products
      </a>
    </div>
  </div>
</section>

<!-- ───────────────────────── 2. THREE PRODUCTS ───────────────────────── -->
<section class="block" id="products" style="padding-top:32px">
  <div class="container">
    <div class="block-head">
      <div class="block-eyebrow">Infinite products. One Infrastructure.</div>
      <h2 class="block-title">SEDA provides one integration, enabling new markets in minutes.</h2>
      <p class="block-sub">
        Explore SEDA's popular products, powering leading protocols and applications across traditional financial venues.
      </p>
    </div>

    <div class="products-grid">

      <!-- Signal -->
      <a href="signal.html" class="card product-card">
        <div class="pc-visual">
          <svg viewBox="0 0 320 100">
            <defs>
              <linearGradient id="bench-fill" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0%"  stop-color="var(--chart-primary)" stop-opacity="0.45"/>
                <stop offset="100%" stop-color="var(--chart-primary)" stop-opacity="0"/>
              </linearGradient>
            </defs>
            <!-- continuous price line — inset from both edges so the line + indicator have breathing room -->
            <path d="M10,72 L30,68 L50,70 L70,62 L90,58 L110,52 L130,56 L150,46 L170,42 L185,36 L200,40 L220,32 L240,26 L260,30 L280,22 L300,16 L310,14 L310,100 L10,100 Z"
                  fill="url(#bench-fill)"/>
            <path d="M10,72 L30,68 L50,70 L70,62 L90,58 L110,52 L130,56 L150,46 L170,42 L185,36 L200,40 L220,32 L240,26 L260,30 L280,22 L300,16 L310,14"
                  pathLength="100" class="mini-line pc-anim-draw"/>
            <!-- end dot -->
            <circle cx="310" cy="14" r="3" class="mini-dot"/>
            <circle cx="310" cy="14" r="7" fill="var(--primary-400)" fill-opacity="0.32" class="pc-bench-dot"/>
            <!-- weekend band -->
            <rect x="200" y="0" width="32" height="100" fill="var(--border-soft)"/>
          </svg>
        </div>
        <div class="pc-name"><span class="pc-mark"></span>Signal</div>
        <h3>24/7 composite feeds for any asset.</h3>
        <p class="pc-line">Data is aggregated from the world's leading data providers, exchanges, and trading venues to deliver continuous data when traditional markets close.</p>
        <div class="pc-stat">
          <div>
            <div class="v" id="stat-vol-card">$18.1B<span style="color:var(--primary-400)">+</span></div>
            <div class="l">Trading volume supported<sup class="disc-ref">1</sup></div>
          </div>
          <span class="pc-link">Learn more <span class="material-symbols-rounded">arrow_forward</span></span>
        </div>
      </a>

      <!-- Bundles -->
      <a href="bundles.html" class="card product-card">
        <div class="pc-visual">
          <svg viewBox="0 0 320 100">
            <!-- 3 stacked composition rows + USA500 result pill, vertically centered in the 100-unit viewBox -->
            <g>
              <rect x="14"  y="32" width="180" height="6" rx="2" class="mini-bar"/>
              <rect x="14"  y="32" width="108" height="6" rx="2" class="mini-bar fill pc-anim-grow"/>
              <text x="200" y="38" font-size="10" fill="var(--text-muted)" font-family="ui-monospace">60%</text>
              <text x="14"  y="26" font-size="9"  fill="var(--text-muted)">Equities</text>

              <rect x="14"  y="54" width="180" height="6" rx="2" class="mini-bar"/>
              <rect x="14"  y="54" width="45"  height="6" rx="2" class="mini-bar fill pc-anim-grow pc-d-1"/>
              <text x="200" y="60" font-size="10" fill="var(--text-muted)" font-family="ui-monospace">25%</text>
              <text x="14"  y="48" font-size="9"  fill="var(--text-muted)">Crypto</text>

              <rect x="14"  y="76" width="180" height="6" rx="2" class="mini-bar"/>
              <rect x="14"  y="76" width="27"  height="6" rx="2" class="mini-bar fill pc-anim-grow pc-d-2"/>
              <text x="200" y="82" font-size="10" fill="var(--text-muted)" font-family="ui-monospace">15%</text>
              <text x="14"  y="70" font-size="9"  fill="var(--text-muted)">Commodities</text>

              <!-- result pill (right side) — centered vertically in the viewBox -->
              <rect x="240" y="30" width="72" height="40" rx="3" class="mini-pill pc-anim-fade pc-d-4"/>
              <text x="276" y="48" font-size="11" font-weight="500" text-anchor="middle" class="mini-pill-text-prim pc-anim-fade pc-d-4">USA500</text>
              <text x="276" y="60" font-size="9"  text-anchor="middle" fill="var(--text-muted)" class="pc-anim-fade pc-d-4">composite</text>
            </g>
          </svg>
        </div>
        <div class="pc-name"><span class="pc-mark"></span>Bundles</div>
        <h3>Bundle feeds with any underlying asset.</h3>
        <p class="pc-line">Build custom data feeds from any combination of data sources with configurable weighting, automatic rebalancing, and cross-asset coverage.</p>
        <div class="pc-stat">
          <div>
            <div class="v">$7B<span style="color:var(--primary-400)">+</span></div>
            <div class="l">USA500 · Hyperliquid</div>
          </div>
          <span class="pc-link">Learn more <span class="material-symbols-rounded">arrow_forward</span></span>
        </div>
      </a>

      <!-- Outcome -->
      <a href="outcomes.html" class="card product-card">
        <div class="pc-visual">
          <svg viewBox="0 0 320 100">
            <!-- origin -->
            <circle cx="14" cy="50" r="5" class="mini-dot"/>
            <text x="26" y="54" font-size="11" fill="var(--text-secondary)" font-weight="500">Resolve</text>

            <!-- branch lines (start clear of the "Resolve" label, curve to right edge) -->
            <path d="M82,50 C157,50 157,22 232,22"  pathLength="100" class="mini-branch pc-anim-draw"/>
            <path d="M82,50 L232,50"                pathLength="100" class="mini-branch pc-anim-draw pc-d-1"/>
            <path d="M82,50 C157,50 157,78 232,78"  pathLength="100" class="mini-branch pc-anim-draw pc-d-2"/>

            <!-- outcome pills (anchored to right edge) -->
            <rect x="232" y="10" width="80" height="24" rx="3" class="mini-pill-success pc-anim-fade pc-d-5"/>
            <text x="272" y="26" font-size="11" font-weight="500" text-anchor="middle" class="mini-pill-text-success pc-anim-fade pc-d-5">YES · 62%</text>

            <rect x="232" y="38" width="80" height="24" rx="3" class="mini-pill pc-anim-fade pc-d-6"/>
            <text x="272" y="54" font-size="11" font-weight="500" text-anchor="middle" class="mini-pill-text-prim pc-anim-fade pc-d-6">NO · 38%</text>

            <rect x="232" y="66" width="80" height="24" rx="3" fill="var(--bg-card-high)" class="pc-anim-fade pc-d-7"/>
            <text x="272" y="82" font-size="10" font-weight="500" text-anchor="middle" fill="var(--text-muted)" class="pc-anim-fade pc-d-7">PENDING</text>

            <!-- attestation marks (top-left) -->
            <g fill="var(--success-500)" opacity="0.9">
              <circle cx="12" cy="14" r="2.5" class="pc-anim-fade pc-d-8"/>
              <circle cx="20" cy="14" r="2.5" class="pc-anim-fade pc-d-8"/>
              <circle cx="28" cy="14" r="2.5" class="pc-anim-fade pc-d-9"/>
            </g>
            <text x="38" y="18" font-size="10" fill="var(--text-muted)" class="pc-anim-fade pc-d-10">214 signals</text>
          </svg>
        </div>
        <div class="pc-name"><span class="pc-mark"></span>Outcomes</div>
        <h3>Resolve any market outcome instantly.</h3>
        <p class="pc-line">Plug into custom oracle infrastructure to power ultra-low latency feeds for prediction markets, options, structured products, and exotic derivatives, fully programmatic, no human reporters.</p>
        <div class="pc-stat">
          <div>
            <div class="v">&lt;200ms</div>
            <div class="l">Median resolution latency</div>
          </div>
          <span class="pc-link">Learn more <span class="material-symbols-rounded">arrow_forward</span></span>
        </div>
      </a>

      <!-- Pre-IPO -->
      <a href="pre-ipo.html" class="card product-card">
        <div class="pc-visual">
          <svg viewBox="0 0 320 100">
            <!-- Pre-IPO entry → IPO breakout. Gentle rise on the private side, dashed IPO line,
                 then steep climb on the public side. Tells the story: "get in early, before the
                 market wakes up." No fabricated dollar values — relative price action only. -->
            <defs>
              <linearGradient id="pipo-fill" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0%" stop-color="var(--primary-400)" stop-opacity="0.4"/>
                <stop offset="100%" stop-color="var(--primary-400)" stop-opacity="0"/>
              </linearGradient>
            </defs>

            <!-- IPO divider (vertical dashed line) -->
            <line x1="200" y1="0" x2="200" y2="100"
                  stroke="var(--border-default)" stroke-width="1" stroke-dasharray="3,3" opacity="0.7"/>

            <!-- Area fill under full curve — inset from both edges so the indicator + ENTRY marker have breathing room -->
            <path d="M10,87 L30,85 L55,83 L80,82 L105,80 L130,78 L155,76 L180,73 L200,70 L218,58 L236,44 L254,32 L272,22 L290,15 L310,9 L310,100 L10,100 Z"
                  fill="url(#pipo-fill)"/>

            <!-- Price line: gentle private-market phase, then steep post-IPO breakout -->
            <path d="M10,87 L30,85 L55,83 L80,82 L105,80 L130,78 L155,76 L180,73 L200,70 L218,58 L236,44 L254,32 L272,22 L290,15 L310,9"
                  pathLength="100" class="mini-line pc-anim-draw" stroke-width="2"/>

            <!-- ENTRY marker (early pre-IPO buy-in) -->
            <g class="pc-anim-fade pc-d-1">
              <circle cx="30" cy="85" r="4" fill="var(--bg-page)" stroke="var(--chart-success)" stroke-width="2"/>
              <text x="30" y="73" font-size="9" font-family="ui-monospace" font-weight="500" fill="var(--text-primary)" letter-spacing="0.5" text-anchor="middle">ENTRY</text>
            </g>

            <!-- IPO marker (the breakout point) -->
            <g class="pc-anim-fade pc-d-3">
              <circle cx="200" cy="70" r="4" fill="var(--bg-page)" stroke="var(--primary-400)" stroke-width="2"/>
              <text x="200" y="60" font-size="9" font-family="ui-monospace" font-weight="500" fill="var(--text-primary)" letter-spacing="0.5" text-anchor="middle">IPO</text>
            </g>

            <!-- End dot at peak (post-IPO upside) — matches Signal card -->
            <circle cx="310" cy="9" r="3" class="mini-dot"/>
            <circle cx="310" cy="9" r="7" fill="var(--primary-400)" fill-opacity="0.32" class="pc-bench-dot"/>
          </svg>
        </div>
        <div class="pc-name"><span class="pc-mark"></span>Pre-IPO</div>
        <h3>Tick-by-tick data for any private company.</h3>
        <p class="pc-line">Access institutional-grade data feeds for 5,000+ private companies, from leading data providers. Unlock pre-IPO markets with one unified, 24/7 endpoint.</p>
        <div class="pc-stat">
          <div>
            <div class="v">5,000<span style="color:var(--primary-400)">+</span></div>
            <div class="l">Private companies covered</div>
          </div>
          <span class="pc-link">Learn more <span class="material-symbols-rounded">arrow_forward</span></span>
        </div>
      </a>

    </div>
  </div>
</section>

