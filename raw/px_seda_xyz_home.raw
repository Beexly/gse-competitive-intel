            <span class="customer-logo"><img src="assets/logos/seda-icon-sm.png" alt="+ More" class="clogo">+ More</span>
          </div>
          <div class="provider-ticker-sep"></div>
          <span class="ticker-label">Data providers include</span>
          <div class="provider-ticker">
            <div class="ticker-track">
              <span class="ticker-item"><img src="assets/logos/dxfeed.png" alt="dxFeed">dxFeed</span>
              <span class="ticker-item"><img src="assets/logos/caplight.png" alt="Caplight">Caplight</span>
