<script>

  // ─── Hero particle gravity ───
  (function () {
    var canvas = document.getElementById("hero-particles");
    if (!canvas || !canvas.getContext) return;
    var ctx = canvas.getContext("2d");
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    var W = 0, H = 0, cx = 0, cy = 0;
    var particles = [];
    var N = 200;
    var running = true;
    var sized = false;

    function isDark() {
      return (document.body.getAttribute("data-theme") || "dark") === "dark";
    }

    function resize() {
      var rect = canvas.parentElement.getBoundingClientRect();
      W = rect.width  || window.innerWidth;
      H = rect.height || Math.max(600, window.innerHeight * 0.8);
      canvas.width  = Math.max(1, Math.floor(W * dpr));
      canvas.height = Math.max(1, Math.floor(H * dpr));
      canvas.style.width  = W + "px";
      canvas.style.height = H + "px";
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cx = W / 2;
      cy = H * 0.46;
      sized = (W > 0 && H > 0);
    }

    function pickColor() {
      var r = Math.random();
      if (r < 0.55) return [186, 163, 253];
      if (r < 0.78) return [214, 200, 254];
      if (r < 0.92) return [22, 186, 132];
      return isDark() ? [255, 255, 255] : [30, 30, 50];
    }

    function spawn(p) {
      var rx = Math.min(W * 0.34, 440);
      var ry = Math.min(H * 0.46, 340);
      var angle = Math.random() * Math.PI * 2;
      var r = 0.55 + Math.sqrt(Math.random()) * 0.55;
      p.x = cx + Math.cos(angle) * rx * r;
      p.y = cy + Math.sin(angle) * ry * r;
      p.vx = 0; p.vy = 0;
      p.size  = 0.9 + Math.random() * 1.6;
      p.color = pickColor();
      p.life  = 0;
      p.maxLife = 220 + Math.random() * 240;
    }

    function tick() {
      if (!sized) resize();
      if (!running || !sized) { requestAnimationFrame(tick); return; }
      ctx.fillStyle = isDark() ? "rgba(0,0,0,0.16)" : "rgba(255,255,255,0.22)";
      ctx.fillRect(0, 0, W, H);
      var faint = isDark() ? 0.30 : 0.40;
      for (var i = 0; i < particles.length; i++) {
        var p = particles[i];
        var dx = cx - p.x, dy = cy - p.y;
        var d  = Math.sqrt(dx * dx + dy * dy);
        if (d < 0.01) d = 0.01;
        var g = 320 / Math.max(35, d);
        p.vx += (dx / d) * g * 0.016; p.vy += (dy / d) * g * 0.016;
        p.vx *= 0.998; p.vy *= 0.998;
        p.x += p.vx; p.y += p.vy; p.life++;
        if (d < 5 || p.life > p.maxLife || p.x < -W*0.2 || p.y < -H*0.2 || p.x > W*1.2 || p.y > H*1.2) { spawn(p); continue; }
        var fadeIn = Math.min(1, p.life / 24);
        var fadeOut = Math.min(1, (d - 4) / 110);
        var alpha = fadeIn * fadeOut * faint;
        var c = p.color;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = "rgba(" + c[0] + "," + c[1] + "," + c[2] + "," + alpha + ")";
        ctx.fill();
      }
      requestAnimationFrame(tick);
    }

    function init() {
      resize(); particles.length = 0;
      for (var i = 0; i < N; i++) { var p = {}; spawn(p); p.life = Math.random() * 360; particles.push(p); }
      tick();
    }

    var resizeTimer;
    window.addEventListener("resize", function () { clearTimeout(resizeTimer); resizeTimer = setTimeout(resize, 120); });
    window.addEventListener("load", resize);
    if ("IntersectionObserver" in window) { var io = new IntersectionObserver(function (e) { running = e[0].isIntersecting; }, { threshold: 0 }); io.observe(canvas); }
    var ts = document.getElementById("themeSwitch");
    if (ts) ts.addEventListener("click", function () { setTimeout(function () { ctx.clearRect(0, 0, W, H); }, 60); });
    var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)");
    if (reduce && reduce.matches) {
      resize();
      for (var j = 0; j < N; j++) { var q = {}; spawn(q); var t = 0.05 + Math.random() * 0.7; q.x = q.x + (cx - q.x) * t; q.y = q.y + (cy - q.y) * t; var dist = Math.hypot(cx - q.x, cy - q.y); var fo = Math.min(1, (dist - 4) / 70); ctx.beginPath(); ctx.arc(q.x, q.y, q.size, 0, Math.PI * 2); ctx.fillStyle = "rgba(" + q.color[0] + "," + q.color[1] + "," + q.color[2] + "," + (fo * 0.8) + ")"; ctx.fill(); }
      return;
    }
    init();
  })();
</script>

<script>
(function() {
  function animateCount(el) {
    var target = parseFloat(el.dataset.count);
    var prefix = el.dataset.prefix || '';
    var suffix = el.dataset.suffix || '';
    var decimals = parseInt(el.dataset.decimals) || 0;
    var duration = 1800;
    var start = null;

    function ease(t) {
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    function step(ts) {
      if (!start) start = ts;
      var progress = Math.min((ts - start) / duration, 1);
      var val = ease(progress) * target;
      el.textContent = prefix + val.toFixed(decimals) + suffix;
      if (progress < 1) requestAnimationFrame(step);
    }

    requestAnimationFrame(step);
  }

  function startCounters() {
    var stats = document.querySelectorAll('.proof-stat .v[data-count]');
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          animateCount(entry.target);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });
    stats.forEach(function(el) { observer.observe(el); });
  }

  // Fetch live stats, update data-count, then start counters
  fetch('/api/stats')
    .then(function(r) { return r.json(); })
    .then(function(d) {
      var volEl = document.getElementById('stat-volume');
      if (volEl && d.volume) {
        var volB = d.volume / 1e9;
        volEl.setAttribute('data-count', volB.toFixed(1));
        volEl.setAttribute('data-suffix', 'B+');
        volEl.setAttribute('data-decimals', '1');
      }
      var burnEl = document.getElementById('stat-burned');
      if (burnEl && d.totalBurned) {
        var burnM = d.totalBurned / 1e6;
        burnEl.setAttribute('data-count', burnM.toFixed(2));
      }
      var volCard = document.getElementById('stat-vol-card');
      if (volCard && d.volumeFormatted) {
        volCard.innerHTML = d.volumeFormatted + '<span style="color:var(--primary-400)">+</span>';
      }
      var volText = document.getElementById('stat-vol-text');
      if (volText && d.volumeFormatted) {
        volText.textContent = d.volumeFormatted + '+';
      }
      startCounters();
    })
    .catch(function() {
      startCounters();
    });
})();
</script>

<script>
(function() {
  var cards = document.querySelectorAll('.product-card');
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
        // After initial animation completes, set elements to final state
        // and remove is-visible so hover can retrigger
        setTimeout(function() {
          entry.target.classList.remove('is-visible');
          entry.target.classList.add('is-animated');
        }, 1200);
      }
    });
  }, { threshold: 0.3 });
  cards.forEach(function(card) {
    card.addEventListener('mouseenter', function() {
      // Reset animations so they replay on hover
      card.classList.remove('is-animated');
      void card.offsetWidth; // force reflow
    });
    card.addEventListener('mouseleave', function() {
      card.classList.add('is-animated');
    });
    observer.observe(card);
  });
})();
</script>

<!-- A/B homepage experiment: tag pageviews + conversions by variant -->
<script>
(function () {
  var m = document.cookie.match(/(?:^|;\s*)ab-home=(a|b)/);
  var variant = m ? m[1] : 'a';

  function track(name, data) {
    window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
    window.va('event', { name: name, data: data });
  }

  // Which homepage this visitor saw (denominator for the test).
  track('home_view', { variant: variant });

  // Clicks heading to the two conversion pages (nav + body links).
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a[href]');
    if (!a) return;
    var href = a.getAttribute('href') || '';
    var dest = /contact/i.test(href) ? 'contact' : (/trial/i.test(href) ? 'trial' : null);
    if (!dest) return;
    track('cta_click', { variant: variant, dest: dest });
  }, true);
})();
</script>

