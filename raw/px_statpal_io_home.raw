                  <div class="ms-xi-sub"><span class="ms-xi-form">4-2-3-1</span>Konstantinos Bratsos</div>
                  <ul class="ms-xi">
                    
                    <li class="is-gk"><span class="ms-xi-num">1</span><span class="ms-xi-player">Marios Siabanis</span></li>
                    
                    <li><span class="ms-xi-num">4</span><span class="ms-xi-player">Giannis Kargas</span></li>
                    
