<style>

.switch {
  position: relative;
  height: 32px;
  width: 300px;
  margin: 20px auto;
  background: #F2F2F2;
  background: #D7D7D7;
  border-radius: 32px;
}
.switch-label {
  font-weight: bold;
  position: relative;
  z-index: 2;
  float: left;
  width: 100px;
  line-height: 32px;
  font-size: 14px;
  color: #676a6c;
  text-align: center;
  cursor: pointer;
}

.switch-input {
  display: none;
}

.switch-input:checked + .switch-label {
  color: #FFF;
  transition: 0.15s ease-out;
  transition-property: color, text-shadow;
}

.switch-input:checked + .switch-label-y ~ .switch-selector {
  transform: translateX(0%);
  background-color: #1AB394;
}
.switch-input:checked + .switch-label-i ~ .switch-selector {
  transform: translateX(100%);
  background-color: #1AB394;
}
.switch-input:checked + .switch-label-n ~ .switch-selector {
  transform: translateX(200%);
  background-color: #1AB394;
}


.switch-selector {
  position: absolute;
  z-index: 1;
  top: 0px;
  left: 0px;
  display: block;
  width: 100px;
  height: 32px;
  border-radius: 32px;
  background-color: #1ab394;
  transition: all 0.3s cubic-bezier(0.18, 0.89, 0.32, 1.28);
}

#curl-request,
#response-json {
  font-family: 'Source Code Pro', monospace, monospace;
  white-space: pre-wrap; /* Wrap long lines */
  word-break: break-word; /* Break really long tokens */
}
.chat-msg{margin-bottom:10px;animation:chatSlide .3s ease}
@keyframes chatSlide{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.chat-msg-user{text-align:right}
.chat-msg-user .chat-bubble{background:#1ab394;color:#fff;display:inline-block;padding:8px 12px;border-radius:12px 12px 4px 12px;max-width:85%;font-size:13px;text-align:left}
.chat-msg-assistant{text-align:left}
.chat-msg-assistant .chat-bubble{background:#f0f0f0;color:#333;display:inline-block;padding:8px 12px;border-radius:12px 12px 12px 4px;max-width:85%;font-size:13px}
.chat-msg-assistant .chat-bubble strong{color:#1ab394}
.chat-typing span{display:inline-block;width:6px;height:6px;background:#999;border-radius:50%;margin:0 2px;animation:bounce 1.4s infinite}
.chat-typing span:nth-child(2){animation-delay:.2s}
.chat-typing span:nth-child(3){animation-delay:.4s}
@keyframes bounce{0%,60%,100%{transform:translateY(0)}30%{transform:translateY(-6px)}}
.chat-followup{background:#e8f5f0;border:1px solid #1ab394;border-radius:10px;padding:3px 8px;font-size:10px;color:#1ab394;cursor:pointer;margin:2px}
.chat-followup:hover{background:#1ab394;color:#fff}
.chat-error{background:#fff5f5;border:1px solid #ffccc7;color:#cf1322;padding:8px;border-radius:6px;font-size:12px;margin-bottom:8px}
.chat-error button{background:#cf1322;color:#fff;border:none;padding:3px 8px;border-radius:4px;font-size:10px;cursor:pointer;margin-left:8px}


/* Custom Sports Dropdown */
.sport-select-wrapper {
  position: relative;
  width: 100%;
  margin-bottom: 16px;
  z-index: 10;
}

.sport-select {
  position: relative;
  width: 100%;
}

.sport-select-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  background: #fff;
  border: 2px solid #e2e8f0;
  border-radius: 10px;
  cursor: pointer;
  transition: all 0.2s ease;
  user-select: none;
  position: relative;
  z-index: 2;
}

.sport-select-trigger:hover {
  border-color: #0e81d9;
  background: #f8fafc;
}

.sport-select.open .sport-select-trigger {
  border-color: #0e81d9;
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
  box-shadow: 0 0 0 3px rgba(14, 129, 217, 0.12);
}

.sport-select-trigger-content {
  display: flex;
  align-items: center;
  gap: 8px;
}

.selected-icon {
  font-size: 16px;
  line-height: 1;
}

.selected-category {
  font-size: 13px;
  color: #1a202c;
  font-weight: 600;
}

.selected-separator {
  color: #cbd5e1;
  font-size: 13px;
}

.selected-option {
  font-size: 13px;
  font-weight: 400;
  color: #64748b;
}

.sport-select-arrow {
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.25s ease;
}

.sport-select.open .sport-select-arrow {
  transform: rotate(180deg);
}

.sport-select-arrow svg {
  width: 12px;
  height: 12px;
  stroke: #64748b;
}

.sport-select-options {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: #fff;
  border: 2px solid #0e81d9;
  border-top: none;
  border-bottom-left-radius: 10px;
  border-bottom-right-radius: 10px;
  max-height: 240px;
  overflow-y: auto;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-10px);
  transition: all 0.25s ease;
  z-index: 1000;
  box-shadow: 0 12px 32px rgba(14, 129, 217, 0.15);
}

.sport-select.open .sport-select-options {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.sport-select-options::-webkit-scrollbar {
  width: 6px;
}

.sport-select-options::-webkit-scrollbar-track {
  background: #f1f5f9;
}

.sport-select-options::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 3px;
}

.option-group:not(:last-child) {
  border-bottom: 1px solid #e2e8f0;
}

.option-group-header {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px 4px;
  font-size: 11px;
  font-weight: 700;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  background: #f8fafc;
  position: sticky;
  top: 0;
  z-index: 1;
}

.option-group-header .group-icon {
  font-size: 14px;
}

.custom-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 12px 6px 32px;
  cursor: pointer;
  transition: all 0.15s ease;
  position: relative;
}

.custom-option > div {
  flex: 1;
  min-width: 0;
  text-align: left;
}

.custom-option::before {
  content: '';
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #cbd5e1;
  transition: all 0.15s ease;
}

.custom-option:hover {
  background: #f0f7ff;
}

.custom-option:hover::before {
  background: #0e81d9;
}

.custom-option.selected {
  background: #e8f4fd;
}

.custom-option.selected::before {
  background: #0e81d9;
  box-shadow: 0 0 0 2px rgba(14, 129, 217, 0.2);
}

.option-title {
  font-size: 12px;
  font-weight: 500;
  color: #1a202c;
  text-align: left;
}

.option-desc {
  font-size: 9px;
  color: #64748b;
  margin-top: 1px;
  text-align: left;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.option-badge {
  font-size: 8px;
  font-weight: 700;
  padding: 2px 0;
  border-radius: 4px;
  text-transform: uppercase;
  margin-left: 8px;
  flex-shrink: 0;
  width: 45px;
  text-align: center;
}

.badge-live {
  background: #10b981;
  color: #fff;
}

.badge-stats {
  background: #8b5cf6;
  color: #fff;
}

.badge-preview {
  background: #f59e0b;
  color: #fff;
}

/* Collapsible sport groups */
.option-group-header {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px 4px;
  font-size: 11px;
  font-weight: 700;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  background: #f8fafc;
  position: sticky;
  top: 0;
  z-index: 1;
  cursor: pointer; /* Add cursor pointer */
  user-select: none; /* Prevent text selection */
}

.option-group-header:hover {
  background: #f1f5f9;
}

/* Collapse/Expand icon */
.group-toggle-icon {
  margin-left: auto;
  transition: transform 0.2s ease;
  font-size: 12px;
  color: #64748b;
}

.option-group.collapsed .group-toggle-icon {
  transform: rotate(-90deg);
}

/* Hide options when collapsed */
.option-group.collapsed .custom-option {
  display: none;
}

/* JSON Modal Expansion Styles */
.json-response-wrapper {
  position: relative;
}

.json-expand-btn {
  position: absolute;
  top: 8px;
  right: 8px;
  background: rgba(255, 255, 255, 0.1);
  border: none;
  color: #fff;
  width: 28px;
  height: 28px;
  border-radius: 4px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease;
  z-index: 5;
}

.json-expand-btn:hover {
  background: rgba(255, 255, 255, 0.2);
}

.json-expand-btn svg {
  width: 16px;
  height: 16px;
}

/* Modal Overlay */
.json-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  z-index: 9998;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.json-modal-overlay.active {
  opacity: 1;
  visibility: visible;
}

/* Modal Container */
.json-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.9);
  width: calc(100% - 60px);
  height: calc(100% - 60px);
  max-width: 1400px;
  max-height: 900px;
  background: #1a1a2e;
  border-radius: 12px;
  z-index: 9999;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease;
  display: flex;
  flex-direction: column;
  box-shadow: 0 25px 80px rgba(0, 0, 0, 0.5);
}

.json-modal.active {
  opacity: 1;
  visibility: visible;
  transform: translate(-50%, -50%) scale(1);
}

/* Modal Header */
.json-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  flex-shrink: 0;
}

.json-modal-title {
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  margin: 0;
  display: flex;
  align-items: center;
  gap: 8px;
}

.json-modal-title svg {
  width: 20px;
  height: 20px;
  color: #4ade80;
}

.json-modal-close {
  background: rgba(255, 255, 255, 0.1);
  border: none;
  color: #fff;
  width: 36px;
  height: 36px;
  border-radius: 6px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease;
}

.json-modal-close:hover {
  background: rgba(255, 255, 255, 0.2);
}

.json-modal-close svg {
  width: 20px;
  height: 20px;
}

/* Modal Body */
.json-modal-body {
  flex: 1;
  overflow: auto;
  padding: 20px;
}

.json-modal-body pre {
  margin: 0;
  font-family: 'Source Code Pro', monospace, monospace;
  font-size: 13px;
  line-height: 1.6;
  color: #e2e8f0;
  white-space: pre-wrap;
  word-break: break-word;
}

/* Scrollbar styling for modal */
.json-modal-body::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}

.json-modal-body::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 5px;
}

.json-modal-body::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 5px;
}

.json-modal-body::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.3);
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .json-modal {
    width: calc(100% - 20px);
    height: calc(100% - 20px);
  }
}
.single-pricing {
    box-shadow: 0 0 10px #eef4ff;
    transition: 0.4s;
    color: #313131;
}

/* Target the column containers of first two pricing cards */
.our-pricing .row .col-lg-4:nth-child(1) .single-pricing,
.our-pricing .row .col-lg-4:nth-child(2) .single-pricing {
    display: flex;
    flex-direction: column;
    min-height: 100%;
}

.our-pricing .row .col-lg-4:nth-child(1) .single-pricing ul,
.our-pricing .row .col-lg-4:nth-child(2) .single-pricing ul {
    flex-grow: 1;
}
.hero-area .row .col-lg-6 > div {
    display: flex;
    flex-direction: column;
    height: 100%;
}

</style>

<style>
/* =============================================
   STATPAL THEME OVERRIDE - Blue Modern Theme
   Paste this in <head> AFTER your style.css link
   ============================================= */

:root {
  --primary: #2563EB;
  --primary-dark: #1E40AF;
  --primary-light: #3B82F6;
  --primary-bg: #EFF6FF;
  --navy: #1E3A8A;
  --radius: 8px;
  --radius-lg: 12px;
}

/* ===========================================
   HERO AREA
   =========================================== */
.hero-area.theme-5::after {
  background: linear-gradient(135deg, var(--primary-dark) 0%, var(--navy) 100%) !important;
}
.hero-area.theme-5 .boxed-btn {
  background: var(--primary-light) !important;
  border-color: var(--primary-light) !important;
}
.hero-area.theme-5 .boxed-btn:hover {
  background: #fff !important;
  color: var(--primary) !important;
}
.hero-area.theme-5 .borderd-btn:hover {
  background: var(--primary-light) !important;
  border-color: var(--primary-light) !important;
}

/* ===========================================
   LOGO
   =========================================== */
.logo a span {
  color: var(--primary-light) !important;
}

/* ===========================================
   "GET LIVE SPORTS DATA IN 3 STEPS"
   & "ADVANTAGES OF OUR SERVICE"
   Both use .service-area.theme-2
   =========================================== */
.service-area.theme-2 {
  background: linear-gradient(135deg, var(--primary-dark) 0%, var(--navy) 100%) !important;
}
.service-area.theme-2 h3,
.service-area.theme-2 h4,
.service-area.theme-2 h5,
.service-area.theme-2 p,
.service-area.theme-2 li,
.service-area.theme-2 .section-title h3,
.service-area.theme-2 .section-title p {
  color: #fff !important;
}
.service-area.theme-2 a {
  color: #fff !important;
}
.service-area.theme-2 .single-services {
  background: rgba(255,255,255,0.1) !important;
}
.service-area.theme-2 .single-services .service-icon i {
  color: #fff !important;
}
.service-area.theme-2 .single-services h4,
.service-area.theme-2 .single-services p {
  color: #fff !important;
}
.service-area.theme-2 .store-btn {
  border-color: #fff !important;
  color: #fff !important;
}
.service-area.theme-2 .store-btn:hover {
  background: var(--primary-light) !important;
  border-color: var(--primary-light) !important;
}

/* Dark "Built to stay up" bar - keep dark navy */
.service-area.theme-2[style*="background:#0b1c32"] {
  background: #0b1c32 !important;
}

/* ===========================================
   FEATURES / SERVICE AREA THEME-5
   =========================================== */
.service-area.theme-5 {
  background: linear-gradient(135deg, var(--primary-dark) 0%, var(--navy) 100%) !important;
}
.service-area.theme-5 .single-services {
  background: rgba(255,255,255,0.1) !important;
}
.service-area.theme-5 .single-services .service-icon i {
  color: #fff !important;
}
.service-area.theme-5 .single-services h4,
.service-area.theme-5 .single-services p {
  color: #fff !important;
}
.service-area.theme-5 .section-title h3,
.service-area.theme-5 .section-title p,
.service-area.theme-5 h3,
.service-area.theme-5 p,
.service-area.theme-5 li {
  color: #fff !important;
}
.service-area.theme-5 a {
  color: #fff !important;
}
.service-area.theme-5 .store-btn {
  border-color: #fff !important;
  color: #fff !important;
}
.service-area.theme-5 .store-btn:hover {
  background: var(--primary-light) !important;
  border-color: var(--primary-light) !important;
}

/* ===========================================
   TESTIMONIALS - Keep white
   =========================================== */
.testmonial-area {
  background: #fff !important;
}

/* ===========================================
   PRICING SECTION
   =========================================== */
.our-pricing.theme-2 {
  background: linear-gradient(135deg, var(--primary-dark) 0%, var(--navy) 100%) !important;
}
.our-pricing.theme-2 .section-title h3,
.our-pricing.theme-2 .section-title p {
  color: #fff !important;
}

/* Pricing cards */
.single-pricing {
  background: #fff !important;
}
.single-pricing .pricing-heading,
.pricing-heading {
  background: var(--primary) !important;
}
.barner-active-recom {
  background: #f59e0b !important;
  color: #fff !important;
}
.single-pricing ul li i {
  color: var(--primary) !important;
}
.single-pricing a {
  color: var(--primary) !important;
}
.single-pricing .boxed-btn:hover {
  background: var(--primary-dark) !important;
  opacity: 0.9;
}

/* Pricing toggle */
.switch-selector {
  background-color: var(--primary) !important;
}
.switch-input:checked + .switch-label-y ~ .switch-selector,
.switch-input:checked + .switch-label-i ~ .switch-selector,
.switch-input:checked + .switch-label-n ~ .switch-selector {
  background-color: var(--primary) !important;
}

/* Pricing table & alert */
.our-pricing .table,
.our-pricing .table th,
.our-pricing .table td {
  color: #fff !important;
  border-color: rgba(255,255,255,0.2) !important;
}
.our-pricing .alert-primary {
  background: rgba(255,255,255,0.15) !important;
  border-color: rgba(255,255,255,0.3) !important;
  color: #fff !important;
}

/* ===========================================
   FAQ SECTION
   =========================================== */
.faq-area,
.faq-area.mobile-apps {
  background: linear-gradient(135deg, var(--primary-dark) 0%, var(--navy) 100%) !important;
}
.faq-area .section-title h3,
.faq-area .section-title p {
  color: #fff !important;
}
.faq-area .nav-link,
.faq-area .tab-btn .nav-link {
  color: #fff !important;
  border-color: rgba(255,255,255,0.2) !important;
  background: transparent !important;
}
.faq-area .nav-link:hover,
.faq-area .nav-link.active,
.faq-area .tab-btn .nav-link:hover,
.faq-area .tab-btn .nav-link.active {
  background: var(--primary-light) !important;
  color: #fff !important;
  border-color: var(--primary-light) !important;
}
.faq-area .tab-list,
.tab-list {
  background: var(--primary-light) !important;
}
.faq-area .tab-list p,
.faq-area .tab-list a,
.tab-list p,
.tab-list a {
  color: #fff !important;
}

/* ===========================================
   CONTACT SECTION
   =========================================== */
.contact-area {
  background: linear-gradient(135deg, var(--primary-dark) 0%, var(--navy) 100%) !important;
}
.contact-area::before,
.contact-area::after {
  display: none !important;
}
.contact-area h3,
.contact-area p {
  color: #fff !important;
}
.contact-area input[type="submit"] {
  background: var(--primary-light) !important;
}
.contact-area input[type="submit"]:hover {
  background: #fff !important;
  color: var(--primary) !important;
}

/* ===========================================
   FOOTER
   =========================================== */
.site-footer,
.site-footer.theme-2 {
  background: var(--navy) !important;
}
.site-footer .widget-title,
.site-footer h4 {
  color: #fff !important;
}
.site-footer p,
.site-footer li,
.site-footer a {
  color: rgba(255,255,255,0.8) !important;
}
.site-footer a:hover {
  color: var(--primary-light) !important;
}
.site-footer .main-footer {
  background: rgba(0,0,0,0.2) !important;
}

/* ===========================================
   CHAT WIDGET
   =========================================== */
.chat-msg-user .chat-bubble {
  background: var(--primary) !important;
}
.chat-msg-assistant .chat-bubble strong {
  color: var(--primary) !important;
}
.chat-followup {
  background: var(--primary-bg) !important;
  border-color: var(--primary) !important;
  color: var(--primary) !important;
}
.chat-followup:hover {
  background: var(--primary) !important;
  color: #fff !important;
}

/* ===========================================
   INLINE STYLE OVERRIDES
   =========================================== */
[style*="background:#e8f5f0"],
[style*="background: #e8f5f0"] {
  background: var(--primary-bg) !important;
}
[style*="border-left:4px solid #1ab394"],
[style*="border-left: 4px solid #1ab394"] {
  border-left-color: var(--primary) !important;
}
[style*="color:#1ab394"],
[style*="color: #1ab394"] {
  color: var(--primary) !important;
}
[style*="border:2px solid #1ab394"],
[style*="border: 2px solid #1ab394"] {
  border-color: var(--primary) !important;
}

/* ===========================================
   MOBILE MENU
   =========================================== */
.offcanvas-menu {
  background: var(--navy) !important;
}
.slicknav_btn {
  background: var(--primary) !important;
}

/* ===========================================
   MISCELLANEOUS
   =========================================== */
.owl-nav div {
  background: var(--primary) !important;
}
.badge-stats {
  background: var(--primary) !important;
}

/* Shadow text animation for chat input */
.chat-input-wrapper {
  position: relative;
}

.chat-shadow-text {
  position: absolute;
  left: 9px;
  right: 9px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 14px;
  font-style: italic;
  color: rgba(0, 0, 0, 0.65);
  pointer-events: none;
  user-select: none;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chat-shadow-text::after {
  content: "|";
  margin-left: 2px;
  animation: shadowBlink 1.2s steps(2, start) infinite;
  opacity: 1;
}

@keyframes shadowBlink {
  0%, 50% { opacity: 1; }
  50.01%, 100% { opacity: 0; }
}

</style>


<!-- ============ Match Context Slider ============ -->
<style>
.ms-section {
  --ms-blue: #2563EB;
  --ms-navy: #1E3A8A;
  --ms-sky: #0284C7;
  --ms-green: #059669;
  --ms-ink: #0F172A;
  --ms-muted: #64748B;
  --ms-line: #E3EAF7;
  --ms-tint: #F5F8FF;
  --ms-red: #EB2564;
  padding: 64px 0 56px;
  background: linear-gradient(180deg, #FFFFFF 0%, #F6F9FF 55%, #EDF2FD 100%);
  border-bottom: 1px solid #E3EAF7;
  color: var(--ms-ink);
}

/* ---- heading ---- */
.ms-head { text-align: center; max-width: 860px; margin: 0 auto 30px; }
.ms-eyebrow {
  display: inline-flex; align-items: center; gap: 7px;
  font-size: 11px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase;
  color: var(--ms-blue); background: #EFF6FF;
  border: 1px solid #D3E2FD; border-radius: 999px; padding: 5px 12px;
}
.ms-eyebrow i {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--ms-green); box-shadow: 0 0 0 3px rgba(5,150,105,.18);
  animation: msPulse 2s ease-in-out infinite;
}
@keyframes msPulse { 50% { opacity: .35; } }

.ms-title {
  margin: 14px 0 10px; font-size: 27px; line-height: 1.28; font-weight: 800;
  color: var(--ms-navy); letter-spacing: -.01em;
}
.ms-sub { margin: 0 auto; max-width: 660px; font-size: 14px; line-height: 1.6; color: var(--ms-muted); }

.ms-endpoints { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 18px; }
.ms-ep {
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 12px; font-weight: 600; padding: 5px 11px;
  border-radius: 999px; border: 1px solid currentColor; background: #fff;
}
.ms-ep::before { content: "GET "; opacity: .45; font-weight: 500; }
.ms-ep--story { color: var(--ms-blue); }
.ms-ep--xi    { color: var(--ms-navy); }
.ms-ep--wx    { color: var(--ms-sky); }
.ms-ep--pred  { color: var(--ms-green); }

/* ---- hero preview pill (links to #match-context) ---- */
.hero-preview-pill{
  display:inline-flex; align-items:center; gap:10px;
  margin:12px 0 6px; padding:7px 14px 7px 8px;
  font-size:14px; font-weight:600; line-height:1.2; color:#eaf4ff;
  text-decoration:none;
  background:rgba(255,255,255,.06);
  border:1px solid rgba(255,255,255,.22);
  border-radius:999px;
  transition:background .18s ease, border-color .18s ease, transform .18s ease;
}
.hero-preview-pill:hover{
  color:#fff; background:rgba(255,255,255,.12);
  border-color:rgba(255,255,255,.4); transform:translateY(-1px);
}
.hero-preview-pill .hpp-badge{
  display:inline-flex; align-items:center; gap:6px;
  padding:3px 10px; border-radius:999px;
  background:#f59e0b; color:#1a1400;
  font-size:11px; font-weight:800; letter-spacing:.06em; text-transform:uppercase;
}
.hero-preview-pill .hpp-badge i{
  width:6px; height:6px; border-radius:50%; background:#1a1400;
  animation:hppPulse 1.8s ease-in-out infinite;
}
@keyframes hppPulse{ 50%{ opacity:.25; } }
.hero-preview-pill .hpp-arrow{ font-weight:700; opacity:.8; transition:transform .18s ease; }
.hero-preview-pill:hover .hpp-arrow{ transform:translateX(3px); opacity:1; }

@media (max-width:520px){
  .hero-preview-pill{ font-size:13px; gap:8px; }
  .hero-preview-pill .hpp-label{ white-space:normal; }
}

/* ---- slider shell ---- */
.ms-slider { position: relative; }
.ms-track { display: grid; }
.ms-slide {
  grid-area: 1 / 1;
  opacity: 0; visibility: hidden; pointer-events: none;
  transform: translateY(6px);
  transition: opacity .45s ease, transform .45s ease;
  background: #fff;
  border: 1px solid var(--ms-line);
  border-radius: 14px;
  box-shadow: 0 12px 34px rgba(30,58,138,.09);
  overflow: hidden;
}
.ms-slide.is-active { opacity: 1; visibility: visible; pointer-events: auto; transform: none; }

/* ---- slide header ---- */
.ms-slide-top {
  display: flex; align-items: center; justify-content: space-between; gap: 18px;
  padding: 15px 20px;
  background: linear-gradient(120deg, var(--ms-navy) 0%, #1D4ED8 100%);
  color: #fff;
}
.ms-league {
  display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: .07em;
  text-transform: uppercase; color: #BFDBFE;
  background: rgba(255,255,255,.12); border-radius: 4px; padding: 3px 8px;
}
.ms-teams { margin: 7px 0 6px; font-size: 20px; font-weight: 800; color: #fff; line-height: 1.2; }
.ms-teams em { font-style: normal; font-weight: 500; opacity: .5; margin: 0 6px; font-size: 15px; }
.ms-facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 14px; }
.ms-facts li {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 12px; color: #DBEAFE; line-height: 1;
}
.ms-facts svg { width: 13px; height: 13px; opacity: .75; flex-shrink: 0; }
.ms-neutral {
  font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em;
  background: rgba(255,255,255,.16); border-radius: 3px; padding: 3px 6px; color: #fff;
}

/* ---- weather chip in the header ---- */
.ms-wx { display: flex; align-items: center; gap: 13px; flex-shrink: 0; }
.ms-wx-icon { width: 42px; height: 42px; color: #FDE68A; flex-shrink: 0; }
.ms-wx-icon svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.ms-wx-temp { font-size: 25px; font-weight: 800; line-height: 1; letter-spacing: -.02em; }
.ms-wx-temp small { font-size: 11px; font-weight: 600; opacity: .6; margin-left: 3px; }
.ms-wx-cond { font-size: 11px; color: #DBEAFE; margin-top: 4px; white-space: nowrap; }
.ms-wx-stats { display: flex; gap: 12px; padding-left: 13px; border-left: 1px solid rgba(255,255,255,.2); }
.ms-wx-stat { text-align: center; }
.ms-wx-stat b { display: block; font-size: 13px; font-weight: 700; }
.ms-wx-stat span { font-size: 9px; text-transform: uppercase; letter-spacing: .05em; color: #93C5FD; }

/* ---- slide body ---- */
.ms-grid {
  display: grid;
  grid-template-columns: 5fr 4fr 3fr;
  gap: 1px;
  background: var(--ms-line);
}
.ms-pane { background: #fff; padding: 16px 18px; min-width: 0; }
.ms-pane-head {
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
  margin-bottom: 12px; padding-bottom: 9px; border-bottom: 1px solid #F1F5FC; line-height: 14px;
}
.ms-pane-title {
  display: inline-flex; align-items: center; gap: 7px;
  font-size: 11px; font-weight: 800; letter-spacing: .07em; text-transform: uppercase;
}
.ms-pane-title::before { content: ""; width: 3px; height: 13px; border-radius: 2px; background: currentColor; }
.ms-pane--story .ms-pane-title { color: var(--ms-blue); }
.ms-pane--xi .ms-pane-title    { color: var(--ms-navy); }
.ms-pane--pred .ms-pane-title  { color: var(--ms-green); }
.ms-pane-note { font-size: 12px; color: var(--ms-red); font-weight: 600; }

/* ---- storylines ---- */
.ms-stories { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
.ms-story {
  background: var(--ms-tint); border: 1px solid #E8EEFB; border-left: 3px solid var(--ms-blue);
  border-radius: 7px; padding: 9px 11px;
}

.ms-stories-more {
  margin: 12px 0 0;
  font-size: 14.5px;
  font-weight: 700;
  color: var(--ms-blue);
}

.ms-story--quote { background: #F0FDF9; border-color: #D3F0E5; border-left-color: var(--ms-green); }
.ms-story-tag {
  display: inline-block; font-size: 9px; font-weight: 700; letter-spacing: .06em;
  text-transform: uppercase; color: var(--ms-muted); margin-bottom: 4px;
}
.ms-story--quote .ms-story-tag { color: var(--ms-green); }
.ms-story-text {
  margin: 0; font-size: 12.5px; line-height: 1.5; color: #1E293B;
  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
}
.ms-story--quote .ms-story-text { font-style: italic; }
.ms-story-meta {
  display: block; margin-top: 5px; font-size: 12px; font-weight: 700;
  color: var(--ms-muted);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* context line — sits under the speaker, quieter + hairline rule */
.ms-story-context {
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden;
  margin-top: 3px; padding-left: 7px;
  border-left: 2px solid #E2E8F0;
  font-size: 11.5px; line-height: 1.4; font-weight: 500; font-style: normal;
  color: #94A3B8;
}
.ms-story--quote .ms-story-context { border-left-color: #BFE6D6; color: #6E9B8B; }

/* ---- lineups ---- */
.ms-xi-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.ms-xi-team { min-width: 0; }
.ms-xi-name {
  font-size: 12px; font-weight: 800; color: var(--ms-navy);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ms-xi-sub { font-size: 10px; color: var(--ms-muted); margin: 2px 0 8px; }
.ms-xi-form {
  display: inline-block; font-family: ui-monospace, Menlo, Consolas, monospace;
  font-size: 10px; font-weight: 700; color: var(--ms-blue);
  background: #EFF6FF; border-radius: 3px; padding: 1px 5px; margin-right: 5px;
}
.ms-xi { list-style: none; margin: 0; padding: 0; }
.ms-xi li {
  display: flex; align-items: center; gap: 6px;
  font-size: 11.5px; line-height: 1.75; color: #334155; min-width: 0;
}
.ms-xi-num {
  flex-shrink: 0; width: 17px; text-align: center;
  font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 9.5px; font-weight: 700;
  color: var(--ms-muted); background: #F1F5F9; border-radius: 3px;
}
.ms-xi-player { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ms-xi li.is-gk .ms-xi-num { background: #FEF3C7; color: #B45309; }
.ms-xi-out {
  margin-top: 8px; padding-top: 7px; border-top: 1px dashed #E2E8F0;
  font-size: 10px; color: #B91C1C; line-height: 1.4;
}
.ms-xi-out b { font-weight: 700; }

/* ---- prediction ---- */
.ms-pred-pick {
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
  background: linear-gradient(120deg, #ECFDF5 0%, #F0FDFA 100%);
  border: 1px solid #C6EEDD; border-radius: 8px; padding: 10px 12px;
}
.ms-pred-choice { font-size: 14px; font-weight: 800; color: #065F46; line-height: 1.25; }
.ms-pred-label { font-size: 9px; text-transform: uppercase; letter-spacing: .06em; color: #059669; font-weight: 700; }
.ms-pred-odd {
  flex-shrink: 0; text-align: center; background: #059669; color: #fff;
  border-radius: 6px; padding: 5px 9px;
}
.ms-pred-odd b { display: block; font-size: 14px; font-weight: 800; line-height: 1; }
.ms-pred-odd span { font-size: 8px; text-transform: uppercase; letter-spacing: .05em; opacity: .85; }
.ms-pred-why {
  margin: 10px 0 0; font-size: 11.5px; line-height: 1.55; color: #475569;
  display: -webkit-box; -webkit-line-clamp: 7; -webkit-box-orient: vertical; overflow: hidden;
}

/* ---- controls ---- */
.ms-controls { display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 22px; }
.ms-arrow {
  width: 34px; height: 34px; border-radius: 50%; border: 1px solid #D3E2FD;
  background: #fff; color: var(--ms-blue); cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background .2s ease, color .2s ease, transform .2s ease;
}
.ms-arrow:hover { background: var(--ms-blue); color: #fff; transform: translateY(-1px); }
.ms-arrow svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
.ms-dots { display: flex; gap: 7px; }
.ms-dot {
  width: 8px; height: 8px; padding: 0; border: 0; border-radius: 50%;
  background: #C7D6F0; cursor: pointer; transition: width .25s ease, background .25s ease;
}
.ms-dot.is-active { width: 24px; border-radius: 4px; background: var(--ms-blue); }

/* ---- theme isolation ----
   style.css / base.html style bare `header`, `h2`, `h3`, `ul` and `article`
   selectors globally. Pin the properties that matter so nothing leaks in. */
.ms-section .ms-slide,
.ms-section .ms-slide-top,
.ms-section .ms-pane {
  position: static;
  float: none;
  margin: 0;
}
.ms-section .ms-slide-top { width: auto; top: auto; left: auto; right: auto; }
.ms-section .ms-slide { grid-area: 1 / 1; }   /* re-assert after the reset above */
.ms-section h2,
.ms-section h3 { text-transform: none; }
.ms-section ul { list-style: none; margin: 0; padding: 0; }
.ms-section ul li { margin: 0; }
.ms-section ul li::before { content: none; }

/* ---- responsive ---- */

/* tablet: prediction drops beside lineups, storylines take the full width */
@media (max-width: 1199px) {
  .ms-grid { grid-template-columns: 1fr 1fr; }
  .ms-pane--story { grid-column: 1 / -1; }
  .ms-stories { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; }
  .ms-wx-stats { gap: 9px; }
}

@media (max-width: 991px) {
  .ms-title { font-size: 23px; }
  .ms-slide-top { flex-wrap: wrap; gap: 14px; }
  .ms-fixture { flex: 1 1 260px; min-width: 0; }
  .ms-wx { flex: 0 1 auto; }
  .ms-stories { grid-template-columns: 1fr 1fr; }
  .ms-stories .ms-story:nth-child(3) { grid-column: 1 / -1; }
}

/* phone: everything stacks, weather becomes a full-width strip */
@media (max-width: 767px) {
  .ms-section { padding: 42px 0 36px; }
  .ms-head { margin-bottom: 22px; }
  .ms-title { font-size: 20px; }
  .ms-sub { font-size: 13px; }
  .ms-ep { font-size: 11px; padding: 4px 9px; }

  .ms-slide-top { flex-direction: column; align-items: stretch; gap: 12px; padding: 14px 15px; }
  .ms-fixture   { flex: 0 0 auto; }   /* cancel the row-layout `flex: 1 1 260px`; in a column that 260px became a min-height, opening the blue gap */
  .ms-teams { font-size: 18px; }
  .ms-facts { gap: 10px; }
  .ms-facts li { font-size: 11px; }

  .ms-wx {
    justify-content: space-between;
    padding-top: 11px;
    border-top: 1px solid rgba(255,255,255,.18);
  }
  .ms-wx-stats {
    flex: 1;
    justify-content: space-around;
    padding-left: 0;
    border-left: 0;
  }
  .ms-wx-icon { width: 34px; height: 34px; }
  .ms-wx-temp { font-size: 21px; }

  .ms-grid { grid-template-columns: 1fr; }
  .ms-pane { padding: 14px 15px; }
  .ms-stories { grid-template-columns: 1fr; }
  .ms-stories .ms-story:nth-child(3) { grid-column: auto; }
  .ms-story-text { -webkit-line-clamp: 4; }
  .ms-pred-why { -webkit-line-clamp: 4; }
  .ms-controls { margin-top: 18px; }
}

/* small phone: tighten the XI so two teams still fit side by side */
@media (max-width: 480px) {
  .ms-title { font-size: 18px; }
  .ms-teams { font-size: 16px; }
  .ms-teams em { margin: 0 4px; }
  .ms-endpoints { gap: 6px; }
  .ms-ep { font-size: 10px; padding: 3px 7px; }
  .ms-ep::before { content: none; }

  .ms-wx-temp { font-size: 19px; }
  .ms-wx-temp small { display: block; margin: 2px 0 0; font-size: 10px; }
  .ms-wx-stats { gap: 4px; }
  .ms-wx-stat b { font-size: 12px; }
  .ms-wx-stat span { font-size: 8px; }

  .ms-xi-wrap { gap: 9px; }
  .ms-xi li { font-size: 10.5px; line-height: 1.7; gap: 4px; }
  .ms-xi-num { width: 15px; font-size: 9px; }
  .ms-xi-name { font-size: 11px; }
  .ms-xi-sub { font-size: 9px; }
  .ms-story-text { font-size: 12px; }
}

@media (prefers-reduced-motion: reduce) {
  .ms-slide { transition: none; }
  .ms-eyebrow i { animation: none; }
}
</style>


        

        <style>
        	/* World Cup Banner */
			.wc-banner {
			  position: relative;
			  z-index: 9999;
			  background: linear-gradient(135deg, #059669 0%, #10b981 100%);
			  color: white;
			  padding: 10px 20px;
			  box-shadow: 0 2px 6px rgba(0,0,0,0.15);
			  border-bottom: 2px solid rgba(255,255,255,0.2);
			  transition: all 0.3s ease;
			  max-height: 60px;
			  overflow: hidden;
			}

			.wc-banner.hidden {
			  display: none;
			}

			/* Push header/nav down when banner is visible */
			body:not(.wc-banner-hidden) header,
			body:not(.wc-banner-hidden) .header,
			body:not(.wc-banner-hidden) nav,
			body:not(.wc-banner-hidden) .navbar {
			  margin-top: 44px;
			}

			/* Remove margin when banner is closed */
			body.wc-banner-hidden header,
			body.wc-banner-hidden .header,
			body.wc-banner-hidden nav,
			body.wc-banner-hidden .navbar {
			  margin-top: 0;
			  transition: margin-top 0.3s ease;
			}

			.wc-banner-content {
			  max-width: 1400px;
			  margin: 0 auto;
			  display: flex;
			  align-items: center;
			  gap: 12px;
			}

			.wc-banner-close {
			  background: rgba(255,255,255,0.25);
			  border: none;
			  color: white;
			  width: 24px;
			  height: 24px;
			  border-radius: 4px;
			  cursor: pointer;
			  display: flex;
			  align-items: center;
			  justify-content: center;
			  flex-shrink: 0;
			  transition: background 0.2s ease;
			}

			.wc-banner-close:hover {
			  background: rgba(255,255,255,0.4);
			}

			.wc-banner-icon {
			  flex-shrink: 0;
			}

			.wc-banner-text {
			  flex: 1;
			  display: flex;
			  align-items: center;
			  gap: 10px;
			  flex-wrap: wrap;
			}

			.wc-banner-title {
			  font-size: 14px;
			  font-weight: 700;
			  white-space: nowrap;
			}

			.wc-banner-divider {
			  color: rgba(255,255,255,0.5);
			  font-size: 14px;
			}

			.wc-banner-desc {
			  font-size: 12px;
			  opacity: 0.95;
			  line-height: 1.4;
			}

			/* Mobile optimizations */
			@media (max-width: 768px) {
			  .wc-banner {
			    padding: 8px 12px;
			    max-height: 80px;
			  }
			  
			  .wc-banner-content {
			    gap: 8px;
			  }
			  
			  .wc-banner-close {
			    width: 22px;
			    height: 22px;
			  }
			  
			  .wc-banner-icon {
			    width: 20px;
			    height: 20px;
			  }
			  
			  .wc-banner-text {
			    flex-direction: column;
			    align-items: flex-start;
			    gap: 2px;
			  }
			  
			  .wc-banner-divider {
			    display: none;
			  }
			  
			  .wc-banner-title {
			    font-size: 12px;
			    white-space: normal;
			    line-height: 1.3;
			  }
			  
			  .wc-banner-desc {
			    font-size: 10px;
			    line-height: 1.3;
			  }
			  
			  body:not(.wc-banner-hidden) header,
