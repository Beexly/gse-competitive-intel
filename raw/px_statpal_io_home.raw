			<script>
  (function () {
    // Demo API Configuration
    var DEMO_KEY = 'b5b07a3f-b019-4a18-8969-6045169feda9';

    var demoEndpoints = {
      soccer: 'https://statpal.io/api/v2/soccer/matches/live',
      soccer_storylines: 'https://statpal.io/api/v2/soccer/live-storylines',
      soccer_lineups: 'https://statpal.io/api/v2/soccer/team-lineups',
      soccer_weather: 'https://statpal.io/api/v2/soccer/weather-forecast',
      soccer_predictions: 'https://statpal.io/api/v2/soccer/predictions',
      soccer_live_stats: 'https://statpal.io/api/v2/soccer/leagues/3037/matches/stats',
      soccer_season_list: 'https://statpal.io/api/v2/soccer/leagues/seasons',
      soccer_head_to_head: 'https://statpal.io/api/v2/soccer/head-to-head',
      soccer_injuries: 'https://statpal.io/api/v2/soccer/injuries-suspensions',
      soccer_teams: 'https://statpal.io/api/v2/soccer/teams/2341082',
      soccer_players: 'https://statpal.io/api/v2/soccer/players/2891848',
      soccer_standings: 'https://statpal.io/api/v2/soccer/leagues/3037/standings',
      soccer_prematch_odds: 'https://statpal.io/api/v2/soccer/leagues/3037/odds/prematch',
      soccer_live_odds: 'https://statpal.io/api/v2/soccer/odds/live',
      nba: 'https://statpal.io/api/v1/nba/livescores',
      nba_standings: 'https://statpal.io/api/v1/nba/standings',
      nba_rosters: 'https://statpal.io/api/v1/nba/rosters/orl',
      nba_team_stats: 'https://statpal.io/api/v1/nba/team-stats/orl',
      nba_team_injuries: 'https://statpal.io/api/v1/nba/injuries/orl',
      nba_odds: 'https://statpal.io/api/v1/nba/odds',
      nfl: 'https://statpal.io/api/v1/nfl/livescores',
      nfl_live_plays: 'https://statpal.io/api/v1/nfl/live-plays',
      nfl_schedule_results: 'https://statpal.io/api/v1/nfl/season-schedule',
      nfl_standings: 'https://statpal.io/api/v1/nfl/standings',
      nfl_rosters: 'https://statpal.io/api/v1/nfl/rosters/sea',
      nfl_injuries: 'https://statpal.io/api/v1/nfl/injuries/sea',
      nfl_team_stats: 'https://statpal.io/api/v1/nfl/team-stats/sea',
      nfl_player_stats: 'https://statpal.io/api/v1/nfl/player-stats/sea',
      nfl_odds: 'https://statpal.io/api/v1/nfl/odds',
      mlb: 'https://statpal.io/api/v1/mlb/livescores',
      mlb_schedule_results: 'https://statpal.io/api/v1/mlb/season-schedule',
      mlb_standings: 'https://statpal.io/api/v1/mlb/standings',
      mlb_rosters: 'https://statpal.io/api/v1/mlb/rosters/atl',
      mlb_team_stats: 'https://statpal.io/api/v1/mlb/team-stats/atl',
      mlb_injuries: 'https://statpal.io/api/v1/mlb/injuries/atl',
      mlb_league_stats: 'https://statpal.io/api/v1/mlb/league-stats/mlb_player_batting',
      mlb_odds: 'https://statpal.io/api/v1/mlb/odds',
      nhl: 'https://statpal.io/api/v1/nhl/livescores',
      nhl_schedule_results: 'https://statpal.io/api/v1/nhl/season-schedule',
      nhl_standings: 'https://statpal.io/api/v1/nhl/standings',
      nhl_rosters: 'https://statpal.io/api/v1/nhl/rosters/edm',
      nhl_team_stats: 'https://statpal.io/api/v1/nhl/team-stats/edm',
      nhl_injuries: 'https://statpal.io/api/v1/nhl/injuries/edm',
      nhl_odds: 'https://statpal.io/api/v1/nhl/livescores',
      cricket: 'https://statpal.io/api/v1/cricket/livescores',
      cricket_schedule: 'https://statpal.io/api/v1/cricket/upcoming-schedule',
      cricket_tournament_list: 'https://statpal.io/api/v1/cricket/tour-list',
      cricket_tournament_matches: 'https://statpal.io/api/v1/cricket/season-schedule/intl/5667',
      cricket_tables: 'https://statpal.io/api/v1/cricket/tables/intl/5667',
      cricket_squads: 'https://statpal.io/api/v1/cricket/squads/intl/5667',
      cricket_odds: 'https://statpal.io/api/v1/cricket/odds',
      horse_racing: 'https://statpal.io/api/v1/horse-racing/live/uk',
      horse_racing_schedule: 'https://statpal.io/api/v1/horse-racing/schedule/uk',
      tennis: 'https://statpal.io/api/v1/tennis/livescores',
      tennis_livestats: 'https://statpal.io/api/v1/tennis/livestats',
      tennis_tournament_list: 'https://statpal.io/api/v1/tennis/tournament-list/atp',
      tennis_tournament_matches: 'https://statpal.io/api/v1/tennis/tournament/49679',
      tennis_standings: 'https://statpal.io/api/v1/tennis/standings/atp',
      tennis_odds: 'https://statpal.io/api/v1/tennis/odds',
      esports: 'https://statpal.io/api/v1/esports/livescores',
      f1: 'https://statpal.io/api/v1/f1/livescores',
      handball: 'https://statpal.io/api/v1/handball/livescores',
      volleyball: 'https://statpal.io/api/v1/volleyball/livescores',
      golf: 'https://statpal.io/api/v1/golf/livescores'
    };

    // Preview endpoints that take a match_id query parameter
    var MATCH_ID_ENDPOINTS = ['soccer_storylines', 'soccer_lineups', 'soccer_weather', 'soccer_predictions'];

    // Backup IDs — only used if no next-day matches are rendered on the page
    var FALLBACK_MATCH_IDS = ['2341082'];

    // Prefer the match IDs already shown in the slider; fall back if none are present
    function demoMatchIdPool() {
      var ids = [];
      var nodes = document.querySelectorAll('#msSlider .ms-slide[data-match-id]');
      Array.prototype.slice.call(nodes).forEach(function (el) {
        var id = el.getAttribute('data-match-id');
        if (id) ids.push(id);
      });
      return ids.length ? ids : FALLBACK_MATCH_IDS.slice();
    }

    // Pick one random ID per preview endpoint at load (independently, so they can differ)
    var demoMatchIds = {};
    (function () {
      var pool = demoMatchIdPool();
      MATCH_ID_ENDPOINTS.forEach(function (key) {
        demoMatchIds[key] = pool[Math.floor(Math.random() * pool.length)];
      });
    })();

    function buildDemoUrl(sport) {
      var base = demoEndpoints[sport];
      if (!base) return null;

      if (sport === 'soccer_head_to_head') {
        return base + '?access_key=' + encodeURIComponent(DEMO_KEY) + '&team1_id=' + encodeURIComponent('2341082') + '&team2_id=' + encodeURIComponent('2341239');
      } else if (sport === 'soccer_storylines') {
        return base + '?access_key=' + encodeURIComponent(DEMO_KEY) + '&match_id=' + encodeURIComponent(demoMatchIds[sport]);
      } else if (sport === 'soccer_lineups') {
        return base + '?access_key=' + encodeURIComponent(DEMO_KEY) + '&match_id=' + encodeURIComponent(demoMatchIds[sport]);
      }  else if (sport === 'soccer_weather') {
        return base + '?access_key=' + encodeURIComponent(DEMO_KEY) + '&match_id=' + encodeURIComponent(demoMatchIds[sport]);
      }  else if (sport === 'soccer_predictions') {
        return base + '?access_key=' + encodeURIComponent(DEMO_KEY) + '&match_id=' + encodeURIComponent(demoMatchIds[sport]);
      } else {
        return base + '?access_key=' + encodeURIComponent(DEMO_KEY);
      }
      
    }

   

    // Custom Select Component
    var select = document.getElementById('demo-sport');
    var trigger = select.querySelector('.sport-select-trigger');
    var options = select.querySelectorAll('.custom-option');
    var selectedIcon = select.querySelector('.selected-icon');
    var selectedCategory = select.querySelector('.selected-category');
    var selectedOption = select.querySelector('.selected-option');
    var runDemoBtn = document.getElementById('run-demo');
    var responsePre = document.getElementById('demo-response');

    var currentValue = 'soccer';

    // Toggle dropdown
    trigger.addEventListener('click', function(e) {
      e.stopPropagation();
      select.classList.toggle('open');
    });

    // Close on outside click
    document.addEventListener('click', function(e) {
      if (!select.contains(e.target)) {
        select.classList.remove('open');
      }
    });

    // Close on escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        select.classList.remove('open');
      }
    });

    // Option selection
    options.forEach(function(option) {
      option.addEventListener('click', function() {
        options.forEach(function(opt) { opt.classList.remove('selected'); });
        this.classList.add('selected');

        currentValue = this.dataset.value;
        selectedIcon.textContent = this.dataset.icon;
        selectedCategory.textContent = this.dataset.category;
        selectedOption.textContent = this.querySelector('.option-title').textContent;

        select.classList.remove('open');
      });
    });

    // Demo button functionality
    function setLoading(isLoading) {
      if (isLoading) {
        runDemoBtn.disabled = true;
        runDemoBtn.textContent = 'Loading...';
      } else {
        runDemoBtn.disabled = false;
        runDemoBtn.innerHTML = '▶ Run Live Demo';
      }
    }

    runDemoBtn.addEventListener('click', function() {
      var url = buildDemoUrl(currentValue);

      if (!url) {
        responsePre.textContent = 'No demo endpoint configured for this sport.';
        return;
      }

      setLoading(true);
      responsePre.textContent = 'Fetching live data...';

      fetch(url, { method: 'GET', headers: { 'Accept': 'application/json' } })
        .then(function(res) {
          if (!res.ok) {
            throw new Error('HTTP ' + res.status + ' ' + res.statusText);
          }
          return res.json();
        })
        .then(function(data) {
          var jsonStr = JSON.stringify(data, null, 2);
          var lines = jsonStr.split('\n');
          var maxLines = 1500;
          
          if (lines.length > maxLines) {
            var truncated = lines.slice(0, maxLines).join('\n');
            truncated += '\n\n... [Response truncated - showing first ' + maxLines + ' of ' + lines.length + ' lines] ...';
            responsePre.textContent = truncated;
          } else {
            responsePre.textContent = jsonStr;
          }
        })
        .catch(function(err) {
          responsePre.textContent = 'Error fetching demo data:\n' + err.message +
            '\n\nThis may be due to rate limits or temporary issues. Please try again in a moment.';
        })
        .finally(function() {
          setLoading(false);
        });
    });
  })();

  // JSON Modal Expansion Functionality
(function() {
  var expandBtn = document.getElementById('json-expand-btn');
  var modalOverlay = document.getElementById('json-modal-overlay');
  var modal = document.getElementById('json-modal');
  var modalClose = document.getElementById('json-modal-close');
  var modalContent = document.getElementById('json-modal-content');
  var responsePre = document.getElementById('demo-response');

  function openModal() {
    modalContent.textContent = responsePre.textContent;
    modalOverlay.classList.add('active');
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modalOverlay.classList.remove('active');
    modal.classList.remove('active');
    document.body.style.overflow = '';
  }

  expandBtn.addEventListener('click', openModal);
  modalClose.addEventListener('click', closeModal);
  modalOverlay.addEventListener('click', closeModal);

  // Close on Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal.classList.contains('active')) {
      closeModal();
    }
  });

  // Prevent modal content click from closing
  modal.addEventListener('click', function(e) {
    e.stopPropagation();
  });
})();

// Sport Group Collapse/Expand Functionality
(function() {
  var groupHeaders = document.querySelectorAll('.option-group-header');
  
  groupHeaders.forEach(function(header) {
    header.addEventListener('click', function(e) {
      e.stopPropagation(); // Prevent dropdown from closing
      
      var optionGroup = this.closest('.option-group');
      optionGroup.classList.toggle('collapsed');
    });
  });
})();
</script>

			<script>
$(document).ready(function(){
  const ChatWidget={
    config:{baseUrl:'/chat',storageKey:'statpal_chat_session',maxRetries:2},
    state:{clientSessionId:null,serverSessionId:null,isWaiting:false,lastFailed:null},
    el:{messages:$('#chatMessages'),input:$('#chatInput'),sendBtn:$('#chatSendBtn'),quickBtns:$('.quick-action-btn'),welcome:$('#welcomeMessage')},
    
    init:function(){
      this.initSession();
      this.bindEvents();
      if(this.state.clientSessionId)this.startServer();
    },
    
    initSession:function(){
      let s=localStorage.getItem(this.config.storageKey);
      if(s){try{let d=JSON.parse(s);if(d.clientId&&Date.now()-d.created<864e5){this.state.clientSessionId=d.clientId;this.state.serverSessionId=d.serverId||null;return}}catch(e){}}
      this.state.clientSessionId='sess_'+Date.now()+'_'+Math.random().toString(36).substr(2,9);
      this.saveSession();
    },
    
    saveSession:function(){try{localStorage.setItem(this.config.storageKey,JSON.stringify({clientId:this.state.clientSessionId,serverId:this.state.serverSessionId,created:Date.now()}))}catch(e){}},
    
    startServer:async function(){
      if(!this.state.clientSessionId)return;
      try{
        let r=await this.api('/session/start/',{client_session_id:this.state.clientSessionId,referrer_url:document.referrer||'',landing_page:window.location.href});
        if(r.success){this.state.serverSessionId=r.session_id;this.saveSession();if(!r.is_new&&r.message_count>0)await this.loadHistory()}
      }catch(e){console.error('Session error:',e)}
    },
    
    loadHistory:async function(){
      if(!this.state.serverSessionId)return;
      try{
        let r=await fetch(this.config.baseUrl+'/session/'+this.state.serverSessionId+'/history/',{method:'GET',headers:{'Accept':'application/json'}});
        let d=await r.json();
        if(d.success&&d.messages&&d.messages.length>0){this.el.welcome.hide();this.el.messages.show();d.messages.forEach(m=>this.addMsg(m.role,m.content,null,false));this.scroll()}
      }catch(e){}
    },
    
    bindEvents:function(){
      let self=this;
      this.el.sendBtn.on('click',function(){self.send()});
      this.el.input.on('keydown',function(e){if(e.key==='Enter'){e.preventDefault();self.send()}});
      this.el.quickBtns.on('click',function(){self.send($(this).data('query'),'quick_action')});
    },
    
    api:async function(endpoint,data,retry=0){
      let url=this.config.baseUrl+endpoint;
      try{
        let r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json','X-CSRFToken':this.csrf()},body:JSON.stringify(data)});
        let res=await r.json();
        if(!r.ok)throw new Error(res.error||'HTTP '+r.status);
        return res;
      }catch(e){if(retry<this.config.maxRetries){await new Promise(r=>setTimeout(r,1000));return this.api(endpoint,data,retry+1)}throw e}
    },
    
    csrf:function(){let c=document.cookie.match(/csrftoken=([^;]+)/);return c?c[1]:null},
    
    send:async function(predef,trigger='typed'){
      if(this.state.isWaiting)return;
      let msg=predef||this.el.input.val().trim();
      if(!msg)return;
      
      this.el.welcome.hide();
      this.el.messages.show();
      this.el.input.val('');
      $('.chat-error').remove();
      
      this.addMsg('user',msg);
			this.setWaiting(true);
			this.showTyping();
			      
      if(!this.state.serverSessionId){try{await this.startServer()}catch(e){this.showError('Failed to connect.',msg,trigger);return}}
      if(!this.state.serverSessionId){this.showError('Session failed. Please refresh.',msg,trigger);return}
      
      try{
        let r=await this.api('/message/',{session_id:this.state.serverSessionId,message:msg,trigger_type:trigger});
        this.hideTyping();
        if(r.success){this.addMsg('assistant',r.message,r.followups);this.state.lastFailed=null}
        else this.showError(r.error||'Error occurred.',msg,trigger);
      }catch(e){console.error(e);this.showError('Failed to get response.',msg,trigger)}
      this.setWaiting(false);
    },
    
    showError:function(err,msg,trigger){
      this.hideTyping();
      this.state.lastFailed={msg:msg,trigger:trigger};
      this.el.messages.append('<div class="chat-error">⚠️ '+this.esc(err)+'<button onclick="ChatWidget.retry()">Retry</button></div>');
      this.scroll();
      this.setWaiting(false);
    },
    
    retry:function(){if(this.state.lastFailed){$('.chat-error').remove();this.send(this.state.lastFailed.msg,this.state.lastFailed.trigger)}},
    
    addMsg:function(role,content,followups,anim=true){
  let h='';
  if(role==='user'){
    h='<div class="chat-msg chat-msg-user"'+(anim?'':' style="animation:none"')+'><div class="chat-bubble">'+this.esc(content)+'</div></div>';
  }else{
    let f='';
    if(followups&&followups.length)f='<div style="margin-top:6px">'+followups.map(x=>'<button class="chat-followup" data-f="'+this.esc(x)+'">'+this.esc(x)+'</button>').join('')+'</div>';
    h='<div class="chat-msg chat-msg-assistant"'+(anim?'':' style="animation:none"')+'><div class="chat-bubble">'+this.fmt(content)+'</div>'+f+'</div>';
  }
  let newMsg=$(h);
  this.el.messages.append(newMsg);
  
  if(role==='assistant'){
    let self=this;
    setTimeout(function(){
      let container=self.el.messages[0];
      let allUserMsgs=container.querySelectorAll('.chat-msg-user');
      if(allUserMsgs.length>0){
        let lastUser=allUserMsgs[allUserMsgs.length-1];
        let scrollPos=lastUser.offsetTop-container.offsetTop;
        container.scrollTop=scrollPos;
      }
    },50);
  }else{
    this.scroll();
  }
  if(followups&&followups.length)this.bindFollowups();
  return newMsg;
},
    
    fmt:function(c){let f=this.esc(c);f=f.replace(/\*\*(.*?)\*\*/g,'<strong>$1</strong>');f=f.replace(/\n/g,'<br>');return f},
    
    showTyping:function(){this.el.messages.append('<div id="chatTyping" class="chat-msg chat-msg-assistant"><div class="chat-bubble"><span class="chat-typing"><span></span><span></span><span></span></span></div></div>');this.scroll()},
    
    hideTyping:function(){$('#chatTyping').remove()},
    
    setWaiting:function(w){this.state.isWaiting=w;this.el.input.prop('disabled',w);this.el.sendBtn.prop('disabled',w);this.el.quickBtns.prop('disabled',w)},
    
    scroll:function(){let c=this.el.messages[0];c.scrollTop=c.scrollHeight},

    scrollToElement:function(el){let c=this.el.messages[0];c.scrollTop=el[0].offsetTop},
    
    esc:function(s){let d=document.createElement('div');d.textContent=s;return d.innerHTML},
    
    bindFollowups:function(){let self=this;$('.chat-followup').off('click').on('click',function(){self.send($(this).data('f'),'followup')})}
  };
  
  ChatWidget.init();
  window.ChatWidget=ChatWidget;
});

// Shadow text typing animation
(function() {
  const exampleQuestions = [
    "Do you have live Premier League scores and standings?",
    "What NBA player stats and box scores are available?",
    "Can I get real-time NFL play-by-play data?",
    "Do you cover Champions League fixtures and results?",
    "What betting odds and markets do you provide?",
    "Is historical MLB data included in the API?",
    "Do you have live tennis scores for ATP and WTA?",
    "What cricket formats do you cover - Tests, ODIs, T20s?",
    "Can I access NHL game events and player statistics?",
    "Do you offer La Liga and Serie A match data?",
    "What's included in the 14-day free trial?",
    "How many soccer leagues are covered worldwide?",
    "Do you have Formula One race results and standings?",
    "Can I get live scores with 5-15 second latency?",
    "What golf tournaments and leaderboards do you cover?"
  ];

  const shadowEl = document.getElementById('chatShadowText');
  const inputEl = document.getElementById('chatInput');

  if (!shadowEl || !inputEl) return;

  let currentIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  let typingTimeout = null;
  let userHasInteracted = false;

  const typingSpeed = 55;
  const deletingSpeed = 35;
  const pauseAfterTyping = 1000;
  const pauseAfterDeleting = 400;

  function clearTimer() {
    if (typingTimeout) {
      clearTimeout(typingTimeout);
      typingTimeout = null;
    }
  }

  function typeLoop() {
    const currentText = exampleQuestions[currentIndex];

    if (!isDeleting) {
      // Typing forward
      if (charIndex < currentText.length) {
        charIndex++;
        shadowEl.textContent = currentText.substring(0, charIndex);
        typingTimeout = setTimeout(typeLoop, typingSpeed);
      } else {
        // Finished typing, pause then start deleting
        typingTimeout = setTimeout(() => {
          isDeleting = true;
          typeLoop();
        }, pauseAfterTyping);
      }
    } else {
      // Deleting
      if (charIndex > 0) {
        charIndex--;
        shadowEl.textContent = currentText.substring(0, charIndex);
        typingTimeout = setTimeout(typeLoop, deletingSpeed);
      } else {
        // Finished deleting, move to next question
        isDeleting = false;
        currentIndex = (currentIndex + 1) % exampleQuestions.length;
        typingTimeout = setTimeout(typeLoop, pauseAfterDeleting);
      }
    }
  }

  // Track user interaction
  window.addEventListener('pointerdown', () => { userHasInteracted = true; }, { once: true });
  window.addEventListener('keydown', () => { userHasInteracted = true; }, { once: true });

  // Stop animation when user focuses input
  inputEl.addEventListener('focus', () => {
    if (!userHasInteracted) return;
    clearTimer();
    shadowEl.textContent = '';
    shadowEl.style.display = 'none';
  });

  // Resume animation when user leaves input empty
  inputEl.addEventListener('blur', () => {
    if (!inputEl.value.trim()) {
      shadowEl.style.display = '';
      clearTimer();
      charIndex = 0;
      isDeleting = false;
      typeLoop();
    }
  });

  // Hide shadow text when user types
  inputEl.addEventListener('input', () => {
    if (inputEl.value.trim()) {
      clearTimer();
      shadowEl.style.display = 'none';
    }
  });

  // Start the animation
  typeLoop();
})();
</script>

<script>
// FAQ Smooth Scroll Enhancement
$(document).ready(function() {
    // When a FAQ tab is clicked, scroll the answer into view
    $('.faq-area .tab-btn .nav-link').on('click', function(e) {
        var targetId = $(this).attr('href');
        
        // Small delay to allow Bootstrap tab transition to start
        setTimeout(function() {
            // On mobile/tablet, scroll to the answer section
            if ($(window).width() < 992) {
                $('html, body').animate({
                    scrollTop: $('.tab-list').offset().top - 150
                }, 400);
            } else {
                // On desktop, ensure the answer panel is visible
                var tabList = $('.tab-list');
                var tabListTop = tabList.offset().top;
                var windowTop = $(window).scrollTop();
                var windowHeight = $(window).height();
                
                // If the answer section is not fully visible, scroll to it
                if (tabListTop < windowTop || tabListTop > windowTop + windowHeight - 200) {
                    $('html, body').animate({
                        scrollTop: tabListTop - 150
                    }, 400);
                }
            }
        }, 100);
    });
});
</script>


<!-- ============ Match Context Slider ============ -->
<script>
(function () {
  var root = document.getElementById('msSlider');
  if (!root) return;

  var slides = Array.prototype.slice.call(root.querySelectorAll('.ms-slide'));
  if (!slides.length) return;

  var dots = Array.prototype.slice.call(root.querySelectorAll('.ms-dot'));
  var prev = document.getElementById('msPrev');
  var next = document.getElementById('msNext');

  var stories = {};
  var dataNode = document.getElementById('msStorylineData');
  if (dataNode) {
    try { stories = JSON.parse(dataNode.textContent); } catch (e) { stories = {}; }
  }

  var index = 0;
  var timer = null;
  var paused = false;
  var DWELL = 25000;
  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function escapeHtml(value) {
    var node = document.createElement('div');
    node.textContent = value == null ? '' : value;
    return node.innerHTML;
  }

  // Fisher-Yates on a copy, take 3 — every re-entry to a slide gets a fresh trio
  function pickThree(list) {
    var pool = list.slice();
    var out = [];
    while (pool.length && out.length < 3) {
      out.push(pool.splice(Math.floor(Math.random() * pool.length), 1)[0]);
    }
    return out;
  }

  function renderStories(slide) {
    var list = stories[slide.getAttribute('data-match-id')] || [];
    var host = slide.querySelector('.ms-stories');
    if (!host || list.length <= 3) return;   // nothing left to rotate through

    host.innerHTML = pickThree(list).map(function (item) {
      var isQuote = item.kind === 'quote';
      var body = isQuote ? '\u201C' + escapeHtml(item.text) + '\u201D' : escapeHtml(item.text);
      return '<li class="ms-story ms-story--' + (isQuote ? 'quote' : 'insight') + '">' +
               '<span class="ms-story-tag">' + escapeHtml(item.scope) + ' &middot; ' + escapeHtml(item.kind) + '</span>' +
               '<p class="ms-story-text">' + body + '</p>' +
               (item.meta ? '<span class="ms-story-meta">' + escapeHtml(item.meta) + '</span>' : '') +
               (item.context ? '<span class="ms-story-context">' + escapeHtml(item.context) + '</span>' : '') +
             '</li>';
    }).join('');
  }

  function show(target) {
    index = (target + slides.length) % slides.length;

    slides.forEach(function (slide, i) {
      var active = i === index;
      slide.classList.toggle('is-active', active);
      slide.setAttribute('aria-hidden', active ? 'false' : 'true');
    });

    dots.forEach(function (dot, i) {
      var active = i === index;
      dot.classList.toggle('is-active', active);
      dot.setAttribute('aria-selected', active ? 'true' : 'false');
    });

    renderStories(slides[index]);
    schedule();
  }

  function schedule() {
    clearTimeout(timer);
    if (paused || reduced || slides.length < 2) return;
    timer = setTimeout(function () { show(index + 1); }, DWELL);
  }

  if (prev) prev.addEventListener('click', function () { show(index - 1); });
  if (next) next.addEventListener('click', function () { show(index + 1); });
  dots.forEach(function (dot, i) {
    dot.addEventListener('click', function () { show(i); });
  });

  root.addEventListener('mouseenter', function () { paused = true; clearTimeout(timer); });
  root.addEventListener('mouseleave', function () { paused = false; schedule(); });
  root.addEventListener('focusin', function () { paused = true; clearTimeout(timer); });
  root.addEventListener('focusout', function () { paused = false; schedule(); });

  document.addEventListener('visibilitychange', function () {
    paused = document.hidden;
    if (paused) { clearTimeout(timer); } else { schedule(); }
  });

  // touch swipe
  var touchX = null;
  root.addEventListener('touchstart', function (e) { touchX = e.changedTouches[0].clientX; }, { passive: true });
  root.addEventListener('touchend', function (e) {
    if (touchX === null) return;
    var delta = e.changedTouches[0].clientX - touchX;
    if (Math.abs(delta) > 45) show(delta < 0 ? index + 1 : index - 1);
    touchX = null;
  }, { passive: true });

  renderStories(slides[0]);
  schedule();
})();
</script>


        

        <script>
			// World Cup Banner functionality
			(function() {
			  const banner = document.getElementById('wcBanner');
			  const closeBtn = document.getElementById('wcBannerClose');
			  const storageKey = 'wc_banner_closed';
			  
			  // Check if user closed the banner in this session
			  if (sessionStorage.getItem(storageKey) === 'true') {
			    banner.classList.add('hidden');
			    document.body.classList.add('wc-banner-hidden');
			  }
			  
			  // Close banner when button is clicked
			  closeBtn.addEventListener('click', function() {
			    banner.classList.add('hidden');
			    document.body.classList.add('wc-banner-hidden');
			    sessionStorage.setItem(storageKey, 'true');
			  });
			})();
		</script>

    </body>
</html>