        <line x1="14" y1="10" x2="21" y2="3"></line>
        <line x1="3" y1="21" x2="10" y2="14"></line>
      </svg>
    </button>
  </div>
  <div class="json-modal-body">
    <pre id="json-modal-content"></pre>
  </div>
</div>
        

        



