        <div class="testmonial-area padding-80">
        	<div class="container">
        		<div class="row">
                <div class="col-lg-8 offset-lg-2 text-center wow fadeInDown" data-wow-duration="3s">
                    <div class="section-title">
                        <h3>How Customers Use StatPal</h3>
												<p>Our API powers live scoreboards, odds comparison tools, fantasy apps, and internal analytics dashboards across multiple countries.</p>
												
												<div class="row mt-4">
												  <div class="col-md-4">
												    <h5>Live score widgets</h5>
