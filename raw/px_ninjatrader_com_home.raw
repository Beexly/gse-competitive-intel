sk="url(#mask1_3761_441)"> <rect x="13" y="22.5" width="1893" height="318" fill="#FF4200"></rect> </g> </g> <defs> <pattern id="pattern0" patternContentUnits="objectBoundingBox" width="0.0369783" height="0.220126"> <use xlink:href="#image0_3761_441" transform="scale(0.000528262 0.00314465)"></use> </pattern> <image id="image0_3761_441" width="70" height="70" xlink:href="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAEYAAABGCAYAAABxLuKEAAAACXBIWXMAAAsTAAALEwEAmpwYAAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAABJSURBVHgB7dqxDQAhEANB35f2hdMaJIQQg8RMBZbjrf6nZ6qWykE3bfnCkmMAAAAAAAAAAOBBJTVbU1RtOAYAAAAAAAAAAB40AKZdDAtpztX9AAAAAElFTkSuQmCC"></image> </defs> </svg> </footer> </div>  <noscript> <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5H2422D" height="0" width="0" style="display:none;visibility:hidden"></iframe> </noscript>  <script src="/vendor/jquery-3.7.1.min.js"></script><script src="/vendor/slick.min.js"></script> <script src="/vendor/jquery-matchheight.min.js"></script> <script src="/vendor/modaal.min.js"></script> <script src="/vendor/utils.js"></script> <script>(function(){const cultures = {"English":[{"country":"United States","url":"/"},{"country":"Europe - Germany","url":"/eu/en-de/"},{"country":"Europe - Netherlands","url":"/eu/en-nl/"},{"country":"Europe","url":"/eu/"},{"country":"Europe - France","url":"/eu/en-fr/"},{"country":"Europe - Italy","url":"/eu/en-it/"},{"country":"Europe - Spain","url":"/eu/en-es/"}],"French":[{"country":"United States","url":"/fr-fr/"},{"country":"Europe - France","url":"/eu/fr-fr/"}],"German":[{"country":"United States","url":"/de-de/"},{"country":"Europe - Germany","url":"/eu/de-de/"}],"Italian":[{"country":"United States","url":"/it-it/"},{"country":"Europe - Italy","url":"/eu/it-it/"}],"Portuguese":[{"country":"United States","url":"/pt-pt/"}],"Russian":[{"country":"United States","url":"/ru-ru/"}],"Spanish":[{"country":"United States","url":"/es-es/"},{"country":"Europe - Spain","url":"/eu/es-es/"}],"Dutch":[{"country":"Europe - Netherlands","url":"/eu/nl-nl/"}]};

      window.cultures = cultures;
    })();</script><script src="/vendor/culture-modal.js"></script>   <script src="/vendor/geo-banner.js"></script> <script>
      (function () {
        function initHero() {
          const $ = window.jQuery;
          if (!$) return;
          // Ported from the live CMS source (Accelerator .../globals/functions.js):
          // a FADE carousel, autoplay from data-rotation-speed, the custom prev/next
          // buttons passed as slick arrows (bound in place since they're elements, not
          // HTML), dots into [data-slider-dots], plus a manual play/pause toggle.
          $("[data-hero-slider-container]").each(function () {
            const container = this; // eslint-disable-line @typescript-eslint/no-this-alias -- jQuery .each() pattern
            const sliderBox = container.querySelector("[data-hero-slider]");
            if (!sliderBox || $(sliderBox).hasClass("slick-initialized")) return;
            const prevBtn = container.querySelector("[data-slider-previous]");
            const nextBtn = container.querySelector("[data-slider-next]");
            const dots = container.querySelector("[data-slider-dots]");
            const autoplayBtn = container.querySelector("[data-slider-autoplay]");
            const srAnnouncer = container.querySelector("[data-carousel-announcer]");
            const rotationSpeed = ($(container).data("rotation-speed") || 5) * 1000;

            $(sliderBox).slick({
              mobileFirst: true,
              prevArrow: prevBtn,
              nextArrow: nextBtn,
              adaptiveHeight: false,
              autoplay: true,
              dots: true,
              arrows: true,
              dotsClass: "slider-dots",
              appendDots: dots,
              autoplaySpeed: rotationSpeed,
              fade: true,
              speed: 200,
            });

            if (autoplayBtn) {
              autoplayBtn.addEventListener("click", function () {
                if ($(autoplayBtn).hasClass("playing")) {
                  $(sliderBox).slick("slickPause");
                  $(autoplayBtn).addClass("paused").removeClass("playing");
                } else {
                  $(sliderBox).slick("slickPlay");
                  $(autoplayBtn).addClass("playing").removeClass("paused");
                }
              });
            }

            $(sliderBox).on("beforeChange", function (event, slick, currentSlide, nextSlide) {
              if (srAnnouncer)
                srAnnouncer.innerHTML =
                  "now showing slide " + (nextSlide + 1) + " of " + slick.slideCount;
            });
          });
        }
        // Basic Carousel widget slider. Ported verbatim from the live CMS source
        // (functions.js initiateBasicCarousel + handleCarouselItemWidth): each
        // .basic-carousel .slider becomes an infinite 4-up slick carousel (responsive
        // 1024→3, 600→2, 480→1) driven by the sibling .slider-btn--prev/--next arrows.
        // handleCarouselItemWidth pins each .slider__item's max-width to its slick width
        // (live keeps items from over-stretching) and reruns on slick's breakpoint event.
        function initBasicCarousel() {
          const $ = window.jQuery;
          if (!$) return;
          $(".basic-carousel .slider").each(function () {
            const slider = this; // eslint-disable-line @typescript-eslint/no-this-alias -- jQuery .each() pattern
            if ($(slider).hasClass("slick-initialized")) return;
            function handleCarouselItemWidth() {
              $(slider)
                .find(".slider__item")
                .each(function () {
                  $(this).css("max-width", this.style.width);
                });
            }
            $(slider).slick({
              dots: true,
              infinite: true,
              speed: 300,
              slidesToShow: 4,
              slidesToScroll: 1,
              prevArrow: $(slider).parent().find(".slider-btn--prev"),
              nextArrow: $(slider).parent().find(".slider-btn--next"),
              responsive: [
                {
                  breakpoint: 1024,
                  settings: { slidesToShow: 3, slidesToScroll: 1, infinite: true },
                },
                { breakpoint: 600, settings: { slidesToShow: 2, slidesToScroll: 1 } },
                { breakpoint: 480, settings: { slidesToShow: 1, slidesToScroll: 1 } },
              ],
            });
            handleCarouselItemWidth();
            $(slider).on("breakpoint", function () {
              handleCarouselItemWidth();
            });
          });
        }
        function initBlogSlider() {
          const $ = window.jQuery;
          if (!$) return;
          const $slider = $("#blog-listing-slider");
          if (!$slider.length || $slider.hasClass("slick-initialized")) return;
          const $wrap = $slider.closest(".blog-listing-slider");
          // Ported from the live CMS source (functions.js blogSliderSettings):
          // variable-width, mobile-first, responsive slidesToShow 1/2/3/4, dots into
          // #blog-listing-slider__dots, custom .slider-button arrows scoped to this
          // slider. (Upstream's `inifinite:false` is a typo, so slick keeps infinite:true.)
          $slider.slick({
            dots: true,
            arrows: false,
            autoplay: false,
            slidesToShow: 1,
            slidesToScroll: 1,
            mobileFirst: true,
            speed: 600,
            adaptiveHeight: true,
            variableWidth: true,
            dotsClass: "slider-dots",
            appendDots: $("#blog-listing-slider__dots"),
            prevArrow: $wrap.find(".slider-button--left"),
            nextArrow: $wrap.find(".slider-button--right"),
            responsive: [
              { breakpoint: 768, settings: { slidesToShow: 2, slidesToScroll: 2, arrows: false } },
              { breakpoint: 1439, settings: { arrows: true, slidesToShow: 3, slidesToScroll: 3 } },
              { breakpoint: 1560, settings: { arrows: true, slidesToShow: 4, slidesToScroll: 4 } },
            ],
            rows: 0,
          });
        }
        // Related-posts slider on the NewsPage detail (#posts-listing-slider). Ported from
        // the live CMS source (functions.js relatedSliderSettings + initiateReslicking): it's
        // a slick slider only on mobile (≤1000px) and "unslick" on desktop (>1000px), with a
        // resize handler that re-slicks/un-slicks across the breakpoint. Dots go into
        // #blog-listing-slider__dots. Guarded so non-news pages skip it entirely.
        function initRelatedSlider() {
          const $ = window.jQuery;
          if (!$) return;
          const $slider = $("#posts-listing-slider");
          if (!$slider.length || $slider.hasClass("slick-initialized")) return;
          // (Upstream's `inifinite:false` is a typo, so live slick keeps infinite:true —
          //  omit the key here to match, like initBlogSlider above.)
          const settings = {
            dots: true,
            arrows: false,
            autoplay: false,
            slidesToShow: 1,
            slidesToScroll: 1,
            mobileFirst: true,
            speed: 300,
            adaptiveHeight: true,
            variableWidth: true,
            dotsClass: "slider-dots",
            appendDots: $("#blog-listing-slider__dots"),
            responsive: [{ breakpoint: 1000, settings: "unslick" }],
            rows: 0,
          };
          const breakpoint = settings.responsive[0].breakpoint;
          $slider.slick(settings);
          $(window).on("resize", function () {
            if ($(window).width() > breakpoint) {
              if ($slider.hasClass("slick-initialized")) $slider.slick("unslick");
              return;
            }
            if (!$slider.hasClass("slick-initialized")) $slider.slick(settings);
          });
        }
        // Header/nav (+ tabs/accordions): the site's data-expander system handles
        // mega-menu dropdowns, the mobile menu overlay, the culture modal, and the
        // homepage tabs — all via [data-expander]. One unified system, as on live.
        function initNav() {
          const t = window.talonUtil;
          if (t && typeof t.setupToggles === "function") t.setupToggles();
        }
        // Sticky header (inlined from utils.js vendorPlugins, minus the lazy-loader):
        // toggle sticky-header-up/down on body as the user scrolls past the header.
        function initStickyHeader() {
          const hdr = document.querySelector(".site-header");
          if (!hdr || !hdr.classList.contains("sticky-header")) return;
          const body = document.body;
          let lastScroll = 0;
          const debounce = window.talonUtil && window.talonUtil.debounce;
          const handler = function () {
            const cur = window.pageYOffset,
              h = hdr.offsetHeight;
            if (cur <= h) {
              body.classList.remove("sticky-header-up", "sticky-header-down");
              lastScroll = cur;
              return;
            }
            if (cur > lastScroll && !body.classList.contains("sticky-header-down")) {
              body.classList.remove("sticky-header-up");
              body.classList.add("sticky-header-down");
            } else if (cur < lastScroll && body.classList.contains("sticky-header-down")) {
              body.classList.remove("sticky-header-down");
              body.classList.add("sticky-header-up");
            }
            lastScroll = cur;
          };
          window.addEventListener("scroll", debounce ? debounce(handler, 0) : handler);
        }
        // Video/livestream modal trigger. Ported verbatim from the live CMS source
        // (functions.js): a delegated click on any [data-toggle="modal"] opens the element
        // whose id matches data-target as a modaal dialog (content_source + start_open).
        // Drives the FeaturedVideoPlayer widget's play button (.featured-livestream__button).
        function initVideoModal() {
          const $ = window.jQuery;
          if (!$ || !$.fn || typeof $.fn.modaal !== "function") return;
          $(document).on("click", '[data-toggle="modal"]', function (e) {
            const target = "#" + $(this).attr("data-target");
            $(this).modaal({
              content_source: target,
              start_open: true,
              overlay_opacity: 0.9,
            });
            e.preventDefault();
          });
        }
        // NT.NewsListing (.news-section2) + NT.EventListing (.events-section) +
        // NT.BlogPostListing (.blogs-section) client-side pagination. All three live widgets page
        // server-side via ?page=N; we render ALL items (each tagged data-news-page /
        // data-event-page / data-blog-page) plus page 1's control markup, and swap the visible
        // window + rebuild the numbered controls here. The chunk algorithm mirrors
        // _Pagination.cshtml exactly so the rendered controls match live for every page. Guarded +
        // scoped to each listing wrapper (the item class comes from the root's data-item-selector),
        // so non-listing pages no-op.
        function initNewsPagination() {
          const roots = document.querySelectorAll(
            "[data-news-listing],[data-event-listing],[data-blog-listing]",
          );
          if (!roots.length) return;
          Array.prototype.forEach.call(roots, function (root) {
            const pageSize = parseInt(root.getAttribute("data-page-size"), 10) || 9;
            const chunkSize = parseInt(root.getAttribute("data-chunk-size"), 10) || 3;
            const totalPages = parseInt(root.getAttribute("data-total-pages"), 10) || 1;
            const list = root.querySelector(".pagination__list");
            const itemSelector = root.getAttribute("data-item-selector") || ".news-listing3__item";
            const items = root.querySelectorAll(itemSelector);
            if (totalPages <= 1 || !list) return;

            function svgLink(hash, srText) {
              return (
                '<a href="#" class="pagination__link pagination__link--svg">' +
                '<svg aria-hidden="true" focusable="false"><use xlink:href="/assets/dist/images/svg-legend.svg#' +
                hash +
                '"></use></svg><span class="sr-only">' +
                srText +
                "</span></a>"
              );
            }

            // Mirror _Pagination.cshtml's chunk window for the given current page.
            function controlsFor(current) {
              let startPage = Math.max(1, current - Math.floor((chunkSize - 1) / 2));
              const endPage = Math.min(startPage + chunkSize - 1, totalPages);
              if (endPage === totalPages) startPage = Math.max(1, totalPages - chunkSize + 1);
              const out = [];
              if (current > 1) out.push({ k: "prev", p: current - 1 });
              if (startPage !== 1) out.push({ k: "first", p: 1 });
              if (current > Math.floor((chunkSize - 1) / 2) && startPage !== 1)
                out.push({ k: "prevChunk", p: Math.max(current - chunkSize, 1) });
              for (let n = startPage; n <= endPage; n++)
                out.push({ k: "page", p: n, active: n === current });
              if (current < totalPages - Math.floor((chunkSize - 1) / 2) && endPage !== totalPages)
                out.push({ k: "nextChunk", p: Math.min(current + chunkSize, totalPages) });
              if (endPage < totalPages) out.push({ k: "last", p: totalPages });
              if (current < totalPages) out.push({ k: "next", p: current + 1 });
              return out;
            }

            function render(current) {
              // Toggle the visible item window.
              Array.prototype.forEach.call(items, function (li, i) {
                li.hidden = Math.floor(i / pageSize) + 1 !== current;
              });
              // Rebuild the numbered controls for the new current page.
              let html = "";
              controlsFor(current).forEach(function (c) {
                if (c.k === "prev")
                  html +=
                    '<li class="PagedList-skipToPrevious pagination__list-item" data-page-number="' +
                    c.p +
                    '">' +
                    svgLink("arrow-left-slider", "Previous page") +
                    "</li>";
                else if (c.k === "first")
                  html +=
                    '<li class="pagination__list-item" data-page-number="1"><a href="#" class="pagination__link">1</a></li>';
                else if (c.k === "prevChunk")
                  html +=
                    '<li class="PagedList-skipToPrevious pagination__list-item" data-page-number="' +
                    c.p +
                    '"><a href="#" class="pagination__link">...<span class="sr-only">Previous chunk</span></a></li>';
                else if (c.k === "page")
                  html += c.active
                    ? '<li class="pagination__list-item active"><span class="pagination__link pagination__link--active">' +
                      c.p +
                      "</span></li>"
                    : '<li class="pagination__list-item" data-page-number="' +
                      c.p +
                      '"><a href="#" class="pagination__link">' +
                      c.p +
                      "</a></li>";
                else if (c.k === "nextChunk")
                  html +=
                    '<li class="PagedList-skipToNext pagination__list-item" data-page-number="' +
                    c.p +
                    '"><a href="#" class="pagination__link">...<span class="sr-only">Next chunk</span></a></li>';
                else if (c.k === "last")
                  html +=
                    '<li class="pagination__list-item" data-page-number="' +
                    c.p +
                    '"><a href="#" class="pagination__link">' +
                    c.p +
                    "</a></li>";
                else if (c.k === "next")
                  html +=
                    '<li class="PagedList-skipToNext pagination__list-item" data-page-number="' +
                    c.p +
                    '">' +
                    svgLink("arrow-right-slider", "Next page") +
                    "</li>";
              });
              list.innerHTML = html;
            }

            list.addEventListener("click", function (e) {
              const li =
                e.target && e.target.closest ? e.target.closest("[data-page-number]") : null;
              if (!li || !list.contains(li)) return;
              e.preventDefault();
              const target = parseInt(li.getAttribute("data-page-number"), 10);
              if (!target || target < 1 || target > totalPages) return;
              render(target);
              root.scrollIntoView({ behavior: "smooth", block: "start" });
            });
          });
        }
        function initAll() {
          initHero();
          initBlogSlider();
          initRelatedSlider();
          initBasicCarousel();
          initNav();
          initStickyHeader();
          initVideoModal();
          initNewsPagination();
        }
        if (document.readyState !== "loading") initAll();
        else document.addEventListener("DOMContentLoaded", initAll);
      })();
    </script> <script>(function(){const sb = {"title":"Attention!","continueLabel":"Continue","message":"You are now leaving a NinjaTrader website and will be redirected to a third-party site. Neither NinjaTrader nor its affiliated entities has endorsed or recommended for use any product, service, or statement offered or presented on the site you are about to visit. Third-party vendors and their websites, products, and services are independent and not affiliated with NinjaTrader or its affiliated entities.\u003cbr />\u003cbr />By clicking the button below, I confirm to have read and understood the statement above.","blacklistedDomains":["ninjatraderecosystem.com","youtube.com","anthonycrudele.com","daytradetowin.com","thelabtrading.com","livestreamtrading.com","moneylinetradingco.com","thepaxgroup.org","stratalerts.ai","x.com","vipertradingsystems.com","crowdedmarketsreport.com","idta.com.au","jtrader.co","microefutures.wordpress.com","crowdedmarketreport.com","try.takeprofittrader.com","blusky.pro","emergeprofit.com","elitetraderfunding.com","fundedfuturesfamily.com","checkout.fundingfutures.com","app.fundingticks.com","tradefundrr.com","fxifyfutures.com","ninjatrader.thelegendstrading.com","lifeuptrading.com","myfundedfutures.com","purdia.com","client-area.thetradingpit.com","tickticktrader.com","tradeday.com","fundingtrading.com","tradeify.co","apextraderfunding.com","fundednext.com","goatfundedfutures.com","thelegendstrading.com","lucidtrading.com","takeprofittrader.com","fundingfutures.com","thetradingpit.com","app.fxifyfutures.com","facebook.com","x.com","linkedin.com","instagram.com","phidiaspropfirm.com"]};

  (function () {
    function init() {
      const $ = window.jQuery;
      if (!$ || !$.fn || typeof $.fn.modaal !== "function") return;
      const cancelBtn =
        '<svg aria-hidden="true" focusable="false"><use xlink:href="/assets/dist/images/svg-legend.svg#x-cross"></use></svg>';

      Array.prototype.forEach.call(document.getElementsByTagName("a"), function (el) {
        const domain = (el.host || "").replace(/^www\./, "").toLowerCase();
        const match =
          sb.blacklistedDomains.indexOf(domain) !== -1 ||
          el.classList.contains("js-globalspeedbump");
        if (!match || el.classList.contains("js-noglobalspeedbump")) return;

        // Capture the destination, then let modaal own the click (it preventDefaults +
        // opens the confirm; Continue runs the callback). Idiomatic modaal binding —
        // re-opens correctly on repeat clicks, unlike the live start_open href-rewrite.
        const url = el.href;
        $(el).modaal({
          type: "confirm",
          confirm_title: sb.title,
          confirm_content: sb.message,
          confirm_button_text: sb.continueLabel,
          confirm_cancel_button_text: cancelBtn,
          confirm_callback: function () {
            window.open(url);
          },
        });
      });
    }
    if (document.readyState !== "loading") init();
    else document.addEventListener("DOMContentLoaded", init);
  })();
})();</script> </body> </html>