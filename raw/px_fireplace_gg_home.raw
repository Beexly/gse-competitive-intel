c(100%-1px)] flex-1 border border-transparent whitespace-nowrap transition-[color,box-shadow] focus-visible:ring-[3px] focus-visible:outline-1 disabled:pointer-events-none disabled:opacity-50 data-[state=active]:shadow-sm [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 flex items-center justify-center gap-1.5 rounded-lg px-3 py-2 text-xs font-medium text-fgrey-400 data-[state=active]:bg-fgrey-850 data-[state=active]:text-fgrey-50 md:text-sm" tabindex="-1" data-orientation="horizontal" data-radix-collection-item=""><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256"><path d="M240,128l-48,40H64L16,128,64,88H192Z" opacity="0.2"></path><path d="M69.12,94.15,28.5,128l40.62,33.85a8,8,0,1,1-10.24,12.29l-48-40a8,8,0,0,1,0-12.29l48-40a8,8,0,0,1,10.24,12.3Zm176,27.7-48-40a8,8,0,1,0-10.24,12.3L227.5,128l-40.62,33.85a8,8,0,1,0,10.24,12.29l48-40a8,8,0,0,0,0-12.29ZM162.73,32.48a8,8,0,0,0-10.25,4.79l-64,176a8,8,0,0,0,4.79,10.26A8.14,8.14,0,0,0,96,224a8,8,0,0,0,7.52-5.27l64-176A8,8,0,0,0,162.73,32.48Z"></path></svg>Trade via API</button></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-_R_dbsnpj6andb_-trigger-api" hidden="" id="radix-_R_dbsnpj6andb_-content-api" tabindex="0" data-slot="tabs-content" class="flex-1 outline-none data-[state=inactive]:hidden flex flex-col gap-4"></div><div data-state="active" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-_R_dbsnpj6andb_-trigger-migrate" id="radix-_R_dbsnpj6andb_-content-migrate" tabindex="0" data-slot="tabs-content" class="flex-1 outline-none data-[state=inactive]:hidden flex flex-col gap-4" style="animation-duration:0s"><div class="flex gap-3 rounded-2xl border border-fgrey-800 bg-fgrey-925 p-4 md:gap-4 md:p-5"><span class="inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-[#FF4752]/10 text-sm font-semibold text-[#FF4752]">1</span><div class="flex min-w-0 flex-1 flex-col gap-3"><div class="flex items-center gap-2"><span class="inline-flex size-8 shrink-0 items-center justify-center rounded-md bg-[#FF4752]/10 text-[#FF4752]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256"><path d="M192,64V168L88,64Z" opacity="0.2"></path><path d="M192,56H88a8,8,0,0,0-5.66,13.66L128.69,116,58.34,186.34a8,8,0,0,0,11.32,11.32L140,127.31l46.34,46.35A8,8,0,0,0,200,168V64A8,8,0,0,0,192,56Zm-8,92.69-38.34-38.34h0L107.31,72H184Z"></path></svg></span><h2 class="text-base font-semibold text-fgrey-100">Create your new account</h2></div><p class="text-sm text-fgrey-400">Set up a Polymarket account. Fireplace runs on the same Polymarket markets, so your positions carry over.</p><div><a href="https://polymarket.com" target="_blank" rel="noopener noreferrer" data-slot="button" class="active:scale-[0.98] inline-flex cursor-pointer items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive bg-[#1D1D1D] text-secondary-foreground shadow-xs border-1 border-[#2C2C2C] px-4 py-2 has-[&gt;svg]:px-3 h-11 w-full md:h-9 md:w-auto hover:bg-fgrey-800">Polymarket<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 256 256"><path d="M204,64V168a12,12,0,0,1-24,0V93L72.49,200.49a12,12,0,0,1-17-17L163,76H88a12,12,0,0,1,0-24H192A12,12,0,0,1,204,64Z"></path></svg></a></div></div></div><div class="flex gap-3 rounded-2xl border border-fgrey-800 bg-fgrey-925 p-4 md:gap-4 md:p-5"><span class="inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-[#FF4752]/10 text-sm font-semibold text-[#FF4752]">2</span><div class="flex min-w-0 flex-1 flex-col gap-3"><div class="flex items-center gap-2"><span class="inline-flex size-8 shrink-0 items-center justify-center rounded-md bg-[#FF4752]/10 text-[#FF4752]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256"><path d="M224,128a96,96,0,1,1-96-96A96,96,0,0,1,224,128Z" opacity="0.2"></path><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm64-88a8,8,0,0,1-8,8H128a8,8,0,0,1-8-8V72a8,8,0,0,1,16,0v48h48A8,8,0,0,1,192,128Z"></path></svg></span><h2 class="text-base font-semibold text-fgrey-100">Cancel your open orders</h2></div><p class="text-sm text-fgrey-400">Resting limit orders lock up your cash and shares — cancel them so everything is free to migrate, and nothing fills after you&#x27;ve left.</p><div><div class="flex items-center gap-1.5 text-sm text-emerald-300"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm45.66,85.66-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35a8,8,0,0,1,11.32,11.32Z"></path></svg>No open orders — nothing to cancel.</div></div></div></div><div class="flex gap-3 rounded-2xl border border-fgrey-800 bg-fgrey-925 p-4 md:gap-4 md:p-5"><span class="inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-[#FF4752]/10 text-sm font-semibold text-[#FF4752]">3</span><div class="flex min-w-0 flex-1 flex-col gap-3"><div class="flex items-center gap-2"><span class="inline-flex size-8 shrink-0 items-center justify-center rounded-md bg-[#FF4752]/10 text-[#FF4752]"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256"><path d="M208,80v96H48V80Z" opacity="0.2"></path><path d="M213.66,181.66l-32,32a8,8,0,0,1-11.32-11.32L188.69,184H48a8,8,0,0,1,0-16H188.69l-18.35-18.34a8,8,0,0,1,11.32-11.32l32,32A8,8,0,0,1,213.66,181.66Zm-139.32-64a8,8,0,0,0,11.32-11.32L67.31,88H208a8,8,0,0,0,0-16H67.31L85.66,53.66A8,8,0,0,0,74.34,42.34l-32,32a8,8,0,0,0,0,11.32Z"></path></svg></span><h2 class="text-base font-semibold text-fgrey-100">Migrate your positions + cash</h2></div><p class="text-sm text-fgrey-400">In Polymarket, open your profile and use Copy address (NOT the Deposit address) — that wallet holds your positions and balance. Paste it here and hit Migrate. This moves ALL of your open positions AND your entire cash balance to it in one step. We sign the on-chain transfer; your private key never leaves Fireplace. It&#x27;s on-chain and can&#x27;t be undone, so double-check the address.</p><div><button data-slot="button" class="active:scale-[0.98] inline-flex cursor-pointer items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive bg-[#1D1D1D] text-secondary-foreground shadow-xs border-1 border-[#2C2C2C] px-4 py-2 has-[&gt;svg]:px-3 h-11 w-full md:h-9 md:w-auto hover:bg-fgrey-800">Migrate everything<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 256 256"><path d="M204,64V168a12,12,0,0,1-24,0V93L72.49,200.49a12,12,0,0,1-17-17L163,76H88a12,12,0,0,1,0-24H192A12,12,0,0,1,204,64Z"></path></svg></button></div></div></div></div></div><p class="mt-8 text-center text-xs text-fgrey-600">Need help? Reach out to support before the deadline — we can&#x27;t assist once the app is offline.</p></div><!--$?--><template id="B:3"></template><!--/$--></div><script>$RC("B:2","S:2")</script><div hi