l=%2Fimages%2FLogoTransparent.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2FLogoTransparent.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2FLogoTransparent.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2FLogoTransparent.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fimages%2FLogoTransparent.png&amp;w=3840&amp;q=75"/></div><span class="jsx-51246894c2975e39 text-white font-extrabold text-xl tracking-wide">PolyOracle</span></a><nav class="jsx-51246894c2975e39 hidden md:flex flex-1 justify-center gap-8"><a class="text-gray-300 hover:text-white hover:scale-105 transition-transform duration-200" href="/#howItWorks">How It Works</a><a class="text-gray-300 hover:text-white hover:scale-105 transition-transform duration-200" href="/#aiEngine">AI Engine</a><a class="text-gray-300 hover:text-white hover:scale-105 transition-transform duration-200" href="/#wallets">Wallets</a><a target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-white hover:scale-105 transition-transform duration-200" href="https://docs.polyoracle.com/">Docs</a></nav><div class="jsx-51246894c2975e39 flex items-center gap-3"><a data-slot="button" class="items-center justify-center gap-2 whitespace-nowrap text-sm font-medium disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive shadow-xs hover:bg-primary/90 h-9 has-[&gt;svg]:px-3 hidden sm:inline-flex bg-[#C04210] text-black px-6 py-2 rounded-lg hover:scale-105 transition-transform duration-200" href="https://app.polyoracle.com/">Launch App</a><button data-slot="sheet-trigger" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50 size-9 md:hidden text-white" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="radix-«Rn5tb»" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu h-6 w-6" aria-hidden="true"><path d="M4 12h16"></path><path d="M4 18h16"></path><path d="M4 6h16"></path></svg></button></div></div></header><main><section class="jsx-956e16cdb2f810f2 relative w-full min-h-screen flex flex-col lg:flex-row items-center justify-center py-24 lg:py-32 overflow-hidden px-6 lg:px-20 bg-black"><div class="jsx-956e16cdb2f810f2 absolute inset-0 z-0 flex justify-start items-center overflow-hidden"><img src="/images/Earth.jpg" alt="World Globe" class="jsx-956e16cdb2f810f2 h-full object-contain max-w-[60%] animate-rotate-globe"/><div class="jsx-956e16cdb2f810f2 absolute inset-0 bg-black/50"></div></div><div class="jsx-956e16cdb2f810f2 relative z-10 w-full lg:w-1/2 flex flex-col items-start text-left space-y-6 lg:pl-12"><h1 class="jsx-956e16cdb2f810f2 text-3xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-extrabold text-gradient animate-float">AI that predicts the prediction <br class="jsx-956e16cdb2f810f2"/><span class="jsx-956e16cdb2f810f2 text-[#C04210]">market outcomes.</span></h1><p class="jsx-956e16cdb2f810f2 text-lg sm:text-xl md:text-2xl text-gray-300 leading-relaxed animate-fade-in delay-200">An intelligence layer that reads the technicalities and probabilities of prediction markets to see if the expected outcome is in line with expected payoff to see which markets are underpriced or overpriced.        </p></div></section><section id="howItWorks" class="jsx-53ffcdc1e8f76c80 relative py-24 bg-black overflow-hidden"><div class="jsx-53ffcdc1e8f76c80 absolute inset-0 -z-10"><div class="jsx-53ffcdc1e8f76c80 absolute w-[400px] h-[400px] bg-[#C04210]/20 rounded-full top-[-50px] left-[-100px] blur-3xl animate-pulseSlow"></div><div class="jsx-53ffcdc1e8f76c80 absolute w-[300px] h-[300px] bg-[#FF8C42]/20 rounded-full bottom-[-50px] right-[-50px] blur-2xl animate-pulseSlow"></div></div><div class="jsx-53ffcdc1e8f76c80 container mx-auto px-6 lg:px-20 text-center"><h2 class="jsx-53ffcdc1e8f76c80 text-4xl md:text-5xl font-extrabold text-white mb-6">How It <span class="jsx-53ffcdc1e8f76c80 text-[#C04210]">Works</span></h2><p class="jsx-53ffcdc1e8f76c80 text-lg md:text-xl text-gray-300 max-w-2xl mx-auto mb-16">PolyOracle scans prediction markets and estimates the odds of an event occurring and through multiple LLMs a consensus has to be reached so there is no bias. Once a quorum is reached, PolyOracle places a position in an underpriced market.</p><div class="jsx-53ffcdc1e8f76c80 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12"><div class="jsx-53ffcdc1e8f76c80 relative group perspective-1000 cursor-pointer md:-translate-y-8"><div class="jsx-53ffcdc1e8f76c80 relative flex flex-col items-center gap-4 p-6 rounded-3xl bg-white/5 border border-white/10 backdrop-blur-lg shadow-lg hover:shadow-[#C04210]/40 transition-all duration-500 transform hover:-translate-y-3 hover:scale-105"><div class="jsx-53ffcdc1e8f76c80 relative w-16 h-16"><div class="jsx-53ffcdc1e8f76c80 absolute -inset-2 rounded-full bg-gradient-to-br from-[#C04210]/20 to-[#FF8C42]/20 blur-xl animate-blob"></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chart-candlestick jsx-53ffcdc1e8f76c80 relative w-8 h-8 text-[#C04210] z-10" aria-hidden="true"><path d="M9 5v4"></path><rect width="4" height="6" x="7" y="9" rx="1"></rect><path d="M9 15v2"></path><path d="M17 3v2"></path><rect width="4" height="8" x="15" y="5" rx="1"></rect><path d="M17 13v3"></path><path d="M3 3v16a2 2 0 0 0 2 2h16"></path></svg></div><h3 class="jsx-53ffcdc1e8f76c80 text-xl font-bold text-white text-center">Market Intelligence</h3><p class="jsx-53ffcdc1e8f76c80 text-gray-300 text-sm sm:text-base leading-relaxed text-center">Continuously aggregates live data from multiple trading and prediction platforms, capturing signals others miss.</p></div></div><div class="jsx-53ffcdc1e8f76c80 relative group perspective-1000 cursor-pointer md:translate-y-8"><div class="jsx-53ffcdc1e8f76c80 relative flex flex-col items-center gap-4 p-6 rounded-3xl bg-white/5 border border-white/10 backdrop-blur-lg shadow-lg hover:shadow-[#C04210]/40 transition-all duration-500 transform hover:-translate-y-3 hover:scale-105"><div class="jsx-53ffcdc1e8f76c80 relative w-16 h-16"><div class="jsx-53ffcdc1e8f76c80 absolute -inset-2 rounded-full bg-gradient-to-br from-[#C04210]/20 to-[#FF8C42]/20 blur-xl animate-blob"></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-brain jsx-53ffcdc1e8f76c80 relative w-8 h-8 text-[#C04210] z-10" aria-hidden="true"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"></path><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"></path><path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4"></path><path d="M17.599 6.5a3 3 0 0 0 .399-1.375"></path><path d="M6.003 5.125A3 3 0 0 0 6.401 6.5"></path><path d="M3.477 10.896a4 4 0 0 1 .585-.396"></path><path d="M19.938 10.5a4 4 0 0 1 .585.396"></path><path d="M6 18a4 4 0 0 1-1.967-.516"></path><path d="M19.967 17.484A4 4 0 0 1 18 18"></path></svg></div><h3 class="jsx-53ffcdc1e8f76c80 text-xl font-bold text-white text-center">AI Decision Engine</h3><p class="jsx-53ffcdc1e8f76c80 text-gray-300 text-sm sm:text-base leading-relaxed text-center">Layered LLMs evaluate risk, probability, and edge—reaching consensus before committing to any position.</p></div></div><div class="jsx-53ffcdc1e8f76c80 relative group perspective-1000 cursor-pointer md:-translate-y-8"><div class="jsx-53ffcdc1e8f76c80 relative flex flex-col items-center gap-4 p-6 rounded-3xl bg-white/5 border border-white/10 backdrop-blur-lg shadow-lg hover:shadow-[#C04210]/40 transition-all duration-500 transform hover:-translate-y-3 hover:scale-105"><div class="jsx-53ffcdc1e8f76c80 relative w-16 h-16"><div class="jsx-53ffcdc1e8f76c80 absolute -inset-2 rounded-full bg-gradient-to-br from-[#C04210]/20 to-[#FF8C42]/20 blur-xl animate-blob"></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left-right jsx-53ffcdc1e8f76c80 relative w-8 h-8 text-[#C04210] z-10" aria-hidden="true"><path d="M8 3 4 7l4 4"></path><path d="M4 7h16"></path><path d="m16 21 4-4-4-4"></path><path d="M20 17H4"></path></svg></div><h3 class="jsx-53ffcdc1e8f76c80 text-xl font-bold text-white text-center">Autonomous Execution</h3><p class="jsx-53ffcdc1e8f76c80 text-gray-300 text-sm sm:text-base leading-relaxed text-center">Positions are taken and executed utilising the wormhole bridge to bridge from Solana to Polygon all in 1 seamless motion</p></div></div><div class="jsx-53ffcdc1e8f76c80 relative group perspective-1000 cursor-pointer md:translate-y-8"><div class="jsx-53ffcdc1e8f76c80 relative flex flex-col items-center gap-4 p-6 rounded-3xl bg-white/5 border border-white/10 backdrop-blur-lg shadow-lg hover:shadow-[#C04210]/40 transition-all duration-500 transform hover:-translate-y-3 hover:scale-105"><div class="jsx-53ffcdc1e8f76c80 relative w-16 h-16"><div class="jsx-53ffcdc1e8f76c80 absolute -inset-2 rounded-full bg-gradient-to-br from-[#C04210]/20 to-[#FF8C42]/20 blur-xl animate-blob"></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-up jsx-53ffcdc1e8f76c80 relative w-8 h-8 text-[#C04210] z-10" aria-hidden="true"><path d="M16 7h6v6"></path><path d="m22 7-8.5 8.5-5-5L2 17"></path></svg></div><h3 class="jsx-53ffcdc1e8f76c80 text-xl font-bold text-white text-center">Adaptive Growth</h3><p class="jsx-53ffcdc1e8f76c80 text-gray-300 text-sm sm:text-base leading-relaxed text-center">The system learns from outcomes, refining strategies to compound returns while safeguarding capital.</p></div></div></div></div></section><section id="aiEngine" class="jsx-5a12768c2678ee85 relative py-32 bg-black overflow-hidden"><div class="jsx-5a12768c2678ee85 absolute inset-0 -z-10"><div class="jsx-5a12768c2678ee85 absolute w-72 h-72 bg-gradient-to-tr from-[#C04210]/20 to-[#FF8C42]/20 rounded-full top-20 left-10 animate-blob"></div><div class="jsx-5a12768c2678ee85 absolute w-56 h-56 bg-gradient-to-tr from-[#FF2D55]/20 to-[#FF8C42]/20 rounded-full bottom-20 right-16 animate-blob animation-delay-2000"></div></div><div class="jsx-5a12768c2678ee85 container relative z-10 flex flex-col lg:flex-row items-center lg:items-start gap-16 px-6 lg:px-20"><div class="jsx-5a12768c2678ee85 flex-1 space-y-6 text-left"><h2 class="jsx-5a12768c2678ee85 text-4xl sm:text-5xl md:text-6xl font-extrabold text-white">PolyOracle  <span class="jsx-5a12768c2678ee85 text-[#C04210]">Prediction Agent</span></h2><p class="jsx-5a12768c2678ee85 text-lg sm:text-xl text-gray-300 max-w-md">Autonomous intelligence scanning prediction  markets like Polymarket to capture the best opportunities with precision.</p></div><div class="jsx-5a12768c2678ee85 flex-1 relative"><div class="jsx-5a12768c2678ee85 absolute left-1/2 top-0 w-1 h-full bg-[#C04210]/50 rounded-full -translate-x-1/2"></div><div class="jsx-5a12768c2678ee85 relative space-y-12"><div class="jsx-5a12768c2678ee85 p-2 relative flex flex-col items-center rounded-3xl bg-black/30 backdrop-blur-md border border-white/10 shadow-lg hover:shadow-[#C04210]/40 transform transition-all duration-500 hover:-translate-y-2"><div class="jsx-5a12768c2678ee85 absolute left-1/2 top-8 w-8 h-1 bg-[#C04210]/50 -translate-x-1/2"></div><div class="jsx-5a12768c2678ee85 flex items-center justify-center w-12 h-12 rounded-full bg-gradient-to-tr from-[#C04210]/60 to-[#FF8C42]/40 shadow-md z-10"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-brain jsx-5a12768c2678ee85 w-8 h-8 text-white" aria-hidden="true"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"></path><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"></path><path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4"></path><path d="M17.599 6.5a3 3 0 0 0 .399-1.375"></path><path d="M6.003 5.125A3 3 0 0 0 6.401 6.5"></path><path d="M3.477 10.896a4 4 0 0 1 .585-.396"></path><path d="M19.938 10.5a4 4 0 0 1 .585.396"></path><path d="M6 18a4 4 0 0 1-1.967-.516"></path><path d="M19.967 17.484A4 4 0 0 1 18 18"></path></svg></div><h3 class="jsx-5a12768c2678ee85 text-xl font-semibold text-white text-center mt-4">Cross-Market Scanning</h3><p class="jsx-5a12768c2678ee85 text-gray-300 text-center leading-relaxed text-sm sm:text-base">Continuously monitor leading prediction and trading platforms in real time.</p></div><div class="jsx-5a12768c2678ee85 p-2 relative flex flex-col items-center rounded-3xl bg-black/30 backdrop-blur-md border border-white/10 s