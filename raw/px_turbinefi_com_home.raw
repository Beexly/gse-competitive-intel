lns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg></div><span class="landingTestimonial-module__27TYyG__source">Trustpilot review</span></div><blockquote class="landingTestimonial-module__27TYyG__quoteText">TurbineFi&#x27;s been a solid way for me to get into automated trading without needing to code. ... I like that you can backtest ideas before putting real money on them. ... Their support actually answers questions and knows what they&#x27;re talking about.</blockquote><figcaption class="landingTestimonial-module__27TYyG__attribution"><div class="landingTestimonial-module__27TYyG__person"><span class="landingTestimonial-module__27TYyG__avatarFallback" aria-hidden="true">EM</span><span class="landingTestimonial-module__27TYyG__identity"><span class="landingTestimonial-module__27TYyG__name">Erick M</span><span class="landingTestimonial-module__27TYyG__role">TurbineFi user</span></span></div><a class="landingTestimonial-module__27TYyG__sourceLink" href="https://www.trustpilot.com/reviews/6a6e6cdc9e1b57482e112fe1" target="_blank" rel="noopener noreferrer">View source<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg></a></figcaption></figure></div><div class="w-full min-w-0 shrink-0 grow-0 overflow-hidden landingTestimonial-module__27TYyG__carouselItem"><figure class="landingTestimonial-module__27TYyG__reviewPanel"><div class="landingTestimonial-module__27TYyG__reviewMeta"><span class="landingTestimonial-module__27TYyG__customerStory">Customer story</span><span class="landingTestimonial-module__27TYyG__source">@alfa_lupo</span></div><blockquote class="landingTestimonial-module__27TYyG__quoteText">TurbineFi&#x27;s research and tools make automated trading on prediction markets dead simple. I was planning to build my own trading bot on Kalshi, but TurbineFi let me deploy my strategy in minutes instead of hours.</blockquote><figcaption class="landingTestimonial-module__27TYyG__attribution"><div class="landingTestimonial-module__27TYyG__person"><img alt="" aria-hidden="true" loading="lazy" width="44" height="44" decoding="async" data-nimg="1" class="landingTestimonial-module__27TYyG__avatar" style="color:transparent" srcSet="/_next/image?url=%2Fauthors%2Fdelz-64.webp&amp;w=48&amp;q=75&amp;dpl=dpl_5QZNNA2CFW9uuhs9iZx6B6LmVXoj 1x, /_next/image?url=%2Fauthors%2Fdelz-64.webp&amp;w=96&amp;q=75&amp;dpl=dpl_5QZNNA2CFW9uuhs9iZx6B6LmVXoj 2x" src="/_next/image?url=%2Fauthors%2Fdelz-64.webp&amp;w=96&amp;q=75&amp;dpl=dpl_5QZNNA2CFW9uuhs9iZx6B6LmVXoj"/><span class="landingTestimonial-module__27TYyG__identity"><span class="landingTestimonial-module__27TYyG__name">Delz</span><span class="landingTestimonial-module__27TYyG__role">Data Science @ Gauntlet &amp; TurbineFi User</span></span></div><a class="landingTestimonial-module__27TYyG__sourceLink" href="https://x.com/alfa_lupo" target="_blank" rel="noopener noreferrer">View source<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg></a></figcaption></figure></div><div class="w-full min-w-0 shrink-0 grow-0 overflow-hidden landingTestimonial-module__27TYyG__carouselItem"><figure class="landingTestimonial-module__27TYyG__reviewPanel"><div class="landingTestimonial-module__27TYyG__reviewMeta"><span class="landingTestimonial-module__27TYyG__customerStory">Customer story</span><span class="landingTestimonial-module__27TYyG__source">in/jotony-guerra</span></div><blockquote class="landingTestimonial-module__27TYyG__quoteText">TurbineFi has let me turn prediction markets into a playable game...10 out 10 would recommend. Being able to chat and create strategies is extremely helpful and allows for an intuitive learning process.</blockquote><figcaption class="landingTestimonial-module__27TYyG__attribution"><div class="landingTestimonial-module__27TYyG__person"><img alt="" aria-hidden="true" loading="lazy" width="44" height="44" decoding="async" data-nimg="1" class="landingTestimonial-module__27TYyG__avatar" style="color:transparent" srcSet="/_next/image?url=%2Fauthors%2Fjotony-guerra-64.webp&amp;w=48&amp;q=75&amp;dpl=dpl_5QZNNA2CFW9uuhs9iZx6B6LmVXoj 1x, /_next/image?url=%2Fauthors%2Fjotony-guerra-64.webp&amp;w=96&amp;q=75&amp;dpl=dpl_5QZNNA2CFW9uuhs9iZx6B6LmVXoj 2x" src="/_next/image?url=%2Fauthors%2Fjotony-guerra-64.webp&amp;w=96&amp;q=75&amp;dpl=dpl_5QZNNA2CFW9uuhs9iZx6B6LmVXoj"/><span class="landingTestimonial-module__27TYyG__identity"><span class="landingTestimonial-module__27TYyG__name">jotony</span><span class="landingTestimonial-module__27TYyG__role">Software Engineer &amp; TurbineFi User</span></span></div><a class="landingTestimonial-module__27TYyG__sourceLink" href="https://www.linkedin.com/in/jotony-guerra/" target="_blank" rel="noopener noreferrer">View source<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg></a></figcaption></figure></div></div><div class="pointer-events-none absolute left-[-12.5%] top-1/2 flex w-[125%] -translate-y-1/2 justify-between px-2 landingTestimonial-module__27TYyG__navigation"><button type="button" aria-label="Previous slide" class="pointer-events-auto h-fit w-fit rounded-full bg-zinc-50 p-2 transition-opacity duration-300 dark:bg-zinc-950 opacity-100 disabled:opacity-40 landingTestimonial-module__27TYyG__navigationButton" disabled=""><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left stroke-zinc-600 dark:stroke-zinc-50"><path d="m15 18-6-6 6-6"></path></svg></button><button type="button" class="pointer-events-auto h-fit w-fit rounded-full bg-zinc-50 p-2 transition-opacity duration-300 dark:bg-zinc-950 opacity-100 disabled:opacity-40 landingTestimonial-module__27TYyG__navigationButton" aria-label="Next slide"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right stroke-zinc-600 dark:stroke-zinc-50"><path d="m9 18 6-6-6-6"></path></svg></button></div><div class="absolute bottom-0 z-10 flex w-full items-center justify-center landingTestimonial-module__27TYyG__indicators"><div class="flex space-x-2"></div></div></div></div></section></div><section class="belowFold-module__BrtCLG__section" style="opacity:0;transform:translateY(40px)"><header class="belowFold-module__BrtCLG__sectionHeader"><span class="belowFold-module__BrtCLG__kicker">III · Strategies</span><h2 class="belowFold-module__BrtCLG__sectionTitle"><span style="display:inline-block;overflow:hidden;padding-bottom:0.15em"><span style="display:inline-block;opacity:0;filter:blur(6px);transform:translateY(18px)">What<!-- --> </span></span><span style="display:inline-block;overflow:hidden;padding-bottom:0.15em"><span style="display:inline-block;opacity:0;filter:blur(6px);transform:translateY(18px)">you<!-- --> </span></span><span style="display:inline-block;overflow:hidden;padding-bottom:0.15em"><span style="display:inline-block;opacity:0;filter:blur(6px);transform:translateY(18px)">can<!-- --> </span></span><span style="display:inline-block;overflow:hidden;padding-bottom:0.15em"><span style="display:inline-block;opacity:0;filter:blur(6px);transform:translateY(18px)">build.</span></span></h2><p class="belowFold-module__BrtCLG__sectionLede">Six starting points. Every card is an actual prompt you can paste into Studio right now.</p></header><div class="belowFold-module__BrtCLG__strategyGrid"><div style="opacity:0;filter:blur(8px);transform:translateY(30px)"><article class="belowFold-module__BrtCLG__strategyCard"><div class="belowFold-module__BrtCLG__strategyHead"><span class="belowFold-module__BrtCLG__strategyKind">Mean reversion</span><span class="belowFold-module__BrtCLG__strategyDesc">Fade extreme prices on binary markets.</span></div><blockquote class="belowFold-module__BrtCLG__strategyPrompt">“<!-- -->Buy NO on any BTC 15-minute market trading above 85 cents if it has only been there for under 10 minutes.<!-- -->”</blockquote></article></div><div style="opacity:0;filter:blur(8px);transform:translateY(30px)"><article class="belowFold-module__BrtCLG__strategyCard"><div class="belowFold-module__BrtCLG__strategyHead"><span class="belowFold-module__BrtCLG__strategyKind">Momentum fade</span><span class="belowFold-module__BrtCLG__strategyDesc">Short rallies on short-horizon contracts.</span></div><blockquote class="belowFold-module__BrtCLG__strategyPrompt">“<!-- -->When BTC rallies more than 0.4% in 15 minutes and the contract trades above 58 cents, short it for $200.<!-- -->”</blockquote></article></div><div style="opacity:0;filter:blur(8px);transform:translateY(30px)"><article class="belowFold-module__BrtCLG__strategyCard"><div class="belowFold-module__BrtCLG__strategyHead"><span class="belowFold-module__BrtCLG__strategyKind">News reaction</span><span class="belowFold-module__BrtCLG__strategyDesc">Trade polling and headline spikes.</span></div><blockquote class="belowFold-module__BrtCLG__strategyPrompt">“<!-- -->Buy YES on NYC mayoral if three consecutive polls show Mamdani above 52%. Cap position at $500.<!-- -->”</blockquote></article></div><div style="opacity:0;filter:blur(8px);transform:translateY(30px)"><article class="belowFold-module__BrtCLG__strategyCard"><div class="belowFold-module__BrtCLG__strategyHead"><span class="belowFold-module__BrtCLG__strategyKind">Calendar arbitrage</span><span class="belowFold-module__BrtCLG__strategyDesc">Arb weekly against daily.</span></div><blockquote class="belowFold-module__BrtCLG__strategyPrompt">“<!-- -->If the weekly S&amp;P contract trades above the sum of its daily contracts by more than 2 cents, sell the weekly and buy the daily basket.<!-- -->”</blockquote></article></div><div style="opacity:0;filter:blur(8px);transform:translateY(30px)"><article class="belowFold-module__BrtCLG__strategyCard"><div class="belowFold-module__BrtCLG__strategyHead"><span class="belowFold-module__BrtCLG__strategyKind">Event basket</span><span class="belowFold-module__BrtCLG__strategyDesc">Diversify across correlated markets.</span></div><blockquote class="belowFold-module__BrtCLG__strategyPrompt">“<!-- -->Split $1,000 equally across every Fed rate cut market for the next meeting, weighted by open interest.<!-- -->”</blockquote></article></div><div style="opacity:0;filter:blur(8px);transform:translateY(30px)"><article class="belowFold-module__BrtCLG__strategyCard"><div class="belowFold-module__BrtCLG__strategyHead"><span class="belowFold-module__BrtCLG__strategyKind">Volatility harvest</span><span class="belowFold-module__BrtCLG__strategyDesc">Sell premium on stable ranges.</span></div><blockquote class="belowFold-module__BrtCLG__strategyPrompt">“<!-- -->On election markets where both YES and NO have traded between 40 and 60 cents for 24 hours, sell the overpriced side and buy it back.<!-- -->”</blockquote></article></div></div></section><section class="belowFold-module__BrtCLG__section" style="opacity:0;transform:translateY(40px)"><header class="belowFold-module__BrtCLG__sectionHeader"><span class="belowFold-module__BrtCLG__kicker">IV · Platform</span><h2 class="belowFold-module__BrtCLG__sectionTitle"><span style="display:inline-block;overflow:hidden;padding-bottom:0.15em"><span style="display:inline-block;opacity:0;filter:blur(6px);transform:translateY(18px)">Built<!-- --> </span></span><span style="display:inline-block;overflow:hidden;padding-bottom:0.15em"><span style="display:inline-block;opacity:0;filter:blur(6px);transform:translateY(18px)">for<!-- --> </span></span><span style="display:inline-block;overflow:hidden;padding-bottom:0.15em"><span style="display:inline-block;opacity:0;filter:blur(6px);transform:translateY(18px)">event<!-- --> </span></span><span style="display:inline-block;overflow:hidden;padding-bottom:0.15em"><span style="display:inline-block;opacity:0;filter:blur(6px);transform:translateY(18px)">markets.</span></span></h2></header><div class="belowFold-module__BrtCLG__capabilityGrid"><div style="opacity:0;filter:blur(8px);transform:translateY(30px)"><article class="belowFold-module__BrtCLG__capabilityCell" data-featured="true"><div class="belowFold-module__BrtCLG__capabilityIcon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12c0 4-4 7-9 7a10 10 0 0 1-3.5-.6L4 20l1.2-3.5A7 7 0 0 1 3 12c0-4 4-7 9-7s9 3 9 7z"></path></svg></div><h3 class="belowFold-module__BrtCLG__capabilityTitle">Plain English in, logic out.</h3><p class="belowFold-module__BrtCLG__capabilityDesc"><span class="brand-copy-turbine">Describe a strategy, see the rules Turbine wrote. Edit by chatting. Nothing you cannot inspect.</span><span class="brand-copy-mangrove">Describe a strategy, see the rules Mangrove wrote. Edit by chatting. Nothing you cannot inspect.</span></p></article></div><div style="opacity:0;filter:blur(8px);transform:translateY(30px)"><article class="belowFold-module__BrtCLG__capabilityCell" data-featured="false"><div class="belowFold-module__BrtCLG__capabilityIcon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 17l5-5 4 4 9-9"></path><path d="M14 7h7v7"></path></svg></div><h3 class="belowFold-module__BrtCLG__capabilityTitle">Thirty-day Kalshi replay.</h3><p class="belowFold-module__BrtCLG__capabilityDesc">Every backtest runs on historical Kalshi market data. Not synthetic prices, not a hand-wavy sim.</p></article></div><div style="opacity:0;filter:blur(8px);transform:translateY(30px)"><article class="belowFold-module__BrtCLG__capabilityCell" data-featured="false"><div class="belowFold-module__BrtCLG__capabilityIcon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.5 19H7a5 5 0 1 1 1.5-9.8A6 6 0 0 1 20 10a4.5 4.5 0 0 1-2.5 9z"></path></svg></div><h3 class="belowFold-module__BrtCLG__capabilityTitle">Cloud execution, always on.</h3><p class="belowFold-module__BrtCLG__capabilityDesc">Strategies run in isolated sandboxes, around the clock, until you pause them. Close your laptop.</p></article></div><div style="opacity:0;filter:blur(8px);transform:translateY(30px)"><article class="belowFold-module__BrtCLG__capabilityCell" data-featured="false"><div class="belowFold-module__BrtCLG__capabilityIcon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8.5" cy="14.5" r="3.5"></circle><path d="M11 12l9-9"></path><path d="M16 7l3 3"></path></svg></div><h3 class="belowFold-module__BrtCLG__capabilityTitle">Your keys, your control.</h3><p class="belowFold-module__BrtCLG__capabilityDesc">API keys stay stored on your specially-provisioned sandbox. Stop a strategy and positions stop immediately.</p></article></div></div><div class="belowFold-module__BrtCLG__venueStrip"><span class="belowFold-module__BrtCLG__venueLabel">Where it plugs in</span><span class="belowFold-module__BrtCLG__venueItem" data-state="live"><span class="belowFold-module__BrtCLG__venueDot"></span>Kalshi<span class="belowFold-module__BrtCLG__venueNote">live</span></span><span class="belowFold-module__BrtCLG__venueItem" data-state="live"><span class="belowFold-module__BrtCLG__venueDot"></span>Polymarket<span class="belowFold-module__BrtCLG__venueNote">live</span></span><span class="belowFold-module__BrtCLG__venueItem" data-state="soon">Manifold<span class="belowFold-module__BrtCLG__venueNote">coming soon</span></span></div></section><section class="belowFold-module__BrtCLG__pricingSection" style="opacity:0;transform:translateY(40px)"><header class="belowFold-module__BrtCLG__sectionHeader"><span class="belowFold-module__BrtCLG__kicker">V · Pricing</span><h2 class="belowFold-module__BrtCLG__sectionTitle">Start small. Scale when you need it.</h2></header><div class="belowFold-module__BrtCLG__pricingLayout"><div class="belowFold-module__BrtCLG__pricingHero"><div class="belowFold-module__BrtCLG__pricingBadge">Starter</div><div class="belowFold-module__BrtCLG__pricingFigureWrap"><span class="belowFold-module__BrtCLG__pricingCurrency">$</span><span class="belowFold-module__BrtCLG__pricingFigure">19</span><span class="belowFold-module__BrtCLG__pricingUnit">/ month</span></div><p class="belowFold-module__BrtCLG__pricingLede">Start at $19/month with 10 deploys per week. Cancel anytime.</p><a class="belowFold-module__BrtCLG__pricingCta" href="/studio?view=dashboard">Build a bot</a></div><dl class="belowFold-module__BrtCLG__pricingList"><div class="belowFold-module__BrtCLG__pricingRow" data-tier="current"><dt><span class="belowFold-module__BrtCLG__pricingPlanName">Starter</span><span class="belowFold-module__BrtCLG__pricingPlanNote">10 deploys per week, every supported bot type, and the full strategy workflow.</span></dt><dd><span class="belowFold-module__BrtCLG__pricingRowPriceLine"><span class="belowFold-module__BrtCLG__pricingRowFigure">$19</span><span class="belowFold-module__BrtCLG__pricingRowUnit">/mo</span></span><span class="belowFold-module__BrtCLG__pricingRowFigureNote">Billed monthly.</span></dd></div><div class="belowFold-module__BrtCLG__pricingRow" data-tier="next"><dt><span class="belowFold-module__BrtCLG__pricingPlanName">Basic · Pro</span><span class="belowFold-module__BrtCLG__pricingPlanNote">100 or 400 deploys per week, with concierge support on Pro.</span></dt><dd><span class="belowFold-module__BrtCLG__pricingRowPriceLine"><span class="belowFold-module__BrtCLG__pricingRowFigure">$99 · $199</span><span class="belowFold-module__BrtCLG__pricingRowUnit">/mo</span></span></dd></div></dl></div></section><section class="belowFold-module__BrtCLG__finalCta"><div class="belowFold-module__BrtCLG__finalCtaInner"><h2 class="belowFold-module__BrtCLG__finalCtaTitle"><span style="display:inline-block;overflow:hidden;padding-bottom:0.15em"><span style="display:inline-block;opacity:0;filter:blur(6px);transform:translateY(18px)">Your<!-- --> </span></span><span style="display:inline-block;overflow:hidden;padding-bottom:0.15em"><span style="display:inline-block;opacity:0;filter:blur(6px);transform:translateY(18px)">next<!-- --> </span></span><span style="display:inline-block;overflow:hidden;padding-bottom:0.15em"><span style="display:inline-block;opacity:0;filter:blur(6px);transform:translateY(18px)">trad