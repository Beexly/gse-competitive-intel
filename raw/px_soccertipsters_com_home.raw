	$(document).ready(function() { 

		$('img').each(function(){  
			var attr = $(this).attr('alt');
			if (typeof attr == typeof undefined || attr == false) {
				var $img = $(this);  
				var filename = $img.attr('src')  
				if (typeof attr == typeof undefined || attr == false) {
					$img.attr('alt', filename.substring((filename.lastIndexOf('/'))+1, filename.lastIndexOf('.')));
				}  
			}
		});  
	});  
	//]]>  
</script>
