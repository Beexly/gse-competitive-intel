[{"url":"https://api.github.com/repos/eddwebster/football_analytics/issues/32","repository_url":"https://api.github.com/repos/eddwebster/football_analytics","labels_url":"https://api.github.com/repos/eddwebster/football_analytics/issues/32/labels{/name}","comments_url":"https://api.github.com/repos/eddwebster/football_analytics/issues/32/comments","events_url":"https://api.github.com/repos/eddwebster/football_analytics/issues/32/events","html_url":"https://github.com/eddwebster/football_analytics/pull/32","id":5155610445,"node_id":"PR_kwDOEWfg0M7_S4UQ","number":32,"title":"Add ParlayJobs","user":{"login":"parlayjobs","id":190293979,"node_id":"U_kgDOC1en2w","avatar_url":"https://avatars.githubusercontent.com/u/190293979?v=4","gravatar_id":"","url":"https://api.github.com/users/parlayjobs","html_url":"https://github.com/parlayjobs","followers_url":"https://api.github.com/users/parlayjobs/followers","following_url":"https://api.github.com/users/parlayjobs/following{/other_user}","gists_url":"https://api.github.com/users/parlayjobs/gists{/gist_id}","starred_url":"https://api.github.com/users/parlayjobs/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/parlayjobs/subscriptions","organizations_url":"https://api.github.com/users/parlayjobs/orgs","repos_url":"https://api.github.com/users/parlayjobs/repos","events_url":"https://api.github.com/users/parlayjobs/events{/privacy}","received_events_url":"https://api.github.com/users/parlayjobs/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-08-14T21:00:58Z","updated_at":"2026-08-14T21:00:58Z","closed_at":null,"assignee":null,"author_association":"NONE","active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/eddwebster/football_analytics/pulls/32","html_url":"https://github.com/eddwebster/football_analytics/pull/32","diff_url":"https://github.com/eddwebster/football_analytics/pull/32.diff","patch_url":"https://github.com/eddwebster/football_analytics/pull/32.patch","merged_at":null},"body":"ParlayJobs is a specialist careers platform covering sports prediction, football and sports analytics, iGaming, trading, data science and betting technology. Many of the analytics companies and employers featured in this repository regularly appear on ParlayJobs, alongside operators, suppliers and technology companies working across the wider sports data ecosystem.\r\n\r\nRather than aggregating jobs indiscriminately, ParlayJobs only collects roles from a pre-approved list of relevant employers. Listings are sourced directly from company career pages and applicant tracking systems, which helps reduce fake, duplicated, expired or unrelated jobs that are common on broader aggregators. The site includes dedicated analytics and data roles, as well as remote opportunities across the sector.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/eddwebster/football_analytics/issues/32/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/eddwebster/football_analytics/issues/32/timeline","performed_via_github_app":null,"state_reason":null},{"url":"https://api.github.com/repos/eddwebster/football_analytics/issues/17","repository_url":"https://api.github.com/repos/eddwebster/football_analytics","labels_url":"https://api.github.com/repos/eddwebster/football_analytics/issues/17/labels{/name}","comments_url":"https://api.github.com/repos/eddwebster/football_analytics/issues/17/comments","events_url":"https://api.github.com/repos/eddwebster/football_analytics/issues/17/events","html_url":"https://github.com/eddwebster/football_analytics/issues/17","id":4747350597,"node_id":"I_kwDOEWfg0M8AAAABGvbSRQ","number":17,"title":"Resource suggestion: World Cup AI Forecast","user":{"login":"erick-huazi","id":291658573,"node_id":"U