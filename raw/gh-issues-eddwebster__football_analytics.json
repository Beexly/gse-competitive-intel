_analytics/issues/17/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/eddwebster/football_analytics/issues/17/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null},{"url":"https://api.github.com/repos/eddwebster/football_analytics/issues/16","repository_url":"https://api.github.com/repos/eddwebster/football_analytics","labels_url":"https://api.github.com/repos/eddwebster/football_analytics/issues/16/labels{/name}","comments_url":"https://api.github.com/repos/eddwebster/football_analytics/issues/16/comments","events_url":"https://api.github.com/repos/eddwebster/football_analytics/issues/16/events","html_url":"https://github.com/eddwebster/football_analytics/pull/16","id":4719793218,"node_id":"PR_kwDOEWfg0M7pVTRh","number":16,"title":"Add Probaball to Odds, Betting, and Predictions data","user":{"login":"perkarlberg","id":14176857,"node_id":"MDQ6VXNlcjE0MTc2ODU3","avatar_url":"https://avatars.githubusercontent.com/u/14176857?v=4","gravatar_id":"","url":"https://api.github.com/users/perkarlberg","html_url":"https://github.com/perkarlberg","followers_url":"https://api.github.com/users/perkarlberg/followers","following_url":"https://api.github.com/users/perkarlberg/following{/other_user}","gists_url":"https://api.github.com/users/perkarlberg/gists{/gist_id}","starred_url":"https://api.github.com/users/perkarlberg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/perkarlberg/subscriptions","organizations_url":"https://api.github.com/users/perkarlberg/orgs","repos_url":"https://api.github.com/users/perkarlberg/repos","events_url":"https://api.github.com/users/perkarlberg/events{/privacy}","received_events_url":"https://api.github.com/users/perkarlberg/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-06-22T19:09:43Z","updated_at":"2026-06-22T19:09:43Z","closed_at":null,"assignee":null,"author_association":"NONE","active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/eddwebster/football_analytics/pulls/16","html_url":"https://github.com/eddwebster/football_analytics/pull/16","diff_url":"https://github.com/eddwebster/football_analytics/pull/16.diff","patch_url":"https://github.com/eddwebster/football_analytics/pull/16.patch","merged_at":null},"body":"Adds [Probaball](https://probaball.online), a free, open data-science forecast of the 2026 FIFA World Cup.\n\nIt blends Elo ratings (walk-forward over ~50k internationals), de-vigged bookmaker odds, and expert predictions (40/40/20), runs a 50,000-run Monte Carlo of the tournament, updates daily during the cup, ships in 6 languages, and — unusually — publishes its own out-of-sample accuracy (Ranked Probability Score / calibration) on an evaluation page.\n\nAdded as a single row in **Data Sources → Odds, Betting, and Predictions data**, next to the FiveThirtyEight Soccer Predictions entry. It's a transparent research/model resource (not a betting/affiliate site). No image/asset changes.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/eddwebster/football_analytics/issues/16/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/eddwebster/football_analytics/issues/16/timeline","performed_via_github_app":null,"state_reason":null},{"url":"https://api.github.com/repos/eddwebster/football_analytics/issues/15","repository_url":"https://api.github.com/repos/eddwebster/football_analytics","labels_url":"https://api.github.com/repos/eddwebster/football_analytics/issues/15/labels{/name}","comments_url":"https://api.github.com/repos/eddwebster/football_analytics/issues/15/comments","events_url":"https://api.github.com/repos/eddwebster/football_analytics/issues/15/event