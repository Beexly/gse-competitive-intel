        <path d="M100.508 10.9742L104.088 15.764H104.248L107.806 10.9742H109.859V22.3784H107.578V14.3955H107.533C107.533 14.3955 107.304 15.1253 106.894 15.6727L105.297 17.8167H103.016L101.42 15.6727C101.009 15.1253 100.781 14.3955 100.781 14.3955H100.736V22.3784H98.4548V10.9742H100.508Z" fill="black"/>
        <path d="M114.886 22.3784H112.605V10.9742H114.886V22.3784Z" fill="black"/>
        <path d="M122.526 20.5537C124.602 20.5537 125.72 19.9607 125.72 18.8887C125.72 17.9764 124.716 17.5886 122.435 17.5886C118.832 17.5886 117.281 16.6307 117.281 14.327C117.281 12.0006 119.105 10.7462 122.526 10.7462C125.674 10.7462 127.772 12.2059 127.772 14.3955H125.492C125.492 13.4375 124.305 12.7989 122.526 12.7989C120.588 12.7989 119.561 13.3235 119.561 14.327C119.561 15.1938 120.474 15.5359 122.64 15.5359C126.404 15.5359 128 16.5623 128 18.8887C128 21.3064 126.085 22.6064 122.526 22.6064C119.242 22.6064 117.052 21.1467 117.052 18.9571H119.333C119.333 19.9151 120.611 20.5537 122.526 20.5537Z" fill="black"/>
      </svg>
    </div>

    <div id="artemis-stack"></div>

    <div id="artemis-dots"></div>

    <div id="artemis-fx-picker">
    </div>
  </div>
</div>

<script>
(function () {
  // ---------- CONFIG ----------
  // Add, remove, or edit slides here — each needs its own caption and image.
  // UPLOAD TO WEBFLOW: replace each image URL with your own asset URL.
  var slides = [
    { caption: "Here's to my Yeh Yeh who invested in the financial markets in the 1970s and earned enough money to send my dad to college.", image: "https://cdn.prod.website-files.com/6a1af09ea29541e23fb54cc8/6a74e82da1cda3b5662a2689_jon.avif" },
    { caption: "Here's to my Dad who wanted to break into Wall Street in the 1970s and got me into investing", image: "https://cdn.prod.website-files.com/6a1af09ea29541e23fb54cc8/6a76075d851983ff83af26c0_anthony-yim-signed-photo%20(1).avif" },
    { caption: "Here's to Artemis, the thesis investment platform for all. From the most famous hedge funds to independent analysts to everyday investors, Artemis is here to give you superpowers so you can be a world-class investor with AI.", image: "https://cdn.prod.website-files.com/6a1af09ea29541e23fb54cc8/6a6a43320f27820ac8809878_team-image.avif" }
  ];

  var fxList = [
    { id: "toss",    label: "Toss",    anim: "fxToss .72s cubic-bezier(.4,0,.7,1)"     },
    { id: "zoom",    label: "Zoom",    anim: "fxZoom .6s cubic-bezier(.5,0,.9,.6)"      },
    { id: "flip",    label: "Flip",    anim: "fxFlip .65s cubic-bezier(.5,0,.6,1)"      },
    { id: "shuffle", label: "Shuffle", anim: "fxShuffle .78s cubic-bezier(.4,0,.5,1)"   },
    { id: "lift",    label: "Lift",    anim: "fxLift .7s cubic-bezier(.55,0,.6,1)"      }
  ];

  // ---------- STATE ----------
  var state = { i: 0, done: false, exiting: false, fx: "lift" };
  var timer = null;

  // ---------- LOCAL STORAGE (show intro once, then re-show after expiry) ----------
  var INTRO_SEEN_KEY = 'artemisIntroSeen';
  var INTRO_EXPIRY_MS = 1000 * 60 * 60 * 24 * 30 * 4; // ~4 months (30-day months)

  function hasSeenIntro() {
    try {
      var raw = localStorage.getItem(INTRO_SEEN_KEY);
      if (!raw) return false;
      var seenAt = parseInt(raw, 10);
      if (isNaN(seenAt)) return false;
      // Expired? Treat as not-seen and clean up the stale key.
      if (Date.now() - seenAt > INTRO_EXPIRY_MS) {
        localStorage.removeItem(INTRO_SEEN_KEY);
        return false;
      }
      return true;
    } catch (e) {
      return false; // localStorage unavailable (privacy mode, etc.) — fail silently
    }
  }
  function markIntroSeen() {
    try { localStorage.setItem(INTRO_SEEN_KEY, String(Date.now())); }
    catch (e) { /* localStorage unavailable — fail silently */ }
  }
  if (hasSeenIntro()) {
    state.done = true; // skip straight past the intro, no flash of slides
  }

  // ---------- DOM refs ----------
  var stackEl   = document.getElementById('artemis-stack');
  var dotsEl    = document.getElementById('artemis-dots');
  var fxPicker  = document.getElementById('artemis-fx-picker');
  var introEl   = document.querySelector('.artemis-intro');

  var jitter = [
    { r: -2.1, x: -6, y: 2 },
    { r: 1.7,  x: 8,  y: -4 },
    { r: -1.1, x: 2,  y: 5 },
    { r: 2.4,  x: -4, y: -2 }
  ];

  // ---------- CARD DOM (built once, then mutated) ----------
  var cardRefs = [];
  function buildCards() {
    stackEl.innerHTML = '';
    cardRefs = [];
    slides.forEach(function (slide, k) {
      var wrap = document.createElement('div');
      wrap.className = 'ai-card-wrap';

      var card = document.createElement('div');
      card.className = 'ai-card';

      var img = document.createElement('img');
      img.src = slide.image;
      img.alt = '';
      card.appendChild(img);

      var body = document.createElement('div');
      body.className = 'ai-card-body';

      var p = document.createElement('p');
      p.className = 'ai-caption';
      p.textContent = slide.caption;
      body.appendChild(p);

      var footer = document.createElement('div');
      footer.className = 'ai-card-footer';

      var skipBtn = document.createElement('button');
      skipBtn.className = 'ai-skip';
      skipBtn.textContent = 'Skip';
      skipBtn.onclick = skip;
      footer.appendChild(skipBtn);

      var nextWrap = document.createElement('div');
      nextWrap.className = 'ai-next-wrap';

      var counter = document.createElement('span');
      counter.className = 'ai-counter';
      counter.textContent = (k + 1) + ' / ' + slides.length;
      nextWrap.appendChild(counter);

      var nextBtn = document.createElement('button');
      nextBtn.className = 'ai-next';
      nextBtn.textContent = k === slides.length - 1 ? 'Enter' : 'Next';
      nextBtn.onclick = next;
      nextWrap.appendChild(nextBtn);

      footer.appendChild(nextWrap);
      body.appendChild(footer);
      card.appendChild(body);
      wrap.appendChild(card);
      stackEl.appendChild(wrap);

      cardRefs.push({ wrap: wrap, card: card, p: p, footer: footer });
    });
  }

  function updateCards(i) {
    cardRefs.forEach(function (ref, k) {
      var d = k - i;
      var gone = d < 0;
      var j = jitter[k % 4];
      var tf = gone
        ? 'translate(-30px,-38px) rotate(' + (j.r - 6) + 'deg) scale(.96)'
        : 'translate(' + (j.x + d * 10) + 'px,' + (j.y + d * 12) + 'px) rotate(' + j.r + 'deg) scale(' + (1 - d * .018) + ')';

      ref.wrap.style.transform = tf;
      ref.wrap.style.opacity = gone ? '0' : '1';
      ref.wrap.style.pointerEvents = d === 0 ? 'auto' : 'none';
      ref.wrap.style.zIndex = 100 - Math.abs(d);

      ref.card.style.boxShadow = '0 ' + (22 - d * 5) + 'px ' + (44 - d * 10) + 'px rgba(0,0,0,' + (.19 - d * .045) + '),0 2px 6px rgba(0,0,0,.09)';
      ref.card.style.filter = 'brightness(' + (1 - d * .035) + ')';

      ref.p.style.visibility = d === 0 ? 'visible' : 'hidden';
      ref.footer.style.visibility = d === 0 ? 'visible' : 'hidden';
    });
  }

  // Cards are position:absolute (so they can overlap in the jittered
  // stack), which means #artemis-stack has no natural height of its own.
  // Since card height now varies with viewport width (responsive image +
  // wrapping caption text), measure the active card and size the stack
  // to match — re-run on every render and on resize.
  function syncStackHeight() {
    var i = Math.min(state.i, cardRefs.length - 1);
    var activeCard = cardRefs[i] && cardRefs[i].card;
    if (activeCard) {
      stackEl.style.height = activeCard.offsetHeight + 'px';
    }
  }

  function next() {
    if (state.i >= cardRefs.length - 1) { finish(); }
    else { state.i += 1; render(); }
  }
  function skip() {
    state.done = true;
    markIntroSeen();
    render();
  }
  function restart() {
    state.i = 0; state.done = false; state.exiting = false;
    render();
  }
  // Optional: call window.replayArtemisIntro() from any button you add
  // elsewhere on the page (e.g. your Webflow homepage) to replay the intro.
  window.replayArtemisIntro = restart;
  function finish() {
    var fx = fxList.filter(function (f) { return f.id === state.fx; })[0] || fxList[0];
    state.exiting = true;
    render();
    clearTimeout(timer);
    var ms = parseFloat(fx.anim.split(" ")[1]) * 1000 - 60;
    timer = setTimeout(function () {
      state.done = true;
      state.exiting = false;
      markIntroSeen();
      render();
    }, ms);
  }
  function pickFx(id) {
    state.fx = id;
    render();
  }

  function render() {
    var n = cardRefs.length;
    var i = Math.min(state.i, n - 1);

    updateCards(i);
    syncStackHeight();

    // --- exit animation on the whole stack ---
    var active = fxList.filter(function (f) { return f.id === state.fx; })[0] || fxList[0];
    if (state.exiting) {
      stackEl.style.animation = active.anim + ' forwards';
    } else {
      stackEl.style.animation = 'none';
    }

    // --- dots ---
    dotsEl.innerHTML = '';
    cardRefs.forEach(function (_, k) {
      var dot = document.createElement('button');
      dot.className = k === i ? 'ai-active' : '';
      dot.onclick = function () { state.i = k; render(); };
      dotsEl.appendChild(dot);
    });

    // --- fx picker ---
    Array.prototype.slice.call(fxPicker.querySelectorAll('button')).forEach(function (b) { b.remove(); });
    fxList.forEach(function (f) {
      var b = document.createElement('button');
      b.textContent = f.label;
      b.className = f.id === state.fx ? 'ai-active' : '';
      b.onclick = function () { pickFx(f.id); };
      fxPicker.appendChild(b);
    });

    // --- screen toggle ---
    // Hiding the intro overlay is all that's needed — whatever page
    // content already exists underneath (built separately in Webflow)
    // shows through automatically. No home/landing markup or class is
    // referenced here.
    introEl.style.display = state.done ? 'none' : 'flex';
  }

  buildCards();

  var resizeTimer = null;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(syncStackHeight, 100);
  });

  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter') return;
    if (state.done || state.exiting) return;
    next();
  });

  render();
})();
</script></div></div><section class="section is-menu"><div class="container"><div class="layout is-menu"><div class="menu-left"><a href="/" aria-label="Back to homepage" id="w-node-cc026ce6-0482-8a7f-2f82-661879c5ce66-79c5ce66" aria-current="page" class="brand w-inline-block w--current"><div class="brand-logo w-embed"><svg width="100%" height="100%" viewBox="0 0 128 34" fill="none" xmlns="http://www.w3.org/2000/svg">
