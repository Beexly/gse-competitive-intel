</head><body><div class="global-styles w-embed"><style>
/* essentials */
body{font-size:1.1111111111111112vw}
.container{max-width:90em; margin: 0 auto; width:100%;}
.w-dropdown-btn,.w-dropdown-link,.w-dropdown-toggle,.w-nav-link,a{color:inherit}
.w-richtext>:first-child{margin-top:0}
.w-richtext ol li:last-child,.w-richtext ul li:last-child,.w-richtext>:last-child{margin-bottom:0}
select{-webkit-appearance:none;-moz-appearance:none;appearance:none;outline:none;}
.w-richtext li ul {margin-top:0em;}
/* custom */
.para-limit {overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;}
.quote-text {overflow: hidden; display: -webkit-box; -webkit-line-clamp: 8; -webkit-box-orient: vertical;}
.weekly-item.is-playing .thumbnail-overlay {opacity: 1;}
.video-screen:hover .button {background-color: var(--text);color: #fff;border-color: var(--text);}
.video-screen:hover .button-icon {background-color: #050505;}
#weeklyTablet {display:none;}
.steps-grid::-webkit-scrollbar {height: 6px; padding: 2px; border-radius: 10px; background: #fff;}
.steps-grid::-webkit-scrollbar-thumb {background: rgba(185, 185, 185, 0.33); border-radius: 50px;} 
.slide-card:has(.slide-link:hover) .link-icon {background-color: var(--text); color: #fff;}
/* attributes */
[data-text-color="black"] {color: var(--text);}
[data-bg-color="black"] {background: var(--text);}
[data-align-content="center"] {margin: 0 auto; text-align: center;}
[data-align-content="right"] {margin-left: auto;}
[data-icon-direction="left"] {direction: rtl;}
[data-icon-direction="left"] .button-icon {margin-right: 0em; margin-left: -1em;}
[data-display="none"] {display: none;}
/* loop tabs */
.loop-tab h4 {opacity: 0; transition: opacity 0.3s ease;}
.loop-tab.w--current h4 {opacity: 1;}
/* media queries */
@media screen and (min-width:1440px){body{font-size:16px}}
@media screen and (max-width:991px){
  body{font-size:14px} #weeklyTablet {display:grid;} #weeklyDesktop {display:none;} .auto-link.w--current {order: -9999;}
}
@media screen and (max-width:767px){
  [mobile-align-center="true"] {margin: 0 auto; text-align: center;}
}
</style></div><div class="intro-slideshow"><div class="w-embed w-script"><style>
  .artemis-intro, .artemis-intro * { box-sizing: border-box; }

  .artemis-intro {
    font-family: Inter, system-ui, sans-serif;
  }

  /* ---- exit animations for the card stack ---- */
  @keyframes fxToss   { 55%{transform:translate(30px,-26px) rotate(6deg);} 100%{transform:translate(-120%,110%) rotate(-34deg);opacity:0;} }
  @keyframes fxZoom   { 100%{transform:scale(2.8);opacity:0;filter:blur(7px);} }
  @keyframes fxFlip   { 35%{transform:perspective(1400px) rotateY(-18deg);} 100%{transform:perspective(1400px) rotateY(-96deg) scale(.88);opacity:0;} }
  @keyframes fxShuffle{ 14%{transform:rotate(-5deg);} 30%{transform:rotate(5deg);} 46%{transform:rotate(-3deg);} 100%{transform:translateY(26px) scale(.14);opacity:0;} }
  @keyframes fxLift   { 20%{transform:translateY(24px) rotate(-2deg);} 100%{transform:translateY(-118vh) rotate(5deg);opacity:.2;} }

  /* ---- intro screen ---- */
  .artemis-intro {
    position: fixed;
    inset: 0;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 24px;
    z-index: 200;
  }
  .intro-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 552px;
  }
  .artemis-intro .artemis-logo-row { width: 100%; display:flex; justify-content:flex-start; margin-bottom:22px; }
  .artemis-intro .artemis-logo-row svg { display:block; height:34px; width:auto; max-width:100%; }

  #artemis-stack {
    position: relative;
    width: 100%;
    height: clamp(420px, 60vh, 544px);
    transform-origin: 50% 55%;
  }
  #artemis-stack.ai-exiting { animation-fill-mode: forwards; }

  .ai-card-wrap {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    transform-origin: 50% 40%;
    transition: opacity .38s ease, transform .46s cubic-bezier(.22,.8,.3,1);
  }
  .ai-card {
    position: relative;
    background: #fff;
    padding: 18px 18px 0;
    border: 1px solid rgba(0,0,0,.07);
    box-sizing: border-box;
    width: 100%;
  }
  .ai-card img { display:block; width:100%; height:auto; aspect-ratio: 470 / 308; object-fit:cover; }
  .ai-card-body { width:100%; box-sizing:border-box; padding:22px 8px 26px; display:flex; flex-direction:column; justify-content:space-between; gap:16px; }
  .ai-caption { margin:0; font:400 16px/1.6 Inter,sans-serif; color:#55524b; text-wrap:pretty; }
  .ai-card-footer { display:flex; align-items:center; justify-content:space-between; }
  .ai-skip { border:none; background:none; color:#a09b91; font:400 12.5px Inter,sans-serif; cursor:pointer; padding:8px 0; }
  .ai-skip:hover { color:#2c2a26; }
  .ai-counter { font:500 11.5px Inter,sans-serif; letter-spacing:.1em; color:#b3ada2; }
  .ai-next { border:none; background:#2c2a26; color:#fff; font:500 12px Inter,sans-serif; letter-spacing:.07em; text-transform:uppercase; padding:12px 26px; cursor:pointer; }
  .ai-next:hover { background:#514c43; }
  .ai-next-wrap { display:flex; align-items:center; gap:16px; }

  #artemis-dots { display:flex; align-items:center; gap:9px; margin-top:60px; position:relative; z-index:950; }
  #artemis-dots button { height:8px; border-radius:999px; border:none; padding:0; cursor:pointer; transition:all .3s ease; background:rgba(44,42,38,.22); }
  #artemis-dots button.ai-active { width:26px; background:#2c2a26; }
  #artemis-dots button:not(.ai-active) { width:8px; }

  #artemis-fx-picker {
    position: fixed; right:20px; bottom:20px; z-index:300;
    display:none; align-items:center; gap:6px;
    background:rgba(255,255,255,.9); border:1px solid rgba(0,0,0,.08);
    border-radius:999px; padding:6px 8px;
  }
  #artemis-fx-picker span { font:500 10px Inter,sans-serif; letter-spacing:.08em; color:#b3ada2; padding:0 4px; }
  #artemis-fx-picker button { border:none; cursor:pointer; border-radius:999px; padding:5px 10px; font:500 10.5px Inter,sans-serif; background:transparent; color:#8b867d; }
  #artemis-fx-picker button.ai-active { background:#2c2a26; color:#fff; }
</style>

<!-- ===== INTRO SLIDESHOW ===== -->
<div class="artemis-intro">
  <div class="intro-container">
    <div class="artemis-logo-row">
