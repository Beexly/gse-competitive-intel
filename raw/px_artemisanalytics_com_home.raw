<path d="M58.6553 22.3784V10.9742H66.8663C68.9191 10.9742 70.2875 12.3427 70.2875 14.3955C70.2875 16.2201 69.1015 17.4974 67.2997 17.6799C67.4593 17.8623 67.619 18.0676 67.7102 18.2273L70.2875 22.3784H67.7102L64.8136 17.7027H60.9362V22.3784H58.6553ZM60.9362 15.6499H66.8663C67.5506 15.6499 68.0067 15.1938 68.0067 14.5095V14.1674C68.0067 13.4831 67.5506 13.027 66.8663 13.027H60.9362V15.6499Z" fill="black"/>
<path d="M71.5393 13.027V10.9742H82.9435V13.027H78.3818V22.3784H76.101V13.027H71.5393Z" fill="black"/>
<path d="M96.06 13.027H87.1648V15.6499H93.7791V17.7027H87.1648V20.3256H96.06V22.3784H84.8839V10.9742H96.06V13.027Z" fill="black"/>
<path d="M100.508 10.9742L104.088 15.764H104.248L107.806 10.9742H109.859V22.3784H107.578V14.3955H107.533C107.533 14.3955 107.304 15.1253 106.894 15.6727L105.297 17.8167H103.016L101.42 15.6727C101.009 15.1253 100.781 14.3955 100.781 14.3955H100.736V22.3784H98.4548V10.9742H100.508Z" fill="black"/>
<path d="M114.886 22.3784H112.605V10.9742H114.886V22.3784Z" fill="black"/>
