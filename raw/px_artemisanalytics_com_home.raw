<path d="M9.37521 3V7.875C9.37521 7.97446 9.3357 8.06984 9.26537 8.14017C9.19505 8.21049 9.09967 8.25 9.00021 8.25C8.90075 8.25 8.80537 8.21049 8.73504 8.14017C8.66472 8.06984 8.62521 7.97446 8.62521 7.875V3.90516L3.26552 9.26531C3.19516 9.33568 3.09972 9.37521 3.00021 9.37521C2.9007 9.37521 2.80526 9.33568 2.7349 9.26531C2.66453 9.19495 2.625 9.09951 2.625 9C2.625 8.90049 2.66453 8.80505 2.7349 8.73469L8.09505 3.375H4.12521C4.02575 3.375 3.93037 3.33549 3.86004 3.26517C3.78972 3.19484 3.75021 3.09946 3.75021 3C3.75021 2.90054 3.78972 2.80516 3.86004 2.73484C3.93037 2.66451 4.02575 2.625 4.12521 2.625H9.00021C9.09967 2.625 9.19505 2.66451 9.26537 2.73484C9.3357 2.80516 9.37521 2.90054 9.37521 3Z" fill="currentColor"/>
