<!-- Icon Hover Effect -->
<script>
document.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll(".button").forEach(button => {
    const icons = button.querySelectorAll(".svg-icon.has-effect");
    if (!icons.length) return;
    button.addEventListener("mouseenter", () => {
      icons.forEach(icon => {
        icon.style.transform = "translate(100%, -100%)";
      });
    });
    button.addEventListener("mouseleave", () => {
      icons.forEach(icon => {
        icon.style.transform = "translate(0%, 0%)";
      });
    });
  });
});
</script>
<script>
document.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll('a[data-no-hover="true"]').forEach(link => {
    const clickable = link.closest(".clickable");
    const button = clickable?.closest(".button");
    if (!button) return;
    button.querySelectorAll(".svg-icon.has-effect").forEach(icon => {
      icon.classList.remove("has-effect");
    });
  });
});
</script><script src="https://cdn.jsdelivr.net/npm/typed.js@2.0.12"></script>
