shrink-0 flex items-center justify-center" style="width:180px;height:90px"><img alt="ProphetX logo" loading="lazy" width="180" height="90" decoding="async" data-nimg="1" class="object-contain filter brightness-0 invert opacity-90 hover:opacity-100 transition-opacity duration-300 max-w-full max-h-full" style="color:transparent" srcSet="/_next/image?url=%2Fassets%2Flogos%2Fprophetx.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fassets%2Flogos%2Fprophetx.png&amp;w=384&amp;q=75 2x" src="/_next/image?url=%2Fassets%2Flogos%2Fprophetx.png&amp;w=384&amp;q=75"/></div></div></div><div class="absolute top-0 left-0 bottom-0 w-24 bg-gradient-to-r from-[#e67307] to-transparent pointer-events-none"></div><div class="absolute top-0 right-0 bottom-0 w-24 bg-gradient-to-l from-[#e67307] to-transparent pointer-events-none"></div></div></div></section></div><div class="" style="opacity:0;transform:translateY(50px)"><section class="bg-white py-20"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="text-center mb-16"><h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Try the API Live</h2><p class="text-lg text-gray-600 mb-2">Test our Markets and Price History APIs with real data</p><p class="text-gray-500 mb-6">No API keys required. Experience the power of unified prediction market data with our interactive API tester.</p><a href="https://docs.polyrouter.io" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-6 py-3 bg-[#ff8308] text-white rounded-lg hover:bg-[#e6730a] transition-colors font-medium text-sm">Read the Docs<svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg></a></div><div class="bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden"><div class="flex border-b border-gray-200"><button class="flex-1 px-3 py-4 text-sm font-medium transition-colors text-white bg-[#ff8308] border-b-2 border-[#ff8308]"><span class="hidden sm:inline">Markets API</span><span class="sm:hidden">Markets</span></button><button class="flex-1 px-3 py-4 text-sm font-medium transition-colors text-gray-600 hover:text-[#ff8308]"><span class="hidden sm:inline">Price History API</span><span class="sm:hidden">History</span></button></div><div class="grid lg:grid-cols-2 gap-0"><div class="p-4 sm:p-8 border-r-0 lg:border-r border-gray-200 border-b lg:border-b-0"><div class="space-y-6"><div><h3 class="text-lg sm:text-xl font-bold text-gray-900 mb-2">Markets API</h3><p class="text-sm sm:text-base text-gray-600">Get real-time market data from multiple prediction market platforms with advanced filtering.</p></div><div class="grid grid-cols-1 sm:grid-cols-2 gap-4"><div><label class="block text-sm font-medium text-gray-700 mb-2">Platform</label><select class="w-full px-2 sm:px-3 py-2 border border-gray-300 rounded-md text-gray-900 focus:ring-2 focus:ring-[#ff8308] focus:border-[#ff8308] text-sm"><option value="polymarket">Polymarket</option><option value="kalshi" selected="">Kalshi</option><option value="manifold">Manifold</option><option value="limitless">Limitless</option></select></div><div><label class="block text-sm font-medium text-gray-700 mb-2">Status</label><select class="w-full px-2 sm:px-3 py-2 border border-gray-300 rounded-md text-gray-900 focus:ring-2 focus:ring-[#ff8308] focus:border-[#ff8308] text-sm"><option value="open" selected="">Open</option><option value="closed">Closed</option><option value="resolved">Resolved</option></select></div><div><label class="block text-sm font-medium text-gray-700 mb-2">Limit</label><input type="number" class="w-full px-2 sm:px-3 py-2 border border-gray-300 rounded-md text-gray-900 focus:ring-2 focus:ring-[#ff8308] focus:border-[#ff8308] text-sm" min="1" max="100" value="10"/></div><div class="flex items-center"><label class="flex items-center cursor-pointer"><input type="checkbox" class="w-4 h-4 text-[#ff8308] border-gray-300 rounded focus:ring-[#ff8308] focus:ring-2"/><span class="ml-2 text-sm font-medium text-gray-700">Include Raw Response</span></label></div></div><button class="w-full px-4 sm:px-6 py-3 bg-[#ff8308] text-white rounded-lg hover:bg-[#e6730a] disabled:opacity-50 disabled:cursor-not-allowed font-medium text-sm sm:text-base"><span class="hidden sm:inline">Test Markets API</span><span class="sm:hidden">Test Markets</span></button></div></div><div class="p-4 sm:p-8 bg-gray-50"><div class="mb-4"><h3 class="text-lg sm:text-xl font-bold text-gray-900 mb-2">API Response</h3><p class="text-sm sm:text-base text-gray-600">Real-time data from our unified prediction market APIs.</p></div><div class="mt-6 flex items-center justify-center h-64 bg-gray-100 rounded-lg border-2 border-dashed border-gray-300"><div class="text-center"><svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg><p class="mt-2 text-sm text-gray-500">API response will appear here</p></div></div></div></div></div></div></section></div><div class="" style="opacity:0;transform:translateY(50px)"><section class="bg-white py-20"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="text-center mb-16"><h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Why choose PolyRouter?</h2><p class="text-lg text-gray-600 mb-2">The only API that connects to every major prediction market</p><p class="text-gray-500">Stop building multiple integrations. Get unified access to all prediction markets through our powerful, developer-friendly APIs.</p></div><div class="grid md:grid-cols-3 gap-8"><a href="https://docs.polyrouter.io" target="_blank" rel="noopener noreferrer" class="bg-white rounded-xl shadow-lg border border-gray-100 p-8 hover:shadow-xl transition-shadow duration-300 text-center cursor-pointer flex flex-col" style="opacity:0;transform:translateY(30px)"><div class="mb-6 flex justify-center" style="transform:scale(0)"><div class="w-12 h-12 bg-[#ff8308] rounded-lg flex items-center justify-center"><svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg></div></div><h3 class="text-xl font-bold text-gray-900 mb-4">Unified REST API</h3><p class="text-gray-600 leading-relaxed mb-6">One API call gets you data from Polymarket, Kalshi, Manifold, and more. Includes specialized endpoints for sports markets and cross-platform analysis.</p><div class="mt-auto"><span class="inline-flex items-center px-4 py-2 bg-[#ff8308] text-white rounded-lg hover:bg-[#e6730a] transition-colors font-medium text-sm">Read the Docs<svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg></span></div></a><a href="https://docs.polyrouter.io/api-reference/sports" target="_blank" rel="noopener noreferrer" class="bg-white rounded-xl shadow-lg border border-gray-100 p-8 hover:shadow-xl transition-shadow duration-300 text-center cursor-pointer flex flex-col" style="opacity:0;transform:translateY(30px)"><div class="mb-6 flex justify-center" style="transform:scale(0)"><div class="w-12 h-12 bg-[#ff8308] rounded-lg flex items-center justify-center"><svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg></div></div><h3 class="text-xl font-bold text-gray-900 mb-4">Custom Sports Endpoints</h3><p class="text-gray-600 leading-relaxed mb-6">Purpose-built endpoints for sports betting markets. Get games, futures, awards, and league data across NFL, NBA, MLB, NHL, and more.</p><div class="mt-auto"><span class="inline-flex items-center px-4 py-2 bg-[#ff8308] text-white rounded-lg hover:bg-[#e6730a] transition-colors font-medium text-sm">Read the Docs<svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg></span></div></a><a href="https://github.com/fieldviolence/polyrouter-mcp" target="_blank" rel="noopener noreferrer" class="bg-white rounded-xl shadow-lg border border-gray-100 p-8 hover:shadow-xl transition-shadow duration-300 text-center cursor-pointer flex flex-col" style="opacity:0;transform:translateY(30px)"><div class="mb-6 flex justify-center" style="transform:scale(0)"><div class="w-12 h-12 bg-[#ff8308] rounded-lg flex items-center justify-center"><svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg></div></div><h3 class="text-xl font-bold text-gray-900 mb-4">PolyRouter MCP</h3><p class="text-gray-600 leading-relaxed mb-6">Use prediction markets directly in Claude Code and AI assistants. Our MCP server brings real-time market data to your AI workflows.</p><div class="mt-auto"><span class="inline-flex items-center px-4 py-2 bg-[#ff8308] text-white rounded-lg hover:bg-[#e6730a] transition-colors font-medium text-sm">Read the Docs<svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg></span></div></a></div></div></section></div><div class="" style="opacity:0;transform:translateY(50px)"><section class="bg-white py-20"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="grid lg:grid-cols-2 gap-12 items-center"><div style="opacity:0;transform:translateX(-50px)"><video src="/assets/videos/final_final_fr.mov" autoPlay="" loop="" muted="" playsInline="" class="w-full h-auto object-contain rounded-xl"></video></div><div class="text-gray-900" style="opacity:0;transform:translateX(50px)"><h2 class="text-3xl md:text-4xl font-bold mb-6">Built by prediction market builders</h2><p class="text-lg text-gray-700 mb-6 leading-relaxed">We&#x27;re backed by real builders who have created and scaled prediction market infrastructure. Get started today with the best unified prediction market API. Sign up and get your API key in seconds.</p><div class="space-y-4 mb-8"><div class="flex items-start space-x-3" style="opacity:0;transform:translateX(20px)"><div class="flex-shrink-0 w-6 h-6 bg-[#ff8308] rounded-full flex items-center justify-center mt-1" style="transform:scale(0)"><svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg></div><p class="text-gray-700"><strong>Built by builders</strong> <!-- -->who have hands-on experience creating prediction market infrastructure</p></div><div class="flex items-start space-x-3" style="opacity:0;transform:translateX(20px)"><div class="flex-shrink-0 w-6 h-6 bg-[#ff8308] rounded-full flex items-center justify-center mt-1" style="transform:scale(0)"><svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rul