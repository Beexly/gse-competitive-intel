							<div
								class="acc-section content float-start w-full   px-[25px] pb-[30px] hidden">
								<div class="p-pdf_iframe__page" aria-label="Page 1" data-page-number="1">
<div class="textLayer" data-main-rotation="0"><span dir="ltr" role="presentation">●</span> <span dir="ltr" role="presentation">Tx FUSION ODDS</span> <span dir="ltr" role="presentation">— Ultra-low-latency live odds at 8–10ms</span><br role="presentation" /><span dir="ltr" role="presentation">●</span> <span dir="ltr" role="presentation">Tx SCORES</span> <span dir="ltr" role="presentation">— Verified in-venue data for US college football and basketball</span><br role="presentation" /><span dir="ltr" role="presentation">●</span> <span dir="ltr" role="presentation">Tx LAB</span> <span dir="ltr" role="presentation">— Historical odds archive with 5M+ fixtures for backtesting and model</span><br role="presentation" /><span dir="ltr" role="presentation">development</span><br role="presentation" /><span dir="ltr" role="presentation">●</span> <span dir="ltr" role="presentation">Tx SOCCER ELITE</span> <span dir="ltr" role="presentation">— Lacerta-powered soccer pricing across 350+ leagues</span><br role="presentation" /><span dir="ltr" role="presentation">●</span> <span dir="ltr" role="presentation">Tx CRICKET ELITE</span> <span dir="ltr" role="presentation">— Ball-by-ball cricket pricing with fewer suspensions</span><br role="presentation" /><span dir="ltr" role="presentation">●</span> <span dir="ltr" role="presentation">Tx ALL SPORTED</span> <span dir="ltr" role="presentation">— Integrated horse and greyhound racing data</span></div>
<div class="annotationLayer" data-main-rotation="0"><span dir="ltr" style="font-size: 1rem" role="presentation">●</span> <span dir="ltr" style="font-size: 1rem" role="presentation">Tx LINE</span> <span dir="ltr" style="font-size: 1rem" role="presentation">— Blockchain-ready, verifiable betting data</span></div>
</div>
							</div>
