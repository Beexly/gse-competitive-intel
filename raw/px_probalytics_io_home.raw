-zinc-900 dark:text-white tracking-tight" style="font-family:&#39;Outfit&#39;, sans-serif;"> Probalytics </span></div></a><nav class="hidden lg:flex items-center"><div class="flex items-center gap-1 px-1 py-1 bg-zinc-100/80 dark:bg-white/[0.04]"><div class="relative"><button class="flex items-center gap-1 px-4 py-1.5 text-sm font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-white dark:hover:bg-white/[0.06] transition-all duration-200"> Product <span class="iconify i-ph:caret-down w-3.5 h-3.5 transition-transform duration-200" aria-hidden="true" style=""></span></button><!----></div><!--[--><a href="/pricing" class="relative px-4 py-1.5 text-sm font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-white dark:hover:bg-white/[0.06] transition-all duration-200">Pricing</a><a href="/blog" class="relative px-4 py-1.5 text-sm font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-white dark:hover:bg-white/[0.06] transition-all duration-200">Blog</a><!--]--><a href="https://docs.probalytics.io" target="_blank" rel="noopener noreferrer" class="relative px-4 py-1.5 text-sm font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-white dark:hover:bg-white/[0.06] transition-all duration-200"> Docs </a></div></nav></div><div class="flex items-center gap-3"><a href="https://app.probalytics.io" class="hidden sm:inline-flex text-sm font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors"> Log in </a><button class="w-9 h-9 flex items-center justify-center text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-white/[0.06] transition-all duration-200" aria-label="Toggle color mode"><!--[--><span class="iconify i-ph:moon w-[18px] h-[18px]" aria-hidden="true" style=""></span><!--]--></button><a href="https://app.probalytics.io" class="hidden sm:inline-flex items-center gap-2 px-5 py-2 text-sm font-medium bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 hover:bg-zinc-800 dark:hover:bg-zinc-100 transition-colors duration-200 shadow-lg shadow-zinc-900/10 dark:shadow-none"><span>Start free trial</span><span class="iconify i-ph:arrow-right w-4 h-4" aria-hidden="true" style=""></span></a><button class="lg:hidden w-9 h-9 flex items-center justify-center text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-white/[0.06] transition-all duration-200" aria-label="Toggle menu"><span class="iconify i-ph:list w-5 h-5" aria-hidden="true" style=""></span></button></div></div></div><!----></div></header><main class="flex-1"><section class="relative pt-32 sm:pt-40 lg:pt-44 pb-12 sm:pb-16 overflow-hidden"><div class="absolute inset-0 hero-gradient"></div><div class="absolute inset-0 grid-pattern fade-mask"></div><div class="relative max-w-6xl mx-auto px-4 sm:px-6"><div class="text-center max-w-3xl mx-auto mb-7 sm:mb-9"><h1 class="text-3xl sm:text-4xl md:text-6xl font-bold tracking-tight text-zinc-900 dark:text-white mb-5 animate-fade-up opacity-0"><span class="gradient-text">Order book and trade history</span> for Polymarket and Kalshi. </h1><p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto mb-7 animate-fade-up opacity-0 animate-delay-200"> Full-depth book snapshots stored on every change — Polymarket since November 2025, Kalshi since May 2026 — timestamped to the millisecond. Markets back to October 2020, fills to 2022. Query it in ClickHouse, pull it over REST, or export Parquet. </p><div class="flex flex-col sm:flex-row items-center justify-center gap-3 animate-fade-up opacity-0 animate-delay-300"><a href="https://app.probalytics.io" class="btn-primary inline-flex items-center gap-2"> Start free trial <span class="iconify i-ph:arrow-right w-4 h-4" aria-hidden="true" style=""></span></a><a href="#sql-demo" class="btn-ghost inline-flex items-center gap-2"><span class="iconify i-ph:play w-4 h-4" aria-hidden="true" style=""></span> Run sample query </a></div><p class="mt-4 text-xs text-zinc-500 animate-fade-up opacity-0 animate-delay-300"> 3-day free trial · Last 7 days of data, every venue · No sales call </p></div><div id="sql-demo" class="scroll-mt-28 mb-7 animate-fade-up opacity-0 animate-delay-300"><div class="relative" data-v-1e85d18b><div class="absolute -inset-2 sm:-inset-4 bg-gradient-to-r from-amber-500/20 to-orange-500/20 blur-2xl opacity-50" data-v-1e85d18b></div><div class="relative glass-card p-0 overflow-hidden" data-v-1e85d18b><div class="sm:px-4 py-2.5 px-4 border-b border-zinc-200/70 dark:border-white/5 flex items-center gap-3" data-v-1e85d18b><div class="flex gap-1.5" data-v-1e85d18b><div class="w-3 h-3 rounded-full bg-red-500/80" data-v-1e85d18b></div><div class="w-3 h-3 rounded-full bg-amber-500/80" data-v-1e85d18b></div><div class="w-3 h-3 rounded-full bg-emerald-500/80" data-v-1e85d18b></div></div><span class="text-xs sm:text-sm font-mono text-zinc-500 ml-1" data-v-1e85d18b>probalytics — clickhouse</span></div><div class="flex overflow-x-auto border-b border-zinc-200/70 dark:border-white/5 no-scrollbar" data-v-1e85d18b><!--[--><button class="sm:px-3 py-2.5 border-brand-500 text-zinc-900 dark:text-white flex-shrink-0 px-3 text-xs font-medium whitespace-nowrap border-b-2 -mb-px transition-colors" data-v-1e85d18b>Top of book · 1ms</button><button class="sm:px-3 py-2.5 border-transparent text-zinc-500 hover:text-zinc-900 dark:hover:text-white flex-shrink-0 px-3 text-xs font-medium whitespace-nowrap border-b-2 -mb-px transition-colors" data-v-1e85d18b>Recent fills</button><button class="sm:px-3 py-2.5 border-transparent text-zinc-500 hover:text-zinc-900 dark:hover:text-white flex-shrink-0 px-3 text-xs font-medium whitespace-nowrap border-b-2 -mb-px transition-colors" data-v-1e85d18b>Buy/sell pressure</button><button class="sm:px-3 py-2.5 border-transparent text-zinc-500 hover:text-zinc-900 dark:hover:text-white flex-shrink-0 px-3 text-xs font-medium whitespace-nowrap border-b-2 -mb-px transition-colors" data-v-1e85d18b>Latest markets</button><!--]--></div><div class="min-h-[420px] lg:grid-cols-[minmax(0,1.12fr)_minmax(0,0.88fr)] grid" data-v-1e85d18b><div class="border-b lg:border-b-0 lg:border-r border-zinc-200/70 dark:border-white/5 flex flex-col min-w-0" data-v-1e85d18b><div class="min-h-[230px] relative flex-1" data-v-1e85d18b><pre aria-hidden="true" class="sql-editor absolute inset-0 overflow-hidden pointer-events-none text-zinc-800 dark:text-zinc-200" data-v-1e85d18b><code data-v-1e85d18b><span class="tok-com">-- Reconstruct top-of-book from the full ladder</span>
<span class="tok-kw">SELECT</span>
  timestamp,
  outcome.name                <span class="tok-kw">AS</span> outcome,
  bids[<span class="tok-num">1</span>].price               <span class="tok-kw">AS</span> best_bid,
  bids[<span class="tok-num">1</span>].size                <span class="tok-kw">AS</span> bid_size,
  asks[<span class="tok-num">1</span>].price               <span class="tok-kw">AS</span> best_ask,
  asks[<span class="tok-num">1</span>].size                <span class="tok-kw">AS</span> ask_size,
  <span class="tok-kw">length</span>(bids) + <span class="tok-kw">length</span>(asks) <span class="tok-kw">AS</span> levels
<span class="tok-kw">FROM</span> orderbook_snapshots
<span class="tok-kw">WHERE</span> outcome.name = <span class="tok-str">'Yes'</span>
<span class="tok-kw">ORDER BY</span> timestamp
<span class="tok-kw">LIMIT</span> <span class="tok-num">10</span>;
</code></pre><textarea spellcheck="false" autocapitalize="off" autocomplete="off" autocorrect="off" wrap="off" aria-label="SQL editor" class="sql-editor absolute inset-0 resize-none bg-transparent text-transparent caret-zinc-900 dark:caret-white outline-none overflow-auto no-scrollbar" data-v-1e85d18b>-- Reconstruct top-of-book from the full ladder
SELECT
  timestamp,
  outcome.name                AS outcome,
  bids[1].price               AS best_bid,
  bids[1].size                AS bid_size,
  asks[1].price               AS best_ask,
  asks[1].size                AS ask_size,
  length(bids) + length(asks) AS levels
FROM orderbook_snapshots
WHERE outcome.name = &#39;Yes&#39;
ORDER BY timestamp
