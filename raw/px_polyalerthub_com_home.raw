              /* Critical CSS to prevent flash/flicker — tie color-scheme to Chakra classes only */
              html { scroll-behavior: smooth; }
              html.chakra-ui-dark { color-scheme: dark; }
              html.chakra-ui-light { color-scheme: light; }
              /* Inline vars so body has correct bg before CSS loads */
              html.chakra-ui-dark {
                --bg-canvas: #171923;
                --bg-surface: #1a202c;
                --text-primary: #f7fafc;
                --border-color: #2d3748;
              }
              html.chakra-ui-light {
                --bg-canvas: #ffffff;
                --bg-surface: #ffffff;
                --text-primary: #1a202c;
                --border-color: #e2e8f0;
              }
              body { 
                margin: 0; 
                min-height: 100vh;
              }
              html.chakra-ui-dark body,
              html.chakra-ui-dark #app-shell,
              html[data-theme="dark"] body,
              html[data-theme="dark"] #app-shell {
                background-color: #171923 !important;
                color: #f7fafc !important;
              }
              html.chakra-ui-light body,
              html.chakra-ui-light #app-shell,
              html[data-theme="light"] body,
              html[data-theme="light"] #app-shell,
              body.chakra-ui-light {
                background-color: #ffffff !important;
                color: #1a202c !important;
              }
              /* Reserve header space to prevent CLS */
              .header-spacer { height: 58px; }
              html.chakra-ui-light #global-header,
              html.chakra-ui-light #global-header-placeholder {
                background-color: #ffffff !important;
                border-bottom-color: #e2e8f0 !important;
              }
              html.chakra-ui-dark #global-header,
              html.chakra-ui-dark #global-header-placeholder {
                background-color: #1a202c !important;
                border-bottom-color: #2d3748 !important;
              }
              /* Reserve footer space to prevent CLS */
              footer[role="contentinfo"] { min-height: 380px; }
              /* Skip to main content link for accessibility */
              .skip-link {
                position: absolute;
                top: -40px;
                left: 0;
                background: #319795;
                color: white;
                padding: 8px 16px;
                z-index: 9999;
                text-decoration: none;
                font-weight: 600;
              }
              .skip-link:focus {
                top: 0;
              }
              /* Optimize font rendering */
              body {
                font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
              }
