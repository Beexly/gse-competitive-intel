<style id='wp-block-template-skip-link-inline-css'>

		.skip-link.screen-reader-text {
			border: 0;
			clip: rect(1px,1px,1px,1px);
			clip-path: inset(50%);
			height: 1px;
			margin: -1px;
			overflow: hidden;
			padding: 0;
			position: absolute !important;
			width: 1px;
			word-wrap: normal !important;
		}

		.skip-link.screen-reader-text:focus {
			background-color: #eee;
			clip: auto !important;
			clip-path: none;
			color: #444;
			display: block;
			font-size: 1em;
			height: auto;
			left: 5px;
			line-height: normal;
			padding: 15px 23px 14px;
			text-decoration: none;
			top: 5px;
			width: auto;
			z-index: 100000;
		}
</style>
<style id='polynoob_lb_assets-inline-css'>

.polynoob-lb-wrap{
  max-width:1200px;
  margin:0 auto;
  overflow-x:auto;
  overflow-y:hidden;
  position:relative
}

/* laptop: scrollbar visibile sottile */
@media (min-width:901px) and (max-width:1200px){
  .polynoob-lb-wrap{
    scrollbar-width:thin;
    scrollbar-color:rgba(42,107,214,0.5) rgba(255,255,255,0.06);
  }
  .polynoob-lb-wrap::-webkit-scrollbar{height:5px}
  .polynoob-lb-wrap::-webkit-scrollbar-track{background:rgba(255,255,255,0.04);border-radius:4px}
  .polynoob-lb-wrap::-webkit-scrollbar-thumb{background:rgba(42,107,214,0.5);border-radius:4px}
  .polynoob-lb-wrap::-webkit-scrollbar-thumb:hover{background:rgba(42,107,214,0.8)}
}

.polynoob-lb-update-indicator{
  position:static;
  display:flex;
  align-items:center;
  gap:6px;
  max-width:100%;
  margin-right:auto;
}
.polynoob-lb-update-legend{
  font-size:11px;
  font-weight:600;
  color:#ffffff;
  opacity:.95;
  white-space:nowrap;
  display:inline-block;
  line-height:1.1;
}
.polynoob-lb-update-dot{font-size:13px;line-height:1}

@media (max-width: 520px){
  .polynoob-lb-update-indicator{
    position:static;
    margin-top:8px;
    max-width:100%;
    gap:6px;
    flex-wrap:wrap;
    justify-content:center;
  }
  .polynoob-lb-update-legend{font-size:10px;white-space:normal;text-align:center}
  .polynoob-lb-update-dot{font-size:12px}

  .polynoob-lb-pager{
    flex-direction:column;
    align-items:center;
    gap:6px;
  }
  .polynoob-lb-pager span{margin-right:0}
  .polynoob-lb-pager button{width:100%;max-width:160px}
}


table.polynoob-leaderboard{
  width:100%;
  border-collapse:collapse;
  table-layout:fixed
}

table.polynoob-leaderboard th,
table.polynoob-leaderboard td{
  padding:3px 3px;
  border-bottom:1px solid #e6e6e6;
  text-align:center;
  vertical-align:middle;
  font-size:11.5px
}

table.polynoob-leaderboard th{
  white-space:normal;
  line-height:1.15
}

table.polynoob-leaderboard td{
  white-space:nowrap
}

table.polynoob-leaderboard th.sortable{cursor:pointer;user-select:none}
table.polynoob-leaderboard th.sortable .arrow{font-size:11px;margin-left:6px;opacity:.6}

table.polynoob-leaderboard td:first-child,
table.polynoob-leaderboard th:first-child{
  text-align:center
}

.polynoob-lb-trader{display:flex;gap:10px;align-items:center}
.polynoob-lb-avatar img{border-radius:50%;transition:transform .18s ease,filter .18s ease,box-shadow .18s ease;will-change:transform}
.polynoob-lb-avatar a{display:inline-block;line-height:0;cursor:pointer}
.polynoob-lb-avatar a:hover img{transform:scale(1.08) rotate(-2deg);filter:brightness(1.06);box-shadow:0 8px 18px rgba(0,0,0,.25)}
.polynoob-lb-avatar a:active img{transform:scale(1.03)}

.polynoob-lb-name{
  min-width:0
}
.polynoob-lb-name a{
  display:inline-block;
  max-width:170px;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap
}

.polynoob-lb-profile{text-align:center}
.polynoob-lb-profile a.button{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-width:110px;
  padding:8px 10px;
  border-radius:10px;
  background:linear-gradient(180deg,#2a6bd6,#1e5aa8);
  color:#fff;
  font-weight:600;
  letter-spacing:.2px;
  text-decoration:none;
  transition:transform .18s ease, box-shadow .18s ease, filter .18s ease;
  box-shadow:0 6px 14px rgba(0,0,0,.16)
}
.polynoob-lb-profile a.button:hover{
  transform:translateY(-3px) scale(1.01);
  box-shadow:0 12px 26px rgba(0,0,0,.22);
  filter:brightness(1.06)
}
.polynoob-lb-profile a.button:active{
  transform:translateY(-1px) scale(0.99)
}
.polynoob-lb-profile small{
  display:block;
  margin-top:6px;
  color:#d4af37;
  font-weight:600
}

@media (max-width: 900px){
  .polynoob-lb-wrap{
    overflow-x:auto;
    overflow-y:hidden;
    -ms-overflow-style:none;
    scrollbar-width:none
  }
  .polynoob-lb-wrap::-webkit-scrollbar{width:0;height:0}
  table.polynoob-leaderboard{
    min-width:760px;
    table-layout:fixed
  }
  table.polynoob-leaderboard th,
  table.polynoob-leaderboard td{
    padding:6px 6px;
    font-size:11px
  }
  .polynoob-lb-profile a.button{
    min-width:100px;
    padding:7px 8px;
    border-radius:10px
  }
  .polynoob-lb-name a,
  .polynoob-lb-name .trader-name{
    max-width:140px
  }
}
@media (min-width: 901px){
  table.polynoob-leaderboard{
    min-width:980px;
    table-layout:auto
  }
  .polynoob-lb-name a{max-width:260px}
}

table.polynoob-leaderboard tbody tr{
  transition:background .15s ease, box-shadow .15s ease
}
table.polynoob-leaderboard tbody tr:hover{
  background:rgba(255,255,255,0.04);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,0.06)
}

.polynoob-lb-search{
  margin:10px 0 14px;
  display:flex;
  justify-content:center
}
.polynoob-lb-search input{
  width:280px;
  max-width:100%;
  padding:10px 12px;
  border-radius:10px;
  border:1px solid rgba(255,255,255,0.12);
  background:rgba(255,255,255,0.06);
  color:inherit;
  outline:none
}
.polynoob-lb-search input:focus{
  border-color:rgba(42,107,214,0.6);
  box-shadow:0 0 0 3px rgba(42,107,214,0.18)
}

@media (max-width: 900px){
  .polynoob-lb-search{
    position:sticky;
    left:0;
    top:0;
    z-index:60;
    justify-content:flex-start;
    padding:10px 10px;
    margin:0 0 10px;
    background:rgba(0, 0, 0, 0);
    backdrop-filter:blur(6px);
  }
  .polynoob-lb-search input{
    width:260px;
  }
}

table.polynoob-leaderboard th.active-sort{
  box-shadow:inset 0 -2px 0 rgba(42,107,214,0.9)
}
table.polynoob-leaderboard td.active-sort-cell{
  background:rgba(42,107,214,0.08)
}

table.polynoob-leaderboard tbody tr:hover{
  box-shadow:inset 4px 0 0 rgba(42,107,214,0.85), inset 0 0 0 1px rgba(255,255,255,0.06)
}

table.polynoob-leaderboard th:last-child,
table.polynoob-leaderboard td:last-child{width:170px}

.polynoob-lb-title{
  margin:0 0 6px;
  font-size:22px;
  font-weight:700;
  text-align:center
}
.polynoob-lb-desc{
  margin:0 0 16px;
  font-size:11.5px;
  opacity:.75;
  max-width:760px;margin-left:auto;margin-right:auto
}

.polynoob-lb-pager{
  margin:14px 0 0;
  display:flex;
  justify-content:center;
  gap:8px;
  flex-wrap:wrap
}
.polynoob-lb-pager span{
  align-self:center;
  opacity:.8;
  font-size:12px
}

.polynoob-lb-pager span{
  align-self:center;
  opacity:.75;
  font-size:12px;
  margin-right:6px
}
.polynoob-lb-pager button{
  background:rgba(255,255,255,0.06);
  border:1px solid rgba(255,255,255,0.12);
  color:inherit;
  padding:8px 10px;
  border-radius:10px;
  cursor:pointer;
  min-width:40px;
  transition:transform .12s ease, background .12s ease, border-color .12s ease
}
.polynoob-lb-pager button:hover{
  transform:translateY(-1px);
  background:rgba(255,255,255,0.10);
  border-color:rgba(42,107,214,0.35)
}
.polynoob-lb-pager button.active{
  background:rgba(42,107,214,0.22);
  border-color:rgba(42,107,214,0.55)
}

table.polynoob-leaderboard{
  table-layout:fixed
}
table.polynoob-leaderboard th:nth-child(1),
table.polynoob-leaderboard td:nth-child(1){width:190px}
table.polynoob-leaderboard th:nth-child(2),
table.polynoob-leaderboard td:nth-child(2){width:80px}
table.polynoob-leaderboard th:nth-child(3),
table.polynoob-leaderboard td:nth-child(3){width:60px}
table.polynoob-leaderboard th:nth-child(4),
table.polynoob-leaderboard td:nth-child(4){width:70px}
table.polynoob-leaderboard th:nth-child(5),
table.polynoob-leaderboard td:nth-child(5){width:110px}
table.polynoob-leaderboard th:nth-child(6),
table.polynoob-leaderboard td:nth-child(6){width:80px}
table.polynoob-leaderboard th:nth-child(7),
table.polynoob-leaderboard td:nth-child(7){width:95px}
table.polynoob-leaderboard th:nth-child(8),
table.polynoob-leaderboard td:nth-child(8){width:95px}
table.polynoob-leaderboard th:nth-child(9),
table.polynoob-leaderboard td:nth-child(9){width:160px}

table.polynoob-leaderboard td{
  text-overflow:ellipsis
}
.polynoob-lb-trader{min-width:0}
.polynoob-lb-avatar{flex:0 0 auto}
.polynoob-lb-name{min-width:0}
.polynoob-lb-name .trader-name{
  display:block;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap
}

.polynoob-lb-agecell{line-height:1.05}
.polynoob-lb-agecell .polynoob-lb-age{display:block}
.polynoob-lb-agecell .polynoob-lb-activity{display:block;margin-top:3px;font-size:12px;font-weight:800;letter-spacing:0.2px;opacity:1;filter:none}
.polynoob-lb-activity--active{color:#00ff6a}
.polynoob-lb-activity--inactive{color:#ff2d55}

/* ── Bottom bar: pager + Active 60 days side by side ── */
.polynoob-lb-bottom{
  display:flex;
  align-items:center;
  justify-content:space-between;
  flex-wrap:wrap;
  gap:10px;
  margin-top:14px;
}
.polynoob-lb-bottom .polynoob-lb-pager{
  margin-top:0;
  flex:1 1 auto;
  justify-content:flex-start;
}
.polynoob-lb-bottom .polynoob-lb-update-indicator{
  flex:0 0 auto;
  margin-right:0;
}

/* tablet: stessa riga, centrata */
@media (max-width:900px) and (min-width:521px){
  .polynoob-lb-bottom{
    position:sticky;
    left:0;
    flex-wrap:nowrap;
    justify-content:space-between;
    padding:6px 10px;
    background:rgba(0,0,0,0.65);
    backdrop-filter:blur(6px);
    border-radius:8px;
  }
  .polynoob-lb-bottom .polynoob-lb-pager{
    justify-content:flex-start;
  }
}

/* mobile: colonna */
@media (max-width:520px){
  .polynoob-lb-bottom{
    flex-direction:column;
    align-items:center;
  }
  .polynoob-lb-bottom .polynoob-lb-pager{
    justify-content:center;
  }
}

</style>
