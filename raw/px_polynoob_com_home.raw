<script id="wp-block-template-skip-link-js-after">
	( function() {
		var skipLinkTarget = document.querySelector( 'main' ),
			sibling,
			skipLinkTargetID,
			skipLink;

		// Early exit if a skip-link target can't be located.
		if ( ! skipLinkTarget ) {
			return;
		}

		/*
		 * Get the site wrapper.
		 * The skip-link will be injected in the beginning of it.
		 */
		sibling = document.querySelector( '.wp-site-blocks' );

		// Early exit if the root element was not found.
		if ( ! sibling ) {
			return;
		}

		// Get the skip-link target's ID, and generate one if it doesn't exist.
		skipLinkTargetID = skipLinkTarget.id;
		if ( ! skipLinkTargetID ) {
			skipLinkTargetID = 'wp--skip-link--target';
			skipLinkTarget.id = skipLinkTargetID;
		}

		// Create the skip link.
		skipLink = document.createElement( 'a' );
		skipLink.classList.add( 'skip-link', 'screen-reader-text' );
		skipLink.href = '#' + skipLinkTargetID;
		skipLink.innerHTML = 'Skip to content';

		// Inject the skip link.
		sibling.parentElement.insertBefore( skipLink, sibling );
	}() );
	
</script>
<script id="polynoob_lb_assets-js-after">
(function(){
  var PAGE_SIZE = 8;

  function num(v){
    if(v===null||v===undefined) return 0;
    v = (''+v).replace(/[^0-9\.-]/g,'');
    var n = parseFloat(v);
    return isNaN(n) ? 0 : n;
  }

  function clearActiveCol(table){
    var ths = table.querySelectorAll('th');
    ths.forEach(function(th){ th.classList.remove('active-sort'); });
    var cells = table.querySelectorAll('td.active-sort-cell');
    cells.forEach(function(td){ td.classList.remove('active-sort-cell'); });
  }

  function markActiveCol(table, colIndex){
    var th = table.querySelector('thead tr').children[colIndex];
    if(th) th.classList.add('active-sort');
    Array.prototype.forEach.call(table.tBodies[0].rows, function(r){
      if(r.cells[colIndex]) r.cells[colIndex].classList.add('active-sort-cell');
    });
  }

  function sortRows(table, colIndex, dir){
    var tbody = table.tBodies[0];
    var rows = Array.prototype.slice.call(tbody.rows);
    rows.sort(function(a,b){
      var av = a.cells[colIndex] ? (a.cells[colIndex].getAttribute('data-sort') || a.cells[colIndex].innerText) : '';
      var bv = b.cells[colIndex] ? (b.cells[colIndex].getAttribute('data-sort') || b.cells[colIndex].innerText) : '';
      var an = num(av), bn = num(bv);
      if(an<bn) return dir==='asc' ? -1 : 1;
      if(an>bn) return dir==='asc' ? 1 : -1;
      return 0;
    });
    rows.forEach(function(r){ tbody.appendChild(r); });
    clearActiveCol(table);
    markActiveCol(table, colIndex);
  }

  function getFilteredRows(table, query){
    var q = (query || '').toLowerCase().trim();
    var all = Array.prototype.slice.call(table.tBodies[0].rows);
    if(q === '') return all;
    return all.filter(function(r){
      var nameEl = r.querySelector('.trader-name');
      var name = nameEl ? nameEl.textContent.toLowerCase() : '';
      return name.indexOf(q) !== -1;
    });
  }

  function applyPagination(table, pager, rows, page){
    var total = rows.length;
    var pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
    var p = Math.min(Math.max(1, page), pages);

    Array.prototype.slice.call(table.tBodies[0].rows).forEach(function(r){ r.style.display = 'none'; });

    var start = (p - 1) * PAGE_SIZE;
    var end = start + PAGE_SIZE;
    rows.slice(start, end).forEach(function(r){ r.style.display = ''; });

    renderPager(pager, pages, p);
    pager.setAttribute('data-page', String(p));
  }

  function renderPager(pager, pages, active){
    pager.innerHTML = '';

    var info = document.createElement('span');
    info.textContent = 'Page ' + active + ' of ' + pages;
    pager.appendChild(info);

    var prev = document.createElement('button');
    prev.type = 'button';
    prev.textContent = 'Previous';
    prev.setAttribute('data-page', String(active - 1));
    if(active === 1) prev.disabled = true;
    pager.appendChild(prev);

    var next = document.createElement('button');
    next.type = 'button';
    next.textContent = 'Next';
    next.setAttribute('data-page', String(active + 1));
    if(active === pages) next.disabled = true;
    pager.appendChild(next);
  }

  function wireWrap(wrap){
    var input = wrap.querySelector('.polynoob-lb-search-input');
    var table = wrap.querySelector('table.polynoob-leaderboard');
    var pager = wrap.querySelector('.polynoob-lb-pager');
    if(!table || !pager) return;

    function refresh(page){
      var rows = getFilteredRows(table, input ? input.value : '');
      applyPagination(table, pager, rows, page || 1);
    }

    refresh(1);

    pager.addEventListener('click', function(e){
      var btn = e.target.closest('button[data-page]');
      if(!btn) return;
      refresh(parseInt(btn.getAttribute('data-page'), 10) || 1);
    });

    if(input){
      input.addEventListener('input', function(){ refresh(1); });
    }

    wrap.addEventListener('click', function(e){
      var th = e.target.closest('th.sortable');
      if(!th) return;
      var col = parseInt(th.getAttribute('data-col'),10);
      var current = th.getAttribute('data-dir') || '';
      var dir = current==='asc' ? 'desc' : 'asc';

      Array.prototype.forEach.call(table.querySelectorAll('th.sortable'), function(x){
        x.setAttribute('data-dir','');
        var a = x.querySelector('.arrow');
        if(a) a.textContent = '';
      });

      th.setAttribute('data-dir', dir);
      var arrow = th.querySelector('.arrow');
      if(arrow) arrow.textContent = dir==='asc' ? '▲' : '▼';

      sortRows(table, col, dir);
      refresh(1);
    });
  }

  document.querySelectorAll('.polynoob-lb-wrap').forEach(wireWrap);
})();
</script>
