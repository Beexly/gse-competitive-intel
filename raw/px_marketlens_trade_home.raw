    <!--
      Per-route <title>, <meta name="description">, <link rel="canonical">,
      and og:/twitter: title/description/url/image are injected at build time
      by the <Seo> component (react-helmet-async) and persisted by the
      prerender step in scripts/prerender.mjs. The tags below are site-wide
      defaults that apply regardless of route.
    -->

    <!-- Open Graph, site-wide defaults -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Marketlens">
    <meta property="og:locale" content="en_US">

    <!-- Twitter, site-wide defaults -->
    <meta name="twitter:card" content="summary_large_image">

    <!-- JSON-LD: Organization -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "https://marketlens.trade/#organization",
      "name": "Marketlens",
      "url": "https://marketlens.trade/",
      "logo": "https://marketlens.trade/logo-512.png",
      "description": "Historical Polymarket order book data, Python SDK, and backtesting API for building and testing trading bots.",
      "sameAs": [
        "https://github.com/marketlenstrade/marketlens-python"
      ]
    }
    </script>

    <!-- JSON-LD: WebSite -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "https://marketlens.trade/#website",
      "url": "https://marketlens.trade/",
      "name": "Marketlens",
      "publisher": { "@id": "https://marketlens.trade/#organization" },
      "inLanguage": "en"
    }
    </script>

    <!-- JSON-LD: SoftwareApplication -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Marketlens",
      "applicationCategory": "DeveloperApplication",
      "applicationSubCategory": "API",
      "operatingSystem": "Any",
      "description": "Python SDK and REST API for Polymarket prediction market order book data, trades, and backtesting.",
      "url": "https://marketlens.trade/",
      "publisher": { "@id": "https://marketlens.trade/#organization" },
      "offers": [
        {
          "@type": "Offer",
          "name": "Free",
          "price": "0",
          "priceCurrency": "USD",
          "description": "600 req/min, 25M rows/day, 1 API key"
        },
        {
          "@type": "Offer",
          "name": "Pro",
          "price": "39",
          "priceCurrency": "USD",
          "description": "3,600 req/min, 5B rows/month, 5 API keys"
        },
        {
          "@type": "Offer",
          "name": "Scale",
          "price": "199",
          "priceCurrency": "USD",
          "description": "10,800 req/min, 50B rows/month, 25 API keys"
        }
      ]
    }
    </script>

