,277],self_thread_metadata:null,full_text:"Bloomberg flagged a real tension in prediction markets today: the fix for manipulation risk is more trading volume, but more trading volume also makes manipulation and insider trading more tempting.\n\n⚖️ The \"more is better\" case: liquid markets are harder to move with a single",hashtag_entities:$R[196]={__refs:$R[197]=[]},timestamp_entities:$R[198]={__refs:$R[199]=[]},cashtag_entities:$R[200]={__refs:$R[201]=[]},smarttags:$R[202]={__refs:$R[203]=[]},created_at_ms:1788346801000},"client:VHdlZXQ6MjA5NTEwNDQ1MzA5OTU4NTg3NA==:note_tweet":$R[204]={__id:"client:VHdlZXQ6MjA5NTEwNDQ1MzA5OTU4NTg3NA==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[205]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDk1MTA0NDUzMDExNTI1NjM0"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDk1MTA0NDUzMDExNTI1NjM0:$R[206]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDk1MTA0NDUzMDExNTI1NjM0",__typename:"NoteTweetResults",result:$R[207]={__ref:"Tm90ZVR3ZWV0OjIwOTUxMDQ0NTMwMTE1MjU2MzQ="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDk1MTA0NDUzMDExNTI1NjM0"},"Tm90ZVR3ZWV0OjIwOTUxMDQ0NTMwMTE1MjU2MzQ=":$R[208]={__id:"Tm90ZVR3ZWV0OjIwOTUxMDQ0NTMwMTE1MjU2MzQ=",__typename:"NoteTweet",text:"Bloomberg flagged a real tension in prediction markets today: the fix for manipulation risk is more trading volume, but more trading volume also makes manipulation and insider trading more tempting.\n\n⚖️ The \"more is better\" case: liquid markets are harder to move with a single bad actor\n🎯 The \"more is worse\" case: liquid markets attract exactly the sophisticated players most likely to exploit non-public information\n📊 The neutral read: nobody's proposed a fix that solves both sides at once\n\n$1T in projected annual volume by 2030 makes this more than academic. h/t @business\n\n#PredictionMarkets #Polyguana #Finance #Investing",entity_set:$R[209]={__ref:"client:Tm90ZVR3ZWV0OjIwOTUxMDQ0NTMwMTE1MjU2MzQ=:entity_set"},id:"Tm90ZVR3ZWV0OjIwOTUxMDQ0NTMwMTE1MjU2MzQ="},"client:Tm90ZVR3ZWV0OjIwOTUxMDQ0NTMwMTE