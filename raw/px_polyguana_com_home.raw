e says belongs to the CFTC, not courts.\n\nA Columbia law professor's take: this is a textbook circuit split headed for the Supreme Court, period.\n\nEven the losing side isn't reading this ruling the same way twice.\n\n#PredictionMarkets #Polyguana #Kalshi",entity_set:$R[425]={__ref:"client:Tm90ZVR3ZWV0OjIwOTQzODc4OTg0NTE2MzYyMjQ=:entity_set"},id:"Tm90ZVR3ZWV0OjIwOTQzODc4OTg0NTE2MzYyMjQ="},"client:Tm90ZVR3ZWV0OjIwOTQzODc4OTg0NTE2MzYyMjQ=:entity_set":$R[426]={__id:"client:Tm90ZVR3ZWV0OjIwOTQzODc4OTg0NTE2MzYyMjQ=:entity_set",__typename:"EntitySet",hashtags:$R[427]={__refs:$R[428]=["client:Tm90ZVR3ZWV0OjIwOTQzODc4OTg0NTE2MzYyMjQ=:entity_set:hashtags:0","client:Tm90ZVR3ZWV0OjIwOTQzODc4OTg0NTE2MzYyMjQ=:entity_set:hashtags:1","client:Tm90ZVR3ZWV0OjIwOTQzODc4OTg0NTE2MzYyMjQ=:entity_set:hashtags:2"]},symbols:$R[429]={__refs:$R[430]=[]},smarttags:$R[431]={__refs:$R[432]=[]},urls:$R[433]={__refs:$R[434]=[]},timestamps:null,user_mentions:$R[435]={__refs:$R[436]=[]}},"client:Tm90ZVR3ZWV0OjIwOTQzODc4OTg0NTE2MzYyMjQ=:entity_set:hashtags:0":$R[437]={__id:"client:Tm90ZVR3ZWV0OjIwOTQzODc4OTg0NTE2MzYyMjQ=:entity_set:hashtags:0",__typename:"ApiTagEntity",indices:$R[438]=[505,523],text:"PredictionMarkets"},"client:Tm90ZVR3ZWV0OjIwOTQzODc4OTg0NTE2MzYyMjQ=:entity_set:hashtags:1":$R[439]={__id:"client:Tm90ZVR3ZWV0OjIwOTQzODc4OTg0NTE2MzYyMjQ=:entity_set:hashtags:1",__typename:"ApiTagEntity",indices:$R[440]=[524,534],text:"Polyguana"},"client:Tm90ZVR3ZWV0OjIwOTQzODc4OTg0NTE2MzYyMjQ=:entity_set:hashtags:2":$R[441]={__id:"client:Tm90ZVR3ZWV0OjIwOTQzODc4OTg0NTE2MzYyMjQ=:entity_set:hashtags:2",__typename:"ApiTagEntity",indices:$R[442]=[535,542],text:"Kalshi"},"client:VHdlZXQ6MjA5NDM4Nzg5ODUzMTM5MzYxNA==:grok_translated_post_with_availability":$R[443]={__id:"client:VHdlZXQ6MjA5NDM4Nzg5ODUzMTM5MzYxNA==:grok_translated_post_with_availability",__typename:"ApiGrokTranslateResponse",is_available:!1,data:null},"client:VHdlZXQ6MjA5NDM4Nzg5ODUzMTM5MzYxNA==:place":$R[444]={__id:"client:VHdlZXQ6MjA5NDM4N