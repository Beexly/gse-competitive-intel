$(document).ready(function(){
	$(".subscribe-button").click(function(){
		$(".subscribe-pop").fadeIn();
		$(".sub-content").slideDown();
	});
	
	$(".sub-over").click(function(){
		$(".sub-content").slideUp();
		$(".subscribe-pop").delay(100).fadeOut();
	});
	
	$(".cancel-sub").click(function(){
		$(".sub-content").slideUp();
		$(".subscribe-pop").delay(100).fadeOut();
	});
});
</script>
