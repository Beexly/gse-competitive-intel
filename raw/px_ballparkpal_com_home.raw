    <div class="col-12" style="max-width: 865px; margin: 0 auto; padding: 0 10px;">
        <div style="text-align: center; margin-bottom: 8px;">
            <h2 class="hp-section-header" style="font-size: 45px; color: #616161;">Trending Players</h2>
            <hr style="width:90%; height:5px; background-color:gray; margin: 1rem auto 5px auto;">
        </div>
    </div>
</div>


<style>
.rf-wrap { max-width: 865px; margin: 20px auto 0; padding: 0 10px 20px; }
.rf-container { }
.rf-header-row { display: flex; gap: 8px; padding: 0; }
.rf-header-btn {
    flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 18px;
    padding: 14px 24px; font-size: 36px; font-weight: bold; color: #fff;
    letter-spacing: 1px; border: none; border-radius: 14px; cursor: pointer;
    box-shadow: 0 4px 0 rgba(0,0,0,0.2), inset 0 1px 0 rgba(255,255,255,0.25);
    transition: filter 0.2s, opacity 0.2s, transform 0.1s, box-shadow 0.1s;
}
.rf-header-btn.rf-risers { background: #4a9e6e; }
.rf-header-btn.rf-fallers { background: #c08c42; }
.rf-header-btn:hover { filter: brightness(1.12); transform: translateY(-1px); box-shadow: 0 5px 0 rgba(0,0,0,0.2), inset 0 1px 0 rgba(255,255,255,0.25); }
.rf-header-btn:active { transform: translateY(2px); box-shadow: 0 1px 0 rgba(0,0,0,0.2), inset 0 1px 0 rgba(255,255,255,0.25); }
.rf-header-btn.inactive { filter: grayscale(80%); opacity: 0.45; box-shadow: 0 2px 0 rgba(0,0,0,0.1); }
.rf-header-btn.inactive:hover { filter: grayscale(60%) brightness(1.1); opacity: 0.6; }
.rf-header-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%; background: #fff; flex-shrink: 0;
}
.rf-header-icon img { height: 26px; width: auto; }
.rf-pc-row { display: flex; justify-content: center; padding: 16px 14px 12px; }
.rf-pc-btn {
    flex: 1; max-width: 160px; text-align: center;
    padding: 8px 4px; font-size: 17px; font-weight: 700;
    border: 2px solid #ccc; border-radius: 22px;
    background: #e0e0e0; color: #999; cursor: pointer; transition: all 0.15s;
    margin: 0 4px;
}
.rf-pc-btn:hover:not(.disabled):not(.active) { background: #d5d5d5; border-color: #bbb; color: #777; }
.rf-pc-btn.active { background: #424242; border-color: #424242; color: #fff; }
.rf-pc-btn.disabled { background: #e0e0e0; border-color: #ccc; color: #999; cursor: not-allowed; }
.rf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 0; }
.rf-col { display: flex; flex-direction: column; gap: 8px; }
.rf-card {
    display: flex; align-items: center; justify-content: center; gap: 14px;
    padding: 10px 14px; border-radius: 14px;
    text-decoration: none; color: inherit; transition: filter 0.12s;
}
.rf-card:hover { filter: brightness(0.95); }
.rf-card.riser-bg { background: rgba(106, 171, 130, 0.15); }
.rf-card.faller-bg { background: rgba(196, 154, 90, 0.15); }
.rf-rank { font-size: 28px; font-weight: 800; color: #94a3b8; width: 34px; text-align: center; flex-shrink: 0; }
.rf-headshot { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; flex-shrink: 0; background: #e8e8e8; }
.rf-info { min-width: 0; }
.rf-values { display: flex; align-items: center; gap: 8px; }
.rf-score {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 46px; height: 36px; padding: 0 10px;
    border-radius: 8px; font-weight: 800; font-size: 18px; color: #fff;
}
.rf-arrow {
    display: inline-block; width: 24px; height: 2px; background: #555; position: relative;
}
.rf-arrow::after {
    content: ''; position: absolute; right: 0; top: 50%;
    border: solid #555; border-width: 0 2px 2px 0; padding: 3px;
    transform: translateY(-50%) rotate(-45deg);
}
.rf-name { font-size: 15px; font-weight: 600; color: #2563eb; margin-top: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-decoration: none; }
.rf-card:hover .rf-name { color: #1d4ed8; }
.rf-pc-last-short { display: none; }
.rf-footnote {
    text-align: center; font-size: 14px; color: #64748b; font-weight: 600;
    font-family: sans-serif; margin: 10px 0 0; line-height: 1.4;
}
.rf-footnote a { color: #2563eb; text-decoration: none; cursor: pointer; }
.rf-footnote a:hover { color: #1d4ed8; }
.rf-key-overlay {
    position: fixed; inset: 0; z-index: 100000;
    display: flex; align-items: center; justify-content: center;
    background: rgba(15, 23, 42, 0.6);
    opacity: 0; visibility: hidden; transition: opacity 0.2s, visibility 0.2s;
}
.rf-key-overlay.is-open { opacity: 1; visibility: visible; }
.rf-key-modal {
    position: relative; max-width: 90vw; max-height: 88vh;
    border-radius: 12px; overflow: hidden;
    transform: scale(0.95); transition: transform 0.2s;
}
.rf-key-overlay.is-open .rf-key-modal { transform: scale(1); }
.rf-key-modal img { display: block; max-width: 100%; max-height: 86vh; height: auto; }
.rf-key-close {
    position: absolute; top: 8px; right: 8px;
    width: 32px; height: 32px; border-radius: 50%;
    border: none; background: rgba(15,23,42,0.6); color: #fff;
    font-size: 20px; cursor: pointer; display: grid; place-items: center;
    transition: background 0.15s;
}
.rf-key-close:hover { background: rgba(15,23,42,0.8); }
.rf-tooltip {
    position: absolute; z-index: 2500;
    width: min(300px, calc(100vw - 24px));
    padding: 9px 10px; border-radius: 10px;
    border: 1px solid #d1d5db; background: #f8fafc;
    box-shadow: 0 8px 20px rgba(2, 8, 23, 0.14);
    color: #1f2937; font-size: 13px; line-height: 1.4;
    font-weight: 600; text-align: center;
    pointer-events: none; opacity: 0; transition: opacity 0.15s;
}
.rf-tooltip.visible { opacity: 1; pointer-events: auto; }

@media (max-width: 1000px) {
    .rf-header-btn { padding: 8px 24px; font-size: 44px; }
    .rf-header-icon { width: 54px; height: 54px; }
    .rf-header-icon img { height: 32px; }
    .rf-grid { gap: 12px; padding: 0 14px 20px; }
    .rf-card { padding: 12px 14px; gap: 14px; }
    .rf-rank { font-size: 36px; width: 42px; }
    .rf-headshot { width: 80px; height: 80px; }
    .rf-score { min-width: 56px; height: 44px; padding: 0 12px; font-size: 22px; border-radius: 10px; }
    .rf-arrow { width: 24px; height: 3px; }
    .rf-arrow::after { border-width: 0 3px 3px 0; padding: 5px; }
    .rf-name { font-size: 19px; }
    .rf-pc-last-full { display: none; }
    .rf-pc-last-short { display: inline; }
    .rf-pc-btn { padding: 10px 6px; font-size: 20px; margin: 0 4px; border-radius: 26px; }
    .rf-pc-btn.rf-pc-first { font-size: 17px; }
    .rf-pc-row { padding: 18px 12px 14px; }
    .rf-footnote { font-size: 22px; }
}
@media (max-width: 420px) {
    .rf-header-btn { padding: 6px 16px; font-size: 36px; gap: 8px; }
    .rf-header-icon { width: 44px; height: 44px; }
    .rf-header-icon img { height: 26px; }
    .rf-rank { font-size: 28px; width: 34px; }
    .rf-headshot { width: 60px; height: 60px; }
    .rf-score { min-width: 46px; height: 36px; padding: 0 8px; font-size: 18px; border-radius: 8px; }
    .rf-arrow { width: 20px; height: 2px; }
    .rf-arrow::after { border-width: 0 3px 3px 0; padding: 4px; }
    .rf-name { font-size: 16px; }
    .rf-pc-btn { padding: 8px 4px; font-size: 17px; margin: 0 3px; border-radius: 24px; }
    .rf-pc-btn.rf-pc-first { font-size: 17px; }
    .rf-card { gap: 10px; padding: 10px 8px; }
    .rf-grid { gap: 10px; padding: 0 8px 16px; }
    .rf-footnote { font-size: 19px; }
}
</style>

<div class="rf-wrap">
    <div class="rf-container">
        <div class="rf-header-row">
            <button id="rf-btn-risers" class="rf-header-btn rf-risers" type="button">
                <span>Risers</span>
                <span class="rf-header-icon"><img src="Images/TrendUp.png" alt=""></span>
            </button>
            <button id="rf-btn-fallers" class="rf-header-btn rf-fallers" type="button">
                <span>Fallers</span>
                <span class="rf-header-icon"><img src="Images/TrendDown.png" alt=""></span>
            </button>
        </div>
        <div style="position: relative;">
            <div id="rf-pc-row" class="rf-pc-row"></div>
            <div id="rf-tooltip" class="rf-tooltip"></div>
        </div>
        <div class="rf-grid">
            <div id="rf-left" class="rf-col"></div>
            <div id="rf-right" class="rf-col"></div>
        </div>
    </div>
    <p class="rf-footnote">Ratings are luck-adjusted, based on contact quality and expected outcomes. <a href="javascript:void(0)" id="rf-guide-link">Ratings Key</a></p>
</div>

<div class="rf-key-overlay" id="rfKeyOverlay">
    <div class="rf-key-modal">
        <img src="Images/NumericRatingsKey2.png" alt="Numeric Ratings Key">
        <button class="rf-key-close" id="rfKeyClose" aria-label="Close">&times;</button>
    </div>
</div>

