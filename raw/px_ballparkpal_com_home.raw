eigh","bt":1,"pt":0},{"pc":250,"pid":671739,"ev":102,"rank":10,"stat":"4.8 exp HRs, 19.9 exp Hits, 40.7 exp Bases, 0 BBs","name":"Michael Harris II","bt":1,"pt":0},{"pc":500,"pid":665487,"ev":111,"rank":1,"stat":"12.2 exp HRs, 41.5 exp Hits, 85.6 exp Bases, 9 BBs","name":"Fernando Tatis Jr.","bt":1,"pt":0},{"pc":500,"pid":695506,"ev":105,"rank":2,"stat":"8.9 exp HRs, 48.7 exp Hits, 86.2 exp Bases, 3 BBs","name":"Jac Caglianone","bt":1,"pt":0},{"pc":500,"pid":673237,"ev":104,"rank":3,"stat":"7.9 exp HRs, 44.3 exp Hits, 75.8 exp Bases, 5 BBs","name":"Yainer Diaz","bt":1,"pt":0},{"pc":500,"pid":643446,"ev":101,"rank":4,"stat":"3.8 exp HRs, 46.0 exp Hits, 65.7 exp Bases, 5 BBs","name":"Jeff McNeil","bt":1,"pt":0},{"pc":500,"pid":621438,"ev":98,"rank":5,"stat":"8.4 exp HRs, 35.4 exp Hits, 71.8 exp Bases, 11 BBs","name":"Tyrone Taylor","bt":1,"pt":0},{"pc":500,"pid":686681,"ev":98,"rank":6,"stat":"6.2 exp HRs, 39.3 exp Hits, 69.3 exp Bases, 6 BBs","name":"Michael Massey","bt":1,"pt":0},{"pc":500,"pid":650490,"ev":96,"rank":7,"stat":"6.8 exp HRs, 42.8 exp Hits, 69.1 exp Bases, 8 BBs","name":"Yandy Diaz","bt":1,"pt":0},{"pc":500,"pid":701538,"ev":94,"rank":8,"stat":"8.4 exp HRs, 37.8 exp Hits, 74.9 exp Bases, 8 BBs","name":"Jackson Merrill","bt":1,"pt":0},{"pc":500,"pid":646240,"ev":93,"rank":9,"stat":"11.0 exp HRs, 28.9 exp Hits, 68.0 exp Bases, 17 BBs","name":"Rafael Devers","bt":1,"pt":0},{"pc":500,"pid":608324,"ev":93,"rank":10,"stat":"8.7 exp HRs, 34.7 exp Hits, 67.0 exp Bases, 14 BBs","name":"Alex Bregman","bt":1,"pt":0},{"pc":1000,"pid":660688,"ev":105,"rank":1,"stat":"11.1 exp HRs, 82.7 exp Hits, 139.8 exp Bases, 15 BBs","name":"Keibert Ruiz","bt":1,"pt":0},{"pc":1000,"pid":695506,"ev":104,"rank":2,"stat":"18.2 exp HRs, 86.0 exp Hits, 157.6 exp Bases, 11 BBs","name":"Jac Caglianone","bt":1,"pt":0},{"pc":1000,"pid":665487,"ev":102,"rank":3,"stat":"16.8 exp HRs, 74.7 exp Hits, 140.4 exp Bases, 21 BBs","name":"Fernando Tatis Jr.","bt":1,"pt":0},{"pc":1000,"pid":665742,"ev":98,"rank":4,"stat":"13.9 exp HRs, 58.5 exp Hits, 111.7 exp Bases, 40 BBs","name":"Juan Soto","bt":1,"pt":0},{"pc":1000,"pid":664983,"ev":91,"rank":5,"stat":"9.9 exp HRs, 79.2 exp Hits, 122.5 exp Bases, 15 BBs","name":"Jake McCarthy","bt":1,"pt":0},{"pc":1000,"pid":671277,"ev":88,"rank":6,"stat":"16.8 exp HRs, 70.5 exp Hits, 137.5 exp Bases, 15 BBs","name":"Luis Garcia","bt":1,"pt":0},{"pc":1000,"pid":670541,"ev":87,"rank":7,"stat":"13.3 exp HRs, 64.9 exp Hits, 120.2 exp Bases, 26 BBs","name":"Yordan Alvarez","bt":1,"pt":0},{"pc":1000,"pid":671739,"ev":87,"rank":8,"stat":"11.7 exp HRs, 77.9 exp Hits, 132.2 exp Bases, 6 BBs","name":"Michael Harris II","bt":1,"pt":0},{"pc":1000,"pid":686681,"ev":87,"rank":9,"stat":"10.5 exp HRs, 73.2 exp Hits, 123.9 exp Bases, 16 BBs","name":"Michael Massey","bt":1,"pt":0},{"pc":1000,"pid":605141,"ev":84,"rank":10,"stat":"8.9 exp HRs, 71.6 exp Hits, 114.8 exp Bases, 19 BBs","name":"Mookie Betts","bt":1,"pt":0}];
    var byPC = {};
    allData.forEach(function(d) {
        if (!byPC[d.pc]) byPC[d.pc] = [];
        byPC[d.pc].push(d);
    });

    var availablePCs = Object.keys(byPC).map(Number).sort(function(a, b) { return a - b; });
    var ALL_PCS = [50, 100, 250, 500, 1000];
    var currentPC = availablePCs.indexOf(100) !== -1 ? 100 : (availablePCs[0] || 100);

    var pcRow = document.getElementById('tp-pc-row');
    var leftCol = document.getElementById('tp-left');
    var rightCol = document.getElementById('tp-right');

    function buildPCButtons() {
        pcRow.innerHTML = ALL_PCS.map(function(pc) {
            var available = availablePCs.indexOf(pc) !== -1;
            var active = pc === currentPC;
            var cls = 'tp-pc-btn';
            if (pc === 50) cls += ' tp-pc-first';
            if (!available) cls += ' disabled';
            else if (active) cls += ' active';
            var label = pc === 50 ? 'Last 50 Pitches' : '<span class="tp-pc-last-full">Last </span><span class="tp-pc-last-short">L </span>' + pc.toLocaleString();
            return '<button class="' + cls + '" data-pc="' + pc + '">' + label + '</button>';
        }).join('');

        var btns = pcRow.querySelectorAll('.tp-pc-btn:not(.disabled)');
        for (var i = 0; i < btns.length; i++) {
            (function(btn) {
                btn.addEventListener('click', function() {
                    currentPC = parseInt(btn.getAttribute('data-pc'));
                    buildPCButtons();
                    render();
                });
            })(btns[i]);
        }
    }

    var tooltip = document.getElementById('tp-tooltip');
    var tooltipTimer = null;
    var isTouch = 'ontouchstart' in window;

    function showTooltip(anchor) {
        if (tooltipTimer) { clearTimeout(tooltipTimer); tooltipTimer = null; }
        tooltip.textContent = 'Views for higher pitch counts need more 2026 data to be collected';
        tooltip.classList.add('visible');
        var btnRect = anchor.getBoundingClientRect();
        var wrapRect = anchor.closest('[style*="position"]').getBoundingClientRect();
        tooltip.style.position = 'absolute';
        var tipW = tooltip.offsetWidth;
        var left = (btnRect.left - wrapRect.left) + btnRect.width / 2 - tipW / 2;
        if (left < 4) left = 4;
        if (left + tipW > wrapRect.width - 4) left = wrapRect.width - 4 - tipW;
        tooltip.style.left = left + 'px';
        tooltip.style.top = (btnRect.bottom - wrapRect.top + 6) + 'px';
        tooltipTimer = setTimeout(function() { tooltip.classList.remove('visible'); }, 3000);
    }

    function hideTooltip() {
        if (tooltipTimer) { clearTimeout(tooltipTimer); tooltipTimer = null; }
        tooltip.classList.remove('visible');
    }

    pcRow.addEventListener('click', function(e) {
        var btn = e.target.closest('.tp-pc-btn.disabled');
        if (btn && isTouch) { showTooltip(btn); }
    });
    pcRow.addEventListener('mouseover', function(e) {
        if (isTouch) return;
        var btn = e.target.closest('.tp-pc-btn.disabled');
        if (btn) { showTooltip(btn); }
    });
    pcRow.addEventListener('mouseout', function(e) {
        if (isTouch) return;
        var btn = e.target.closest('.tp-pc-btn.disabled');
        if (btn) { hideTooltip(); }
    });
    document.addEventListener('click', function(e) {
        if (!e.target.closest('.tp-pc-btn.disabled') && !e.target.closest('.tp-tooltip')) {
            hideTooltip();
        }
    });

    function getTopPerformers(pc) {
        return (byPC[pc] || []).filter(function(d) { return d.rank <= 10; })
            .sort(function(a, b) { return a.rank - b.rank; });
    }

    function escHtml(s) {
        var el = document.createElement('span');
        el.textContent = s;
        return el.innerHTML;
    }

    function shortName(name) {
        if (name.length <= 15) return name;
        var parts = name.split(' ');
        if (parts.length < 2) return name;
        return parts[0].charAt(0) + '. ' + parts.slice(1).join(' ');
    }

    function parseStatLine(s) {
        var parts = s.split(',');
        var stats = [];
        for (var i = 0; i < parts.length; i++) {
            var part = parts[i].trim();
            var m = part.match(/^([\d.]+)\s+(?:exp\s+)?(.+)$/);
            if (m) {
                var val = m[1];
                var label = m[2];
                if (label === 'HRs') label = 'HR';
                else if (label === 'Hits') label = 'H';
                else if (label === 'Bases') label = 'TB';
                else if (label === 'BBs') label = 'BB';
                else if (label === 'Ks') label = 'K';
                stats.push({ val: val, label: label });
            }
        }
        return stats;
    }

    function buildCard(d, rank) {
        var page = d.bt ? 'Batter-Summary' : 'Pitcher-Summary';
        var href = page + '.php?PlayerId=' + d.pid;
        var headshot = 'https://img.mlbstatic.com/mlb-photos/image/upload/w_80,q_100/v1/people/' + d.pid + '/headshot/silo/current';
        var evColor = getScoreColor(d.ev);
        var stats = parseStatLine(d.stat);
        var statsHtml = '<div class="tp-stats">';
        for (var i = 0; i < stats.length; i++) {
            statsHtml += '<span class="tp-stat"><b>' + stats[i].val + '</b> ' + stats[i].label + '</span>';
        }
        statsHtml += '</div>';
        return '<a href="' + href + '" class="tp-card">' +
            '<span class="tp-rank">' + rank + '</span>' +
            '<img src="' + headshot + '" class="tp-headshot" alt="" />' +
            '<div class="tp-info">' +
                '<span class="tp-score" style="background:' + evColor + '">' + d.ev + '</span>' +
                '<div class="tp-detail">' +
                    '<div class="tp-name">' + escHtml(shortName(d.name)) + '</div>' +
                    statsHtml +
                '</div>' +
            '</div>' +
        '</a>';
    }

    function render() {
        var items = getTopPerformers(currentPC);
        var leftItems = items.slice(0, 5);
        var rightItems = items.slice(5, 10);
        leftCol.innerHTML = leftItems.map(function(d, i) { return buildCard(d, i + 1); }).join('');
        rightCol.innerHTML = rightItems.map(function(d, i) { return buildCard(d, i + 6); }).join('');
    }

    buildPCButtons();
    render();

    document.getElementById('tp-guide-link').addEventListener('click', function() {
        document.getElementById('rfKeyOverlay').classList.add('is-open');
    });
})();
</script>


<style>
.lu-wrap { max-width: 865px; margin: 30px auto 0; padding: 0 10px 20px; }
.lu-header-row { display: flex; gap: 8px; padding: 0; }
.lu-header-btn {
    flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 18px;
    padding: 14px 24px; font-size: 36px; font-weight: bold; color: #fff;
    letter-spacing: 1px; border: none; border-radius: 14px; cursor: pointer;
    box-shadow: 0 4px 0 rgba(0,0,0,0.2), inset 0 1px 0 rgba(255,255,255,0.25);
    transition: filter 0.2s, opacity 0.2s, transform 0.1s, box-shadow 0.1s;
}
.lu-header-btn.lu-lucky { background: #4a9e6e; }
.lu-header-btn.lu-unlucky { background: #c04242; }
.lu-header-btn:hover { filter: brightness(1.12); transform: translateY(-1px); box-shadow: 0 5px 0 rgba(0,0,0,0.2), inset 0 1px 0 rgba(255,255,255,0.25); }
.lu-header-btn:active { transform: translateY(2px); box-shadow: 0 1px 0 rgba(0,0,0,0.2), inset 0 1px 0 rgba(255,255,255,0.25); }
.lu-header-btn.inactive { filter: grayscale(80%); opacity: 0.45; box-shadow: 0 2px 0 rgba(0,0,0,0.1); }
.lu-header-btn.inactive:hover { filter: grayscale(60%) brightness(1.1); opacity: 0.6; }
.lu-header-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%; background: #fff; flex-shrink: 0;
}
.lu-header-icon img { height: 30px; width: auto; }
.lu-pc-row { display: flex; justify-content: center; padding: 16px 14px 12px; }
.lu-pc-btn {
    flex: 1; max-width: 160px; text-align: center;
    padding: 8px 4px; font-size: 17px; font-weight: 700;
    border: 2px solid #ccc; border-radius: 22px;
    background: #e0e0e0; color: #999; cursor: pointer; transition: all 0.15s;
    margin: 0 4px;
}
.lu-pc-btn:hover:not(.disabled):not(.active) { background: #d5d5d5; border-color: #bbb; color: #777; }
.lu-pc-btn.active { background: #424242; border-color: #424242; color: #fff; }
.lu-pc-btn.disabled { background: #e0e0e0; border-color: #ccc; color: #999; cursor: not-allowed; }
.lu-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 0; }
.lu-col { display: flex; flex-direction: column; gap: 8px; }
.lu-card {
    display: flex; align-items: center; gap: 14px;
    padding: 10px 14px; border-radius: 14px;
    text-decoration: none; color: inherit; transition: filter 0.12s;
}
.lu-card:hover { filter: brightness(0.95); }
.lu-card.lucky-bg { background: rgba(106, 171, 130, 0.15); }
.lu-card.unlucky-bg { background: rgba(192, 66, 66, 0.12); }
.lu-rank { font-size: 28px; font-weight: 800; color: #94a3b8; width: 34px; text-align: center; flex-shrink: 0; }
.lu-headshot { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; flex-shrink: 0; background: #e8e8e8; }
.lu-info { min-width: 0; flex: 1; display: flex; align-items: center; gap: 10px; }
.lu-detail { min-width: 0; flex: 1; }
.lu-score-cluster {
    display: flex; flex-direction: column; gap: 3px;
    width: 72px; flex-shrink: 0;
}
.lu-score-top { display: flex; gap: 3px; }
.lu-score-small {
    flex: 1; min-width: 0; height: 24px; padding: 0 4px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 6px; font-weight: 800; font-size: 13px; color: #fff;
}
.lu-score-main {
    height: 28px; padding: 0 6px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 8px; font-weight: 900; font-size: 20px; color: #fff;
}
.lu-name {
    font-size: 15px; font-weight: 600; color: #2563eb;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0;
    text-decoration: none;
}
.lu-card:hover .lu-name { color: #1d4ed8; }
.lu-name-mobile { display: none; }
.lu-footnote-break { display: inline; }
.lu-stats { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 6px; }
.lu-stat {
    display: inline-flex; align-items: center;
    padding: 1px 5px; border-radius: 4px;
    font-size: 11px; font-weight: 600; color: #64748b;
    white-space: nowrap; line-height: 1.4;
}
.lu-card.lucky-bg .lu-stat { background: rgba(106, 171, 130, 0.18); }
.lu-card.unlucky-bg .lu-stat { background: rgba(192, 66, 66, 0.14); }
.lu-stat b { margin-right: 2px; color: #1a1a1a; font-weight: 800; }
.lu-pc-last-short { display: none; }
.lu-footnote {
    text-align: center; font-size: 14px; color: #64748b; font-weight: 600;
    font-family: sans-serif; margin: 10px 0 0; line-height: 1.4;
}
.lu-footnote a { color: #2563eb; text-decoration: none; cursor: pointer; }
.lu-footnote a:hover { color: #1d4ed8; }
.lu-tooltip {
    position: absolute; z-index: 2500;
    width: min(300px, calc(100vw - 24px));
    padding: 9px 10px; border-radius: 10px;
    border: 1px solid #d1d5db; background: #f8fafc;
    box-shadow: 0 8px 20px rgba(2, 8, 23, 0.14);
    color: #1f2937; font-size: 13px; line-height: 1.4;
    font-weight: 600; text-align: center;
    pointer-events: none; opacity: 0; transition: opacity 0.15s;
}
.lu-tooltip.visible { opacity: 1; pointer-events: auto; }

@media (max-width: 1000px) {
    .lu-header-btn { padding: 8px 24px; font-size: 44px; }
    .lu-header-icon { width: 54px; height: 54px; }
    .lu-header-icon img { height: 38px; }
    .lu-grid { gap: 12px; padding: 0 14px 20px; }
    .lu-card { padding: 12px 14px; gap: 14px; }
    .lu-rank { font-size: 36px; width: 42px; }
    .lu-headshot { width: 80px; height: 80px; }
    .lu-info { gap: 8px; }
    .lu-score-cluster { width: 96px; gap: 4px; }
    .lu-score-top { gap: 4px; }
    .lu-score-small { height: 32px; font-size: 17px; border-radius: 8px; }
    .lu-score-main { height: 40px; font-size: 26px; border-radius: 10px; }
    .lu-name { font-size: 19px; }
    .lu-name-desktop { display: none; }
    .lu-name-mobile { display: inline; }
    .lu-footnote-break { display: none; }
    .lu-pc-last-full { display: none; }
    .lu-pc-last-short { display: inline; }
    .lu-pc-btn { padding: 10px 6px; font-size: 20px; margin: 0 4px; border-radius: 26px; }
    .lu-pc-btn.lu-pc-first { font-size: 17px; }
    .lu-pc-row { padding: 18px 12px 14px; }
    .lu-footnote { font-size: 22px; }
    .lu-stats { display: grid; grid-template-columns: auto auto; gap: 4px; justify-content: start; }
    .lu-stat { font-size: 13px; padding: 2px 6px; }
}
@media (max-width: 420px) {
    .lu-header-btn { padding: 6px 16px; font-size: 36px; gap: 8px; }
    .lu-header-icon { width: 44px; height: 44px; }
    .lu-header-icon img { height: 30px; }
    .lu-rank { font-size: 28px; width: 34px; }
    .lu-headshot { width: 60px; height: 60px; }
    .lu-score-cluster { width: 72px; gap: 3px; }
    .lu-score-top { gap: 3px; }
    .lu-score-small { height: 24px; font-size: 13px; border-radius: 6px; }
    .lu-score-main { height: 30px; font-size: 20px; border-radius: 8px; }
    .lu-name { font-size: 16px; }
    .lu-pc-btn { padding: 8px 4px; font-size: 17px; margin: 0 3px; border-radius: 24px; }
    .lu-pc-btn.lu-pc-first { font-size: 17px; }
    .lu-card { gap: 10px; padding: 10px 8px; }
    .lu-grid { gap: 10px; padding: 0 8px 16px; }
    .lu-footnote { font-size: 19px; }
    .lu-stat { font-size: 10px; padding: 1px 4px; }
}
</style>

<div class="lu-wrap">
    <div class="lu-container">
        <div class="lu-header-row">
            <button id="lu-btn-lucky" class="lu-header-btn lu-lucky" type="button">
                <span>Lucky</span>
                <span class="lu-header-icon"><img src="Images/Lucky.png" alt=""></span>
            </button>
            <button id="lu-btn-unlucky" class="lu-header-btn lu-unlucky" type="button">
                <span>Unlucky</span>
                <span class="lu-header-icon"><img src="Images/Unlucky.png" alt=""></span>
            </button>
        </div>
        <div style="position: relative;">
            <div id="lu-pc-row" class="lu-pc-row"></div>
            <div id="lu-tooltip" class="lu-tooltip"></div>
        </div>
        <div class="lu-grid">
            <div id="lu-left" class="lu-col"></div>
            <div id="lu-right" class="lu-col"></div>
        </div>
    </div>
    <p class="lu-footnote">"Luck" is the difference between expected outcomes from contact (top left rating) and actual results (top right rating).<br class="lu-footnote-break"> <a href="javascript:void(0)" id="lu-guide-link">Ratings Key</a></p>
</div>

<script>
(function() {
    var SCORE_COLORS = [
        '#d73737','#d83c37','#d94237','#da4736','#db4d36','#dc5336','#dd5936','#df5f36','#e06535','#e16b35',
        '#e27135','#e37735','#e47e35','#e58434','#e68b34','#e79134','#e89834','#e99f33','#eaa633','#ecad33',
        '#edb433','#eebb33','#efc232','#f0ca32','#f1d132','#f1d132','#ebd531','#e6d930','#e1dc2f','#d7db2e',
        '#cad52d','#bdd02c','#b0cb2c','#a4c52b','#98bf2a','#8dba29','#82b428','#78af27','#6eaa26','#65a425',
        '#5c9e24','#539923','#4b9322','#438e21','#3c8821','#358320','#2f7d1f','#29781e','#23721d','#1e6d1c'
    ];

    function getScoreColor(score) {
        var idx;
        if (score <= 40) {
            idx = Math.floor(score / 1.6);
            idx = Math.max(0, Math.min(24, idx));
        } else {
            idx = 25 + Math.floor((score - 40) / 3.4);
            idx = Math.max(25, Math.min(49, idx));
        }
        return SCORE_COLORS[idx];
    }

    // Green gradient for positive luck, red gradient for negative luck.
    // Intensity scales with magnitude (capped at 45).
    function getLuckColor(lv) {
        var mag = Math.min(Math.abs(lv), 45);
        var t = mag / 45; // 0..1
        if (lv >= 0) {
            // light green -> deep green
            var r = Math.round(134 + (30 - 134) * t);
            var g = Math.round(190 + (120 - 190) * t);
            var b = Math.round(140 + (35 - 140) * t);
            return 'rgb(' + r + ',' + g + ',' + b + ')';
        } else {
            // light red -> deep red
            var r2 = Math.round(224 + (175 - 224) * t);
            var g2 = Math.round(110 + (35 - 110) * t);
            var b2 = Math.round(110 + (35 - 110) * t);
            return 'rgb(' + r2 + ',' + g2 + ',' + b2 + ')';
        }
    }

