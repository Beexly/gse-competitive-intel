/* ── Announcement Message Bar ── */
.hp-announcement {
    display: inline-block;
    padding: 7px 28px;
    margin: 2px 0 20px;
    font-size: 17px;
    font-family: sans-serif;
    color: #7a5a00;
    background-color: #fff8e1;
    border: 1px solid #ffe082;
    border-radius: 8px;
    letter-spacing: 0.15px;
    line-height: 1.4;
}

/* ── Quick Links Row ── */
.hp-quick-links {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin: 6px 0 30px;
    font-size: 14px;
    font-family: sans-serif;
}

.hp-quick-link,
.hp-quick-link:link,
.hp-quick-link:visited,
.hp-quick-link:active {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #2e7d46;
    text-decoration: none;
    transition: color 0.15s ease;
    white-space: nowrap;
}

.hp-quick-link:hover {
    color: #1b5e30;
    text-decoration: underline;
}

.hp-quick-link-icon {
    font-size: 13px;
    line-height: 1;
}

.hp-quick-links-sep {
    color: #ccc;
    user-select: none;
}

