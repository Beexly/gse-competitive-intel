<!--
<script>
(function() {
    var btn = document.getElementById('asg-info-btn');
    var tip = document.getElementById('asg-tooltip');
    var timer = null;
    function show() {
        if (timer) { clearTimeout(timer); timer = null; }
        tip.classList.add('visible');
        timer = setTimeout(hide, 5000);
    }
    function hide() {
        if (timer) { clearTimeout(timer); timer = null; }
        tip.classList.remove('visible');
    }
    /* On touch devices a tap fires mouseenter (show) then click (toggle -> hide),
       so only bind hover handlers when the device actually supports hover */
    var canHover = window.matchMedia('(hover: hover)').matches;
    if (canHover) {
        btn.addEventListener('mouseenter', show);
        btn.addEventListener('mouseleave', hide);
    }
    btn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (tip.classList.contains('visible')) { hide(); } else { show(); }
    });
    document.addEventListener('click', function(e) {
        if (!e.target.closest('.asg-info-wrap')) { hide(); }
    });
})();
</script>

