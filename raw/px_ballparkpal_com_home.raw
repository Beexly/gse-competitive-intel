<!-- Welcome Video Overlay -->
<div id="welcomeVideoOverlay" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.85); z-index:99999; cursor:pointer;" onclick="closeWelcomeVideo()">
    <div id="welcomeVideoInner" style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:80vw; max-width:960px; cursor:default;" onclick="event.stopPropagation()">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
            <span style="color:#fff; font-size:18px; font-family:sans-serif;">Welcome to 2026</span>
            <span onclick="closeWelcomeVideo()" style="color:#fff; font-size:32px; cursor:pointer; line-height:1; padding:0 4px;">&times;</span>
        </div>
        <div style="position:relative; padding-bottom:56.25%; height:0; overflow:hidden; border-radius:8px; background:#000;">
            <iframe id="welcomeVideoIframe" src="" style="position:absolute; top:0; left:0; width:100%; height:100%; border:none;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
    </div>
</div>
<script>
function openWelcomeVideo() {
    document.body.style.zoom = '1';
    document.getElementById('welcomeVideoIframe').src = 'https://www.youtube.com/embed/0L32Ny1zf54?autoplay=1';
    document.getElementById('welcomeVideoOverlay').style.display = 'block';
}
function closeWelcomeVideo() {
    document.getElementById('welcomeVideoOverlay').style.display = 'none';
    document.getElementById('welcomeVideoIframe').src = '';
    document.body.style.zoom = '';
}
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeWelcomeVideo();
});
</script>




