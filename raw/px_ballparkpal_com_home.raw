    function getScoreColor(score) {
        var idx;
        if (score <= 40) {
            idx = Math.floor(score / 1.6);
            idx = Math.max(0, Math.min(24, idx));
        } else {
            idx = 25 + Math.floor((score - 40) / 3.4);
            idx = Math.max(25, Math.min(49, idx));
        }
        return SCORE_COLORS[idx];
    }

