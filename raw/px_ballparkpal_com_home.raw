<div id="siteNoticeDialog" role="dialog" aria-modal="false" aria-labelledby="siteNoticeDialogTitle" style="display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 10000; background: #fff8e1; border: 2px solid #f1c40f; border-radius: 10px; box-shadow: 0 6px 24px rgba(0,0,0,0.25); padding: 32px 40px; max-width: 640px; width: calc(100% - 40px); font-family: sans-serif;">
    <h2 id="siteNoticeDialogTitle" style="margin: 0 0 16px; font-size: 28px; font-weight: 600; color: #7a5a00;">Notice</h2>
    <p style="margin: 0 0 24px; font-size: 20px; line-height: 1.5; color: #5b4400;">We are currently working to address an issue preventing some data from displaying on the site. Thank you for your patience.</p>
    <div style="text-align: right;">
        <button type="button" onclick="dismissSiteNoticeDialog();" style="background: #f1c40f; color: #5b4400; border: none; padding: 10px 22px; border-radius: 6px; cursor: pointer; font-size: 18px; font-weight: 600;">OK</button>
    </div>
</div>
-->
<script>
    var SITE_NOTICE_VERSION = '2026-05-06-v1';
    var SITE_NOTICE_STORAGE_KEY = 'siteNoticeDialogDismissedVersion';

    function dismissSiteNoticeDialog() {
        var dlg = document.getElementById('siteNoticeDialog');
        if (dlg) { dlg.style.display = 'none'; }
        try {
            localStorage.setItem(SITE_NOTICE_STORAGE_KEY, SITE_NOTICE_VERSION);
        } catch (e) { /* localStorage may be unavailable; ignore */ }
    }

    document.addEventListener('DOMContentLoaded', function() {
        var dlg = document.getElementById('siteNoticeDialog');
        if (!dlg) { return; }
        var dismissedVersion = null;
        try {
            dismissedVersion = localStorage.getItem(SITE_NOTICE_STORAGE_KEY);
        } catch (e) { /* localStorage may be unavailable; show the dialog */ }
        if (dismissedVersion !== SITE_NOTICE_VERSION) {
            dlg.style.display = 'block';
        }
    });
</script>


