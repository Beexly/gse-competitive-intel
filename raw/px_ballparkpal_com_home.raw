        byPC[d.pc].push(d);
    });

    var availablePCs = Object.keys(byPC).map(Number).sort(function(a, b) { return a - b; });
    var ALL_PCS = [50, 100, 250, 500, 1000];
    var currentPC = availablePCs.indexOf(100) !== -1 ? 100 : (availablePCs[0] || 100);
    var viewMode = 'both';

    var pcRow = document.getElementById('rf-pc-row');
    var leftCol = document.getElementById('rf-left');
    var rightCol = document.getElementById('rf-right');
    var btnRisers = document.getElementById('rf-btn-risers');
    var btnFallers = document.getElementById('rf-btn-fallers');

    function buildPCButtons() {
        pcRow.innerHTML = ALL_PCS.map(function(pc) {
            var available = availablePCs.indexOf(pc) !== -1;
            var active = pc === currentPC;
            var cls = 'rf-pc-btn';
            if (pc === 50) cls += ' rf-pc-first';
            if (!available) cls += ' disabled';
            else if (active) cls += ' active';
            var label = pc === 50 ? 'Last 50 Pitches' : '<span class="rf-pc-last-full">Last </span><span class="rf-pc-last-short">L </span>' + pc.toLocaleString();
            return '<button class="' + cls + '" data-pc="' + pc + '">' + label + '</button>';
        }).join('');

        var btns = pcRow.querySelectorAll('.rf-pc-btn:not(.disabled)');
        for (var i = 0; i < btns.length; i++) {
            (function(btn) {
                btn.addEventListener('click', function() {
                    currentPC = parseInt(btn.getAttribute('data-pc'));
                    buildPCButtons();
                    render();
                });
            })(btns[i]);
        }
    }

    var tooltip = document.getElementById('rf-tooltip');
    var tooltipTimer = null;
    var isTouch = 'ontouchstart' in window;

    function showTooltip(anchor) {
        if (tooltipTimer) { clearTimeout(tooltipTimer); tooltipTimer = null; }
        tooltip.textContent = 'Views for higher pitch counts need more 2026 data to be collected';
        tooltip.classList.add('visible');
        var btnRect = anchor.getBoundingClientRect();
        var wrapRect = anchor.closest('[style*="position"]').getBoundingClientRect();
        tooltip.style.position = 'absolute';
        var tipW = tooltip.offsetWidth;
        var left = (btnRect.left - wrapRect.left) + btnRect.width / 2 - tipW / 2;
        if (left < 4) left = 4;
        if (left + tipW > wrapRect.width - 4) left = wrapRect.width - 4 - tipW;
        tooltip.style.left = left + 'px';
        tooltip.style.top = (btnRect.bottom - wrapRect.top + 6) + 'px';
        tooltipTimer = setTimeout(function() { tooltip.classList.remove('visible'); }, 3000);
    }

    function hideTooltip() {
        if (tooltipTimer) { clearTimeout(tooltipTimer); tooltipTimer = null; }
        tooltip.classList.remove('visible');
    }

    pcRow.addEventListener('click', function(e) {
        var btn = e.target.closest('.rf-pc-btn.disabled');
        if (btn && isTouch) { showTooltip(btn); }
    });

    pcRow.addEventListener('mouseover', function(e) {
        if (isTouch) return;
        var btn = e.target.closest('.rf-pc-btn.disabled');
        if (btn) { showTooltip(btn); }
    });

    pcRow.addEventListener('mouseout', function(e) {
        if (isTouch) return;
        var btn = e.target.closest('.rf-pc-btn.disabled');
        if (btn) { hideTooltip(); }
    });

    document.addEventListener('click', function(e) {
        if (!e.target.closest('.rf-pc-btn.disabled') && !e.target.closest('.rf-tooltip')) {
            hideTooltip();
        }
    });

    function getRisers(pc) {
        return (byPC[pc] || []).filter(function(d) { return d.rr <= 10; }).sort(function(a, b) { return a.rr - b.rr; });
    }

    function getFallers(pc) {
        return (byPC[pc] || []).filter(function(d) { return d.fr <= 10; }).sort(function(a, b) { return a.fr - b.fr; });
    }

    function escHtml(s) {
        var el = document.createElement('span');
        el.textContent = s;
        return el.innerHTML;
    }

    function buildCard(d, type, rank) {
        var page = d.bt ? 'Batter-Summary' : 'Pitcher-Summary';
        var href = page + '.php?PlayerId=' + d.pid;
        var bgClass = type === 'riser' ? 'riser-bg' : 'faller-bg';
        var headshot = 'https://img.mlbstatic.com/mlb-photos/image/upload/w_80,q_100/v1/people/' + d.pid + '/headshot/silo/current';
        var prevColor = getScoreColor(d.prev);
        var currColor = getScoreColor(d.curr);
        return '<a href="' + href + '" class="rf-card ' + bgClass + '">' +
            '<span class="rf-rank">' + rank + '</span>' +
            '<img src="' + headshot + '" class="rf-headshot" alt="" />' +
            '<div class="rf-info">' +
                '<div class="rf-values">' +
                    '<span class="rf-score" style="background:' + prevColor + '">' + d.prev + '</span>' +
                    '<span class="rf-arrow"></span>' +
                    '<span class="rf-score" style="background:' + currColor + '">' + d.curr + '</span>' +
                '</div>' +
                '<div class="rf-name">' + escHtml(d.name) + '</div>' +
            '</div>' +
        '</a>';
    }

    function render() {
        var leftItems, rightItems, leftType, rightType;

        if (viewMode === 'both') {
            leftItems = getRisers(currentPC).slice(0, 5);
            rightItems = getFallers(currentPC).slice(0, 5);
            leftType = 'riser';
            rightType = 'faller';
        } else if (viewMode === 'risers') {
            var risers = getRisers(currentPC);
            leftItems = risers.slice(0, 5);
            rightItems = risers.slice(5, 10);
            leftType = 'riser';
            rightType = 'riser';
        } else {
            var fallers = getFallers(currentPC);
            leftItems = fallers.slice(0, 5);
            rightItems = fallers.slice(5, 10);
            leftType = 'faller';
            rightType = 'faller';
        }

        var leftStart = 1;
        var rightStart = viewMode === 'both' ? 1 : 6;
        leftCol.innerHTML = leftItems.map(function(d, i) { return buildCard(d, leftType, leftStart + i); }).join('');
        rightCol.innerHTML = rightItems.map(function(d, i) { return buildCard(d, rightType, rightStart + i); }).join('');

        btnRisers.classList.toggle('inactive', viewMode === 'fallers');
        btnFallers.classList.toggle('inactive', viewMode === 'risers');
    }

    btnRisers.addEventListener('click', function() {
        if (viewMode === 'both') viewMode = 'risers';
        else viewMode = 'both';
        render();
    });

    btnFallers.addEventListener('click', function() {
        if (viewMode === 'both') viewMode = 'fallers';
        else viewMode = 'both';
        render();
    });

    buildPCButtons();
    render();

    var rfOverlay = document.getElementById('rfKeyOverlay');
    var rfClose = document.getElementById('rfKeyClose');
    document.getElementById('rf-guide-link').addEventListener('click', function() { rfOverlay.classList.add('is-open'); });
    rfClose.addEventListener('click', function() { rfOverlay.classList.remove('is-open'); });
    rfOverlay.addEventListener('click', function(e) { if (e.target === rfOverlay) rfOverlay.classList.remove('is-open'); });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') rfOverlay.classList.remove('is-open'); });
})();
</script>


<style>
.tp-wrap { max-width: 865px; margin: 30px auto 0; padding: 0 10px 20px; }
.tp-header {
    display: flex; align-items: center; justify-content: center; gap: 18px;
    padding: 14px 24px; font-size: 36px; font-weight: bold; color: #fff;
    letter-spacing: 1px; border: none; border-radius: 14px;
    background: #5a8db4;
    box-shadow: 0 4px 0 rgba(0,0,0,0.2), inset 0 1px 0 rgba(255,255,255,0.25);
}
.tp-header-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%; background: #fff; flex-shrink: 0;
}
.tp-header-icon img { height: 26px; width: auto; }
.tp-pc-row { display: flex; justify-content: center; padding: 16px 14px 12px; }
.tp-pc-btn {
    flex: 1; max-width: 160px; text-align: center;
    padding: 8px 4px; font-size: 17px; font-weight: 700;
    border: 2px solid #ccc; border-radius: 22px;
    background: #e0e0e0; color: #999; cursor: pointer; transition: all 0.15s;
    margin: 0 4px;
}
.tp-pc-btn:hover:not(.disabled):not(.active) { background: #d5d5d5; border-color: #bbb; color: #777; }
.tp-pc-btn.active { background: #424242; border-color: #424242; color: #fff; }
.tp-pc-btn.disabled { background: #e0e0e0; border-color: #ccc; color: #999; cursor: not-allowed; }
.tp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 0; }
.tp-col { display: flex; flex-direction: column; gap: 8px; }
.tp-card {
    display: flex; align-items: center; gap: 14px;
    padding: 10px 14px; border-radius: 14px;
    background: rgba(122, 157, 184, 0.15);
    text-decoration: none; color: inherit; transition: filter 0.12s;
}
.tp-card:hover { filter: brightness(0.95); }
.tp-rank { font-size: 28px; font-weight: 800; color: #94a3b8; width: 34px; text-align: center; flex-shrink: 0; }
.tp-headshot { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; flex-shrink: 0; background: #e8e8e8; }
.tp-info { min-width: 0; flex: 1; display: flex; align-items: center; gap: 10px; }
.tp-detail { min-width: 0; flex: 1; }
.tp-score {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 56px; height: 56px; padding: 0 12px;
    border-radius: 12px; font-weight: 800; font-size: 24px; color: #fff; flex-shrink: 0;
}
.tp-name {
    font-size: 15px; font-weight: 600; color: #2563eb;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0;
    text-decoration: none;
}
.tp-card:hover .tp-name { color: #1d4ed8; }
.tp-stats { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 6px; }
.tp-stat {
    display: inline-flex; align-items: center;
    padding: 1px 5px; border-radius: 4px;
    background: rgba(122, 157, 184, 0.14);
    font-size: 11px; font-weight: 600; color: #64748b;
    white-space: nowrap; line-height: 1.4;
}
.tp-stat b { margin-right: 2px; color: #1a1a1a; font-weight: 800; }
.tp-pc-last-short { display: none; }
.tp-footnote {
    text-align: center; font-size: 14px; color: #64748b; font-weight: 600;
    font-family: sans-serif; margin: 10px 0 0; line-height: 1.4;
}
.tp-footnote a { color: #2563eb; text-decoration: none; cursor: pointer; }
.tp-footnote a:hover { color: #1d4ed8; }
.tp-tooltip {
    position: absolute; z-index: 2500;
    width: min(300px, calc(100vw - 24px));
    padding: 9px 10px; border-radius: 10px;
    border: 1px solid #d1d5db; background: #f8fafc;
    box-shadow: 0 8px 20px rgba(2, 8, 23, 0.14);
    color: #1f2937; font-size: 13px; line-height: 1.4;
    font-weight: 600; text-align: center;
    pointer-events: none; opacity: 0; transition: opacity 0.15s;
}
.tp-tooltip.visible { opacity: 1; pointer-events: auto; }

@media (max-width: 1000px) {
    .tp-header { padding: 8px 24px; font-size: 44px; }
    .tp-header-icon { width: 54px; height: 54px; }
    .tp-header-icon img { height: 32px; }
    .tp-grid { gap: 12px; padding: 0 14px 20px; }
    .tp-card { padding: 12px 14px; gap: 14px; }
    .tp-rank { font-size: 36px; width: 42px; }
    .tp-headshot { width: 80px; height: 80px; }
    .tp-info { gap: 8px; }
    .tp-score { min-width: 80px; height: 80px; padding: 0; font-size: 28px; border-radius: 14px; }
    .tp-name { font-size: 19px; }
    .tp-pc-last-full { display: none; }
    .tp-pc-last-short { display: inline; }
    .tp-pc-btn { padding: 10px 6px; font-size: 20px; margin: 0 4px; border-radius: 26px; }
    .tp-pc-btn.tp-pc-first { font-size: 17px; }
    .tp-pc-row { padding: 18px 12px 14px; }
    .tp-footnote { font-size: 22px; }
    .tp-stats { display: grid; grid-template-columns: auto auto; gap: 4px; justify-content: start; }
    .tp-stat { font-size: 13px; padding: 2px 6px; }
}
@media (max-width: 420px) {
    .tp-header { padding: 6px 16px; font-size: 36px; gap: 8px; }
    .tp-header-icon { width: 44px; height: 44px; }
    .tp-header-icon img { height: 26px; }
    .tp-rank { font-size: 28px; width: 34px; }
    .tp-headshot { width: 60px; height: 60px; }
    .tp-score { min-width: 60px; height: 60px; padding: 0; font-size: 22px; border-radius: 12px; }
    .tp-name { font-size: 16px; }
    .tp-pc-btn { padding: 8px 4px; font-size: 17px; margin: 0 3px; border-radius: 24px; }
    .tp-pc-btn.tp-pc-first { font-size: 17px; }
    .tp-card { gap: 10px; padding: 10px 8px; }
    .tp-grid { gap: 10px; padding: 0 8px 16px; }
    .tp-footnote { font-size: 19px; }
    .tp-stat { font-size: 10px; padding: 1px 4px; }
}
</style>

<div class="tp-wrap">
    <div class="tp-container">
        <div class="tp-header">
            <span class="tp-header-icon"><img src="Images/TopPerformingCrown.png" alt=""></span>
            <span>Top Performers</span>
        </div>
        <div style="position: relative;">
            <div id="tp-pc-row" class="tp-pc-row"></div>
            <div id="tp-tooltip" class="tp-tooltip"></div>
        </div>
        <div class="tp-grid">
            <div id="tp-left" class="tp-col"></div>
            <div id="tp-right" class="tp-col"></div>
        </div>
    </div>
    <p class="tp-footnote">Ratings and stat lines are luck-adjusted, based on contact quality and expected outcomes. <a href="javascript:void(0)" id="tp-guide-link">Ratings Key</a></p>
</div>

<script>
(function() {
    var SCORE_COLORS = [
        '#d73737','#d83c37','#d94237','#da4736','#db4d36','#dc5336','#dd5936','#df5f36','#e06535','#e16b35',
        '#e27135','#e37735','#e47e35','#e58434','#e68b34','#e79134','#e89834','#e99f33','#eaa633','#ecad33',
        '#edb433','#eebb33','#efc232','#f0ca32','#f1d132','#f1d132','#ebd531','#e6d930','#e1dc2f','#d7db2e',
        '#cad52d','#bdd02c','#b0cb2c','#a4c52b','#98bf2a','#8dba29','#82b428','#78af27','#6eaa26','#65a425',
        '#5c9e24','#539923','#4b9322','#438e21','#3c8821','#358320','#2f7d1f','#29781e','#23721d','#1e6d1c'
    ];

    function getScoreColor(score) {
        var idx;
        if (score <= 40) {
            idx = Math.floor(score / 1.6);
            idx = Math.max(0, Math.min(24, idx));
        } else {
            idx = 25 + Math.floor((score - 40) / 3.4);
            idx = Math.max(25, Math.min(49, idx));
        }
        return SCORE_COLORS[idx];
    }

    var allData = [{"pc":50,"pid":682985,"ev":120,"rank":1,"stat":"4.1 exp HRs, 9.5 exp Hits, 24.1 exp Bases, 0 BBs","name":"Riley Greene","bt":1,"pt":0},{"pc":50,"pid":668804,"ev":112,"rank":2,"stat":"1.8 exp HRs, 6.6 exp Hits, 13.2 exp Bases, 2 BBs","name":"Bryan Reynolds","bt":1,"pt":0},{"pc":50,"pid":646240,"ev":110,"rank":3,"stat":"1.6 exp HRs, 4.2 exp Hits, 10.0 exp Bases, 1 BBs","name":"Rafael Devers","bt":1,"pt":0},{"pc":50,"pid":660670,"ev":110,"rank":4,"stat":"2.0 exp HRs, 4.2 exp Hits, 10.7 exp Bases, 1 BBs","name":"Ronald Acuna Jr.","bt":1,"pt":0},{"pc":50,"pid":681198,"ev":108,"rank":5,"stat":"1.6 exp HRs, 7.2 exp Hits, 13.2 exp Bases, 1 BBs","name":"TJ Rumfield","bt":1,"pt":0},{"pc":50,"pid":521692,"ev":105,"rank":6,"stat":"1.4 exp HRs, 7.1 exp Hits, 12.9 exp Bases, 0 BBs","name":"Salvador Perez","bt":1,"pt":0},{"pc":50,"pid":686681,"ev":105,"rank":7,"stat":"0.5 exp HRs, 5.0 exp Hits, 7.8 exp Bases, 1 BBs","name":"Michael Massey","bt":1,"pt":0},{"pc":50,"pid":682829,"ev":105,"rank":8,"stat":"2.4 exp HRs, 5.1 exp Hits, 13.1 exp Bases, 2 BBs","name":"Elly De La Cruz","bt":1,"pt":0},{"pc":50,"pid":686469,"ev":104,"rank":9,"stat":"1.2 exp HRs, 3.8 exp Hits, 8.4 exp Bases, 3 BBs","name":"Vinnie Pasquantino","bt":1,"pt":0},{"pc":50,"pid":671976,"ev":103,"rank":10,"stat":"1.2 exp HRs, 7.2 exp Hits, 13.6 exp Bases, 0 BBs","name":"Tristan Peters","bt":1,"pt":0},{"pc":100,"pid":668804,"ev":110,"rank":1,"stat":"2.6 exp HRs, 12.8 exp Hits, 24.0 exp Bases, 3 BBs","name":"Bryan Reynolds","bt":1,"pt":0},{"pc":100,"pid":682985,"ev":105,"rank":2,"stat":"4.1 exp HRs, 10.5 exp Hits, 25.6 exp Bases, 1 BBs","name":"Riley Greene","bt":1,"pt":0},{"pc":100,"pid":680869,"ev":105,"rank":3,"stat":"4.3 exp HRs, 9.5 exp Hits, 25.0 exp Bases, 0 BBs","name":"Zack Gelof","bt":1,"pt":0},{"pc":100,"pid":673237,"ev":105,"rank":4,"stat":"1.8 exp HRs, 9.6 exp Hits, 17.7 exp Bases, 1 BBs","name":"Yainer Diaz","bt":1,"pt":0},{"pc":100,"pid":660688,"ev":104,"rank":5,"stat":"2.6 exp HRs, 11.0