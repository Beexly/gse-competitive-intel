al Bases","thr":1,"pid":805999,"gc":3,"rank":10,"sb":0,"b1":null,"b2":null,"b3":null,"name":"A.J. Ewing"},{"st":"Strikeout","thr":1,"pid":808959,"gc":17,"rank":2,"sb":0,"b1":null,"b2":null,"b3":null,"name":"Munetaka Murakami"},{"st":"Strikeout","thr":1,"pid":808959,"gc":36,"rank":1,"sb":3,"b1":18,"b2":25,"b3":35,"name":"Munetaka Murakami"},{"st":"Strikeout","thr":2,"pid":808959,"gc":17,"rank":2,"sb":0,"b1":null,"b2":null,"b3":null,"name":"Munetaka Murakami"},{"st":"Strikeout","thr":1,"pid":808959,"gc":32,"rank":1,"sb":2,"b1":18,"b2":25,"b3":null,"name":"Munetaka Murakami"},{"st":"Strikeout","thr":1,"pid":808959,"gc":23,"rank":1,"sb":1,"b1":18,"b2":null,"b3":null,"name":"Munetaka Murakami"},{"st":"Strikeout","thr":2,"pid":808959,"gc":23,"rank":1,"sb":1,"b1":18,"b2":null,"b3":null,"name":"Munetaka Murakami"},{"st":"Strikeout","thr":2,"pid":808959,"gc":32,"rank":1,"sb":2,"b1":18,"b2":25,"b3":null,"name":"Munetaka Murakami"},{"st":"Strikeout","thr":2,"pid":808959,"gc":36,"rank":1,"sb":3,"b1":18,"b2":25,"b3":35,"name":"Munetaka Murakami"},{"st":"Strikeout","thr":3,"pid":808959,"gc":23,"rank":1,"sb":1,"b1":18,"b2":null,"b3":null,"name":"Munetaka Murakami"},{"st":"Strikeout","thr":3,"pid":808959,"gc":17,"rank":2,"sb":0,"b1":null,"b2":null,"b3":null,"name":"Munetaka Murakami"},{"st":"Strikeout","thr":3,"pid":808959,"gc":36,"rank":1,"sb":3,"b1":18,"b2":25,"b3":35,"name":"Munetaka Murakami"},{"st":"Strikeout","thr":3,"pid":808959,"gc":32,"rank":1,"sb":2,"b1":18,"b2":25,"b3":null,"name":"Munetaka Murakami"}];

    var STREAK_TYPES = [
        { key: 'Hit', thr: 1, label: '1+ Hits' },
        { key: 'On Base', thr: 1, label: 'On Base' },
        { key: 'Total Bases', thr: 2, label: '2+ Bases' },
        { key: 'Home Run', thr: 1, label: '1+ HR' },
        { key: 'Walk', thr: 1, label: '1+ BB' },
        { key: 'Stolen Bases', thr: 1, label: '1+ SB' },
        { key: 'Strikeout', thr: 1, label: '1+ K' }
    ];

    var currentType = STREAK_TYPES[0];
    var currentBreaks = 1;

    var typeRow = document.getElementById('hs-type-row');
    var leftCol = document.getElementById('hs-left');
    var rightCol = document.getElementById('hs-right');

    function buildTypeButtons() {
        typeRow.innerHTML = STREAK_TYPES.map(function(t) {
            var cls = 'hs-type-btn';
            if (t.key === currentType.key) cls += ' active';
            return '<button class="' + cls + '" data-type="' + t.key + '">' + t.label + '</button>';
        }).join('');

        var btns = typeRow.querySelectorAll('.hs-type-btn');
        for (var i = 0; i < btns.length; i++) {
            (function(btn) {
                btn.addEventListener('click', function() {
                    var key = btn.getAttribute('data-type');
                    for (var j = 0; j < STREAK_TYPES.length; j++) {
                        if (STREAK_TYPES[j].key === key) { currentType = STREAK_TYPES[j]; break; }
                    }
                    buildTypeButtons();
                    render();
                });
            })(btns[i]);
        }
    }

    var breakBtns = document.querySelectorAll('.hs-break-btn');
    for (var i = 0; i < breakBtns.length; i++) {
        (function(btn) {
            btn.addEventListener('click', function() {
                currentBreaks = parseInt(btn.getAttribute('data-breaks'));
                for (var j = 0; j < breakBtns.length; j++) {
                    breakBtns[j].classList.toggle('active', parseInt(breakBtns[j].getAttribute('data-breaks')) === currentBreaks);
                }
                render();
            });
        })(breakBtns[i]);
    }

    function getStreaks() {
        return allData.filter(function(d) {
            return d.st === currentType.key && d.thr === currentType.thr && d.sb === currentBreaks;
        }).sort(function(a, b) { return a.rank - b.rank; });
    }

    function escHtml(s) {
        var el = document.createElement('span');
        el.textContent = s;
        return el.innerHTML;
    }

    function shortName(name) {
        if (name.length <= 14) return name;
        var parts = name.split(' ');
        if (parts.length < 2) return name;
        return parts[0].charAt(0) + '. ' + parts.slice(1).join(' ');
    }

    function buildStreakBar(d) {
        var breaks = [];
        if (d.b1 !== null) breaks.push(d.b1);
        if (d.b2 !== null) breaks.push(d.b2);
        if (d.b3 !== null) breaks.push(d.b3);
        var total = d.gc + d.sb;
        var html = '<div class="hs-streak-bar">';
        for (var i = 1; i <= total; i++) {
            var cls = breaks.indexOf(i) !== -1 ? 'fail' : 'success';
            html += '<span class="hs-box ' + cls + '"></span>';
        }
        html += '</div>';
        return html;
    }

    function buildCard(d) {
        var href = 'Batter-Summary.php?PlayerId=' + d.pid;
        var headshot = 'https://img.mlbstatic.com/mlb-photos/image/upload/w_80,q_100/v1/people/' + d.pid + '/headshot/silo/current';
        return '<a href="' + href + '" class="hs-card">' +
            '<img src="' + headshot + '" class="hs-headshot" alt="" />' +
            '<div class="hs-info">' +
                '<span class="hs-score">' + d.gc + '</span>' +
                '<div class="hs-detail">' +
                    '<div class="hs-name">' + escHtml(shortName(d.name)) + '</div>' +
                    buildStreakBar(d) +
                '</div>' +
            '</div>' +
        '</a>';
    }

    function render() {
        var items = getStreaks();
        var left = items.slice(0, 5);
        var right = items.slice(5, 10);
        leftCol.innerHTML = left.map(function(d) { return buildCard(d); }).join('');
        rightCol.innerHTML = right.map(function(d) { return buildCard(d); }).join('');
    }

    buildTypeButtons();
    render();
})();
</script>

