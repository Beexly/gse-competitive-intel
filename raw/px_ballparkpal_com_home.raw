    const allTeams = {"109":{"TeamId":109,"TeamAbv2":"ARI","TeamCity":"Arizona","TeamNickname":"Dbacks","FullName":"Arizona Dbacks","TeamColorBackground":"#A71930","TeamColorText":"#FFFFFF"},"144":{"TeamId":144,"TeamAbv2":"ATL","TeamCity":"Atlanta","TeamNickname":"Braves","FullName":"Atlanta Braves","TeamColorBackground":"#13274F","TeamColorText":"#FFFFFF"},"110":{"TeamId":110,"TeamAbv2":"BAL","TeamCity":"Baltimore","TeamNickname":"Orioles","FullName":"Baltimore Orioles","TeamColorBackground":"#DF4601","TeamColorText":"#FFFFFF"},"111":{"TeamId":111,"TeamAbv2":"BOS","TeamCity":"Boston","TeamNickname":"Red Sox","FullName":"Boston Red Sox","TeamColorBackground":"#BD3039","TeamColorText":"#FFFFFF"},"112":{"TeamId":112,"TeamAbv2":"CHC","TeamCity":"Chicago","TeamNickname":"Cubs","FullName":"Chicago Cubs","TeamColorBackground":"#0E3386","TeamColorText":"#FFFFFF"},"145":{"TeamId":145,"TeamAbv2":"CHW","TeamCity":"Chicago","TeamNickname":"White Sox","FullName":"Chicago White Sox","TeamColorBackground":"#27251F","TeamColorText":"#FFFFFF"},"113":{"TeamId":113,"TeamAbv2":"CIN","TeamCity":"Cincinnati","TeamNickname":"Reds","FullName":"Cincinnati Reds","TeamColorBackground":"#C6011F","TeamColorText":"#FFFFFF"},"114":{"TeamId":114,"TeamAbv2":"CLE","TeamCity":"Cleveland","TeamNickname":"Guardians","FullName":"Cleveland Guardians","TeamColorBackground":"#0C2340","TeamColorText":"#FFFFFF"},"115":{"TeamId":115,"TeamAbv2":"COL","TeamCity":"Colorado","TeamNickname":"Rockies","FullName":"Colorado Rockies","TeamColorBackground":"#33006F","TeamColorText":"#FFFFFF"},"116":{"TeamId":116,"TeamAbv2":"DET","TeamCity":"Detroit","TeamNickname":"Tigers","FullName":"Detroit Tigers","TeamColorBackground":"#FA4616","TeamColorText":"#0C2340"},"117":{"TeamId":117,"TeamAbv2":"HOU","TeamCity":"Houston","TeamNickname":"Astros","FullName":"Houston Astros","TeamColorBackground":"#EB6E1F","TeamColorText":"#002D62"},"118":{"TeamId":118,"TeamAbv2":"KC","TeamCity":"Kansas City","TeamNickname":"Royals","FullName"