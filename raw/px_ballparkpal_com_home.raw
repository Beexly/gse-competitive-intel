}
.dugout-title {
    font-size: 48px;
    font-weight: 800;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: 0.2px;
    white-space: nowrap;
    position: relative;
    z-index: 2;
}
.dugout-links {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    justify-content: center;
    position: relative;
    z-index: 2;
}
.dugout-link {
    font-size: 18px;
    font-weight: 600;
    color: #ffffff;
    text-decoration: none;
    position: relative;
    z-index: 3;
}
.dugout-link:hover {
    text-decoration: underline;
}
.dugout-bar a,
.dugout-bar a:visited,
.dugout-bar a:link {
    color: #ffffff !important;
}
.dugout-logo {
    position: relative;
    z-index: 2;
}
@media (max-width: 600px) {
    .daily-fantasy-bar {
        flex-wrap: wrap;
        padding: 12px 16px;
        gap: 12px;
    }
    .daily-fantasy-title-group {
        width: 100%;
        justify-content: center;
        padding-left: 0;
    }
    .daily-fantasy-title {
        font-size: 26px;
    }
    .daily-fantasy-separator {
        display: none;
    }
    .daily-fantasy-link {
        font-size: 18px;
    }
    .dugout-bar {
        flex-wrap: wrap;
        justify-content: center;
        padding: 6px 14px;
        gap: 10px;
    }
    .dugout-center {
        flex-wrap: wrap;
        gap: 24px;
    }
    .dugout-title {
        font-size: 36px;
    }
    .dugout-link {
        font-size: 16px;
    }
    .dugout-logo {
        width: 52px;
        height: 52px;
    }
}
.odds-section {
    display: flex;
    gap: 18px;
    justify-content: center;
    align-items: stretch;
    max-width: 865px;
    margin: 10px auto 20px auto;
    padding: 0 10px;
}
.odds-sidebar {
    width: 180px;
    background: #e9f2fb;
    border: 1px solid #cfd9e6;
    border-radius: 10px;
    padding: 0 14px;
    text-align: left;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
}
.odds-sidebar a {
    display: block;
    font-size: 20px;
    font-weight: 600;
    color: #111827;
    text-decoration: none;
    margin: 0;
}
.odds-sidebar a:hover {
    text-decoration: underline;
}
.odds-main {
    flex: 1 1 0;
    min-width: 300px;
    margin-bottom: 0;
    padding-bottom: 0;
}
.odds-header {
    text-align: center;
    margin-bottom: 8px;
}
.odds-buttons {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 0;
    padding-bottom: 0;
}
.odds-row {
    display: grid;
    gap: 10px;
}
.odds-row-top {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}
.odds-row-bottom {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-bottom: 0;
}
.odds-button {
    width: 100%;
    font-size: 30px;
    line-height: 1.05;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #5f91c7;
    text-align: center;
    padding: 12px 10px;
    margin-bottom: 0;
}
.odds-buttons a {
    margin-bottom: 0;
}
.odds-button span {
    display: inline-block;
}
@media (max-width: 768px) {
    .odds-section {
        flex-direction: column;
        align-items: center;
    }
    .odds-sidebar {
        width: 100%;
        max-width: 280px;
        text-align: center;
    }
    .odds-row,
    .odds-row-top,
    .odds-row-bottom {
        grid-template-columns: 1fr;
    }
}
.research-tools-section {
    max-width: 865px;
    margin: 10px auto 20px auto;
    padding: 0 10px;
}
.research-tools-header {
    text-align: center;
    margin-bottom: 8px;
}
.research-tools-buttons {
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.research-tools-row {
    display: grid;
    gap: 10px;
}
.research-tools-row-top {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}
.research-tools-row-bottom {
    grid-template-columns: repeat(4, minmax(0, 1fr));
}
.research-tools-button {
    width: 100%;
    font-size: 30px;
    line-height: 1.05;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 12px 10px;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    cursor: pointer;
}
.research-tools-button.purple {
    background-color: #a579ad;
}
.research-tools-button.black {
    background-color: #43474d;
}
.research-tools-button.green {
    background-color: #80ad80;
}
.research-tools-button.gold {
    background-color: #dba444;
}
.research-tools-button.magenta {
    background-color: #53548a;
}
.research-tools-button.teal {
    background-color: #64b5b1;
}
.research-tools-button.red {
    background-color: #c27e84;
}
.research-tools-button.bluegray {
    background-color: #5B6C8F;
}
.research-tools-buttons a {
    text-decoration: none;
}
@media (max-width: 768px) {
    .research-tools-row-top,
    .research-tools-row-bottom {
        grid-template-columns: 1fr;
    }
}
</style>


