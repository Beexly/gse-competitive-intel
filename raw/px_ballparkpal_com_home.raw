7":{"TeamId":137,"TeamAbv2":"SF","TeamCity":"San Francisco","TeamNickname":"Giants","FullName":"San Francisco Giants","TeamColorBackground":"#FD5A1E","TeamColorText":"#27251F"},"136":{"TeamId":136,"TeamAbv2":"SEA","TeamCity":"Seattle","TeamNickname":"Mariners","FullName":"Seattle Mariners","TeamColorBackground":"#005C5C","TeamColorText":"#FFFFFF"},"138":{"TeamId":138,"TeamAbv2":"STL","TeamCity":"St. Louis","TeamNickname":"Cardinals","FullName":"St. Louis Cardinals","TeamColorBackground":"#C41E3A","TeamColorText":"#FFFFFF"},"139":{"TeamId":139,"TeamAbv2":"TB","TeamCity":"Tampa Bay","TeamNickname":"Rays","FullName":"Tampa Bay Rays","TeamColorBackground":"#8FBCE6","TeamColorText":"#FFFFFF"},"140":{"TeamId":140,"TeamAbv2":"TEX","TeamCity":"Texas","TeamNickname":"Rangers","FullName":"Texas Rangers","TeamColorBackground":"#003278","TeamColorText":"#FFFFFF"},"141":{"TeamId":141,"TeamAbv2":"TOR","TeamCity":"Toronto","TeamNickname":"Blue Jays","FullName":"Toronto Blue Jays","TeamColorBackground":"#134A8E","TeamColorText":"#FFFFFF"},"120":{"TeamId":120,"TeamAbv2":"WAS","TeamCity":"Washington","TeamNickname":"Nationals","FullName":"Washington Nationals","TeamColorBackground":"#AB0003","TeamColorText":"#FFFFFF"}};
    const batterState = {
        type: 'batter',
        teamId: 115,
        playerId: 696100,
        playersByTeam: battersByTeam,
        teamDd: document.getElementById('batterTeamDd'),
        playerDd: document.getElementById('batterPlayerDd'),
        teamMenu: document.getElementById('batterTeamMenu'),
        playerMenu: document.getElementById('batterPlayerMenu'),
        teamLabel: document.getElementById('batterTeamLabel'),
        playerLabel: document.getElementById('batterPlayerLabel'),
        barEl: document.getElementById('batterSelectHalf'),
        bioHeadshot: document.getElementById('batterBioHeadshot'),
        bioLinks: document.getElementById('batterBioLinks')
    };
    
    const pitcherState = {
        type: 'pitcher',
        teamId: 147,
        playerId: 693645,
        playersByTeam: pitchersByTeam,
        teamDd: document.getElementById('pitcherTeamDd'),
        playerDd: document.getElementById('pitcherPlayerDd'),
        teamMenu: document.getElementById('pitcherTeamMenu'),
        playerMenu: document.getElementById('pitcherPlayerMenu'),
        teamLabel: document.getElementById('pitcherTeamLabel'),
        playerLabel: document.getElementById('pitcherPlayerLabel'),
        barEl: document.getElementById('pitcherSelectHalf'),
        bioHeadshot: document.getElementById('pitcherBioHeadshot'),
        bioLinks: document.getElementById('pitcherBioLinks')
    };
    
    const vsLink = document.getElementById('vsMatchupLink');

    function shortenPlayerDisplayName(fullName) {
        const s = String(fullName || '').trim();
        if ([...s].length <= 11) return s;
        const i = s.search(/\s/);
        if (i <= 0) return s;
        const firstWord = s.slice(0, i).trim();
        const rest = s.slice(i + 1).trim();
        if (!rest) return s;
        const initial = [...firstWord][0] || '';
        return initial + '. ' + rest;
    }
    
    const requiredEls = [
        batterState.teamDd, batterState.playerDd, batterState.teamMenu, batterState.playerMenu,
        batterState.teamLabel, batterState.playerLabel, batterState.barEl, batterState.bioHeadshot, batterState.bioLinks,
        pitcherState.teamDd, pitcherState.playerDd, pitcherState.teamMenu, pitcherState.playerMenu,
        pitcherState.teamLabel, pitcherState.playerLabel, pitcherState.barEl, pitcherState.bioHeadshot, pitcherState.bioLinks,
        vsLink
    ];
    
    if (requiredEls.some(el => !el)) {
        console.error('Player selection module: required elements not found.');
        return;
    }

    // Menu helper functions
    function openMenu(menu, anchor) {
        if (menu.parentElement !== document.body) {
            document.body.appendChild(menu);
        }
        const r = anchor.getBoundingClientRect();
        const gutter = 6;
        const maxRight = window.innerWidth - 8;
        menu.hidden = false;
        const width = menu.offsetWidth || 260;
        const left = Math.min(r.left, maxRight - width);
        menu.style.left = `${Math.max(8, left)}px`;
        menu.style.top = `${Math.max(8, r.bottom + gutter)}px`;
        
        const rectContains = (el, x, y) => {
            const rr = el.getBoundingClientRect();
            return x >= rr.left && x <= rr.right && y >= rr.top && y <= rr.bottom;
        };
        
        const close = () => {
            menu.hidden = true;
            document.removeEventListener('pointerdown', onPointerDown, true);
            document.removeEventListener('keydown', onEsc, true);
            window.removeEventListener('resize', onResize, true);
        };
        
        const onPointerDown = e => {
            if (rectContains(menu, e.clientX, e.clientY)) return;
            if (rectContains(anchor, e.clientX, e.clientY)) return;
            close();
        };
        const onEsc = e => { if (e.key === 'Escape') close(); };
        const onResize = () => close();
        
        document.addEventListener('pointerdown', onPointerDown, true);
        document.addEventListener('keydown', onEsc, true);
        window.addEventListener('resize', onResize, true);
    }
    
    function createMenuButton(label, attrs = {}) {
        const b = document.createElement('button');
        b.textContent = label;
        Object.entries(attrs).forEach(([k, v]) => b.setAttribute(k, v));
        return b;
    }
    
    // Build team menu
    function buildTeamMenu(state) {
        state.teamMenu.innerHTML = '';
        const hdr = document.createElement('div');
        hdr.className = 'hd';
        hdr.textContent = 'Teams';
        state.teamMenu.appendChild(hdr);
        
        const sortedTeams = Object.values(allTeams).sort((a, b) => a.FullName.localeCompare(b.FullName));
        sortedTeams.forEach(team => {
            const b = createMenuButton(team.FullName, {
                'data-teamid': team.TeamId,
                'aria-current': team.TeamId === state.teamId ? 'true' : 'false'
            });
            b.addEventListener('click', () => {
                state.teamId = team.TeamId;
                state.teamLabel.textContent = team.TeamNickname || team.FullName;
                applyTeamColors(state);
                state.teamMenu.hidden = true;
                
                // Update player list and select first player
                const players = state.playersByTeam[state.teamId];
                if (players && players.length > 0) {
                    players.sort((a, b) => a.PlayerName.localeCompare(b.PlayerName));
                    state.playerId = players[0].PlayerId;
                    state.playerLabel.textContent = shortenPlayerDisplayName(players[0].PlayerName);
                    updateHeadshot(state, state.playerId);
                    updateBioLinks(state, state.playerId);
                    updateVsLink();
                }
                
                // Open player menu
                setTimeout(() => {
                    buildPlayerMenu(state);
                    openMenu(state.playerMenu, state.playerDd);
                }, 80);
            });
            state.teamMenu.appendChild(b);
        });
    }
    
    // Build player menu
    function buildPlayerMenu(state) {
        state.playerMenu.innerHTML = '';
        const players = state.playersByTeam[state.teamId];
        
        const hdr = document.createElement('div');
        hdr.className = 'hd';
        hdr.textContent = (state.type === 'batter' ? 'Batters' : 'Pitchers');
        state.playerMenu.appendChild(hdr);
        
        if (players && players.length > 0) {
            const sortedPlayers = [...players].sort((a, b) => a.PlayerName.localeCompare(b.PlayerName));
            sortedPlayers.forEach(p => {
                const b = createMenuButton(p.PlayerName, {
                    'data-playerid': p.PlayerId,
                    'aria-current': p.PlayerId === state.playerId ? 'true' : 'false'
                });
                b.addEventListener('click', () => {
                    state.playerId = p.PlayerId;
                    state.playerLabel.textContent = shortenPlayerDisplayName(p.PlayerName);
                    state.playerMenu.hidden = true;
                    updateHeadshot(state, state.playerId);
                    updateBioLinks(state, state.playerId);
                    updateVsLink();
                });
                state.playerMenu.appendChild(b);
            });
        }
    }
    
    function updateBioLinks(state, playerId) {
        if (state.type === 'batter') {
            state.bioLinks.innerHTML = `
                <a href="/Batter-Projections.php?PlayerId=${playerId}">Projections</a>
                <a href="/Batter-Odds.php?PlayerId=${playerId}">Odds</a>
                <a href="/Batter-Summary.php?PlayerId=${playerId}">Profile</a>
                <a href="/Batter-Over-Under.php?PlayerId=${playerId}">Over/Under</a>
                <a href="/Batter-Play-Log.php?PlayerId=${playerId}">Play Log</a>
                <a href="/Batter-Game-Log.php?PlayerId=${playerId}">Game Log</a>
                <a href="/Batter-Splits.php?PlayerId=${playerId}">Splits</a>
                <a href="/Batter-Matchups.php?PlayerId=${playerId}">Matchups</a>
                <a href="/Batter-Park-Factors.php?PlayerId=${playerId}">Parks</a>
                <a href="/Batter-Weekly-Metrics.php?PlayerId=${playerId}">Weekly</a>
            `;
        } else {
            state.bioLinks.innerHTML = `
                <a href="/Pitcher-Projections.php?PlayerId=${playerId}">Projections</a>
                <a href="/Pitcher-Odds.php?PlayerId=${playerId}">Odds</a>
                <a href="/Pitcher-Summary.php?PlayerId=${playerId}">Profile</a>
                <a href="/Pitcher-Over-Under.php?PlayerId=${playerId}">Over/Under</a>
                <a href="/Pitcher-Trends.php?PlayerId=${playerId}">Trends</a>
                <a href="/Pitcher-Play-Log.php?PlayerId=${playerId}">Play Log</a>
                <a href="/Pitcher-Game-Log.php?PlayerId=${playerId}">Game Log</a>
                <a href="/Pitcher-Matchups.php?PlayerId=${playerId}">Matchups</a>
                <a href="/Pitcher-Park-Factors.php?PlayerId=${playerId}">Parks</a>
                <a href="/Pitcher-Game-Stats.php?PlayerId=${playerId}">Game Metrics</a>
            `;
        }
    }
    
    function updateVsLink() {
        if (!vsLink) return;
        vsLink.href = `Matchup-Machine.php?BatterId=${batterState.playerId}&PitcherId=${pitcherState.playerId}`;
    }
    
    function updateHeadshot(state, playerId) {
        state.bioHeadshot.src = `https://img.mlbstatic.com/mlb-photos/image/upload/w_120,q_100/v1/people/${playerId}/headshot/silo/current`;
    }
    
    function applyTeamColors(state) {
        const team = allTeams[state.teamId];
        if (!team) return;
        const borderColor = team.TeamColorBackground || '#0f172a';
        if (state.barEl) {
            state.barEl.style.background = team.TeamColorBackground || '#0f172a';
            state.barEl.style.color = team.TeamColorText || '#ffffff';
        }
        if (state.type === 'batter') {
            const batterBox = document.getElementById('batterBioBox');
            if (batterBox) batterBox.style.borderColor = borderColor;
        } else {
            const pitcherBox = document.getElementById('pitcherBioBox');
            if (pitcherBox) pitcherBox.style.borderColor = borderColor;
        }
    }
    
    // Event listeners for dropdown buttons
    batterState.teamDd.addEventListener('click', () => {
        buildTeamMenu(batterState);
        openMenu(batterState.teamMenu, batterState.teamDd);
    });
    
    batterState.playerDd.addEventListener('click', () => {
        buildPlayerMenu(batterState);
        openMenu(batterState.playerMenu, batterState.playerDd);
    });
    
    pitcherState.teamDd.addEventListener('click', () => {
        buildTeamMenu(pitcherState);
        openMenu(pitcherState.teamMenu, pitcherState.teamDd);
    });
    
    pitcherState.playerDd.addEventListener('click', () => {
        buildPlayerMenu(pitcherState);
        openMenu(pitcherState.playerMenu, pitcherState.playerDd);
    });

    // ---------- Player search popover ----------
    function buildSearchIndex(playersByTeam) {
        const flat = [];
        const playerIdToTeamId = Object.create(null);
        Object.keys(playersByTeam).forEach(teamIdStr => {
            const teamId = parseInt(teamIdStr, 10);
            const team = allTeams[teamId];
            if (!team) return;
            const logo = team.TeamAbv2 ? `Images/${team.TeamAbv2}-logo.svg` : '';
            (playersByTeam[teamIdStr] || []).forEach(p => {
                flat.push({
                    playerId: p.PlayerId,
                    fullName: p.PlayerName,
                    teamId: teamId,
                    logo: logo
                });
                playerIdToTeamId[p.PlayerId] = teamId;
            });
        });
        flat.sort((a, b) => a.fullName.localeCompare(b.fullName));
        return { flat, playerIdToTeamId };
    }

    const batterSearchIndex = buildSearchIndex(battersByTeam);
    const pitcherSearchIndex = buildSearchIndex(pitchersByTeam);

    function selectPlayerFromSearch(state, p) {
        const team = allTeams[p.teamId];
        if (team) {
            state.teamId = team.TeamId;
            state.teamLabel.textContent = team.TeamNickname || team.FullName;
            applyTeamColors(state);
        }
        state.playerId = p.playerId;
        state.playerLabel.textContent = shortenPlayerDisplayName(p.fullName);
        updateHeadshot(state, state.playerId);
        updateBioLinks(state, state.playerId);
        updateVsLink();
    }

    function closeSearchPopover() {
        const pop = document.getElementById('searchPopover');
        const bd = document.getElementById('searchBackdrop');
        if (pop) { if (pop._cleanup) pop._cleanup(); pop.remove(); }
        if (bd) bd.remove();
    }

    function openPlayerSearch(state, searchBtn, allPlayers, kind) {
        closeSearchPopover();

        const backdrop = document.createElement('div');
        backdrop.className = 'search-backdrop';
        backdrop.id = 'searchBackdrop';
        document.body.appendChild(backdrop);

        const popover = document.createElement('div');
        popover.className = 'search-popover';
        popover.id = 'searchPopover';

        const inputWrap = document.createElement('div');
        inputWrap.className = 'search-input-wrap';
        inputWrap.innerHTML = '<svg class="search-input-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8.5" cy="8.5" r="5.5"/><line x1="12.5" y1="12.5" x2="17" y2="17"/></svg>';

        const input = document.createElement('input');
        input.type = 'text';
        input.className = 'search-input';
        input.placeholder = kind === 'batter' ? 'Search batters\u2026' : 'Search pitchers\u2026';
        input.setAttribute('autocomplete', 'off');
        input.setAttribute('autocorrect', 'off');
        input.setAttribute('spellcheck', 'false');
        inputWrap.appendChild(input);
        popover.appendChild(inputWrap);

        const resultsEl = document.createElement('div');
        resultsEl.className = 'search-results';
        popover.appendChild(resultsEl);

        document.body.appendChild(popover);

        const rect = searchBtn.getBoundingClientRect();
        if (window.innerWidth <= 800) {
            popover.style.left = '10px';
            popover.style.right = '10px';
            popover.style.top = Math.max(8, Math.min(rect.bottom + 6, window.innerHeight - 400)) + 'px';
        } else {
            const width = 340;
            const desiredLeft = rect.right - width;
            popover.style.left = Math.max(8, Math.min(desiredLeft, window.innerWidth - width - 8)) + 'px';
            popover.style.top = Math.max(8, rect.bottom + 6) + 'px';
        }

        input.focus();

        let activeIdx = -1;
        let filtered = [];

        function render(list) {
            resultsEl.innerHTML = '';
            activeIdx = -1;
            if (input.value.trim() === '') {
                const el = document.createElement('div');
                el.className = 'search-empty';
                el.textContent = 'Type a name to search\u2026';
                resultsEl.appendChild(el);
                return;
            }
            if (list.length === 0) {
                const el2 = document.createElement('div');
                el2.className = 'search-empty';
                el2.textContent = 'No players found';
                resultsEl.appendChild(el2);
                return;
            }
            list.slice(0, 80).forEach(p => {
                const btn = document.createElement('button');
                btn.className = 'search-result';
                if (p.logo) {
                    const img = document.createElement('img');
                    img.className = 'search-result-logo';
                    img.src = p.logo;
                    img.alt = '';
                    img.loading = 'lazy';
                    img.addEventListener('error', () => { img.style.visibility = 'hidden'; });
                    btn.appendChild(img);
                }
                const span = document.createElement('span');
                span.className = 'search-result-name';
                span.textContent = p.fullName;
                btn.appendChild(span);
                btn.addEventListener('click', () => pick(p));
                resultsEl.appendChild(btn);
            });
        }

        function pick(p) {
            selectPlayerFromSearch(state, p);
            closeSearchPopover();
        }

        function highlightActive() {
            const items = resultsEl.querySelectorAll('.search-result');
            items.forEach((el, i) => el.classList.toggle('search-result-active', i === activeIdx));
            if (activeIdx >= 0 && items[activeIdx]) items[activeIdx].scrollIntoView({ block: 'nearest' });
        }

        input.addEventListener('input', () => {
            const q = input.value.trim().toLowerCase();
            if (!q) { filtered = []; render(filtered); return; }
            filtered = allPlayers.filter(p => p.fullName.toLowerCase().indexOf(q) !== -1);
            render(filtered);
        });

        input.addEventListener('keydown', e => {
            const items = resultsEl.querySelectorAll('.search-result');
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                activeIdx = Math.min(activeIdx + 1, items.length - 1);
                highlightActive();
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                activeIdx = Math.max(activeIdx - 1, 0);
                highlightActive();
            } else if (e.key === 'Enter') {
                e.preventDefault();
                if (activeIdx >= 0 && activeIdx < filtered.length) pick(filtered[activeIdx]);
            }
        });

        const onDocKey = e => { if (e.key === 'Escape') closeSearchPopover(); };
        document.addEventListener('keydown', onDocKey);
        backdrop.addEventListener('click', closeSearchPopover);
        popover.addEventListener('click', e => e.stopPropagation());

        render([]);

        popover._cleanup = () => document.removeEventListener('keydown', onDocKey);
    }

    const batterSearchBtn = document.getElementById('batterSearchBtn');
    const pitcherSearchBtn = document.getElementById('pitcherSearchBtn');
    if (batterSearchBtn) {
        batterSearchBtn.addEventListener('click', e => {
            e.stopPropagation();
            openPlayerSearch(batterState, batterSearchBtn, batterSearchIndex.flat, 'batter');
        });
    }
    if (pitcherSearchBtn) {
        pitcherSearchBtn.addEventListener('click', e => {
            e.stopPropagation();
            openPlayerSearch(pitcherState, pitcherSearchBtn, pitcherSearchIndex.flat, 'pitcher');
        });
    }

    // Initialize menus
    buildTeamMenu(batterState);
    buildPlayerMenu(batterState);
    applyTeamColors(batterState);
    buildTeamMenu(pitcherState);
    buildPlayerMenu(pitcherState);
    applyTeamColors(pitcherState);
    updateVsLink();
})();
</script>

