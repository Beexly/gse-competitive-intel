2,0-1-.449-1-1s.448-1,1-1,1,.449,1,1-.448,1-1,1Z" class="fill-brand-green" stroke="none"></path></g></svg><span class="font-heading text-[14px] leading-[1.2] font-normal text-brand-green lg:text-[16px]">FAQ</span></div><h2 class="font-heading text-[34px] leading-none font-light tracking-[-1.7px] text-landing-text-primary lg:text-[42px] lg:tracking-[-2.1px]">Common Questions</h2></div><div class="mt-4 transition-all delay-150 duration-700 ease-out lg:mt-7 translate-y-5 opacity-0"><div data-slot="accordion" class="flex w-full flex-col" data-orientation="vertical"><div data-state="open" data-orientation="vertical" data-slot="accordion-item" class="not-last:border-b border-dashed border-divider-secondary last:border-b-0"><h3 data-orientation="vertical" data-state="open" class="flex"><button type="button" aria-controls="radix-_R_16eoltlb_" aria-expanded="true" data-state="open" data-orientation="vertical" id="radix-_R_6eoltlb_" data-slot="accordion-trigger" class="group/accordion-trigger relative flex flex-1 items-center justify-between gap-8 rounded-lg border border-transparent py-5 text-left font-heading text-lg font-normal transition-colors outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:after:border-ring disabled:pointer-events-none disabled:opacity-50 tracking-[-0.54px] text-foreground lg:text-[20px] lg:tracking-[-0.8px]" data-radix-collection-item="">Where do my tokens go when I stake?<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" class="size-4 shrink-0 transition-transform duration-300 group-data-[state=closed]/accordion-trigger:rotate-180"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.25 7.75 6 3.5 1.75 7.75" class="12-chevron-up_inline_svg__nc-icon-wrapper"></path></svg></button></h3><div data-state="open" id="radix-_R_16eoltlb_" role="region" aria-labelledby="radix-_R_6eoltlb_" data-orientation="vertical" data-slot="accordion-cont