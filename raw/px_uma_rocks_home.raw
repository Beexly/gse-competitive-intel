<!DOCTYPE html><html lang="en-GB"><head><meta charSet="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="preload" as="image" imageSrcSet="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fhero.fa7fb709.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fhero.fa7fb709.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fhero.fa7fb709.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fhero.fa7fb709.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fhero.fa7fb709.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fhero.fa7fb709.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fhero.fa7fb709.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fhero.fa7fb709.png&amp;w=3840&amp;q=75 3840w" imageSizes="(max-width: 800px) 100vw, 620px"/><link rel="stylesheet" href="/_next/static/css/b0c0f461861d0760.css" data-precedence="next"/><link rel="preload" as="script" fetchPriority="low" href="/_next/static/chunks/webpack-6ad340f11c2cb7a7.js"/><script src="/_next/static/chunks/fd9d1056-348c95cc3e60b215.js" async=""></script><script src="/_next/static/chunks/2117-a97f393b331c5295.js" async=""></script><script src="/_next/static/chunks/main-app-be3d940aef6bd3eb.js" async=""></script><script src="/_next/static/chunks/963a8f67-5c04d5adb278f179.js" async=""></script><script src="/_next/static/chunks/c16f53c3-902c0f2637b1710c.js" async=""></script><script src="/_next/static/chunks/2972-5fbecc94687ce867.js" async=""></script><script src="/_next/static/chunks/8476-89e81fef544b3ff7.js" async=""></script><script src="/_next/static/chunks/app/(main)/page-60655beac9d86aff.js" async=""></script><script src="/_next/static/chunks/app/(main)/layout-b805fcb4fa3eea6f.js" async=""></script><title>Passive income on Polymarket</title><meta name="description" content="Earn money by delegating your Polymarket voting power."/><meta name="application-name" content="UMA.rocks"/><meta name="generator" content="Next.js"/><meta name="keywords" content="polymarket, uma, crypto passive income, staking, oracle, crypto"/><meta name="robots" content="index, follow"/><link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="160x160"/><script src="/_next/static/chunks/polyfills-42372ed130431b0a.js" noModule=""></script></head><body><div class="max-w-screen-xl mx-auto px-5"><header class="flex flex-row justify-between items-center my-5"><div class="flex lg:w-auto items-center justify-between"><a class="text-lg" href="/"><span class="font-bold text-slate-800">🗳️ UMA</span><span class="text-slate-500">.rocks</span></a></div><a target="_blank" rel="noopener noreferrer" class="text-lg" href="https://dune.com/lancelot_c/umarocks">Dashboard</a></header></div><div><div class="max-w-screen-xl mx-auto px-5"><main class="grid lg:grid-cols-2 place-items-center pt-16 md:pt-12"><div class="py-6 md:order-1 hidden md:block"><img alt="Astronaut in the air" loading="eager" width="520" height="424" decoding="async" data-nimg="1" style="color:transparent" sizes="(max-width: 800px) 100vw, 620px" srcSet="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fhero.fa7fb709.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fhero.fa7fb709.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fhero.fa7fb709.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fhero.fa7fb709.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fhero.fa7fb709.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fhero.fa7fb709.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fhero.fa7fb709.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fhero.fa7fb709.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fhero.fa7fb709.png&amp;w=3840&amp;q=75"/></div><div><h1 class="text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter">Passive income on Polymarket</h1><p class="text-lg mt-4 text-slate-600 max-w-xl">Earn <b>0<!-- -->% APR</b> by delegating your Polymarket voting power.</p><div class="mt-6 flex flex-col sm:flex-row gap-3"><a class="" href="#get-started"><button type="button" class="rounded-md bg-gray-900 px-3.5 py-2.5 text-md font-semibold text-white hover:bg-gray-800">Get started</button></a><a rel="noopener" class="" target="_blank" href="https://discord.gg/nqxpBsv26A"><button type="button" class="rounded-md box-border border-2 border-gray-900 bg-white px-3.5 py-2 text-md font-semibold text-gray-900 hover:text-gray-800 hover:border-gray-800">Talk to us on Discord</button></a></div></div></main><div class="bg-white pt-8 md:pt-0 pb-0 sm:pb-24"><div class="mx-auto max-w-7xl px-6 lg:px-8"><h3 class="mt-5 text-center text-md/8 font-semibold text-gray-900 opacity-50">As seen in</h3><div class="mx-auto mt-5 grid max-w-lg grid-cols-4 items-center gap-x-8 gap-y-10 sm:max-w-xl sm:grid-cols-6 sm:gap-x-10 lg:mx-0 lg:max-w-none lg:grid-cols-5"><a class="col-span-2 lg:col-span-1 opacity-50 hover:opacity-100" href="https://www.wired.com/story/volodymyr-zelensky-suit-polymarket-rebellion/"><img alt="Wired" loading="lazy" width="960" height="193" decoding="async" data-nimg="1" class="max-h-7 w-full object-contain" style="color:transparent" srcSet="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2FWired_logo.49ea6d1f.png&amp;w=1080&amp;q=75 1x, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2FWired_logo.49ea6d1f.png&amp;w=1920&amp;q=75 2x" src="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2FWired_logo.49ea6d1f.png&amp;w=1920&amp;q=75"/></a><a class="col-span-2 lg:col-span-1 opacity-50 hover:opacity-100" href="https://www.wsj.com/finance/polymarket-bet-disputes-fb1b8c6a"><img alt="WallStreetJournal" loading="lazy" width="3840" height="326" decoding="async" data-nimg="1" class="max-h-9 w-full object-contain" style="color:transparent" srcSet="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2FWSJ_Logo.599fde41.png&amp;w=3840&amp;q=75 1x" src="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2FWSJ_Logo.599fde41.png&amp;w=3840&amp;q=75"/></a><a class="col-span-2 lg:col-span-1 opacity-50 hover:opacity-100" href="https://www.nytimes.com/2026/06/28/business/donk-polymarket-prediction-markets.html"><img alt="TheNewYorkTimes" loading="lazy" width="3840" height="649" decoding="async" data-nimg="1" class="max-h-8 w-full object-contain" style="color:transparent" srcSet="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2FThe_New_York_Times_Logo.ad15ac31.png&amp;w=3840&amp;q=75 1x" src="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2FThe_New_York_Times_Logo.ad15ac31.png&amp;w=3840&amp;q=75"/></a><a class="col-span-2 sm:col-start-2 lg:col-span-1 opacity-50 hover:opacity-100" href="https://www.bloomberg.com/news/articles/2026-05-26/crypto-whales-dominate-polymarket-disputes-worth-5-billion"><img alt="Bloomberg" loading="lazy" width="3840" height="717" decoding="async" data-nimg="1" class="max-h-7 w-full object-contain" style="color:transparent" srcSet="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2FBloomberg-Logo.a738edaf.png&amp;w=3840&amp;q=75 1x" src="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2FBloomberg-Logo.a738edaf.png&amp;w=3840&amp;q=75"/></a><a class="col-span-2 col-start-2 sm:col-start-auto lg:col-span-1 opacity-50 hover:opacity-100" href="https://www.economist.com/interactive/1843/2026/07/23/rules-based-disorder-why-prediction-markets-struggle-if-reality-is-contested"><img alt="TheEconomist" loading="lazy" width="930" height="291" decoding="async" data-nimg="1" class="max-h-9 w-full object-contain" style="color:transparent" srcSet="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fthe_economist_logo.1e3a67a3.png&amp;w=1080&amp;q=75 1x, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fthe_economist_logo.1e3a67a3.png&amp;w=1920&amp;q=75 2x" src="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fthe_economist_logo.1e3a67a3.png&amp;w=1920&amp;q=75"/></a></div></div></div><div class="pb-20"><div class="mt-16 md:mt-0"><h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">Put your UMA tokens on autopilot</h2><p class="text-lg mt-4 text-slate-600">Our UMA pool is currently managing <b>0<!-- --> UMA ($<!-- -->0<!-- -->)</b> from <a target="_blank" rel="noopener noreferrer" class="underline" href="https://dune.com/lancelot_c/umarocks"><b>0<!-- --> delegators</b></a>.</p></div><div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16"><div class="flex gap-4 items-start"><div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-slot="icon" class="text-white"><path fill-rule="evenodd" d="M2.25 6a3 3 0 0 1 3-3h13.5a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H5.25a3 3 0 0 1-3-3V6Zm3.97.97a.75.75 0 0 1 1.06 0l2.25 2.25a.75.75 0 0 1 0 1.06l-2.25 2.25a.75.75 0 0 1-1.06-1.06l1.72-1.72-1.72-1.72a.75.75 0 0 1 0-1.06Zm4.28 4.28a.75.75 0 0 0 0 1.5h3a.75.75 0 0 0 0-1.5h-3Z" clip-rule="evenodd"></path></svg></div><div><h3 class="font-semibold text-lg">Automated voting</h3> <p class="text-slate-500 mt-2 leading-relaxed">Delegate your UMA tokens to our pool, we vote everyday on your behalf on the <a href="https://uma.xyz/" target="_blank" rel="noopener noreferrer" class="underline">UMA oracle</a>, you get the staking rewards.</p></div></div><div class="flex gap-4 items-start"><div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-slot="icon" class="text-white"><path fill-rule="evenodd" d="M15.75 1.5a6.75 6.75 0 0 0-6.651 7.906c.067.39-.032.717-.221.906l-6.5 6.499a3 3 0 0 0-.878 2.121v2.818c0 .414.336.75.75.75H6a.75.75 0 0 0 .75-.75v-1.5h1.5A.75.75 0 0 0 9 19.5V18h1.5a.75.75 0 0 0 .53-.22l2.658-2.658c.19-.189.517-.288.906-.22A6.75 6.75 0 1 0 15.75 1.5Zm0 3a.75.75 0 0 0 0 1.5A2.25 2.25 0 0 1 18 8.25a.75.75 0 0 0 1.5 0 3.75 3.75 0 0 0-3.75-3.75Z" clip-rule="evenodd"></path></svg></div><div><h3 class="font-semibold text-lg">Non-custodial</h3> <p class="text-slate-500 mt-2 leading-relaxed">We use UMA's <a href="https://docs.uma.xyz/protocol-overview/dvm-2.0#vote-delegation" target="_blank" rel="noopener noreferrer" class="underline">vote delegation</a> to guarantee that only YOU can unstake your UMA and claim your rewards.</p></div></div><div class="flex gap-4 items-start"><div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-slot="icon" class="text-white"><path fill-rule="evenodd" d="M11.47 2.47a.75.75 0 0 1 1.06 0l4.5 4.5a.75.75 0 0 1-1.06 1.06l-3.22-3.22V16.5a.75.75 0 0 1-1.5 0V4.81L8.03 8.03a.75.75 0 0 1-1.06-1.06l4.5-4.5ZM3 15.75a.75.75 0 0 1 .75.75v2.25a1.5 1.5 0 0 0 1.5 1.5h13.5a1.5 1.5 0 0 0 1.5-1.5V16.5a.75.75 0 0 1 1.5 0v2.25a3 3 0 0 1-3 3H5.25a3 3 0 0 1-3-3V16.5a.75.75 0 0 1 .75-.75Z" clip-rule="evenodd"></path></svg></div><div><h3 class="font-semibold text-lg">Permissionless exit</h3> <p class="text-slate-500 mt-2 leading-relaxed">You can exit at anytime from your <a href="https://vote.uma.xyz/wallet-settings" target="_blank" rel="noopener noreferrer" class="underline">wallet settings</a> or by directly calling the UMA smart contract.</p></div></div><div class="flex gap-4 items-start"><div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-slot="icon" class="text-white"><path fill-rule="evenodd" d="M12.516 2.17a.75.75 0 0 0-1.032 0 11.209 11.209 0 0 1-7.877 3.08.75.75 0 0 0-.722.515A12.74 12.74 0 0 0 2.25 9.75c0 5.942 4.064 10.933 9.563 12.348a.749.749 0 0 0 .374 0c5.499-1.415 9.563-6.406 9.563-12.348 0-1.39-.223-2.73-.635-3.985a.75.75 0 0 0-.722-.516l-.143.001c-2.996 0-5.717-1.17-7.734-3.08Zm3.094 8.016a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd"></path></svg></div><div><h3 class="font-semibold text-lg">No smart contract risk</h3> <p class="text-slate-500 mt-2 leading-relaxed">Hackers cannot hack our smart contracts because we don't have any, we rely entirely on UMA smart contracts.</p></div></div><div class="flex gap-4 items-start"><div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-slot="icon" class="text-white"><path fill-rule="evenodd" d="M8.25 6.75a3.75 3.75 0 1 1 7.5 0 3.75 3.75 0 0 1-7.5 0ZM15.75 9.75a3 3 0 1 1 6 0 3 3 0 0 1-6 0ZM2.25 9.75a3 3 0 1 1 6 0 3 3 0 0 1-6 0ZM6.31 15.117A6.745 6.745 0 0 1 12 12a6.745 6.745 0 0 1 6.709 7.498.75.75 0 0 1-.372.568A12.696 12.696 0 0 1 12 21.75c-2.305 0-4.47-.612-6.337-1.684a.75.75 0 0 1-.372-.568 6.787 6.787 0 0 1 1.019-4.38Z" clip-rule="evenodd"></path><path d="M5.082 14.254a8.287 8.287 0 0 0-1.308 5.135 9.687 9.687 0 0 1-1.764-.44l-.115-.04a.563.563 0 0 1-.373-.487l-.01-.121a3.75 3.75 0 0 1 3.57-4.047ZM20.226 19.389a8.287 8.287 0 0 0-1.308-5.135 3.75 3.75 0 0 1 3.57 4.047l-.01.121a.563.563 0 0 1-.373.486l-.115.04c-.567.2-1.156.349-1.764.441Z"></path></svg></div><div><h3 class="font-semibold text-lg">Credibly neutral</h3> <p class="text-slate-500 mt-2 leading-relaxed">Anyone can create a <a href="https://github.com/UMA-rocks/voting-committees#umarocks-voting-committees" target="_blank" rel="noopener noreferrer" class="underline">voting committee</a> on UMA.rocks to make sure our pool stays decentralized.</p></div></div><div class="flex gap-4 items-start"><div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-slot="icon" class="text-white"><path fill-rule="evenodd" d="M4.755 10.059a7.5 7.5 0 0 1 12.548-3.364l1.903 1.903h-3.183a.75.75 0 1 0 0 1.5h4.992a.75.75 0 0 0 .75-.75V4.356a.75.75 0 0 0-1.5 0v3.18l-1.9-1.9A9 9 0 0 0 3.306 9.67a.75.75 0 1 0 1.45.388Zm15.408 3.352a.75.75 0 0 0-.919.53 7.5 7.5 0 0 1-12.548 3.364l-1.902-1.903h3.183a.75.75 0 0 0 0-1.5H2.984a.75.75 0 0 0-.75.75v4.992a.75.75 0 0 0 1.5 0v-3.18l1.9 1.9a9 9 0 0 0 15.059-4.035.75.75 0 0 0-.53-.918Z" clip-rule="evenodd"></path></svg></div><div><h3 class="font-semibold text-lg">Restaking</h3> <p class="text-slate-500 mt-2 leading-relaxed">We automatically restake your rewards every month in order to maximize your APR.</p></div></div><div class="flex gap-4 items-start"><div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-slot="icon" class="text-white"><path fill-rule="evenodd" d="M14.615 1.595a.75.75 0 0 1 .359.852L12.982 9.75h7.268a.75.75 0 0 1 .548 1.262l-10.5 11.25a.75.75 0 0 1-1.272-.71l1.992-7.302H3.75a.75.75 0 0 1-.548-1.262l10.5-11.25a.75.75 0 0 1 .913-.143Z" clip-rule="evenodd"></path></svg></div><div><h3 class="font-semibold text-lg">99% correct votes</h3> <p class="text-slate-500 mt-2 leading-relaxed">Voting on the UMA oracle every day of the year requires a lot of time and expertise. Let us do the hard work while you sleep.</p></div></div><div class="flex gap-4 items-start"><div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-slot="icon" class="text-white"><path fill-rule="evenodd" d="M9.315 7.584C12.195 3.883 16.695 1.5 21.75 1.5a.75.75 0 0 1 .75.75c0 5.056-2.383 9.555-6.084 12.436A6.75 6.75 0 0 1 9.75 22.5a.75.75 0 0 1-.75-.75v-4.131A15.838 15.838 0 0 1 6.382 15H2.25a.75.75 0 0 1-.75-.75 6.75 6.75 0 0 1 7.815-6.666ZM15 6.75a2.25 2.25 0 1 0 0 4.5 2.25 2.25 0 0 0 0-4.5Z" clip-rule="evenodd"></path><path d="M5.26 17.242a.75.75 0 1 0-.897-1.203 5.243 5.243 0 0 0-2.05 5.022.75.75 0 0 0 .625.627 5.243 5.243 0 0 0 5.022-2.051.75.75 0 1 0-1.202-.897 3.744 3.744 0 0 1-3.008 1.51c0-1.23.592-2.323 1.51-3.008Z"></path></svg></div><div><h3 class="font-semibold text-lg">Whale power</h3> <p class="text-slate-500 mt-2 leading-relaxed">UMA tokenomics favors the biggest holders, which mean you have more chance of winning disputes by joining a pool than by voting on your own.</p></div></div><div class="flex gap-4 items-start"><div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-slot="icon" class="text-white"><path d="M10.5 1.875a1.125 1.125 0 0 1 2.25 0v8.219c.517.162 1.02.382 1.5.659V3.375a1.125 1.125 0 0 1 2.25 0v10.937a4.505 4.505 0 0 0-3.25 2.373 8.963 8.963 0 0 1 4-.935A.75.75 0 0 0 18 15v-2.266a3.368 3.368 0 0 1 .988-2.37 1.125 1.125 0 0 1 1.591 1.59 1.118 1.118 0 0 0-.329.79v3.006h-.005a6 6 0 0 1-1.752 4.007l-1.736 1.736a6 6 0 0 1-4.242 1.757H10.5a7.5 7.5 0 0 1-7.5-7.5V6.375a1.125 1.125 0 0 1 2.25 0v5.519c.46-.452.965-.832 1.5-1.141V3.375a1.125 1.125 0 0 1 2.25 0v6.526c.495-.1.997-.151 1.5-.151V1.875Z"></path></svg></div><div><h3 class="font-semibold text-lg">Stay in control</h3> <p class="text-slate-500 mt-2 leading-relaxed">You can opt-out of automated voting for a specific dispute by voting on your own and we won't overwrite your vote.</p></div></div></div></div><div id="get-started" class="py-0 md:pt-20"><div class="mt-16 md:mt-0"><h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">Get started</h2></div><div class="rounded-md border border-gray-300 p-16 mt-8 text-center"><div></div><button type="button" class="rounded-full px-4 py-2.5 text-sm font-semibold shadow-xs bg-indigo-600 text-white hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Connect wallet</button></div><span hidden="" style="position:fixed;top:1px;left:1px;width:1px;height:0;padding:0;margin:-1px;overflow:hidden;clip:rect(0, 0, 0, 0);white-space:nowrap;border-width:0;display:none"></span><span hidden="" style="position:fixed;top:1px;left:1px;width:1px;height:0;padding:0;margin:-1px;overflow:hidden;clip:rect(0, 0, 0, 0);white-space:nowrap;border-width:0;display:none"></span></div></div><div id="faq" class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:px-8 lg:py-20"><div class="mx-auto max-w-4xl divide-y divide-gray-900/10"><h2 class="text-2xl font-bold leading-10 tracking-tight text-gray-900">Frequently asked questions</h2><dl class="mt-10 space-y-6 divide-y divide-gray-900/10"><div class="pt-6" data-headlessui-state=""><dt><button class="group flex w-full items-start justify-between text-left text-gray-900" id="headlessui-disclosure-button-:R16kukva:" type="button" aria-expanded="false" data-headlessui-state=""><span class="text-base font-semibold leading-7">What is UMA?</span><span class="ml-6 flex h-7 items-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-6 w-6 group-data-[open]:hidden"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path></svg><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="h-6 w-6 [.group:not([data-open])_&amp;]:hidden"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14"></path></svg></span></button></dt></div><div class="pt-6" data-headlessui-state=""><dt><button class="group flex w-full items-start justify-between text-left text-gray-900" id="headlessui-disclosure-button-:R1akukva:" type="button" aria-expanded="false" data-headlessui-state=""><span class="text-base font-semibold leading-7">What is UMA.rocks?</span><span class="ml-6 flex h-7 items-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" clas