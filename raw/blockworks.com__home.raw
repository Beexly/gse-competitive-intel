;bottom:max(env(safe-area-inset-bottom, 0px), 1rem);inset-inline-end:calc(env(safe-area-inset-right, 0px) + 1rem)" class="css-1l30axn"></div><!--$--><!--/$--></div></div><script id="__NEXT_DATA__" type="application/json">{"props":{"pageProps":{"meta":{"title":"Blockworks","description":"Blockworks is a data and software platform for crypto markets. It offers investor relations software, a data API, and a market research platform to its users that span across crypto-native startups and traditional institutions. The company’s focus on consistent data models and repeatable analytical frameworks enables it to be the operating system for onchain businesses.","og_description":"Blockworks | Connecting investors and businesses in onchain capital markets.","og_image":[{"url":"https://blockworks.com/images/share-image.jpg"}]},"visualizationSections":[{"title":"Crypto ETFs","subTitle":"Onchain metrics, activity and charts for Crypto ETFs.","relatedDashboardLink":"/analytics/crypto-etfs","visualizations":[{"id":2651,"width":"FULL"}]},{"title":"Treasury Companies","subTitle":"Track trading volume, net asset value (NAV), and key risk measures for crypto treasury companies.","relatedDashboardLink":"/analytics/treasury-companies","visualizations":[{"id":2928,"width":"HALF"},{"id":2930,"width":"HALF"}]},{"title":"Revenue Leaderboard","subTitle":"Track on-chain revenue from leading crypto apps.","relatedDashboardLink":"/analytics/revenue-leaderboard","visualizations":[{"id":5066,"width":"HALF"},{"id":5073,"width":"HALF"}]}],"initialTopGainersData":{"data":[{"id":397979,"code":"VVV","title":"Venice Token","slug":"venice-token","description":null,"image_url":"https://blockworks-assets.imgix.net/54023/large/VVV_Token_Transparent.png?1741856877","price_usd":24.08,"market_cap":{"rank":77,"usd":1151620406,"dominance":0.00399442,"percent_change_btc_1h":8.9,"percent_change_btc_24h":28.8789,"percent_change_usd_1h":8.9,"percent_change_usd_24h":27.7772,"percent_change_usd_7d":54.1,"percent_change_usd_30d":109.3,"percent_change_usd_ytd":1381.11,"percent_change_eth_1h":8.9,"percent_change_eth_24h":28.13,"updated_at":1788900501},"project":{"id":8471,"title":"Venice Token","slug":"venice-token","image_url":"https://blockworks-assets.imgix.net/54023/large/VVV_Token_Transparent.png?1741856877"}},{"id":398537,"code":"USELESS","title":"Useless Coin","slug":"useless-3","description":null,"image_url":"https://blockworks-assets.imgix.net/55684/large/coingeckoupdate.png?1755203747","price_usd":0.276209,"market_cap":{"rank":172,"usd":276632535,"dominance":0.000959505,"percent_change_btc_1h":1.5,"percent_change_btc_24h":23.8837,"percent_change_usd_1h":1.5,"percent_change_usd_24h":22.8247,"percent_change_usd_7d":137.4,"percent_change_usd_30d":632.2,"percent_change_usd_ytd":266.342,"percent_change_eth_1h":1.5,"percent_change_eth_24h":23.1638,"updated_at":1788900501},"project":{"id":9025,"title":"Useless Coin","slug":"useless-coin","image_url":"https://blockworks-assets.imgix.net/55684/large/coingeckoupdate.png?1755203747"}},{"id":27,"code":"DOT","title":"Polkadot","slug":"polkadot","description":"Polkadot is a blockchain network designed to support various interconnected, application-specific sub-chains called parachains (short for parallelized chains). Each chain built within Polkadot uses Parity Technologies' Substrate modular framework, which allows developers to select specific components that suit their application-specific chain best. Polkadot refers to the entire ecosystem of parachains that plug into a single base platform known as the Relay Chain. This base platform, which also leverages Substrate, does not support application functionality but instead provides security to the network's parachains and contains Polkadot's consensus, finality, and voting logic.","image_url":"https://blockworks-assets.imgix.net/12171/large/polkadot.png?1696512008","price_usd":1.24,"sector":"Smart Contract Platforms","market_cap":{"rank":54,"usd":2115964926,"dominance":0.00733926,"percent_change_btc_1h":2.1,"percent_change_btc_24h":18.0987,"percent_change_usd_1h":2.1,"percent_change_usd_24h":17.0893,"percent_change_usd_7d":42.7,"percent_change_usd_30d":53.3,"percent_change_usd_ytd":-38.4603,"percent_change_eth_1h":2.1,"percent_change_eth_24h":17.4125,"updated_at":1788900501},"project":{"id":1128,"title":"Polkadot","slug":"polkadot","image_url":"https://blockworks-assets.imgix.net/12171/large/polkadot.png?1696512008"}},{"id":400648,"code":"PONS","title":"Pons","slug":"pons","description":"","image_url":"https://assets.coingecko.com/coins/images/102174571/standard/jhitvkisdq8fhxvimdkpcw7y3dx5.?1784093932","price_usd":0.82698,"market_cap":{"rank":116,"usd":588958932,"dominance":0.00204282,"percent_change_btc_1h":1.5,"percent_change_btc_24h":17.3141,"percent_change_usd_1h":1.5,"percent_change_usd_24h":16.3113,"percent_change_usd_7d":116.3,"percent_change_usd_30d":2371.6,"percent_change_usd_ytd":7189.4,"percent_change_eth_1h":1.5,"percent_change_eth_24h":16.6324,"updated_at":1788900501},"project":{"id":17819,"title":"Pons","slug":"pons","image_url":"https://s1.coincarp.com/logo/1/pons.png?style=200\u0026v=1784099327"}},{"id":44,"code":"VET","title":"VeChain","slug":"vechain","description":"VeChain is a smart contract platform focused on providing supply chain management solutions for enterprises and integrating with Internet of Things (IoT) devices to facilitate the process. Its goal is to leverage distributed ledger technology to streamline these operations and information flow for complicated supply chains. VeChain Token (VET) and VeChainThor Energy (VTHO) are the two tokens on the Vechain network. The former is used to relay value across VeChain's network, while the latter is utilized to power smart contract transactions as energy or \"gas.\" The VeChain platform claims to give authorized stakeholders with a total view of critical information related to a product and its business processes (i.e storage, transit, supply and authenticity) as well 