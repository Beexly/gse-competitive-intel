proof-of-stake (PoW/PoS) cryptocurrency with a strong focus on community input, open governance, and sustainable funding for development. It utilizes its hybrid consensus and on-chain governance systems to ensure that a small group cannot dominate the flow of transactions or make changes to Decred without the input of the community. The project funds its own development from a decentralized treasury. ","image_url":"https://blockworks-assets.imgix.net/329/large/decred.png?1696501665","price_usd":17.24,"sector":"Currencies","market_cap":{"rank":163,"usd":303259692,"dominance":0.00105186,"percent_change_btc_1h":0.8,"percent_change_btc_24h":9.964,"percent_change_usd_1h":0.8,"percent_change_usd_24h":9.02405,"percent_change_usd_7d":19.7,"percent_change_usd_30d":33.3,"percent_change_usd_ytd":-0.493417,"percent_change_eth_1h":0.8,"percent_change_eth_24h":9.32504,"updated_at":1788900501},"project":{"id":1188,"title":"Decred","slug":"decred","image_url":"https://blockworks-assets.imgix.net/329/large/decred.png?1696501665"}}],"total":155,"page":1},"initialTopLosersData":{"data":[{"id":399103,"code":"AKE","title":"Akedo","slug":"akedo","description":null,"image_url":"https://blockworks-assets.imgix.net/68410/large/akedo.png?1755678461","price_usd":0.01561665,"market_cap":{"rank":146,"usd":356022308,"dominance":0.00123487,"percent_change_btc_1h":0,"percent_change_btc_24h":-17.3315,"percent_change_usd_1h":0,"percent_change_usd_24h":-18.0381,"percent_change_usd_7d":83.7,"percent_change_usd_30d":281.8,"percent_change_usd_ytd":3612.66,"percent_change_eth_1h":0,"percent_change_eth_24h":-17.8118,"updated_at":1788900501},"project":{"id":9562,"title":"Akedo","slug":"akedo","image_url":"https://blockworks-assets.imgix.net/68410/large/akedo.png?1755678461"}},{"id":398338,"code":"TIBBIR","title":"Ribbita by Virtuals","slug":"ribbita-by-virtuals","description":null,"image_url":"https://blockworks-assets.imgix.net/54970/large/Untitled_design.png?1742941268","price_usd":0.206427,"market_cap":