</svg></div><div class="text-style-tagline">LinkedIn</div></a></div></div></div></div></div></div><div class="footer_asset-wrap"><img src="https://cdn.prod.website-files.com/68629e56973c805c224da3d7/68653acbeba7536557615b80_footer-asset.svg" loading="lazy" alt="" class="footer-asset-svg"/></div><div class="w-embed w-script"><script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
console.log("Script loaded");
document.addEventListener("DOMContentLoaded", function () {
  const formBlocks = document.querySelectorAll('[fs-recaptcha-element="form-block"]');

  // ⬇️ REPLACE THIS WITH YOUR PUBLIC SITE KEY
  const siteKey = "6LfZKF4sAAAAAOklIR6tICh0gCzRSdgK1P9puYTb"; 
  const serverUrl = "https://hook.us2.make.com/isgsxoa1oahv48ubb10crj7ni8h7rrnd";

  formBlocks.forEach((formBlock) => {
    const form = formBlock.querySelector("form");
    const submitButton = form.querySelector('[type="submit"]');
    const loadingText = formBlock.getAttribute("fs-recaptcha-loadingtext") || "Loading...";
    const originalSubmitText = submitButton.value;

    const hideBadge = formBlock.getAttribute("fs-recaptcha-badge") === "hide";
    if (hideBadge) {
      const style = document.createElement("style");
      style.innerHTML = ".grecaptcha-badge { display: none !important; }";
      document.head.appendChild(style);
    }

    // ⚡️ Webflow Bypass Enabled (Capture Phase)
    form.addEventListener("submit", function (event) {
      
      // 1. Check if we already processed this form. 
      // If true, we return immediately and let Webflow's native script handle the rest.
      if (form.getAttribute("data-custom-submission") === "true") {
        console.log("Passing control to Webflow native submission...");
        return; 
      }

      // 2. Stop Webflow from seeing this event the first time
      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation(); 

      console.log("Submit intercepted - Custom Script running");

      // 3. Lock the form visually so user knows something is happening
      submitButton.disabled = true; 
      submitButton.value = loadingText;

      async function handleFormSubmission() {
        try {
          const token = await grecaptcha.execute(siteKey, { action: "submit" });

          // IP Fetching
          let userIp = "";
          try {
              const ipResponse = await fetch("https://api.ipify.org?format=json");
              const ipData = await ipResponse.json();
              userIp = ipData.ip;
          } catch (err) {
              console.warn("Could not fetch IP", err);
          }

          let serializedData = {};
          new FormData(form).forEach((value, key) => {
            serializedData[key] = value;
          });

          // Send to Make
          const response = await fetch(serverUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ 
                token: token, 
                formData: serializedData,
                userIp: userIp 
            }),
          });

          // SCENARIO A: Make.com Success
          if (response.ok) {
            console.log("Custom script success! Handing over to Webflow.");
            proceedToWebflow();
          } 
          // SCENARIO B: Make.com Server Error (e.g. 500 or 404)
          else {
            console.warn("Make.com failed (Server Error). Falling back to Webflow to ensure data safety.");
            // We proceed anyway so we don't lose the lead
            proceedToWebflow();
          }

        } catch (error) {
          // SCENARIO C: Network/Script Error
          console.error("Critical Error (Network/Script). Falling back to Webflow to ensure data safety.", error);
          // We proceed anyway so we don't lose the lead
          proceedToWebflow();
        }

        // Helper function to trigger Webflow's native submit
        function proceedToWebflow() {
            // Mark form as processed so the event listener at the top ignores the next click
            form.setAttribute("data-custom-submission", "true");
            
            // Unlock button (Webflow needs it enabled to submit)
            submitButton.disabled = false;
            submitButton.value = originalSubmitText;
            
            // Trigger the submit event again. 
            // Since 'data-custom-submission' is now true, our script ignores it, 
            // and Webflow's native script picks it up to handle the UI and Database storage.
            form.requestSubmit();
        }
      }

      handleFormSubmission();
    }, true); // useCapture: true ensures this runs before Webflow
  });
});
</script></div></footer><div class="cookie2-wrapper"><div fs-cc="banner" class="cookie-banner2_component"><div class="cookie-banner2_content"><div class="cookie-banner2_content-top"><div class="text-size-regular text-color-n400">By clicking “Accept”, you agree to the storing of cookies on your device to enhance site navigation, analyze site usage, and assist in our marketing efforts. View our <a href="#">Privacy Policy</a> for more information.</div></div><div class="cookie-banner2_buttons-wrapper"><a fs-cc="open-preferences" href="#" class="button is-link is-alternate w-inline-block"><div>Preferences</div></a><a fs-cc="deny" id="w-node-_713d5472-31ce-8005-f4ae-25415c8c9567-5c8c955a" href="#" class="button is-secondary is-alternate w-button">Decline</a><a fs-cc="allow" href="#" class="button is-alternate w-button">Accept</a></div><div id="w-node-_713d5472-31ce-8005-f4ae-25415c8c956b-5c8c955a" class="cookies_banner-x"><div aria-label="Close Cookies Modal" fs-cc="close" class="cookie-banner2_close-button"><div class="icon-embed-small w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 32 33" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img">
