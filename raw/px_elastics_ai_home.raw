/* Animate Icon */
.accordion-css__item-icon {
  transition: transform 0.6s cubic-bezier(0.625, 0.05, 0, 1), opacity 0.5s ease;
	opacity: 0.6;
}

[data-accordion-status="active"] .accordion-css__item-icon {
  transform: rotate(45deg);
	opacity: 1;
}
</style></div><div class="u-custom-code w-embed w-script"><script>
function initAccordionCSS() {
  document.querySelectorAll('[data-accordion-css-init]').forEach((accordion) => {
    const closeSiblings = accordion.getAttribute('data-accordion-close-siblings') === 'true';

    accordion.addEventListener('click', (event) => {
      const toggle = event.target.closest('[data-accordion-toggle]');
      if (!toggle) return; // Exit if the clicked element is not a toggle

      const singleAccordion = toggle.closest('[data-accordion-status]');
      if (!singleAccordion) return; // Exit if no accordion container is found

      const isActive = singleAccordion.getAttribute('data-accordion-status') === 'active';
      singleAccordion.setAttribute('data-accordion-status', isActive ? 'not-active' : 'active');
      
      // When [data-accordion-close-siblings="true"]
      if (closeSiblings && !isActive) {
        accordion.querySelectorAll('[data-accordion-status="active"]').forEach((sibling) => {
          if (sibling !== singleAccordion) sibling.setAttribute('data-accordion-status', 'not-active');
        });
      }
    });
  });
}

// Initialize Accordion CSS
document.addEventListener('DOMContentLoaded', () => {
  initAccordionCSS();
});
</script></div><div class="u-custom-code w-embed w-script"><script>
document.addEventListener("DOMContentLoaded", function() {
  // Create the scroll-triggered animation
  gsap.fromTo(".features_progress-bar", 
    {
      width: "0%"
    },
    {
      width: "100%",
      ease: "none",
      scrollTrigger: {
        trigger: ".trigger-ix-loader",
        start: "top top",
      end: "bottom top",
        scrub: true
      }
  });
});
</script></div><div class="hide w-embed"><style>
.arch_image-wrapper{
background-image: radial-gradient(78.85% 78.85% at 13.35% 16.4%, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0.00) 100%);
}
.arch_subasset {
    background-image: radial-gradient(78.85% 78.85% at 13.35% 16.4%, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.00) 100%);
}
  .arch_subasset.is-2.is-smaller.has-2 {
  background-image: none;
}
</style></div></section><section id="Architecture" class="section_layout90 hide"><div class="padding-global"><div class="container-large"><div class="padding-top padding-xhuge"><div class="layout90_component"><div class="w-layout-grid layout90_content"><div class="layout90_content-left"><h2 class="heading-style-h2">Architecture</h2></div><div class="layout90_content-right"><p class="text-size-medium text-color-n800">Elastics combines AI agents, portfolio and risk management, and modular components in a scalable, cloud-native system built for high-performance trading.</p></div></div><div class="spacer-xxlarge"></div></div></div></div></div><div class="padding-bottom padding-xlarge"><div class="tab_main-container light-accent-box-y"><div class="layout90_image-wrapper light-accent-box"><div data-tabs-autoplay-duration="5000" data-tabs="wrapper" data-tabs-autoplay="true" class="tab-layout__wrap light-accent-box"><div class="tab-layout__col light-accent-box"><div aria-live="polite" role="region" class="tab-visual__wrap"><div id="tab1" data-tabs="visual-item" role="tabpanel" class="tab-visual__item active"><div class="tab-visual__inner"><img sizes="100vw" srcset="https://cdn.prod.website-files.com/68629e56973c805c224da3d7/686517a7edcfbc660a9e4c79_e81fc5c61cefba6633dab192cb3e17b3_arch1-img-p-500.png 500w, https://cdn.prod.website-files.com/68629e56973c805c224da3d7/686517a7edcfbc660a9e4c79_e81fc5c61cefba6633dab192cb3e17b3_arch1-img-p-800.png 800w, https://cdn.prod.website-files.com/68629e56973c805c224da3d7/686517a7edcfbc660a9e4c79_e81fc5c61cefba6633dab192cb3e17b3_arch1-img-p-1080.png 1080w, https://cdn.prod.website-files.com/68629e56973c805c224da3d7/686517a7edcfbc660a9e4c79_e81fc5c61cefba6633dab192cb3e17b3_arch1-img.png 1600w" alt="Agents Architecture" src="https://cdn.prod.website-files.com/68629e56973c805c224da3d7/686517a7edcfbc660a9e4c79_e81fc5c61cefba6633dab192cb3e17b3_arch1-img.png" loading="lazy" class="tab-image"/></div></div><div id="tab2" data-tabs="visual-item" role="tabpanel" class="tab-visual__item"><div class="tab-visual__inner"><img sizes="100vw" srcset="https://cdn.prod.website-files.com/68629e56973c805c224da3d7/686517a791f68be00d545154_ef179a58831b8af7785ec5ef3f457c49_arch2-img-p-500.png 500w, https://cdn.prod.website-files.com/68629e56973c805c224da3d7/686517a791f68be00d545154_ef179a58831b8af7785ec5ef3f457c49_arch2-img-p-800.png 800w, https://cdn.prod.website-files.com/68629e56973c805c224da3d7/686517a791f68be00d545154_ef179a58831b8af7785ec5ef3f457c49_arch2-img-p-1080.png 1080w, https://cdn.prod.website-files.com/68629e56973c805c224da3d7/686517a791f68be00d545154_ef179a58831b8af7785ec5ef3f457c49_arch2-img.png 1600w" alt="Elastics AI Architecture" src="https://cdn.prod.website-files.com/68629e56973c805c224da3d7/686517a791f68be00d545154_ef179a58831b8af7785ec5ef3f457c49_arch2-img.png" loading="lazy" class="tab-image"/></div></div><div id="tab3" data-tabs="visual-item" role="tabpanel" class="tab-visual__item"><div class="tab-visual__inner"><img sizes="100vw" srcset="https://cdn.prod.website-files.com/68629e56973c805c224da3d7/686517a7e9d31dd4d650bec3_4ac6fe4a634a9b114ea516fa29c38b26_arch3-img-p-500.png 500w, https://cdn.prod.website-files.com/68629e56973c805c224da3d7/686517a7e9d31dd4d650bec3_4ac6fe4a634a9b114ea516fa29c38b26_arch3-img-p-800.png 800w, https://cdn.prod.website-files.com/68629e56973c805c224da3d7/686517a7e9d31dd4d650bec3_4ac6fe4a634a9b114ea516fa29c38b26_arch3-img-p-1080.png 1080w, https://cdn.prod.website-files.com/68629e56973c805c224da3d7/686517a7e9d31dd4d650bec3_4ac6fe4a634a9b114ea516fa29c38b26_arch3-img.png 1600w" alt="Elastics OS  Architecture" src="https://cdn.prod.website-files.com/68629e56973c805c224da3d7/686517a7e9d31dd4d650bec3_4ac6fe4a634a9b114ea516fa29c38b26_arch3-img.png" loading="lazy" class="tab-image"/></div></div><div id="tab4" data-tabs="visual-item" role="tabpanel" class="tab-visual__item"><div class="tab-visual__inner"><img sizes="100vw" srcset="https://cdn.prod.website-files.com/68629e56973c805