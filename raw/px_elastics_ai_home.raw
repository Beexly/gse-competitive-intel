.light-accent-box, .light-accent-box-y{
position: relative;
}

.light-accent-box::after{
    content: " ";
    position: absolute;
    border: 0.0625rem var(--_primitives---colors--nautral-400) solid;
    background-color: transparent;
    z-index: 0;
    inset: calc(.03125rem * -1);
		pointer-events: none;
}

.light-accent-box-y::after {
    inset: calc(.03125rem * -1) 0;
    border-top: 0.0625rem var(--_primitives---colors--nautral-400) solid;
    border-bottom: 0.0625rem var(--_primitives---colors--nautral-400) solid;
    content: " ";
    position: absolute;
    background-color: transparent;
    z-index: 0;
		pointer-events: none;
}
.tab_active-bar{
transition: transform 0.35s cubic-bezier(0.65,0.05,0.36,1);
transform-origin: top;
}
.tab-content__item.active .tab_active-bar{
transform: scaley(1);
transform-origin: bottom;
transition: transform 0.65s cubic-bezier(0.65,0.05,0.36,1);
}
</style></div><div class="absolute w-embed w-script"><script>
function initTabSystem() {
  const wrappers = document.querySelectorAll('[data-tabs="wrapper"]');
  
  wrappers.forEach((wrapper) => {
    const contentItems = wrapper.querySelectorAll('[data-tabs="content-item"]');
    const visualItems = wrapper.querySelectorAll('[data-tabs="visual-item"]');
    
    const autoplay = wrapper.dataset.tabsAutoplay === "true";
    const autoplayDuration = parseInt(wrapper.dataset.tabsAutoplayDuration) || 5000;
    
    let activeContent = null;
    let activeVisual = null;
    let autoplayTimer = null;

    function startAutoplay(index) {
      if (autoplayTimer) clearTimeout(autoplayTimer);
      
      if (autoplay) {
        autoplayTimer = setTimeout(() => {
          const nextIndex = (index + 1) % contentItems.length;
          switchTab(nextIndex);
        }, autoplayDuration);
      }
    }

    function switchTab(index) {
      if (contentItems[index] === activeContent) return;
      
      if (autoplayTimer) clearTimeout(autoplayTimer);
      
      const outgoingContent = activeContent;
      const outgoingVisual = activeVisual;
      
      const incomingContent = contentItems[index];
      const incomingVisual = visualItems[index];
      
      // Remove active class from outgoing elements
      if (outgoingContent) {
        outgoingContent.classList.remove("active");
        if (outgoingVisual) {
          outgoingVisual.classList.remove("active");
          // Smooth autoAlpha transition from 1 to 0
          gsap.to(outgoingVisual, { autoAlpha: 0, duration: 0.5, delay: 0.25, ease: "power1.out" });
        }
      }
      
      // Add active class to incoming elements
      incomingContent.classList.add("active");
      incomingVisual.classList.add("active");
      
      // Smooth autoAlpha transition for incoming visual
      if (incomingVisual) {
        gsap.fromTo(incomingVisual, 
          { autoAlpha: 0 }, 
          { autoAlpha: 1, duration: 0.5, ease: "power1.out" }
        );
      }
      
      // Update active references
      activeContent = incomingContent;
      activeVisual = incomingVisual;
      
      // Start autoplay timer for next tab
      startAutoplay(index);
    }

    // Initialize first tab as active
    switchTab(0);
    
    // Add click listeners to content items
    contentItems.forEach((item, i) =>
      item.addEventListener("click", () => {
        if (item === activeContent) return;
        switchTab(i);
      })
    );
  });
}

// Initialize Tab System
document.addEventListener('DOMContentLoaded', () => {
  initTabSystem();
});
</script></div></div></div></div></section><section id="Institutions" class="section_layout239"><div class="padding-global"><div class="container-large"><div class="padding-section-large"><div class="layout239_component"><div class="text-align-center"><div class="max-width-large align-center"><h2 class="heading-style-h2">Built for serious trading.</h2></div></div><div class="spacer-xxlarge"></div><div class="swiper layout239_list-wrapper"><div class="swiper-wrapper layout239_list"><div class="swiper-slide layout239_item"><div class="layout239_image-wrapper"><img loading="lazy" src="https://cdn.prod.website-files.com/68629e56973c805c224da3d7/68652150e326be4e14df01da_873c155aa890a0413aac5fa86debc550_Image.svg" alt="" class="layout239_image"/></div><div class="layout239_content"><h3 class="heading-style-h5">Non-custodial trading</h3><div class="spacer-54"></div><p class="text-size-regular text-color-n400">Trade directly on prediction market platforms while maintaining control of your funds.</p></div></div><div class="swiper-slide layout239_item"><div class="layout239_image-wrapper"><img loading="lazy" src="https://cdn.prod.website-files.com/68629e56973c805c224da3d7/68652150d98096646946eff1_9f78862b232eb3e477df5554c3b5ba67_Image-1.svg" alt="" class="layout239_image"/></div><div class="layout239_content"><h3 class="heading-style-h5">Low-latency execution</h3><div class="spacer-54"></div><p class="text-size-regular text-color-n400">Execute trades quickly with infrastructure optimized for real-time prediction markets.</p></div></div><div class="swiper-slide layout239_item"><div class="layout239_image-wrapper"><img loading="lazy" src="https://cdn.prod.website-files.com/68629e56973c805c224da3d7/68652150e8dcbc544d9ddbd0_77d703b221885a02b4b1106bbc454544_Image-2.svg" alt="" class="layout239_image"/></div><div class="layout239_content"><h3 class="heading-style-h5">Reliable infrastructure</h3><div class="spacer-54"></div><p class="text-size-regular text-color-n400">Built for continuous market monitoring, automated agents, and real-time trading.</p></div></div></div></div><div class="pps_navigation-wrap"><div class="swiper_btn-wrap"><a aria-label="Previous Slide" href="#" class="swiper-btn is-prev is-pps w-inline-block"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 25 26" fill="none" class="arrow-svg"><path d="M15.8017 6.5918C17.9927 8.21217 19.9606 10.1051 21.6567 12.2227C21.8022 12.4044 21.875 12.6231 21.875 12.8418M15.8017 19.0918C17.9927 17.4714 19.9606 15.5785 21.6567 13.4609C21.8022 13.2792 21.875 13.0605 21.875 12.8418M21.875 12.8418H3.125" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></a><a aria-label="Next Slide" href="#" class="swiper-btn is-next is-pps w-inline-block"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 25 26" fill="none" class="arrow-svg"><path d="M15.8017 6.5918C17.9927 8.21217 19.9606 10.1051 21.6567 12.2227C21.8022 12.4044 21.875 12.6231 21.875 12.8418M15.8017 19.0918C17.9927 17.4714 19.9606 15.5785 21.6567 13.4609C21.8022 13.2792 21.875 13.0605 21.875 12.8418M21.875 12.8418H3.125" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div><div class="pps_count text-size-regular text-weight-semibold"><div swiper-current-slide="pps">1</div><div>/</div><div swiper-count-slide="pps">2</div></div></div><div class="u-custom-code w-embed w-script"><script>
// Wait for DOM to be fully loaded
document.addEventListener('DOMContentLoaded', function() {
  let ppsSwiper = null;
  
  // Function to initialize PPS Swiper
  function initPpsSwiper() {
    if (window.innerWidth < 768 && !ppsSwiper) {
      ppsSwiper = new Swiper('.swiper.layout239_list-wrapper', {
        slidesPerView: 1,
        spaceBetween: 32,
        loop: false,
        
        // Navigation arrows
        navigation: {
          nextEl: '.swiper-btn.is-next.is-pps',
          prevEl: '.swiper-btn.is-prev.is-pps',
        },
        
        // Optional: Add smooth transitions
        speed: 300,
        
        // Optional: Add keyboard navigation
        keyboard: {
          enabled: true,
          onlyInViewport: true,
        },
        
        // Optional: Add accessibility
        a11y: {
          prevSlideMessage: 'Previous slide',
          nextSlideMessage: 'Next slide',
        },
        
        // Autoplay every 3 seconds
        autoplay: {
          delay: 3000,
          disableOnInteraction: false,
        },
        
        // Events
        on: {
          init: function() {
            // Update slide counter on initialization
            updateSlideCounter(this);
          },
          slideChange: function() {
            // Update slide counter when slide changes
            updateSlideCounter(this);
          }
        }
      });
    }
  }
  
  // Function to destroy PPS Swiper
  function destroyPpsSwiper() {
    if (window.innerWidth >= 768 && ppsSwiper) {
      ppsSwiper.destroy(true, true);
      ppsSwiper = null;
    }
  }
  
  // Function to update slide counter
  function updateSlideCounter(swiper) {
    const currentSlide = swiper.activeIndex + 1;
    const totalSlides = swiper.slides.length;
    
    // Update current slide number
    const currentSlideEl = document.querySelector('[swiper-current-slide="pps"]');
    if (currentSlideEl) {
      currentSlideEl.textContent = currentSlide;
    }
    
    // Update total slides count
    const totalSlidesEl = document.querySelector('[swiper-count-slide="pps"]');
    if (totalSlidesEl) {
      totalSlidesEl.textContent = totalSlides;
    }
  }
  
  // Initialize on page load
  initPpsSwiper();
  
  // Handle window resize
  window.addEventListener('resize', function() {
    if (window.innerWidth < 768) {
      initPpsSwiper();
    } else {
      destroyPpsSwiper();
    }
  });
});
</script></div></div></div></div></div></section><section id="FAQ" class="section_faq1"><div class="padding-section-custom1"><div class="faq1_component"><div class="padding-global"><div id="header-faq" class="max-width-large align-center"><h2 class="heading-style-h2">Have questions?</h2><div class="spacer-small"></div><p class="text-size-medium text-color-n800">Everything you need to know about Elastics.</p></div></div><div class="spacer-xxlarge"></div><div class="faq_block-wrap light-accent-box-y"><div class="max-width-large align-center"><div data-accordion-close-siblings="true" data-accordion-css-init="" class="faq1_list light-accent-box"><ul class="accordion-css__list"><li data-accordion-status="active" class="accordion-css__item lightmode light-accent-box"><div data-hover="" data-accordion-toggle="" class="accordion-css__item-top lightmode"><h3 class="accordion-css__item-h6 heading-style-h6">What are prediction markets?</h3><div class="accordion-css__item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 25 25" fill="none" class="accordion-css__item-icon-svg"><path d="M12.5 19.7916V12.4999M12.5 12.4999V5.20825M12.5 12.4999L5.20834 12.4999M12.5 12.4999L19.7917 12.4999" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></div><div class="accordion-css__item-bottom"><div class="accordion-css__item-bottom-wrap"><div class="accordion-css__item-bottom-content lightmode"><p class="accordion-css__item-p text-size-regular text-color-n800">Prediction markets allow participants to trade on the outcome of real-world events. Market prices reflect collective expectations, creating actionable signals across politics, sports, crypto, and more.</p></div></div></div></li><li data-accordion-status="not-active" class="accordion-css__item lightmode light-accent-box"><div data-hover="" data-accordion-toggle="" class="accordion-css__item-top lightmode"><h3 class="accordion-css__item-h6 heading-style-h6">How does Elastics work?</h3><div class="accordion-css__item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 25 25" fill="none" class="accordion-css__item-icon-svg"><path d="M12.5 19.7916V12.4999M12.5 12.4999V5.20825M12.5 12.4999L5.20834 12.4999M12.5 12.4999L19.7917 12.4999" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></div><div class="accordion-css__item-bottom"><div class="accordion-css__item-bottom-wrap"><div class="accordion-css__item-bottom-content lightmode"><p class="accordion-css__item-p text-size-regular text-color-n800">Elastics provides a unified platform to trade on Polymarket and Kalshi. Connect your accounts, access live and historical market data, and place orders across venues through a single interface.</p></div></div></div></li><li data-accordion-status="not-active" class="accordion-css__item lightmode light-accent-box"><div data-hover="" data-accordion-toggle="" class="accordion-css__item-top lightmode"><h3 class="accordion-css__item-h6 heading-style-h6">Who can use Elastics?</h3><div class="accordion-css__item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 25 25" fill="none" class="accordion-css__item-icon-svg"><path d="M12.5 19.7916V12.4999M12.5 12.4999V5.20825M12.5 12.4999L5.20834 12.4999M12.5 12.4999L19.7917 12.4999" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></div><div class="accordion-css__item-bottom"><div class="accordion-css__item-bottom-wrap"><div class="accordion-css__item-bottom-content lightmode"><p class="accordion-css__item-p text-size-regular text-color-n800">From individual traders to hedge funds, Elastics supports anyone looking to trade prediction markets with better tooling, unified access, and institutional-grade workflows.</p></div></div></div></li><li data-accordion-status="not-active" class="accordion-css__item lightmode light-accent-box"><div data-hover="" data-accordion-toggle="" class="accordion-css__item-top lightmode"><h3 class="accordion-css__item-h6 heading-style-h6">Does Elastics meet institutional standards?</h3><div class="accordion-css__item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 25 25" fill="none" class="accordion-css__item-icon-svg"><path d="M12.5 19.7916V12.4999M12.5 12.4999V5.20825M12.5 12.4999L5.20834 12.4999M12.5 12.4999L19.7917 12.4999" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></div><div class="accordion-css__item-bottom"><div class="accordion-css__item-bottom-wrap"><div class="accordion-css__item-bottom-content lightmode"><p class="accordion-css__item-p text-size-regular text-color-n800">Yes. Elastics is built with secure authentication, reliable infrastructure, and production-ready systems designed for professional trading environments.</p></div></div></div></li><li data-accordion-status="not-active" class="accordion-css__item lightmode light-accent-box"><div data-hover="" data-accordion-toggle="" class="accordion-css__item-top lightmode"><h3 class="accordion-css__item-h6 heading-style-h6">Is Elastics non-custodial?</h3><div class="accordion-css__item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 25 25" fill="none" class="accordion-css__item-icon-svg"><path d="M12.5 19.7916V12.4999M12.5 12.4999V5.20825M12.5 12.4999L5.20834 12.4999M12.5 12.4999L19.7917 12.4999" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></div><div class="accordion-css__item-bottom"><div class="accordion-css__item-bottom-wrap"><div class="accordion-css__item-bottom-content lightmode"><p class="accordion-css__item-p text-size-regular text-color-n800">Yes. You connect directly to Polymarket via DeFi wallets and to Kalshi using CeFi API keys. Elastics never takes custody of your funds.</p></div></div></div></li><li data-accordion-status="not-active" class="accordion-css__item lightmode light-accent-box"><div data-hover="" data-accordion-toggle="" class="accordion-css__item-top lightmode"><h3 class="accordion-css__item-h6 heading-style-h6">What are the costs?</h3><div class="accordion-css__item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 25 25" fill="none" class="accordion-css__item-icon-svg"><path d="M12.5 19.7916V12.4999M12.5 12.4999V5.20825M12.5 12.4999L5.20834 12.4999M12.5 12.4999L19.7917 12.4999" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></div><div class="accordion-css__item-bottom"><div class="accordion-css__item-bottom-wrap"><div class="accordion-css__item-bottom-content lightmode"><p class="accordion-css__item-p text-size-regular text-color-n800">Elastics is free.</p></div></div></div></li></ul></div></div></div><div class="w-embed"><style>
[data-accordion-status="active"].accordion-css__item.lightmode{
background-color: var(--_primitives---colors--nautral-25);
}
</style></div></div></div></section><section class="section_hblog"><div class="padding-global"><div class="container-large"><div class="hblog_component"><div class="hblog_top"><h2 class="heading-style-h2">Find the signal</h2><a href="/blog" class="button is-secondary w-inline-block"><div>See all articles</div></a></div><div class="hblog_list-wrapper w-dyn-list"><div role="list" class="hblog_list w-dyn-items"><div id="w-node-d755e705-bcfa-351e-dbb0-e34a5ecf9e4d-224da436" role="listitem" class="hblog-list_item w-dyn-item"><div class="hblog-list-item_content-wrapper"><a href="/blog-posts/elastics-raises-2m-pre-seed-for-ai-agents-for-prediction-markets" class="blog-list-item_link w-inline-block"></a><img src="https://cdn.prod.website-files.com/697b572a989177e1eb94dfdd/69f5110a88eaa34213ff9af3_image1.jpg" loading="lazy" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/697b572a989177e1eb94dfdd/69f5110a88eaa34213ff9af3_image1-p-500.jpg 500w, https://cdn.prod.website-files.com/697b572a989177e1eb94dfdd/69f5110a88eaa34213ff9af3_image1-p-800.jpg 800w, https://cdn.prod.website-files.com/697b572a989177e1eb94dfdd/69f5110a88eaa34213ff9af3_image1-p-1080.jpg 1080w, https://cdn.prod.website-files.com/697b572a989177e1eb94dfdd/69f5110a88eaa34213ff9af3_image1-p-1600.jpg 1600w, https://cdn.prod.website-files.com/697b572a989177e1eb94dfdd/69f5110a88eaa34213ff9af3_image1.jpg 1999w" class="hblog-list-item_image"/><div class="hblog-list-item_content"><div class="blog-header-list-item-content_top"><div class="blog-header-list-item-content_meta"><div class="blog-categories_list-wrapper w-dyn-list"><div role="list" class="blog-categories_list w-dyn-items"><div role="listitem" class="blog-categories-list_item w-dyn-item"><div>News &amp; Announcements</div></div></div></div><div class="text-style-tagline text-color-n600">5/5/2026</div></div><h2 class="heading-style-h6">Elastics Raises $2M Pre-Seed for AI Agents for Prediction Markets</h2></div><div class="blog_author-wrapper"><img s