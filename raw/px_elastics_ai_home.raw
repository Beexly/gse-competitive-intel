.layout303_item{
transition: background-color 0.5s ease;}

.features_subtext{
transition: opacity 0.65s ease, filter 0.45s linear;
opacity: 0;
filter: blur(5px);}



[data-status="active"].layout303_item .features_subtext{
opacity: 1;
filter: blur(0px);}
</style></div><div class="u-custom-code w-embed w-script"><script>
document.addEventListener('DOMContentLoaded', function() {
  const items = document.querySelectorAll('.layout303_item');
  let scrollTriggers = [];
  let currentMode = null;
  
  function isMobile() {
    return window.innerWidth <= 991;
  }
  
function initMobileScrollTriggers() {
  const container = items[0].parentElement; // Get the container
  
  // Individual triggers for each item to become active
  items.forEach((item, index) => {
    const trigger = ScrollTrigger.create({
      trigger: item,
      start: "top 65%",
      onEnter: () => {
        item.setAttribute('data-status', 'active');
      },
      onEnterBack: () => {
        item.setAttribute('data-status', 'active');
      }
    });
    scrollTriggers.push(trigger);
  });
  
  // Container trigger to make all items inactive when container leaves
  const containerTrigger = ScrollTrigger.create({
    trigger: container,
    start: "top 100%", // When container top reaches bottom of viewport
    end: "bottom 0%",  // When container bottom reaches top of viewport
    onLeave: () => {
      // Container scrolled past - make all items inactive
      items.forEach(item => {
        item.setAttribute('data-status', 'inactive');
      });
    },
    onLeaveBack: () => {
      // Container scrolled back up past viewport - make all items inactive
      items.forEach(item => {
        item.setAttribute('data-status', 'inactive');
      });
    }
  });
  
  scrollTriggers.push(containerTrigger);
}
  
  function initDesktopStaggeredAnimation() {
    // Set all items as inactive initially
    items.forEach(item => {
      item.setAttribute('data-status', 'inactive');
    });
    
    // Create a container trigger that progressively activates items based on scroll position
    const container = items[0].parentElement; // Assuming items are in a container
    
    const trigger = ScrollTrigger.create({
      trigger: container,
      start: "top 80%", // Start when container top reaches bottom of viewport
      end: "top 40%",   // End when container top reaches center of viewport
      scrub: true,
      onUpdate: (self) => {
        // Calculate how many items should be active based on scroll progress
        const progress = self.progress; // 0 to 1
        const activeCount = Math.ceil(progress * items.length);
        
        // Activate items progressively
        items.forEach((item, index) => {
          if (index < activeCount) {
            item.setAttribute('data-status', 'active');
          } else {
            item.setAttribute('data-status', 'inactive');
          }
        });
      },
      onLeave: () => {
        // All items active when fully scrolled past
        items.forEach(item => {
          item.setAttribute('data-status', 'active');
        });
      },
      onLeaveBack: () => {
        // All items inactive when scrolling back up past trigger
        items.forEach(item => {
          item.setAttribute('data-status', 'inactive');
        });
      }
    });
    
    scrollTriggers.push(trigger);
  }
  
  function cleanup() {
    // Remove ScrollTrigger instances
    scrollTriggers.forEach(trigger => trigger.kill());
    scrollTriggers = [];
  }
  
  function init() {
    const newMode = isMobile() ? 'mobile' : 'desktop';
    
    // Only reinitialize if mode changed
    if (currentMode !== newMode) {
      cleanup();
      currentMode = newMode;
      
      if (currentMode === 'mobile') {
        initMobileScrollTriggers();
      } else {
        initDesktopStaggeredAnimation();
      }
    }
  }
  
  // Initialize on load
  init();
  
  // Reinitialize on window resize
  let resizeTimeout;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(init, 250);
  });
});
</script></div></div></div></div></div></section><section id="Features" class="section_layout516"><div class="features_navigation-wrap"><section id="tabs" class="features_navigation accent-box-y"><div class="features_nav-container hide-mobile-landscape"><a href="#Agents" class="features_nav-item accent-box w-inline-block"><div>Agents</div></a><a href="#Elastics-AI" class="features_nav-item accent-box w-inline-block"><div>Elastics AI</div></a><a href="#Elastics-OS" class="features_nav-item accent-box w-inline-block"><div>Elastics OS</div></a><div class="features_progress-wrap"><div class="features_progress-bar"></div></div></div><div class="mobile-nav-features show-mobile-portrait"><div class="features_nav-container"><a href="#agents" class="features_nav-item accent-box w-inline-block"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="icon-1x1-xsmall show-mobile-portrait"><path d="M12 2V7M12 7H10C8.13872 7 7.20808 7 6.45492 7.24472C4.93273 7.73931 3.73931 8.93273 3.24472 10.4549C3 11.2081 3 12.1387 3 14C3 15.8613 3 16.7919 3.24472 17.5451C3.73931 19.0673 4.93273 20.2607 6.45492 20.7553C7.20808 21 8.13872 21 10 21H14C15.8613 21 16.7919 21 17.5451 20.7553C19.0673 20.2607 20.2607 19.0673 20.7553 17.5451C21 16.7919 21 15.8613 21 14C21 12.1387 21 11.2081 20.7553 10.4549C20.2607 8.93273 19.0673 7.73931 17.5451 7.24472C16.7919 7 15.8613 7 14 7H12ZM9 14C8.44772 14 8 13.5523 8 13C8 12.4477 8.44772 12 9 12C9.55228 12 10 12.4477 10 13C10 13.5523 9.55228 14 9 14ZM15 14C14.4477 14 14 13.5523 14 13C14 12.4477 14.4477 12 15 12C15.5523 12 16 12.4477 16 13C16 13.5523 15.5523 14 15 14Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg><div class="hide-mobile-portrait">Agents</div></a><a href="#elastics-ai" class="features_nav-item accent-box w-inline-block"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 25 24" fill="none" class="icon-1x1-xsmall show-mobile-portrait"><path d