.hblog-list_item:nth-child(n+3) .blog_author-wrapper, .hblog-list_item:nth-child(n+3) .blog-header-list-item-content_meta  {
display:none;
}

.hblog-list_item:nth-child(n+3) .heading-style-h6 {
font-size: 1rem;
font-weight:400;
line-height:150%;
}

.hblog-list_item:last-child {
border:none;
padding:0;
}

.hblog-list_item .heading-style-h6 {
transition: color 0.2s ease-in-out;
}

.hblog-list_item:hover .heading-style-h6 {
color: var(--_primitives---colors--blue600);
}
</style></div></div></div></div></section><section class="section_testimonial40"><div class="spacer-xhuge"></div><div class="accent-box-y"><div class="padding-global"><div class="testimonial40_component container-large"><div id="w-node-_3445c1a1-b16e-bc3b-f025-27b987659e2e-224da436" class="testimonial40_content-left"><div class="testimonial40_heading-wrapper"><h2 class="heading-style-h4">What they say about us?</h2></div><div class="testimonial_navigation-wrap"><div class="swiper_btn-wrap"><a aria-label="Previous Slide" href="#" class="swiper-btn is-prev is-testimonial w-inline-block"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 25 26" fill="none" class="arrow-svg"><path d="M15.8017 6.5918C17.9927 8.21217 19.9606 10.1051 21.6567 12.2227C21.8022 12.4044 21.875 12.6231 21.875 12.8418M15.8017 19.0918C17.9927 17.4714 19.9606 15.5785 21.6567 13.4609C21.8022 13.2792 21.875 13.0605 21.875 12.8418M21.875 12.8418H3.125" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></a><a aria-label="Next Slide" href="#" class="swiper-btn is-next is-testimonial w-inline-block"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 25 26" fill="none" class="arrow-svg"><path d="M15.8017 6.5918C17.9927 8.21217 19.9606 10.1051 21.6567 12.2227C21.8022 12.4044 21.875 12.6231 21.875 12.8418M15.8017 19.0918C17.9927 17.4714 19.9606 15.5785 21.6567 13.4609C21.8022 13.2792 21.875 13.0605 21.875 12.8418M21.875 12.8418H3.125" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div><div class="testimonial_count text-size-regular text-weight-semibold"><div swiper-current-slide="testimonial">1</div><div>/</div><div swiper-count-slide="testimonial">2</div></div></div><div class="accent-box-y is-testimonial-mobile"></div><div class="accent-line-r testimonial-desktop"></div></div><div class="swiper testimonial40_slider"><div class="swiper-wrapper testimonial40_mask"><div class="swiper-slide testimonial40_slide accent-box"><div class="testimonial40_card"><div class="testimonial40_content-top"><div class="heading-style-h5">“Elastics empowered us to innovate on prediction markets seamlessly, unlocking new alpha opportunities without the usual complexity or cost.”</div></div><div class="testimonial40_client"><div class="testimonial40_client-info"><div class="text-weight-semibold text-size-regular">Jonathan Stall-Ryan</div><div class="text-size-regular text-color-n400">CEO, Everhaven Securities</div></div><div class="testimonial40_client-image-wrapper"><img loading="lazy" src="https://cdn.prod.website-files.com/68629e56973c805c224da3d7/68653579006784e2b22dfdcb_c7c24f01bcdc7ace626415202ab13898_everhaven.png" alt="Everhaven logo" class="testimonial40_customer-image"/></div></div></div></div><div class="swiper-slide testimonial40_slide accent-box"><div class="testimonial40_card"><div class="testimonial40_content-top"><div class="heading-style-h5">“We were able to automate our strategies to run around the clock, backtest our edge efficiently, and quickly react to market changes based on real-time data.”</div></div><div class="testimonial40_client"><div class="testimonial40_client-info"><div class="text-weight-semibold text-size-regular">Szymon Pawica</div><div class="text-size-regular text-color-n400">Investor, Pavitza Capital</div></div><div class="testimonial40_client-image-wrapper"><img loading="lazy" src="https://cdn.prod.website-files.com/68629e56973c805c224da3d7/686e439f3d3910d932c82262_70ed5f5ca0d50d671f2966d99aa8da97_pavitzacapital.svg" alt="Pavitza Capital Logo" class="testimonial40_customer-image"/></div></div></div></div></div></div></div></div></div><div class="spacer-xlarge"></div><div class="u-custom-code w-embed w-script"><script>
// Wait for DOM to be fully loaded
document.addEventListener('DOMContentLoaded', function() {
  // Initialize Swiper for testimonial slider
  const testimonialSwiper = new Swiper('.swiper.testimonial40_slider', {
    slidesPerView: 1,
    spaceBetween: 0,
    loop: false,
    
    // Navigation arrows
    navigation: {
      nextEl: '.swiper-btn.is-next.is-testimonial',
      prevEl: '.swiper-btn.is-prev.is-testimonial',
    },
    
    // Optional: Add smooth transitions
    speed: 300,
    
    // Optional: Add keyboard navigation
    keyboard: {
      enabled: true,
      onlyInViewport: true,
    },
    
    // Optional: Add accessibility
    a11y: {
      prevSlideMessage: 'Previous testimonial',
      nextSlideMessage: 'Next testimonial',
    },
    
    // Autoplay every 3 seconds
    autoplay: {
      delay: 3000,
      disableOnInteraction: false,
    },
    
    // Events
    on: {
      init: function() {
        // Update slide counter on initialization
        updateSlideCounter(this);
      },
      slideChange: function() {
        // Update slide counter when slide changes
        updateSlideCounter(this);
      }
    }
  });
  
  // Function to update slide counter
  function updateSlideCounter(swiper) {
    const currentSlide = swiper.activeIndex + 1;
    const totalSlides = swiper.slides.length;
    
    // Update current slide number
    const currentSlideEl = document.querySelector('[swiper-current-slide="testimonial"]');
    if (currentSlideEl) {
      currentSlideEl.textContent = currentSlide;
    }
    
    // Update total slides count
    const totalSlidesEl = document.querySelector('[swiper-count-slide="testimonial"]');
    if (totalSlidesEl) {
      totalSlidesEl.textContent = totalSlides;
    }
  }
});
</script></div><div class="u-custom-code w-embed"><style>
[aria-disabled="true"].swiper-btn{
background-color: var(--_primitives---colors--neutral-900);
}

[aria-disabled="true"].swiper-btn.is-pps{
background-color: var(--_primitives---colors--nautral-400);
}
</style></div></section><footer class="footer1_component"><div class="padding-global"><div class="container-large"><div class="padding-vertical padding-xxlarge"><div class="padding-bottom padding-xxlarge"><div class="w-layout-grid footer1_top-wrapper"><div class="footer1_left-wrapper"><div class="heading-style-d1">AI Trading Terminal</div><div class="spacer-medium"></div><div class="footer_cta-wrap"><a href="https://app.elastics.ai" target="_blank" class="button is-alternate w-button">Launch App</a></div></div><div class="w-layout-grid footer1_menu-wrapper"><div class="footer1_link-column"><div class="text-style-tagline text-color-n600">Legal</div><div class="spacer-xsmall"></div><div class="w-layout-grid footer1_legal-list"><a href="/privacy-policy" class="footer1_legal-link">Privacy Policy</a><a href="/terms-of-service" class="footer1_legal-link">Terms of Service</a><a fs-cc="open-preferences" href="#" class="footer1_legal-link">Cookie Settings</a></div></div><div class="footer1_link-column"><div class="text-style-tagline text-color-n600">Contact</div><div class="spacer-xsmall"></div><div class="footer1_link-list"><a href="/cdn-cgi/l/email-protection#385b57564c595b4c785d54594b4c515b4b165951" class="footer1_link"><span class="__cf_email__" data-cfemail="660509081207051226030a0715120f051548070f">[email&#160;protected]</span></a><a href="https://maps.app.goo.gl/i3Med9z3SRqQ3f2L6" target="_blank" class="footer1_link">Elastics Inc. <br/>169 Madison Ave, Ste 15617<br/>New York, NY 10016<br/>United States</a></div></div></div></div></div><div class="divider-horizontal"></div><div class="padding-top padding-medium"><div class="footer1_bottom-wrapper"><div class="footer1_credit-text">©2026 All rights reserved by Elastics Inc.</div><div class="footer_socials"><a href="https://x.com/ElasticsAI" target="_blank" class="footer1_social-link w-inline-block"><div class="icon-1x1-custom1 w-embed"><svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.o