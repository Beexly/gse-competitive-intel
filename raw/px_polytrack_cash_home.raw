h([1,"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://polytrack.cash/#organization\",\"name\":\"Polytrack\",\"url\":\"https://polytrack.cash\",\"logo\":\"https://polytrack.cash/favicon-circle-512.png\",\"email\":\"polytrack.cash@gmail.com\"},{\"@type\":\"WebSite\",\"@id\":\"https://polytrack.cash/#website\",\"name\":\"Polytrack\",\"url\":\"https://polytrack.cash\",\"description\":\"A Polymarket signal dashboard for live trade tracking, severity scoring, wallet analysis, watchlists, analytics, and Telegram alerts.\",\"dateModified\":\"2026-07-15\",\"publisher\":{\"@id\":\"https://polytrack.cash/#organization\"},\"inLanguage\":\"en\"},{\"@type\":\"SoftwareApplication\",\"@id\":\"https://polytrack.cash/#software\",\"name\":\"Polytrack\",\"applicationCategory\":\"FinanceApplication\",\"operatingSystem\":\"Web\",\"url\":\"https://polytrack.cash\",\"description\":\"Polytrack monitors Polymarket for large trades, volume spikes, new wallets, and coordinated wallet movement, then keeps live feeds, severity context, wallet analysis, analytics, watchlists, history, and Telegram alerts in one dashboard.\",\"dateModified\":\"2026-07-15\",\"featureList\":[\"Live tracker for flagged Polymarket trades\",\"Dual trade feeds for general and whale-focused monitoring\",\"Advanced filters for time, size, side, market, severity, probability, and resolution date\",\"Severity scoring for large trades, volume spikes, new wallets, and coordinated movement\",\"Trader profiles with positions, activity, PnL charts, volume, and markets traded\",\"Trader comparison for side-by-side wallet analysis\",\"Leaderboard for volume and average trade size leaders\",\"Market heatmap for flagged volume by market and severity\",\"Analytics dashboard for severity volume, buy/sell pressure, categories, top markets, and top wallets\",\"History and starred trades for market review and saved activity\",\"Wallet watchlist with labels and recent trade activity\",\"Telegram alerts for HIGH severity trades and watched-wallet activity\",\"Breaking news feed for market-relevant headlines\"],\"audience\":{\"@type\":\"Audience\",\"audienceType\":\"Polymarket traders and prediction market analysts\"},\"offers\":[{\"@type\":\"Offer\",\"name\":\"Crypto, lifetime access\",\"price\":\"99.99\",\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://polytrack.cash/presignup\"},{\"@type\":\"Offer\",\"name\":\"Card, weekly subscription\",\"price\":\"10.00\",\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://polytrack.cash/presignup\"},{\"@type\":\"Offer\",\"name\":\"Card, yearly subscription\",\"price\":\"99.99\",\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://polytrack.cash/presignup\"}],\"publisher\":{\"@id\":\"https://polytrack.cash/#organization\"}},{\"@type\":\"FAQPage\",\"@id\":\"https://polytrack.cash/#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What do I get, and what is the price?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"You get the full dashboard: live tracker, dual feeds, advanced filters, severity scoring, trader profiles, comparisons, leaderboard, heatmap, analytics, history, starred trades, watchlist, Telegram alerts, and news - however you pay. Choose a one-time $99.99 crypto payment for lifetime access, or a $10/week or $99.99/year card subscription.\"}},{\"@type\":\"Question\",\"name\":\"Is Polytrack affiliated with Polymarket?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Polytrack is an independent dashboard for monitoring and analyzing Polymarket activity. It is not an exchange, broker, or first-party Polymarket application.\"}},{\"@type\":\"Question\",\"name\":\"Does Polytrack give financial advice or trade automatically?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Polytrack does not place trades, manage funds, or tell you what to buy. Severity labels, including \\\"insider\\\" language, are heuristic screens - most flagged trades are not insider trading. See our Terms of Service for the full risk disclosure.\"}},{\"@type\":\"Question\",\"name\":\"How do Telegram alerts work?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"You connect your own Telegram bot token and chat ID, then choose HIGH severity alerts, watched-wallet alerts, or both.\"}},{\"@type\":\"Question\",\"name\":\"What makes a trade HIGH severity?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Severity considers trade size, short-window volume, volume spikes, price movement, sensitive market categories, coordinated wallets, one-direction flow, accumulation, new wallets, and repeat flagged wallet activity.\"}},{\"@type\":\"Question\",\"name\":\"Can I follow specific wallets?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Add any valid Polymarket wallet to your watchlist, label it if you want, and monitor its recent trades separately from the main feed.\"}},{\"@type\":\"Question\",\"name\":\"How quickly can I start?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Create an account, complete checkout, and open the dashboard. Telegram is optional and can be connected from settings later.\"}},{\"@type\":\"Question\",\"name\":\"Can I cancel?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The one-time crypto payment is a lifetime purchase, so there is nothing to cancel. A weekly or yearly card subscription can be canceled anytime; cancelling stops future renewals but does not refund the current period.\"}}]}]}"])</script><script>self.__next_f.push([1,"0:{\"P\":null,\"b\":\"K_RKSZy0S0cxEUjIGWuf4\",\"p\":\"\",\"c\":[\"\",\"\"],\"i\":false,\"f\":[[[\"\",{\"children\":[\"__PAGE__\",{}]},\"$undefined\",\"$undefined\",true],[\"\",[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/3aefc04b1d9be7e5.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"