	<div class="wpb_raw_code wpb_raw_html wpb_content_element">
		<div class="wpb_wrapper">
			<bam-promotion-list data-max-length="4" data-placement-id="1191" data-context="web-daily-book-deals" data-property-id="5"></bam-promotion-list>
